// v114: kolom Jam selalu terlihat di desktop dan mobile; kolom Pertemuan dihapus.
function initJadwalUiOnLoad(){try{fillJadwalSantri();ensureJadwalTimePickers();}catch(e){console.warn('Jadwal UI init:',e)}}
// V157 AUTH: pemulihan sesi dibuat lebih tahan terhadap hard-refresh Android/Vercel.
// Jangan menampilkan login hanya karena getSession terlambat; beri waktu untuk
// storage Supabase dan fallback backup membaca sesi. SIGNED_OUT hanya diproses
// setelah logout manual atau setelah boot benar-benar selesai tanpa sesi.
let authBootInProgress=true;
let authRestoreInProgress=false;
let authRestoreTimer=null;
let manualLogoutInProgress=false;
let authBootFinished=false;

function showAuthChecking(message='Memeriksa sesi login...'){
  const overlay=document.getElementById('loginOverlay');
  const area=document.getElementById('loginFormArea');
  const msg=document.getElementById('authBootMsg');
  // Saat refresh, tampilkan layar loading terlebih dahulu. Jika sesi masih aktif,
  // startApp akan memulihkan halaman terakhir; landing publik hanya tampil bila
  // pemeriksaan selesai dan memang tidak ada sesi login.
  const pub=document.getElementById('publicLanding');
  if(pub) pub.classList.add('hidden');
  if(overlay){overlay.classList.remove('hidden');overlay.classList.add('auth-checking');}
  if(area) area.classList.add('hidden');
  if(msg) msg.textContent=message;
}

async function restoreAuthenticatedSession(session, options={}){
  if(!session?.user?.id) return false;
  if(authRestoreInProgress) return false;
  authRestoreInProgress=true;
  try{
    currentAccessToken=session.access_token||currentAccessToken;
    saveAuthBackup(session);
    const profResult=await Promise.race([
      supabaseClient.from('profiles').select('id,full_name,role').eq('id',session.user.id).single(),
      new Promise((_,reject)=>setTimeout(()=>reject(new Error('PROFILE_BOOT_TIMEOUT')),12000))
    ]);
    const prof=profResult?.data;
    if(!prof) throw profResult?.error||new Error('Profil pengguna belum dapat dimuat.');
    currentUser={id:session.user.id,role:prof.role,username:session.user.email,full_name:prof.full_name};
    currentAccessToken=session.access_token||currentAccessToken;
    try{await loadCloudData()}catch(e){console.error('Auth restore data:',e)}
    // SPP dan keuangan dimulai secara paralel di startApp; jangan menunggu/memanggil SPP dua kali.
    startApp(!!options.showWelcome);
    return true;
  }catch(e){
    console.error('Auth restore:',e);
    if(currentUser?.id===session.user.id){startApp(false);return true;}
    return false;
  }finally{authRestoreInProgress=false;}
}

supabaseClient.auth.onAuthStateChange((_event,session)=>{
  if(session){
    currentAccessToken=session.access_token||currentAccessToken;
    saveAuthBackup(session);
    if(authBootInProgress || authRestoreInProgress) return;
    clearTimeout(authRestoreTimer);
    authRestoreTimer=setTimeout(async()=>{
      const ok=await restoreAuthenticatedSession(session);
      if(!ok) showAuthChecking('Sesi tersimpan. Menyiapkan aplikasi...');
    },0);
    return;
  }
  if(_event==='SIGNED_OUT' && (manualLogoutInProgress || authBootFinished)){
    cloudLoadInProgress=false;
    currentUser=null;
    currentAccessToken=null;
    clearAuthBackup();
    showLoginForm('Silakan masuk sesuai akun Anda');
  }
});

(async()=>{
  showAuthChecking('Memeriksa sesi login...');
  let session=null;
  try{
    // Coba storage bawaan Supabase beberapa kali. Hard-refresh Android kadang
    // membutuhkan waktu singkat sebelum localStorage dapat dibaca.
    // Optimasi v1: getSession biasanya cepat; hindari menunggu 6 x 7 detik.
    // Tetap lakukan beberapa percobaan singkat untuk cold-start Android.
    for(let i=0;i<3 && !session;i++){
      try{
        const result=await Promise.race([
          supabaseClient.auth.getSession(),
          new Promise((_,reject)=>setTimeout(()=>reject(new Error('AUTH_BOOT_TIMEOUT')),3500))
        ]);
        if(result?.error) throw result.error;
        session=result?.data?.session||null;
      }catch(e){console.warn('Auth getSession attempt '+(i+1)+':',e?.message||e)}
      if(!session && i<2) await new Promise(r=>setTimeout(r,300));
    }

    // Fallback backup: jika storage bawaan belum terbaca, pulihkan refresh token.
    if(!session){
      const saved=getAuthBackup();
      if(saved?.access_token&&saved?.refresh_token){
        try{
          const restored=await Promise.race([
            supabaseClient.auth.setSession({access_token:saved.access_token,refresh_token:saved.refresh_token}),
            new Promise((_,reject)=>setTimeout(()=>reject(new Error('AUTH_RESTORE_TIMEOUT')),12000))
          ]);
          if(restored?.error) console.warn('Backup sesi:',restored.error);
          session=restored?.data?.session||null;
        }catch(e){console.warn('Backup sesi tidak dapat dipulihkan:',e?.message||e)}
      }
    }

    if(!session){
      // Satu pemeriksaan terakhir sebelum menampilkan form login.
      await new Promise(r=>setTimeout(r,400));
      try{session=(await supabaseClient.auth.getSession())?.data?.session||null}catch(e){}
    }

    if(session){
      const ok=await restoreAuthenticatedSession(session);
      authBootInProgress=false;
      authBootFinished=true;
      if(!ok){
        showAuthChecking('Sesi login ditemukan. Memulihkan aplikasi...');
        const retry=await new Promise(r=>setTimeout(r,1000)).then(async()=>{
          try{return (await supabaseClient.auth.getSession())?.data?.session||null}catch(e){return null}
        });
        if(retry) await restoreAuthenticatedSession(retry);
      }
      return;
    }

    authBootInProgress=false;
    authBootFinished=true;
    showPublicLanding();
  }catch(e){
    console.error('Auth boot fatal:',e);
    authBootInProgress=false;
    authBootFinished=true;
    const backup=getAuthBackup();
    if(backup?.access_token&&backup?.refresh_token){
      showAuthChecking('Sesi login tersimpan. Mencoba memulihkan...');
      try{
        const restored=await supabaseClient.auth.setSession({access_token:backup.access_token,refresh_token:backup.refresh_token});
        const ok=await restoreAuthenticatedSession(restored?.data?.session||null);
        if(ok) return;
      }catch(err){console.warn('Final auth recovery:',err)}
    }
    showPublicLanding();
  }
})();

</script>

<script>
function openPublicFlyer(title){
  const cards=Array.from(document.querySelectorAll('.publicFlyerCard'));
  const card=cards.find(el=>el.querySelector('h3')?.textContent.trim()===title);
  const image=card?.querySelector('img');
  const modal=document.getElementById('publicFlyerModal');
  const preview=document.getElementById('publicFlyerModalImage');
  if(!image||!modal||!preview)return;
  preview.src=image.src;preview.alt=image.alt;modal.classList.add('open');document.body.style.overflow='hidden';
}
function closePublicFlyer(){const modal=document.getElementById('publicFlyerModal');if(modal)modal.classList.remove('open');document.body.style.overflow='';}
document.addEventListener('keydown',function(event){if(event.key==='Escape')closePublicFlyer();});
</script>
<script id="shq-public-visitor-analytics">
/* Statistik kunjungan Ruang Kenal — V68.
   Pengunjung dicatat secara anonim; tidak menyimpan nama, email, atau alamat IP. */
(function(){
  const VISITOR_KEY = 'shq_public_visitor_id_v1';
  const VISIT_SESSION_KEY = 'shq_public_visit_logged_v1';
  function getAnonymousVisitorId(){
    try {
      let id = localStorage.getItem(VISITOR_KEY);
      if (!id) {
        id = (crypto && crypto.randomUUID) ? crypto.randomUUID() :
          ('v-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2));
        localStorage.setItem(VISITOR_KEY, id);
      }
      return id;
    } catch(e) {
      return 'session-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2);
    }
  }
  async function recordPublicVisit(){
    try {
      if (sessionStorage.getItem(VISIT_SESSION_KEY) === '1') return;
      // Catat hanya ketika halaman publik memang dibuka, bukan saat admin/pengajar/wali memakai sistem.
      const landing = document.getElementById('publicLanding');
      if (!landing || landing.classList.contains('hidden')) return;
      if (!window.supabaseClient || !supabaseClient.from) return;
      const visitorId = getAnonymousVisitorId();
      const { error } = await supabaseClient.from('public_visitor_events').insert({
        visitor_key: visitorId,
        page_path: '/ruang-kenal'
      });
      if (!error) {
        try { sessionStorage.setItem(VISIT_SESSION_KEY, '1'); } catch(e) {}
      } else {
        console.warn('Statistik pengunjung belum aktif. Pastikan SQL V68 sudah dijalankan di Supabase.', error.message);
      }
    } catch(e) { console.warn('Pencatatan kunjungan:', e); }
  }
  function maybeRecord(){
    // Tunggu sedikit agar alur auth menentukan apakah ini pengunjung publik.
    setTimeout(recordPublicVisit, 1800);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', maybeRecord);
  else maybeRecord();

  async function renderVisitorStats(){
    const el = document.getElementById('dashboardData');
    if (!el || typeof isAdmin !== 'function' || !isAdmin()) return;
    let card = document.getElementById('shqVisitorStatsCard');
    if (!card) {
      card = document.createElement('div');
      card.id = 'shqVisitorStatsCard';
      card.className = 'card';
      card.style.cssText = 'margin-top:16px;border:1px solid #d9d2bd;background:#fffdf7';
      card.innerHTML = '<h3 style="margin-top:0;color:#244B37">👁 Statistik Pengunjung Ruang Kenal</h3><p class="muted" style="margin-top:-4px">Data kunjungan anonim yang tercatat melalui Shohibul Quran System.</p><div id="shqVisitorStatsBody" class="dashStats"><div class="dashStat"><div><small>Memuat statistik…</small><strong>—</strong></div></div></div><p class="muted" style="font-size:12px;margin-bottom:0">Satu kunjungan dicatat maksimal sekali per sesi browser. Pengunjung unik merupakan perkiraan berdasarkan ID anonim pada perangkat/browser.</p>';
      el.appendChild(card);
    }
    const body = document.getElementById('shqVisitorStatsBody');
    if (!body) return;
    try {
      const { data, error } = await supabaseClient.rpc('get_public_visitor_stats');
      if (error) throw error;
      const s = Array.isArray(data) ? data[0] : data;
      if (!s) throw new Error('Statistik belum tersedia');
      body.innerHTML = [
        ['Total Kunjungan', Number(s.total_visits || 0).toLocaleString('id-ID'), 'Sepanjang waktu'],
        ['Pengunjung Unik', Number(s.unique_visitors || 0).toLocaleString('id-ID'), 'Perkiraan perangkat/browser'],
        ['Hari Ini', Number(s.today_visits || 0).toLocaleString('id-ID'), 'Kunjungan hari ini'],
        ['Bulan Ini', Number(s.month_visits || 0).toLocaleString('id-ID'), 'Kunjungan bulan berjalan']
      ].map(x => '<div class="dashStat"><div class="dashIcon">📊</div><div><small>'+x[0]+'</small><strong>'+x[1]+'</strong><span>'+x[2]+'</span></div></div>').join('');
    } catch(e) {
      body.innerHTML = '<div class="muted">Statistik belum dapat dimuat. Jalankan file SQL V68 di Supabase SQL Editor, lalu muat ulang dashboard admin.</div>';
      console.warn('Statistik pengunjung:', e.message || e);
    }
  }
  // Dashboard admin di-render ulang saat data selesai dimuat; amati tanpa mengubah dashboard role lain.
  const dashboard = document.getElementById('dashboardData');
  if (dashboard && window.MutationObserver) {
    const observer = new MutationObserver(() => {
      if (typeof isAdmin === 'function' && isAdmin()) setTimeout(renderVisitorStats, 150);
    });
    observer.observe(dashboard, {childList:true, subtree:false});
  }
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && typeof isAdmin === 'function' && isAdmin()) renderVisitorStats();
  });
})();
</script>
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function () {
    navigator.serviceWorker.register('/sw.js')
      .catch(function (error) {
        console.error('SQS Service Worker registration failed:', error);
      });
  });
}
</script>
<script>
/* SQS Push Activation - integrated safely without changing existing app logic */
(function(){
  const SQS_PUSH_VAPID_PUBLIC_KEY = 'BCKAyQ4gpE43EX0yqyjaBVCiLLZtNV5L6r1KSjJ_9m421KTzht82GSHAupldzueY03lpe_yU2r_KLucBOlSwQug';
  const SQS_PUSH_TABLE = 'sqs_push_subscriptions';
  function urlBase64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = atob(base64);
    return Uint8Array.from(raw, c => c.charCodeAt(0));
  }
  function makeUI() {
    if (document.getElementById('sqsPushActivation')) return;
    const wrap = document.createElement('div');
    wrap.id = 'sqsPushActivation';
    wrap.style.cssText = 'position:fixed;z-index:99999;right:14px;bottom:calc(18px + env(safe-area-inset-bottom));font-family:inherit;';
    wrap.innerHTML = `
      <button id="sqsPushOpen" type="button" style="border:0;border-radius:999px;padding:12px 16px;background:#244b38;color:#fff;font-weight:700;box-shadow:0 4px 18px #0003;cursor:pointer">🔔 Notifikasi</button>
      <div id="sqsPushPanel" style="display:none;position:absolute;right:0;bottom:58px;width:min(310px,calc(100vw - 28px));background:#fff;color:#244b38;border:1px solid #d8cfb5;border-radius:16px;padding:16px;box-shadow:0 8px 28px #0003">
        <div style="font-weight:800;font-size:16px;margin-bottom:6px">Notifikasi Shohibul Quran</div>
        <div id="sqsPushStatus" style="font-size:13px;line-height:1.5;margin-bottom:12px;color:#52655a">Aktifkan notifikasi agar informasi terbaru dapat dikirim ke perangkat ini.</div>
        <button id="sqsPushEnable" type="button" style="width:100%;border:0;border-radius:10px;padding:11px;background:#c5a66b;color:#244b38;font-weight:800;cursor:pointer">Aktifkan Notifikasi</button>
        <button id="sqsPushClose" type="button" style="width:100%;border:0;background:transparent;padding:8px;margin-top:5px;color:#52655a;cursor:pointer">Tutup</button>
      </div>`;
    document.body.appendChild(wrap);
    const panel = wrap.querySelector('#sqsPushPanel');
    wrap.querySelector('#sqsPushOpen').addEventListener('click', () => { panel.style.display = panel.style.display === 'none' ? 'block' : 'none'; updateStatus(); });
    wrap.querySelector('#sqsPushClose').addEventListener('click', () => panel.style.display = 'none');
    wrap.querySelector('#sqsPushEnable').addEventListener('click', activate);
  }
  function setStatus(msg, success) {
    const el = document.getElementById('sqsPushStatus');
    if (el) { el.textContent = msg; el.style.color = success ? '#247347' : '#52655a'; }
  }
  async function getSessionUser() {
    if (typeof supabaseClient === 'undefined' || !supabaseClient) return null;
    const { data, error } = await supabaseClient.auth.getSession();
    if (error) throw error;
    return data && data.session && data.session.user ? data.session.user : null;
  }
  async function updateStatus() {
    try {
      const user = await getSessionUser();
      if (!user) { setStatus('Silakan masuk ke sistem terlebih dahulu untuk mengaktifkan notifikasi.', false); return; }
      if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) { setStatus('Browser/perangkat ini belum mendukung notifikasi web.', false); return; }
      if (Notification.permission === 'denied') { setStatus('Izin notifikasi diblokir. Ubah izin situs melalui pengaturan browser.', false); return; }
      const reg = await navigator.serviceWorker.getRegistration('/');
      const sub = reg ? await reg.pushManager.getSubscription() : null;
      setStatus(sub ? 'Notifikasi sudah aktif pada perangkat ini.' : 'Notifikasi belum aktif pada perangkat ini.', !!sub);
    } catch (e) { setStatus('Status notifikasi belum dapat diperiksa. Coba lagi setelah masuk.', false); }
  }
  async function activate() {
    const btn = document.getElementById('sqsPushEnable');
    if (btn) { btn.disabled = true; btn.textContent = 'Memproses…'; }
    try {
      const user = await getSessionUser();
      if (!user) { setStatus('Anda harus masuk ke SQS terlebih dahulu.', false); return; }
      if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window)) { setStatus('Browser/perangkat ini belum mendukung notifikasi web.', false); return; }
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') { setStatus('Izin notifikasi belum diberikan. Silakan izinkan melalui browser.', false); return; }
      const reg = await navigator.serviceWorker.register('/sw.js');
      await navigator.serviceWorker.ready;
      let subscription = await reg.pushManager.getSubscription();
      if (!subscription) subscription = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlBase64ToUint8Array(SQS_PUSH_VAPID_PUBLIC_KEY) });
      const payload = subscription.toJSON();
      const { error } = await supabaseClient.from(SQS_PUSH_TABLE).upsert({
        user_id: user.id, endpoint: subscription.endpoint, subscription: payload,
        device_label: (navigator.userAgent || 'Perangkat').slice(0,180), enabled: true,
        updated_at: new Date().toISOString()
      }, { onConflict: 'endpoint' });
      if (error) throw error;
      setStatus('Berhasil! Notifikasi Shohibul Quran aktif pada perangkat ini.', true);
    } catch (e) { console.error('SQS push activation:', e); setStatus('Aktivasi belum berhasil: ' + (e.message || 'terjadi kesalahan').slice(0,180), false); }
    finally { if (btn) { btn.disabled = false; btn.textContent = 'Aktifkan Notifikasi'; } }
  }
  function init() {
    makeUI(); updateStatus();
    if (typeof supabaseClient !== 'undefined' && supabaseClient && supabaseClient.auth) supabaseClient.auth.onAuthStateChange(() => updateStatus());
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>

</body>
</html>
