<!-- Shohibul Quran System V66 - Stable layout/auth flow based on V59 -->
<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Shohibul Quran System — V157</title>
<style>
/* v97 - Admin navigation stays fixed while page content scrolls */
:root{--header-h:90px}
.mainNavLabeled{position:sticky;top:var(--header-h);z-index:4;box-shadow:0 2px 8px #23331d0a}
:root{--g:#5f8f27;--g2:#41681c;--bg:#f7f8f4;--card:#fff;--line:#dce4d7;--text:#24331d;--muted:#687464}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
header{background:linear-gradient(135deg,var(--g2),var(--g));color:#fff;padding:16px 20px;position:sticky;top:0;z-index:5}
.brand{display:flex;align-items:center;gap:12px}.brand img{width:58px;height:58px;object-fit:contain;background:#fff;border-radius:9px;padding:3px}
header h1{margin:0;font-size:22px}header small{opacity:.9}
nav{display:flex;gap:7px;flex-wrap:wrap;padding:10px;background:#fff;border-bottom:1px solid var(--line)}
nav button,.btn{border:0;border-radius:9px;padding:10px 13px;background:#edf3e9;color:var(--g2);font-weight:700;cursor:pointer}
nav button.active,.btn.primary{background:var(--g);color:#fff}.btn.edit{background:#fff3cf;color:#755b00}.danger{background:#ffe8e8!important;color:#a51d1d!important}
main{max-width:1200px;margin:auto;padding:16px}.page{display:none}.page.active{display:block}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:17px;margin-bottom:15px;box-shadow:0 3px 14px #23331d0b}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
label{font-weight:700;font-size:13px}input,select,textarea{width:100%;margin-top:5px;padding:10px;border:1px solid #ccd8c7;border-radius:8px;font:inherit;background:#fff}textarea{min-height:85px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.muted{color:var(--muted);font-size:13px}
table{width:100%;border-collapse:collapse;margin-top:10px}th,td{border:1px solid var(--line);padding:8px;text-align:left;font-size:13px;vertical-align:top}th{background:#eef4e9}
.scoreBox{background:#f8faf6;border:1px solid var(--line);border-radius:10px;padding:12px;grid-column:1/-1}
.reportHead{display:flex;align-items:center;gap:15px;border-bottom:2px solid var(--g);padding-bottom:12px;margin-bottom:15px}.reportHead img{width:75px;height:75px;object-fit:contain}
.reportHead h2{margin:0 0 4px}.badge{display:inline-block;padding:4px 8px;border-radius:20px;background:#e9f2e3;color:var(--g2);font-weight:700}
@media(max-width:700px){.grid{grid-template-columns:1fr}table{display:block;overflow:auto}.dashStats{grid-template-columns:1fr 1fr}.dashGrid2{grid-template-columns:1fr}.dashMiniGrid{grid-template-columns:1fr}}
.dashWelcome{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;background:linear-gradient(135deg,#f1f7ec,#fff);border:1px solid var(--line);border-radius:14px;padding:15px;margin-bottom:15px}.dashWelcome h3{margin:0 0 4px}.dashDate{font-size:12px;color:var(--muted);background:#fff;border:1px solid var(--line);padding:7px 10px;border-radius:20px}
.dashStats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:15px}.dashStat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;align-items:flex-start;gap:10px;min-width:0;box-shadow:0 3px 14px #23331d0b}.dashIcon{width:38px;height:38px;border-radius:10px;background:#eef4e9;display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 38px}.dashStat small{display:block;color:var(--muted);font-size:12px}.dashStat strong{display:block;font-size:25px;margin:2px 0}.dashStat span{display:block;color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dashGrid2{display:grid;grid-template-columns:1.25fr .75fr;gap:15px;margin-bottom:15px}.dashPanel{margin-bottom:0}.dashPanel h3{margin-top:0}.dashChart{height:205px;display:flex;align-items:flex-end;justify-content:space-around;gap:12px;padding:10px 5px 0;border-bottom:1px solid var(--line)}.dashBarCol{height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;min-width:35px;flex:1}.dashBarValue{font-size:11px;font-weight:700;margin-bottom:5px}.dashBar{width:min(44px,70%);background:linear-gradient(to top,var(--g2),var(--g));border-radius:7px 7px 0 0;min-height:8px}.dashBarLabel{font-size:10px;color:var(--muted);margin-top:7px}.dashEmpty{height:180px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:13px;text-align:center}.dashMiniGrid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.dashMini{border:1px solid var(--line);border-radius:10px;padding:10px;background:#fbfcfa}.dashMiniTitle{font-size:12px;font-weight:700}.dashMiniValue{font-size:23px;font-weight:700;margin:3px 0}.dashPills{display:flex;gap:7px;flex-wrap:wrap}.dashPill{padding:7px 9px;border-radius:20px;background:#fff3cf;border:1px solid #ead9a2;font-size:12px}.dashPill small{color:#806c31}


.reportStudent{padding:10px 12px;background:#f8faf6;border:1px solid var(--line);border-radius:9px;line-height:1.7}.reportAverage{margin:12px 0;padding:11px 13px;border-left:4px solid var(--g);background:#eef4e9;border-radius:7px}.summaryTable{margin-bottom:18px}.reportSession{border:1px solid var(--line);border-radius:11px;margin:0 0 14px;overflow:hidden;background:#fff}.reportSessionHead{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px 12px;background:#eef4e9;border-bottom:1px solid var(--line)}.reportSessionScore{white-space:nowrap;color:var(--g2)} .reportLesson{border-top:1px solid var(--line);padding:10px 12px}.reportLesson:first-child{border-top:0}.reportMaterial{padding:8px 12px;border-bottom:1px solid var(--line)}.componentTable{margin:0;border:0}.componentTable th,.componentTable td{font-size:12px}.reportNote{padding:9px 12px;background:#fbfcfa;border-top:1px solid var(--line);font-size:12px}.componentTable th:nth-child(2),.componentTable td:nth-child(2){width:70px}.componentTable th:nth-child(3),.componentTable td:nth-child(3){width:70px}@media(max-width:700px){.reportSessionHead{align-items:flex-start;flex-direction:column}.reportStudent{font-size:12px}}
@media print{header,nav,.no-print{display:none!important}body{background:#fff}.page{display:none!important}.page.printable{display:block!important}.card{box-shadow:none}.page.printable #report{width:100%!important;max-width:182mm!important;margin:0 auto!important;overflow:hidden!important}.page.printable #report table{width:100%!important;max-width:100%!important;table-layout:fixed!important;border-collapse:collapse!important;font-size:8px!important}.page.printable #report th,.page.printable #report td{padding:3px!important;vertical-align:top!important;overflow-wrap:anywhere!important;word-break:break-word!important;white-space:normal!important}.page.printable #report th:last-child,.page.printable #report td:last-child{width:27%!important}.page.printable #report img{max-width:100%!important}}


/* v83 - Navigasi dengan ikon + keterangan yang jelas */
.mainNavLabeled{display:flex;gap:7px;flex-wrap:wrap;align-items:stretch;padding:10px;background:#fff;border-bottom:1px solid var(--line)}
.mainNavLabeled button{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;white-space:nowrap}
.mainNavLabeled .navIcon{font-size:17px;line-height:1;display:inline-flex;align-items:center;justify-content:center}
.mainNavLabeled button span:last-child{line-height:1.1}
.mainNavLabeled button:hover{box-shadow:0 3px 10px #23331d12}
@media(max-width:700px){.mainNavLabeled{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.mainNavLabeled button{width:100%;font-size:11px;padding:9px 7px;min-height:42px}.mainNavLabeled .navIcon{font-size:16px}}

/* v96 - Dashboard Admin polish */
.dashAdminGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:15px}.dashAdminPanel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;box-shadow:0 3px 14px #23331d0b}.dashAdminPanel h3{margin:0 0 4px}.dashAdminPanel .muted{font-size:12px}.dashAdminMetric{font-size:25px;font-weight:700;margin:4px 0}.dashAdminStatus{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}.dashAdminStatus span{padding:6px 8px;border-radius:18px;background:#f5f8f3;border:1px solid var(--line);font-size:11px}.dashAdminActions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.dashAdminActions .dashQuickBtn{min-height:64px}@media(max-width:900px){.dashAdminGrid{grid-template-columns:1fr 1fr}.dashAdminActions{grid-template-columns:1fr 1fr}}@media(max-width:700px){.dashAdminGrid{grid-template-columns:1fr 1fr;gap:8px}.dashAdminPanel{padding:11px}.dashAdminMetric{font-size:21px}.dashAdminActions{grid-template-columns:1fr 1fr}.dashAdminActions .dashQuickBtn{min-height:58px}}
/* v82 - Dashboard UI Refresh */
.dashQuick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:15px}.dashQuickBtn{display:flex;align-items:center;gap:10px;text-align:left;background:#fff;border:1px solid var(--line);border-radius:12px;padding:11px 12px;color:var(--text);cursor:pointer;box-shadow:0 2px 10px #23331d08}.dashQuickBtn:hover{border-color:#b9cdb0;transform:translateY(-1px)}.dashQuickIcon{font-size:20px;width:34px;height:34px;border-radius:9px;background:#eef4e9;display:flex;align-items:center;justify-content:center}.dashQuickBtn b{display:block;font-size:12px}.dashQuickBtn small{display:block;color:var(--muted);font-size:11px;margin-top:2px}.dashSection{margin-bottom:15px}.dashTableWrap{overflow:auto}.dashTableWrap table{min-width:620px}.dashEmptyBox{padding:18px;border:1px dashed #cbd8c4;border-radius:11px;background:#fbfcfa;color:var(--muted);text-align:center}.dashAlert{border-left:4px solid #c58a00;background:#fff9e9;border-radius:9px;padding:10px 12px;margin-top:10px;font-size:12px}.dashGood{border-left:4px solid var(--g);background:#f2f8ed;border-radius:9px;padding:10px 12px;margin-top:10px;font-size:12px}@media(max-width:900px){.dashStats{grid-template-columns:repeat(3,minmax(0,1fr))}.dashQuick{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.dashStats{grid-template-columns:1fr 1fr}.dashQuick{grid-template-columns:1fr 1fr}.dashQuickBtn{padding:10px}.dashQuickIcon{width:30px;height:30px;font-size:17px}}

.loginOverlay{position:fixed;inset:0;background:linear-gradient(135deg,#41681c,#6f9e35);display:flex;align-items:center;justify-content:center;z-index:9999;padding:20px}.loginCard{width:min(430px,100%);background:#fff;border-radius:18px;padding:25px;box-shadow:0 18px 60px #0004}.loginLogo{width:90px;height:90px;object-fit:contain;display:block;margin:0 auto 10px}.loginCard h2{text-align:center;margin:5px 0}.loginCard .muted{text-align:center;margin-bottom:18px}.userBadge{margin-left:auto;background:#ffffff22;padding:7px 10px;border-radius:20px;font-size:12px}.topbar{display:flex;align-items:center;gap:10px;min-width:0}.topbar .brand{min-width:0;flex:1 1 auto}.topbar .brand>div{min-width:0}.topbar .brand h1,.topbar .brand small{overflow-wrap:anywhere}.logoutBtn{background:#fff;color:#41681c;border:0;border-radius:8px;padding:8px 11px;font-weight:700;cursor:pointer;white-space:nowrap;flex:0 0 auto}.userBadge{max-width:42%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:0 1 auto}@media(max-width:700px){header{padding:12px 14px}.topbar{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"brand brand" "user logout";gap:9px 8px}.topbar .brand{grid-area:brand;width:100%;gap:9px}.brand img{width:52px;height:52px}.topbar .brand h1{font-size:20px;line-height:1.05}.topbar .brand small{font-size:11px;line-height:1.25;display:block}.userBadge{grid-area:user;max-width:none;width:100%;margin-left:0;padding:7px 10px;text-align:center}.logoutBtn{grid-area:logout;width:auto;min-width:78px;padding:8px 12px}nav{padding:8px;gap:6px}nav button{flex:1 1 calc(50% - 6px);min-width:0;padding:9px 8px;font-size:12px}.navIcon{margin-right:3px}}.hidden{display:none!important}.scheduleToday{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.scheduleItem{border:1px solid var(--line);border-radius:11px;padding:12px;background:#fbfcfa}.scheduleItem h4{margin:0 0 5px}.scheduleTime{font-size:20px;font-weight:800;color:var(--g2)}@media(max-width:700px){.scheduleToday{grid-template-columns:1fr}}
.toastHost{position:fixed;right:18px;top:18px;z-index:10001;display:flex;flex-direction:column;gap:9px;pointer-events:none}.toast{min-width:260px;max-width:360px;background:#fff;color:var(--text);border:1px solid var(--line);border-left:5px solid var(--g);border-radius:11px;padding:12px 14px;box-shadow:0 8px 30px #23331d22;font-size:13px;font-weight:700;animation:toastIn .22s ease}.toast.success{border-left-color:var(--g)}.toast.error{border-left-color:#a51d1d}.toast.info{border-left-color:#557799}@keyframes toastIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:translateY(0)}}

.progressChart{background:#fbfcfa;border:1px solid var(--line);border-radius:12px;padding:14px;margin-top:12px}.progressChart h3{margin:0 0 4px}.chartWrap{position:relative;width:100%;height:280px}.chartWrap svg{width:100%;height:100%;display:block}.chartGrid{stroke:#dfe7da;stroke-width:1}.chartLine{fill:none;stroke:var(--g);stroke-width:3;stroke-linecap:round;stroke-linejoin:round}.chartArea{fill:#5f8f2718}.chartDot{fill:#fff;stroke:var(--g);stroke-width:3}.chartText{font-family:Arial,sans-serif;fill:#687464;font-size:11px}.chartValue{font-family:Arial,sans-serif;fill:#24331d;font-size:11px;font-weight:700}.chartEmpty{height:220px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);font-size:13px}.progressLegend{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-top:8px;font-size:12px;color:var(--muted)}

/* v14 - Penyempurnaan Portal Walisantri */
.waliHero{background:linear-gradient(135deg,#f0f7e9,#fff);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:14px}.waliHeroTop{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.waliChildName{font-size:24px;margin:4px 0}.waliMeta{display:flex;gap:7px;flex-wrap:wrap}.waliMeta span{background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 10px;font-size:12px}.waliStats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}.waliStat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px}.waliStat .num{font-size:24px;font-weight:800;margin-top:4px}.waliSectionTitle{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.waliTableWrap{overflow-x:auto}.waliTableWrap table{min-width:560px}.waliDoaGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.waliDoaItem{border:1px solid var(--line);border-radius:10px;padding:9px;background:#fbfcfa;display:flex;justify-content:space-between;gap:8px}.waliFilterNote{font-size:12px;color:var(--muted);margin-top:6px}
@media(max-width:700px){.waliStats{grid-template-columns:1fr 1fr}.waliChildName{font-size:21px}.waliHero{padding:13px}.waliDoaGrid{grid-template-columns:1fr}.waliTableWrap table{min-width:520px}.waliStats .waliStat{padding:11px}.waliStat .num{font-size:21px}.waliHero .btn{width:100%}}
@media(max-width:420px){.waliStats{grid-template-columns:1fr 1fr;gap:8px}.waliStat .num{font-size:19px}}
.institutionBadge{display:inline-block;margin-top:4px;padding:5px 10px;border-radius:999px;background:#edf3e9;color:var(--g2);font-size:11px;font-weight:800;letter-spacing:.08em}.accountBadge{display:inline-block;margin-left:7px;padding:3px 7px;border-radius:999px;background:#edf3e9;color:var(--g2);font-size:10px;font-weight:800;letter-spacing:.05em}

/* v85 - Dashboard Pengajar lebih informatif dan mobile friendly */
.teacherDashHead{background:linear-gradient(135deg,#f1f7ec,#ffffff);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:14px}
.teacherDashHead .headRow{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
.teacherDashHead h3{margin:0 0 5px;font-size:22px}
.teacherDashHead p{margin:0}
.teacherDashBadge{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 10px;font-size:12px;color:var(--g2);font-weight:700}
.teacherDashQuick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:15px}
.teacherDashQuick .dashQuickBtn{min-height:64px}
.teacherTodayList{display:grid;gap:9px}
.teacherTodayItem{display:grid;grid-template-columns:62px 1fr auto;align-items:center;gap:10px;padding:11px;border:1px solid var(--line);border-radius:12px;background:#fbfcfa}
.teacherTodayTime{font-weight:800;font-size:15px;color:var(--g2);text-align:center;background:#eef4e9;border-radius:9px;padding:8px 4px}
.teacherTodayItem h4{margin:0 0 3px;font-size:14px}
.teacherTodayItem .muted{font-size:11px}
.teacherTodayItem .btn{white-space:nowrap}
.teacherEmpty{padding:18px;border:1px dashed #cbd8c4;border-radius:11px;background:#fbfcfa;color:var(--muted);text-align:center}
.teacherAttention{display:grid;gap:8px}
.teacherAttentionItem{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 11px;border:1px solid var(--line);border-radius:10px;background:#fff}
.teacherAttentionItem b{font-size:13px}
@media(max-width:900px){.teacherDashQuick{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.teacherDashQuick{grid-template-columns:1fr 1fr}.teacherTodayItem{grid-template-columns:54px 1fr}.teacherTodayItem .btn{grid-column:1/-1;width:100%}.teacherDashHead h3{font-size:20px}}

/* v87 - Penyempurnaan Dashboard Walisantri */
.waliQuick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:0 0 14px}
.waliQuickBtn{display:flex;align-items:center;gap:10px;text-align:left;background:#fff;border:1px solid var(--line);border-radius:12px;padding:11px 12px;color:var(--text);cursor:pointer;box-shadow:0 2px 10px #23331d08}
.waliQuickBtn:hover{border-color:#b9cdb0;transform:translateY(-1px)}
.waliQuickIcon{width:34px;height:34px;border-radius:9px;background:#eef4e9;display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}
.waliQuickBtn b{display:block;font-size:12px}.waliQuickBtn small{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.waliWelcome{background:linear-gradient(135deg,#f1f7ec,#fff);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin-bottom:12px}
.waliWelcomeTop{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.waliWelcome h3{margin:0 0 4px;font-size:21px}.waliWelcome p{margin:0}
.waliStatus{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 10px;font-size:11px;font-weight:700;color:var(--g2)}
@media(max-width:900px){.waliQuick{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.waliQuick{grid-template-columns:1fr 1fr;gap:8px}.waliQuickBtn{padding:10px}.waliQuickIcon{width:30px;height:30px;font-size:17px}.waliWelcome{padding:13px}.waliWelcome h3{font-size:19px}}

/* v159 - Manajemen Akun Walisantri: edit email/password */
.waliEditModal{position:fixed;inset:0;background:#0007;display:flex;align-items:center;justify-content:center;padding:14px;z-index:10020}
.waliEditCard{width:min(520px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:16px;padding:18px;box-shadow:0 20px 70px #0005}
.waliEditCard h3{margin:0 0 5px}.waliEditGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.waliEditGrid label{display:block}.waliEditGrid .full{grid-column:1/-1}.waliEditInfo{background:#f4f8f1;border:1px solid var(--line);border-radius:10px;padding:10px;margin:10px 0;font-size:13px}
@media(max-width:600px){.waliEditGrid{grid-template-columns:1fr}.waliEditGrid .full{grid-column:auto}}
</style>
<style id="v108-jadwal-weekly">
/* v108: recurring weekly multi-slot schedules */
.jadwalWeeklyBox{margin-top:14px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#f7fbf3}
.jadwalWeeklyGrid{display:block;margin-top:10px}
.jadwalWeeklyHead{font-size:12px;font-weight:700;color:var(--g2);padding:4px 6px}
.jadwalWeeklyRow{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
.jadwalWeeklyRow label{display:flex;align-items:center;gap:7px;margin:0;padding:7px 6px;background:#fff;border-radius:9px}
.jadwalWeeklyRow select{width:100%;margin-top:0;min-height:42px}
.jadwalWeeklyRow label:nth-child(2){display:flex}
.jadwalSummary{margin-top:10px;padding:10px;border-radius:10px;background:#eef6e8}
@media(max-width:700px){.jadwalWeeklyRow{grid-template-columns:1fr 1fr}.jadwalWeeklyHead{display:inline-block;width:49%}.jadwalWeeklyHead:nth-child(2){display:inline-block}}
</style>


<style id="v99-mobile-responsive">
/* v99: safe mobile responsiveness; visual-only */
html,body{max-width:100%;overflow-x:hidden;}
*{box-sizing:border-box;}
img,svg,canvas,video{max-width:100%;}
button,input,select,textarea{max-width:100%;}
@media (max-width:700px){
  .container,.page,.content,.main-content,.dashboard,.section,.card{max-width:100%;}
  .container{padding-left:12px!important;padding-right:12px!important;}
  .grid,.dashboard-grid,.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;}
  .toolbar,.tools,.actions,.header-actions{flex-wrap:wrap!important;gap:8px!important;}
  .toolbar button,.tools button,.actions button{min-width:0;}
  table{width:100%;}
  .table-wrap,.table-responsive{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;}
  input,select,textarea{font-size:16px!important;}
  .modal,.dialog{width:calc(100vw - 24px)!important;max-width:calc(100vw - 24px)!important;}
}
@media (max-width:430px){
  .grid,.dashboard-grid,.stats-grid{grid-template-columns:1fr!important;}
  h1{font-size:1.35rem;} h2{font-size:1.15rem;}
  button{min-height:40px;}
}
</style>

<style id="v100-ui-audit">
/* v100: safe UI audit — layout only, no data/auth logic changes */
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--header-h) + 76px)}
body{overflow-x:hidden}
main{width:100%;min-width:0}
.page{width:100%;min-width:0}
.card{min-width:0;overflow:visible}
.toolbar,.tools,.actions,.header-actions{min-width:0}
button,.btn{max-width:100%;white-space:normal}
input,select,textarea{min-width:0;max-width:100%}
.dashStats,.dashGrid2,.dashAdminGrid,.dashQuick,.dashAdminActions,.grid,.scheduleToday,.waliQuick{min-width:0}
.tableWrap,.table-responsive,.dashTableWrap{width:100%;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
.tableWrap table,.table-responsive table,.dashTableWrap table{min-width:620px}
/* Keep the top navigation stable while page content scrolls. */
#mainNav{position:sticky;top:var(--header-h);z-index:4;max-width:100%;overflow:visible}
#mainNav button{min-width:0;overflow:hidden;text-overflow:ellipsis}
@media(max-width:700px){
  html{scroll-padding-top:calc(var(--header-h) + 94px)}
  main{padding:12px}
  .card{padding:13px;border-radius:12px}
  .dashWelcome,.waliWelcome{gap:10px}
  .dashStats{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .dashAdminGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .dashQuick,.dashAdminActions{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .dashQuickBtn,.dashAdminActions .dashQuickBtn{min-width:0;width:100%;overflow:hidden}
  .dashQuickBtn b,.dashQuickBtn small{overflow-wrap:anywhere}
  .actions{align-items:stretch}
  .actions .btn{flex:1 1 150px}
  .reportHead{align-items:flex-start;flex-wrap:wrap}
  .reportHead h2{font-size:18px}
  .reportHead img{width:58px;height:58px}
  .mainNavLabeled{position:sticky;top:var(--header-h);z-index:4}
  .mainNavLabeled button{min-width:0;overflow:hidden;text-overflow:ellipsis}
}
@media(max-width:430px){
  main{padding:10px}
  .card{padding:11px}
  .dashStats,.dashAdminGrid,.dashQuick,.dashAdminActions,.waliQuick{gap:7px}
  .dashStat{padding:10px;gap:7px}
  .dashStat strong{font-size:20px}
  .dashIcon{width:32px;height:32px;flex-basis:32px;font-size:16px}
  .dashQuickBtn{padding:9px}
  .dashQuickIcon{width:30px;height:30px;flex-basis:30px;font-size:17px}
  .mainNavLabeled button{font-size:10px;min-height:40px;padding:8px 5px;gap:4px}
  .mainNavLabeled .navIcon{font-size:15px}
}
</style>

<style id="v132-dashboard-mobile-fix">
/* v132: Dashboard Admin aman untuk layar HP kecil — layout/data tidak diubah */
#dashboardData,
#dashboardData .card,
#dashboardData .dashWelcome,
#dashboardData .dashAdminPanel,
#dashboardData .dashStat,
#dashboardData .dashMini,
#dashboardData .dashQuickBtn{
  min-width:0;
  max-width:100%;
  box-sizing:border-box;
}
#dashboardData .dashAdminPanel,
#dashboardData .dashStat,
#dashboardData .dashMini{
  overflow:hidden;
}
#dashboardData .dashAdminPanel h3,
#dashboardData .dashAdminPanel .muted,
#dashboardData .dashStat small,
#dashboardData .dashStat strong,
#dashboardData .dashStat span,
#dashboardData .dashMiniTitle,
#dashboardData .dashMiniValue{
  min-width:0;
  max-width:100%;
  overflow-wrap:anywhere;
  word-break:break-word;
}
#dashboardData .dashAdminStatus{
  min-width:0;
  max-width:100%;
}
#dashboardData .dashAdminStatus span{
  min-width:0;
  max-width:100%;
  overflow-wrap:anywhere;
}
#dashboardData .dashWelcome>div{
  min-width:0;
  max-width:100%;
}
#dashboardData .dashDate{
  max-width:100%;
  overflow-wrap:anywhere;
}
@media(max-width:700px){
  #dashboardData .dashAdminGrid{
    grid-template-columns:1fr !important;
  }
  #dashboardData .dashAdminPanel{
    width:100%;
    padding:12px;
  }
  #dashboardData .dashAdminMetric{
    font-size:22px;
    overflow-wrap:anywhere;
  }
  #dashboardData .dashStats{
    grid-template-columns:1fr 1fr !important;
  }
  #dashboardData .dashGrid2{
    grid-template-columns:1fr !important;
  }
  #dashboardData .dashQuick,
  #dashboardData .dashAdminActions{
    grid-template-columns:1fr 1fr !important;
  }
  #dashboardData .scheduleToday{
    grid-template-columns:1fr !important;
  }
}
@media(max-width:380px){
  #dashboardData .dashStats,
  #dashboardData .dashQuick,
  #dashboardData .dashAdminActions{
    grid-template-columns:1fr !important;
  }
  #dashboardData .dashWelcome{
    align-items:flex-start;
  }
  #dashboardData .dashDate{
    width:100%;
    text-align:left;
  }
}
</style>

<style id="v135-session-status-dashboard">#dashboardData .dashPanel{min-width:0;overflow:hidden}#dashboardData .dashMini{min-width:0}</style>

<style id="v160-elegant-login-background">
/* v160: Latar depan/login elegan bernuansa hijau zamrud, emas, dan motif geometris halus */
.loginOverlay{
  isolation:isolate;overflow:hidden;
  background:
    radial-gradient(ellipse at 14% 18%,rgba(201,169,91,.22) 0,rgba(201,169,91,0) 31%),
    radial-gradient(ellipse at 88% 82%,rgba(116,157,82,.28) 0,rgba(116,157,82,0) 34%),
    linear-gradient(135deg,#183528 0%,#17432f 42%,#285b3b 72%,#102d25 100%);
}
.loginOverlay::before{
  content:"";position:absolute;inset:-10%;z-index:-1;pointer-events:none;opacity:.19;
  background-image:
    linear-gradient(30deg,transparent 47%,rgba(220,190,117,.5) 48%,rgba(220,190,117,.5) 49%,transparent 50%),
    linear-gradient(150deg,transparent 47%,rgba(220,190,117,.42) 48%,rgba(220,190,117,.42) 49%,transparent 50%);
  background-size:74px 74px;mask-image:radial-gradient(ellipse at center,#000 8%,transparent 76%);
}
.loginOverlay::after{
  content:"";position:absolute;z-index:-1;pointer-events:none;width:min(78vw,650px);aspect-ratio:1;border:1px solid rgba(225,196,125,.25);border-radius:50%;
  box-shadow:0 0 0 28px rgba(225,196,125,.035),0 0 0 58px rgba(225,196,125,.03),0 0 0 94px rgba(225,196,125,.025);
  right:-22%;top:-34%;
}
.loginCard{
  position:relative;width:min(430px,100%);padding:30px 27px 27px;border-radius:22px;
  background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(247,250,242,.96));
  border:1px solid rgba(225,196,125,.75);box-shadow:0 24px 80px rgba(0,0,0,.34),0 0 0 7px rgba(255,255,255,.045);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
}
.loginCard::before{content:"";position:absolute;top:0;left:12%;right:12%;height:3px;border-radius:0 0 8px 8px;background:linear-gradient(90deg,transparent,#C5A66A,#e8d7a4,#C5A66A,transparent)}
.loginLogo{width:94px;height:94px;object-fit:contain;display:block;margin:0 auto 13px;padding:5px;background:#fff;border:1px solid #e5d7ad;border-radius:22px;box-shadow:0 7px 22px rgba(24,67,45,.12)}
.loginCard h2{color:#17432f;font-size:23px;letter-spacing:.15px;text-align:center;margin:5px 0 8px}
.loginCard .muted{text-align:center;margin-bottom:18px;color:#667568;line-height:1.55}
.loginCard label{color:#284b35}
.loginCard input{border-color:#d6dfd1;background:#fff;transition:border-color .18s,box-shadow .18s}
.loginCard input:focus{outline:none;border-color:#71934d;box-shadow:0 0 0 3px rgba(95,143,39,.13)}
.loginCard .btn.primary{background:linear-gradient(135deg,#285b3b,#477b37);box-shadow:0 7px 18px rgba(35,82,48,.2);border:1px solid rgba(197,164,90,.55);padding:12px 14px}
.loginCard .btn.primary:hover{filter:brightness(1.06);transform:translateY(-1px)}
@media(max-width:480px){.loginOverlay{padding:17px}.loginCard{padding:26px 20px 22px;border-radius:19px}.loginLogo{width:84px;height:84px}.loginCard h2{font-size:21px}}
@media(prefers-reduced-motion:reduce){.loginCard .btn.primary{transition:none}}
</style>

<style id="v161-elegant-all-portals">
/* Shohibul Quran System V161 — visual refresh only; preserve existing app logic */
:root{--g:#557f2b;--g2:#31551f;--bg:#f5f7f1;--card:#fff;--line:#e0e6d9;--text:#25351f;--muted:#707b69;--gold:#C5A66A;--soft:#edf4e7}
html{scroll-behavior:smooth}body{background:radial-gradient(ellipse at top left,#edf4e5 0,transparent 42%),linear-gradient(180deg,#f8faf5 0%,#f2f5ee 100%);color:var(--text);letter-spacing:.05px}
header{background:linear-gradient(120deg,#29481d 0%,#426b27 58%,#668d38 100%);box-shadow:0 7px 24px #2039191c;border-bottom:1px solid #d0b66f;}
.brand img{border:1px solid #e2d2a3;box-shadow:0 3px 12px #1729102b;border-radius:14px;background:#fff;padding:4px}
header h1{letter-spacing:.15px;text-shadow:0 1px 1px #1b351a22}
main{padding:20px;max-width:1240px}
.page.active{animation:v161FadeIn .22s ease-out}@keyframes v161FadeIn{from{opacity:.7;transform:translateY(3px)}to{opacity:1;transform:translateY(0)}}
.card,.dashStat,.dashAdminPanel,.dashQuickBtn,.scheduleItem{border:1px solid #e0e6d9;border-radius:18px;box-shadow:0 5px 20px #25351f08;transition:box-shadow .18s ease,border-color .18s ease}
.card{padding:20px;background:linear-gradient(145deg,#fff 0%,#fdfefb 100%);margin-bottom:17px}
.card>h2,.card>h3{letter-spacing:-.25px;color:#2f4824}
.card>h2{font-size:clamp(20px,2.5vw,26px);margin-top:0;margin-bottom:9px}
.card>h3{font-size:18px}
nav.mainNavLabeled{background:#fffdf9;border-bottom:1px solid #e4e7dc;box-shadow:0 5px 16px #25351f08;padding:11px 14px;gap:8px}
.mainNavLabeled button{border:1px solid transparent;border-radius:12px;background:#f3f6ef;color:#4a633a;min-height:42px;padding:10px 13px;transition:all .18s ease}
.mainNavLabeled button:hover{background:#e8f0df;border-color:#d5e2c9;box-shadow:0 4px 12px #25351f0d;transform:translateY(-1px)}
.mainNavLabeled button.active{background:linear-gradient(135deg,#557f2b,#6c963b);color:#fff;border-color:#64883b;box-shadow:0 4px 11px #426b2730}
.mainNavLabeled .navIcon{filter:saturate(.86)}
.btn,button{transition:background-color .16s ease,box-shadow .16s ease,transform .16s ease}
.btn{border-radius:11px;padding:11px 15px;border:1px solid #dfe7d7;background:#eff4e9;color:#3f612c}
.btn.primary{background:linear-gradient(135deg,#5a862d,#6b9637);border-color:#5a862d;color:#fff;box-shadow:0 4px 10px #507b2926}
.btn:hover,nav button:hover{filter:brightness(.99)}.btn.primary:hover{box-shadow:0 6px 15px #507b2938;transform:translateY(-1px)}
input,select,textarea{border:1px solid #d6dfcf;border-radius:11px;padding:12px 13px;background:#fff;color:#273621;min-height:44px;box-shadow:inset 0 1px 2px #25351f04}
input:focus,select:focus,textarea:focus{outline:none;border-color:#7fa65a;box-shadow:0 0 0 3px #6d96351c}
label{color:#34462b;font-size:13px;line-height:1.5}label input,label select,label textarea{margin-top:7px}
table{border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fff}th,td{border-width:0 1px 1px 0;border-color:#e3e8de;padding:10px 11px;line-height:1.45}th{background:#edf4e7;color:#344e26;font-weight:700}tr:last-child td{border-bottom:0}th:last-child,td:last-child{border-right:0}tbody tr:nth-child(even){background:#fbfcf9}tbody tr:hover{background:#f2f7ec}
.badge{background:#edf4e5;color:#3f612b;border:1px solid #dce8d0;padding:5px 9px}
.dashWelcome{border:1px solid #dce6d3;border-left:4px solid var(--gold);border-radius:18px;background:linear-gradient(120deg,#edf5e6,#FFFDF8);padding:20px;box-shadow:0 5px 18px #25351f07}
.dashDate{border-color:#e5dfca;background:#FFFDF8}
.dashStat{background:linear-gradient(145deg,#fff,#fbfdf8);padding:16px}.dashStat:hover,.dashAdminPanel:hover,.scheduleItem:hover{box-shadow:0 8px 24px #25351f10;border-color:#cbdcbd}
.dashIcon,.dashQuickIcon{background:linear-gradient(145deg,#eef5e8,#e4eed9);color:#426526;border:1px solid #e0e9d7}
.dashQuickBtn{background:#fff;padding:13px;border-radius:15px}.dashQuickBtn:hover{border-color:#bfd2b0;background:#fcfef9}
.dashPanel,.dashAdminPanel{border-radius:17px}.dashAdminPanel{padding:17px;background:linear-gradient(145deg,#fff,#fcfdf9)}
.scheduleItem{padding:16px;background:linear-gradient(145deg,#fff,#fafcf7);border-radius:15px}.scheduleTime{color:#456b29;font-size:clamp(18px,2.3vw,23px)}
/* Walisantri portal */
#waliPortal .card:first-child{background:linear-gradient(120deg,#edf5e6,#fffdf8);border-left:4px solid var(--gold)}
#waliPortalData .card{border-radius:18px}
.waliSectionTitle{gap:12px}.dashMini{border-color:#e0e7d9;background:linear-gradient(145deg,#fff,#f8fbf5);border-radius:12px}.dashMiniValue{color:#3f6427}
.progressChart,.chartWrap{border-radius:15px}
/* Pengajar and Admin management pages */
#pengajar .card:first-child,#manajemenAkun .card:first-child,#dataSantri .card:first-child{border-top:3px solid #6b923d}
#pengajar .card:nth-child(2),#manajemenAkun .card:nth-child(n+2){background:linear-gradient(145deg,#fff,#fcfdf9)}
#presensi .card,#pembelajaran .card,#jadwal .card{border-radius:17px}
#sessionStatusBox{border-radius:15px!important;border:1px solid #e1e9d9;background:linear-gradient(145deg,#f5f8ef,#FFFDF8)!important;padding:16px!important}
.notice{border-radius:12px!important;border:1px solid #e1e9d9;background:#f4f8ef!important;padding:12px 14px}
.modal,.waliEditModal{backdrop-filter:blur(4px)}
@media(max-width:700px){main{padding:12px}.card{padding:15px;border-radius:15px;margin-bottom:13px}.dashWelcome{padding:15px}.dashStat{padding:12px;border-radius:14px}.dashQuickBtn{padding:10px;border-radius:13px}.mainNavLabeled{padding:9px;gap:6px}.mainNavLabeled button{border-radius:10px;min-height:42px;padding:8px 6px}.btn{padding:11px 13px}input,select,textarea{padding:11px 12px}table{border-radius:10px}th,td{padding:8px;font-size:12px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;scroll-behavior:auto!important;transition:none!important}}
</style>


<style id="v162-session-edit-mobile-fix">
/* v162: tombol Edit sesi tetap terlihat pada layar HP meski tabel melebar */
#sessionList .card{min-width:0;max-width:100%}
#sessionList .card>div[style*="overflow-x:auto"]{position:relative;max-width:100%;overflow-x:auto!important;-webkit-overflow-scrolling:touch}
#sessionList table{min-width:760px;table-layout:auto}
#sessionList table th:last-child,#sessionList table td:last-child{position:sticky;right:0;z-index:2;min-width:104px;width:104px;background:#fffdf8;box-shadow:-5px 0 8px rgba(37,53,31,.08);white-space:normal}
#sessionList table th:last-child{z-index:3;background:#edf4e7}
#sessionList table td:last-child .btn{display:inline-block;margin:2px 0;min-width:68px;padding:8px 10px;font-size:12px}
@media(max-width:700px){
  #sessionList table{min-width:700px}
  #sessionList table th:last-child,#sessionList table td:last-child{min-width:96px;width:96px;padding:6px}
  #sessionList table td:last-child .btn{display:block;width:100%;min-width:0;margin:3px 0;padding:8px 5px}
}
</style>

<style id="v162-mobile-table-scroll-fix">
/* V162: table scroll independently on portrait phones; preserve existing app logic */
.table-scroll{display:block;width:100%;max-width:100%;min-width:0;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x pan-y;position:relative;scrollbar-width:thin;scrollbar-color:#9bb58b #eef3e9;border-radius:10px}
.table-scroll>table{display:table!important;width:max-content!important;min-width:100%!important;max-width:none!important;table-layout:auto!important;border-collapse:separate!important;border-spacing:0!important;margin:0}
.table-scroll>table th,.table-scroll>table td{white-space:normal;min-width:88px;max-width:240px;vertical-align:top}
.table-scroll>table th:first-child,.table-scroll>table td:first-child{min-width:135px}
.spp-bills-scroll>table th,.spp-bills-scroll>table td{min-width:105px}
.spp-bills-scroll>table th:first-child,.spp-bills-scroll>table td:first-child{min-width:155px}
.spp-settings-scroll>table th,.spp-settings-scroll>table td{min-width:115px}
.spp-settings-scroll>table th:first-child,.spp-settings-scroll>table td:first-child{min-width:160px}
.account-status-scroll>table th,.account-status-scroll>table td{min-width:120px}
.account-status-scroll>table th:nth-child(2),.account-status-scroll>table td:nth-child(2){min-width:180px}
.account-status-scroll>table th:nth-child(4),.account-status-scroll>table td:nth-child(4){min-width:190px}
.teacher-list-scroll>table th,.teacher-list-scroll>table td{min-width:120px}
.teacher-list-scroll>table th:first-child,.teacher-list-scroll>table td:first-child{min-width:190px}
.santri-list-scroll>table th,.santri-list-scroll>table td{min-width:120px}
.santri-list-scroll>table th:first-child,.santri-list-scroll>table td:first-child{min-width:170px}
.row-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap;min-width:145px}
.row-actions .btn{flex:0 0 auto;white-space:nowrap}
/* Override older global mobile table rules only inside explicit scroll containers. */
@media(max-width:700px){.table-scroll>table{display:table!important;overflow:visible!important;width:max-content!important;min-width:100%!important}.table-scroll>table th,.table-scroll>table td{font-size:12px;padding:9px;max-width:210px}.table-scroll{margin-bottom:4px}.row-actions{flex-wrap:nowrap}}
</style>


<style id="v162-table-alignment-mobile-fix">
/* v162: perbaikan tabel Admin/Pengajar agar kolom rapi dan bisa digeser mandiri di HP */
.waliTableWrap,.table-wrap,.table-responsive,.tableWrap,.table-wrapper,.dashTableWrap{
  display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;
  overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch;
  overscroll-behavior-x:contain;touch-action:pan-x pan-y;
  border-radius:12px;scrollbar-width:thin;
}
.waliTableWrap table,.table-wrap table,.table-responsive table,.tableWrap table,.table-wrapper table,.dashTableWrap table{
  width:max-content!important;min-width:100%!important;max-width:none!important;
  table-layout:auto!important;margin:0!important;
}
.waliTableWrap th,.waliTableWrap td,.table-wrap th,.table-wrap td,.table-responsive th,.table-responsive td,.tableWrap th,.tableWrap td,.table-wrapper th,.table-wrapper td,.dashTableWrap th,.dashTableWrap td{
  white-space:normal;overflow-wrap:anywhere;word-break:normal;vertical-align:top;
}
/* Kolom angka/status tidak terlalu sempit; kolom nama tetap dapat membungkus teks */
#presensiData .waliTableWrap table{min-width:700px!important}
#presensiData .waliTableWrap th,#presensiData .waliTableWrap td{padding:9px 10px}
#presensiData .waliTableWrap th:first-child,#presensiData .waliTableWrap td:first-child{min-width:125px}
#presensiData .waliTableWrap th:last-child,#presensiData .waliTableWrap td:last-child{min-width:115px}
#dashboardData .waliTableWrap table,#pengajar .waliTableWrap table,#spp .waliTableWrap table,#manajemenAkun .waliTableWrap table{min-width:680px!important}
@media(max-width:700px){
  .waliTableWrap,.table-wrap,.table-responsive,.tableWrap,.table-wrapper,.dashTableWrap{margin-left:0!important;margin-right:0!important;max-width:100%!important}
  .waliTableWrap table,.table-wrap table,.table-responsive table,.tableWrap table,.table-wrapper table,.dashTableWrap table{font-size:12px!important}
  .waliTableWrap th,.waliTableWrap td,.table-wrap th,.table-wrap td,.table-responsive th,.table-responsive td,.tableWrap th,.tableWrap td,.table-wrapper th,.table-wrapper td,.dashTableWrap th,.dashTableWrap td{padding:8px!important}
}
</style>

<style id="v162-mobile-table-fix">
/* tabel responsif: gulir di area tabel, bukan seluruh halaman */
.table-scroll,.santri-list-scroll,.waliTableWrap,.dashTableWrap,.table-responsive,.tableWrap{display:block;width:100%;max-width:100%;overflow-x:auto!important;overflow-y:hidden;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y;overscroll-behavior-x:contain}
.table-scroll table,.santri-list-scroll table,.waliTableWrap table,.dashTableWrap table{width:max-content;min-width:100%;border-collapse:separate;border-spacing:0}
#sessionList>div>div[style*="overflow-x:auto"],#akunWaliList,#sppBillsData,#accountStatusData{max-width:100%;overflow-x:auto!important;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y}
#sessionList table{min-width:780px}#santriList table{min-width:760px}#pengajarList table{min-width:900px}#sppBillsData table,#accountStatusData table{min-width:720px}
.waliTableWrap table{min-width:760px}.dashTableWrap table{min-width:720px}
.row-actions{display:flex;gap:6px;flex-wrap:wrap;min-width:120px}.row-actions .btn{white-space:nowrap}
@media(max-width:700px){.table-scroll,.santri-list-scroll,.waliTableWrap,.dashTableWrap{margin-right:0}.table-scroll th,.table-scroll td,.santri-list-scroll th,.santri-list-scroll td,.waliTableWrap th,.waliTableWrap td,.dashTableWrap th,.dashTableWrap td{white-space:normal;min-width:85px}.table-scroll th:last-child,.table-scroll td:last-child,.santri-list-scroll th:last-child,.santri-list-scroll td:last-child{min-width:130px}.dashStats,.dashAdminGrid{min-width:0}}
</style>

<style id="v162-score-table-mobile-fix">
/* v30: rapikan lembar penilaian pada layar kecil */
.scoreBox{min-width:0;box-sizing:border-box;padding:14px}
.scoreBox h3{margin:2px 0 12px}
.scoreTableWrap{width:100%;max-width:100%;overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:#fff;-webkit-overflow-scrolling:touch}
.scoreTable{width:100%;min-width:0;table-layout:fixed;border-collapse:separate;border-spacing:0;margin:0}
.scoreTable .scoreColName{width:47%}
.scoreTable .scoreColWeight{width:15%}
.scoreTable .scoreColValue{width:38%}
.scoreTable th,.scoreTable td{padding:10px 9px;overflow-wrap:anywhere;word-break:normal;vertical-align:middle}
.scoreTable th{font-weight:700;line-height:1.3}
.scoreTable td{line-height:1.4}
.scoreTable .scoreWeight{white-space:nowrap}
.scoreTable input.score{display:block;width:100%;min-width:0;max-width:100%;box-sizing:border-box;padding:10px 7px;margin:0;font-size:16px}
@media(max-width:420px){
 .scoreBox{padding:10px}
 .scoreTable .scoreColName{width:44%}
 .scoreTable .scoreColWeight{width:15%}
 .scoreTable .scoreColValue{width:41%}
 .scoreTable th,.scoreTable td{padding:9px 6px;font-size:12px}
 .scoreTable input.score{padding:9px 5px;font-size:15px}
}
</style>

<style id="v163-save-success-modal">
/* v161 - Modal sukses penyimpanan yang lebih ramah */
.saveSuccessOverlay{position:fixed;inset:0;z-index:10020;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(19,29,17,.52);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);animation:ssFade .18s ease}
.saveSuccessOverlay.hidden{display:none!important}.saveSuccessCard{width:min(360px,100%);background:#fff;border:1px solid #e1eadb;border-radius:24px;padding:28px 23px 22px;text-align:center;box-shadow:0 24px 70px #14220f40;animation:ssPop .24s ease}
.saveSuccessIcon{width:88px;height:88px;margin:0 auto 17px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#eaf7e7;border:7px solid #f4faf1;color:#2d8a43}
.saveSuccessIcon svg{width:48px;height:48px;stroke:currentColor;stroke-width:4;fill:none;stroke-linecap:round;stroke-linejoin:round}
.saveSuccessCard h2{font-size:23px;line-height:1.25;margin:0 0 9px;color:#243b25}.saveSuccessCard p{font-size:14px;line-height:1.55;color:#687464;margin:0 0 22px}.saveSuccessCard .saveSuccessButton{width:100%;border:0;border-radius:12px;padding:13px 16px;background:linear-gradient(135deg,#41681c,#5f8f27);color:#fff;font-size:15px;font-weight:800;cursor:pointer;box-shadow:0 5px 14px #41681c2e}.saveSuccessCard .saveSuccessButton:active{transform:scale(.99)}
@keyframes ssFade{from{opacity:0}to{opacity:1}}@keyframes ssPop{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
@media(max-width:420px){.saveSuccessCard{padding:25px 19px 19px;border-radius:21px}.saveSuccessIcon{width:78px;height:78px}.saveSuccessCard h2{font-size:21px}}
</style>


<style id="v164-wali-rewards">
.waliRewardCard{border:1px solid #dce8d2;background:linear-gradient(135deg,#fbfdf8,#f0f6e9)}
.waliRewardGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:14px}
.waliRewardItem{min-width:0;background:#fff;border:1px solid #e0e8d9;border-radius:16px;padding:14px 10px;text-align:center}
.waliRewardItem.is-earned{border-color:#c8dcb8;box-shadow:0 3px 12px #345c1b0d}
.waliRewardIcon{width:48px;height:48px;margin:0 auto 8px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#edf4e7;font-size:25px}
.waliRewardItem:not(.is-earned) .waliRewardIcon{filter:grayscale(1);opacity:.48;background:#f1f2ef}
.waliRewardItem b{display:block;font-size:13px;line-height:1.35;color:#2e4725}
.waliRewardItem small{display:block;margin-top:5px;font-size:11px;line-height:1.4;color:#6b7764}
.waliRewardMessage{margin-top:12px;border-radius:12px;background:#fff;padding:12px 14px;color:#40553a;font-size:13px;line-height:1.55}
@media(max-width:640px){.waliRewardGrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.waliRewardItem{padding:12px 8px}.waliRewardIcon{width:42px;height:42px;font-size:22px}}

/* v161 - Mode Pengunjung Publik Shohibul Quran */
.publicLanding{position:fixed;inset:0;z-index:9998;overflow:auto;background:#f7f8f4;color:#24331d;font-family:Arial,sans-serif}
.publicLanding.hidden{display:none!important}.publicTop{position:sticky;top:0;z-index:5;background:#244B37;color:#fff;padding:12px max(16px,calc((100vw - 1120px)/2));display:flex;align-items:center;gap:12px;box-shadow:0 3px 14px #102b1e25}.publicBrandMark{width:46px;height:46px;border-radius:12px;background:#fff;color:#244B37;display:flex;align-items:center;justify-content:center;font-size:25px;flex:0 0 auto}.publicBrandText{min-width:0;flex:1}.publicBrandText b{display:block;font-size:16px;letter-spacing:.4px}.publicBrandText small{display:block;color:#e5d39a;font-size:11px;margin-top:4px}.publicLoginBtn{border:1px solid #d9c37f;border-radius:10px;background:#fff;color:#244B37;font-weight:800;padding:10px 13px;cursor:pointer;white-space:nowrap}
.publicWrap{max-width:1120px;margin:auto;padding:20px 16px 38px}.publicHero{display:grid;grid-template-columns:1.2fr .8fr;gap:22px;align-items:center;padding:30px 26px;border-radius:22px;background:linear-gradient(135deg,#244B37,#3F6B4F);color:#fff;position:relative;overflow:hidden}.publicEyebrow{display:inline-flex;padding:6px 10px;border-radius:30px;background:#ffffff18;border:1px solid #ffffff35;color:#ead8a2;font-size:11px;font-weight:800;letter-spacing:.8px}.publicHero h1{font-size:clamp(28px,4vw,44px);line-height:1.12;margin:14px 0 12px;max-width:600px}.publicHero p{line-height:1.7;color:#f0f5ef;max-width:590px}.publicHeroArt{min-height:220px;border-radius:18px;background:radial-gradient(circle at 50% 35%,#f1e2b6 0 11%,transparent 11.5%),linear-gradient(145deg,#f5edda,#d9e7d2);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}.publicHeroBook{font-size:88px;filter:drop-shadow(0 12px 10px #173b2530)}.publicHeroArt:before,.publicHeroArt:after{content:'۞';position:absolute;color:#b89b4e;opacity:.55;font-size:100px}.publicHeroArt:before{top:-20px;left:-12px}.publicHeroArt:after{bottom:-35px;right:-10px}.publicBtnRow{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.publicPrimary,.publicSecondary{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border-radius:10px;padding:12px 15px;font-size:13px;font-weight:800;cursor:pointer}.publicPrimary{background:#C5A66A;color:#173f2e;border:0}.publicSecondary{background:transparent;color:#fff;border:1px solid #ffffff80}.publicSection{margin-top:25px}.publicSectionHead{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap;margin-bottom:13px}.publicSectionHead h2{margin:0;color:#244B37;font-size:23px}.publicSectionHead p{margin:6px 0 0;color:#687464;font-size:13px;line-height:1.5}.publicCards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.publicCard{background:#fff;border:1px solid #dce4d7;border-radius:15px;padding:17px;box-shadow:0 4px 16px #23331d08}.publicCardIcon{width:44px;height:44px;border-radius:12px;background:#edf4e7;display:flex;align-items:center;justify-content:center;font-size:23px;margin-bottom:10px}.publicCard h3{margin:0 0 7px;font-size:16px;color:#24472f}.publicCard p{margin:0;color:#687464;font-size:13px;line-height:1.6}.publicSteps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.publicStep{background:#fff;border:1px solid #dce4d7;border-radius:13px;padding:14px}.publicStep span{display:inline-flex;width:29px;height:29px;border-radius:50%;align-items:center;justify-content:center;background:#244B37;color:#fff;font-size:12px;font-weight:800;margin-bottom:9px}.publicStep b{display:block;font-size:13px;margin-bottom:5px}.publicStep small{font-size:12px;line-height:1.5;color:#687464}.publicFinder{display:grid;grid-template-columns:.85fr 1.15fr;gap:16px;align-items:start}.publicFinderForm{background:#fff;border:1px solid #dce4d7;border-radius:16px;padding:17px}.publicFinderForm label{display:block;margin:12px 0 0;font-size:12px}.publicFinderForm select{margin-top:6px}.publicResult{background:#edf4e7;border:1px solid #cdddc3;border-radius:16px;padding:18px;min-height:220px}.publicResult h3{color:#244B37;margin:7px 0}.publicResult p,.publicResult li{font-size:13px;line-height:1.65}.publicResult ul{padding-left:20px}.publicNote{font-size:11px!important;color:#687464}.publicFaq{display:grid;grid-template-columns:1fr 1fr;gap:10px}.publicFaq details{background:#fff;border:1px solid #dce4d7;border-radius:12px;padding:13px}.publicFaq summary{cursor:pointer;font-weight:800;font-size:13px;color:#24472f}.publicFaq p{font-size:12px;color:#687464;line-height:1.6;margin-bottom:0}.publicFooter{margin-top:28px;background:#244B37;color:#fff;border-radius:18px;padding:22px;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}.publicFooter h2{margin:0 0 7px;font-size:22px}.publicFooter p{margin:0;color:#e5eee5;font-size:13px;line-height:1.6}.publicFooter a{background:#C5A66A;color:#173f2e;text-decoration:none;border-radius:10px;padding:12px 15px;font-weight:800;font-size:13px}.publicTiny{font-size:11px;color:#687464;text-align:center;margin-top:13px;line-height:1.6}
@media(max-width:760px){.publicTop{padding:10px 12px}.publicBrandMark{width:40px;height:40px}.publicBrandText b{font-size:13px}.publicBrandText small{font-size:10px}.publicLoginBtn{padding:9px 10px;font-size:12px}.publicWrap{padding:13px 12px 28px}.publicHero{grid-template-columns:1fr;padding:22px 18px;gap:16px}.publicHeroArt{min-height:125px}.publicHeroBook{font-size:62px}.publicHero h1{font-size:30px}.publicCards{grid-template-columns:1fr}.publicSteps{grid-template-columns:1fr 1fr}.publicFinder{grid-template-columns:1fr}.publicFaq{grid-template-columns:1fr}.publicSectionHead h2{font-size:21px}}

</style>


<style id="public-elegant-overrides">
.publicLanding{background:#f8f7f1;color:#203d30;font-family:Georgia,"Times New Roman",serif}
.publicTop{background:rgba(255,255,255,.96);color:#244B37;border-bottom:1px solid #e8dfc6;box-shadow:0 5px 22px rgba(28,65,48,.08);padding-top:14px;padding-bottom:14px}
.publicBrandMark{width:64px;height:64px;background:#fff;border:0;border-radius:0;overflow:visible;box-shadow:none}
.publicBrandMark img{display:block;width:100%;height:100%;object-fit:contain}
.publicBrandText b{font-family:Georgia,"Times New Roman",serif;font-size:clamp(15px,2vw,21px);letter-spacing:.5px;color:#244B37}
.publicBrandText small{font-family:Georgia,"Times New Roman",serif;color:#9c7a32;font-size:12px}
.publicLoginBtn{background:#244B37;color:#fff;border:1px solid #244B37;border-radius:14px;padding:13px 17px;box-shadow:0 5px 14px #244B371c}
.publicWrap{max-width:1200px;padding:24px 18px 42px}
.publicHero{grid-template-columns:1.08fr .92fr;gap:24px;padding:42px 30px;border:1px solid #e4d9b8;border-radius:28px;background:linear-gradient(115deg,#FBF8F1 0%,#f5f1e5 53%,#e7eadb 100%);color:#244B37;box-shadow:0 18px 50px rgba(31,69,49,.08)}
.publicHero:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.15;background-image:radial-gradient(circle at 10% 10%,#b99a4a 1px,transparent 1.5px);background-size:24px 24px}
.publicHero>div{position:relative;z-index:1}
.publicEyebrow{background:#eee5c9;border:1px solid #e1d4aa;color:#8a6b2d;padding:9px 14px;letter-spacing:1px;font-size:11px}
.publicHero h1{font-family:Georgia,"Times New Roman",serif;color:#244B37;font-size:clamp(34px,4.6vw,56px);line-height:1.06;letter-spacing:-.7px;margin:22px 0 16px}
.publicHero p{color:#5b6c63;font-family:Georgia,"Times New Roman",serif;font-size:17px;line-height:1.65}
.publicHeroArt{min-height:310px;border:1px solid #e7dec5;border-radius:24px;background:linear-gradient(145deg,#fdfbf4,#e2eadb);box-shadow:inset 0 0 0 8px #ffffff70}
.publicHeroBook{font-size:108px;filter:drop-shadow(0 14px 12px #173b2520)}
.publicHeroArt:before,.publicHeroArt:after{font-size:118px;color:#b99a4a;opacity:.48}
.publicBtnRow{gap:12px}
.publicPrimary,.publicSecondary{font-family:Georgia,"Times New Roman",serif;font-size:15px;padding:15px 19px;border-radius:14px;min-height:50px}
.publicPrimary{background:#244B37;color:white;box-shadow:0 8px 20px #244B3720}
.publicSecondary{background:#fff;color:#244B37;border:1px solid #dfd4b6}
.publicSection{margin-top:42px}
.publicSectionHead h2{font-family:Georgia,"Times New Roman",serif;font-size:clamp(24px,3vw,34px);letter-spacing:-.3px;color:#244B37}
.publicSectionHead p{font-family:Georgia,"Times New Roman",serif;font-size:15px;line-height:1.65;color:#6b766c}
.publicCards{gap:16px}
.publicCard{border:1px solid #e8e3d5;border-radius:22px;padding:18px;background:linear-gradient(180deg,#fff 0%,#fdfcf8 100%);box-shadow:0 9px 26px rgba(27,65,46,.055)}
.publicCardIcon{width:52px;height:52px;border-radius:16px;background:#edf1e5;color:#244B37}
.publicCard h3{font-family:Georgia,"Times New Roman",serif;color:#244B37;font-size:19px}
.publicCard p{font-family:Georgia,"Times New Roman",serif;font-size:14px;line-height:1.7;color:#68756b}
.publicStep{border:1px solid #e7e0cf;border-radius:18px;background:#FFFDF8;padding:17px}
.publicStep span{background:#2c6a50;color:#fff}
.publicStep b{font-family:Georgia,"Times New Roman",serif;color:#244B37;font-size:15px}
.publicStep small{line-height:1.65}
.publicFinderForm,.publicResult{border-radius:20px;border-color:#e5ddc7;box-shadow:0 8px 22px #244B3708}
.publicResult{background:linear-gradient(145deg,#eef2e7,#f8f5e8)}
.publicFaq details{border-color:#e8e1d1;border-radius:16px;background:#FFFDF8}
.publicFaq summary{font-family:Georgia,"Times New Roman",serif;color:#244B37}
.publicFooter{background:linear-gradient(120deg,#244B37,#3F6B4F);border-radius:24px;padding:28px}
.publicFooter h2{font-family:Georgia,"Times New Roman",serif}
@media(max-width:760px){
 .publicTop{padding:10px 14px;gap:9px}
 .publicBrandMark{width:60px;height:60px}
 .publicBrandText b{font-size:14px;letter-spacing:.2px}
 .publicBrandText small{font-size:10px}
 .publicLoginBtn{padding:11px 12px;font-size:12px}
 .publicWrap{padding:16px 14px 30px}
 .publicHero{grid-template-columns:1fr;padding:25px 20px 22px;gap:18px;border-radius:25px}
 .publicHero h1{font-size:clamp(34px,9vw,46px);line-height:1.08;margin:19px 0 14px}
 .publicHero p{font-size:16px;line-height:1.65}
 .publicHeroArt{min-height:175px;border-radius:22px}
 .publicHeroBook{font-size:76px}
 .publicHeroArt:before,.publicHeroArt:after{font-size:86px}
 .publicBtnRow{display:grid;grid-template-columns:1fr}
 .publicPrimary,.publicSecondary{width:100%;font-size:15px}
 .publicSection{margin-top:32px}
 .publicCards{grid-template-columns:1fr}
 .publicCard{padding:20px}
}
</style>


<style id="shq-refresh-loading-style">
.loginOverlay.auth-checking .loginCard{position:relative}
.loginOverlay.auth-checking #authBootMsg{display:flex;align-items:center;justify-content:center;gap:10px;min-height:34px;font-weight:600}
.loginOverlay.auth-checking #authBootMsg::before{content:"";display:inline-block;width:19px;height:19px;flex:0 0 19px;border:3px solid #dce7d7;border-top-color:#286044;border-radius:50%;animation:shqAuthSpin .8s linear infinite}
@keyframes shqAuthSpin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.loginOverlay.auth-checking #authBootMsg::before{animation:none}}
</style>

<style id="shq-theme-unification-v163">
/* V163: Penyelarasan visual publik, login, dashboard, dan seluruh modul. Tidak mengubah logika aplikasi. */
:root{--g:#244B37;--g2:#1D3D2E;--bg:#F6F1E7;--card:#FFFDF8;--line:#e5dfc9;--text:#243c30;--muted:#6d796f;--gold:#C5A66A;--soft:#E9EEE5;--shq-green:#244B37;--shq-green-light:#3F6B4F;--shq-ivory:#F6F1E7;--shq-gold:#C5A66A}
body{background:radial-gradient(ellipse at 12% 0%,rgba(216,189,121,.10),transparent 32%),linear-gradient(180deg,#F6F1E7 0%,#f1f4ed 100%);color:#243c30}
header{background:linear-gradient(115deg,#1D3D2E 0%,#244B37 60%,#3F6B4F 100%);border-bottom:1px solid rgba(216,189,121,.65);box-shadow:0 8px 24px rgba(18,60,45,.13)}
header .brand img{border:1px solid rgba(216,189,121,.65);border-radius:13px;background:#FFFDF8;box-shadow:0 4px 14px rgba(12,42,30,.18)}
header h1{color:#FFFDF8;letter-spacing:.2px}header small{color:#e8d8a8!important}
.userBadge{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.18);color:#FFFDF8}
.logoutBtn{background:#FFFDF8;color:#244B37;border:1px solid #C5A66A;border-radius:11px;box-shadow:0 3px 10px rgba(0,0,0,.08)}
nav.mainNavLabeled{background:rgba(255,254,250,.97);border-bottom:1px solid #e5dfc9;box-shadow:0 5px 18px rgba(23,77,56,.06)}
.mainNavLabeled button{background:#F0EEE5;color:#385b48;border:1px solid transparent;border-radius:12px}
.mainNavLabeled button:hover{background:#e9efe4;border-color:#d9e3d3}
.mainNavLabeled button.active{background:linear-gradient(135deg,#244B37,#3F6B4F);color:#fff;border-color:#C5A66A;box-shadow:0 4px 13px rgba(23,77,56,.18)}
main{color:#243c30}
.card,.dashStat,.dashAdminPanel,.dashQuickBtn,.scheduleItem{border-color:#e5e2d6;box-shadow:0 5px 22px rgba(28,56,41,.045)}
.card{background:linear-gradient(145deg,#FFFDF8 0%,#fff 100%)}
.card>h2,.card>h3{color:#244B37}
.dashWelcome,#waliPortal .card:first-child{background:linear-gradient(120deg,#E9EEE5 0%,#FFFDF8 100%);border-color:#e2dfce;border-left-color:#C5A66A}
.dashIcon,.dashQuickIcon{background:linear-gradient(145deg,#E9EEE5,#e4ebdc);color:#244B37;border-color:#dfe6d8}
.dashStatValue,.dashMiniValue,.scheduleTime{color:#244B37}
.btn.primary{background:linear-gradient(135deg,#244B37,#3F6B4F);border:1px solid #C5A66A;color:#FFFDF8;box-shadow:0 5px 14px rgba(23,77,56,.16)}
.btn{border-radius:12px}.btn:not(.primary){background:#F6F1E7;color:#28533e;border-color:#e0e2d6}
input,select,textarea{border-color:#dcded1;background:#FFFDF8;color:#243c30;border-radius:12px}
input:focus,select:focus,textarea:focus{border-color:#6b9479;box-shadow:0 0 0 3px rgba(23,77,56,.12)}
label{color:#385344}
table{border-color:#e5e2d6}th{background:#E9EEE5;color:#244c37}tbody tr:nth-child(even){background:#FBF8F1}tbody tr:hover{background:#f1f5ed}
.badge{background:#E9EEE5;color:#244B37;border-color:#dce5d6}
.loginOverlay{background:radial-gradient(ellipse at 14% 18%,rgba(216,189,121,.20),transparent 31%),radial-gradient(ellipse at 88% 82%,rgba(93,145,106,.24),transparent 34%),linear-gradient(135deg,#183528 0%,#244B37 52%,#286247 100%)}
.loginOverlay::before{opacity:.16;background-size:78px 78px}
.loginCard{background:linear-gradient(145deg,#FFFDF8 0%,#F6F1E7 100%);border-color:rgba(216,189,121,.85);box-shadow:0 24px 80px rgba(0,0,0,.30),0 0 0 7px rgba(255,255,255,.045)}
.loginCard::before{background:linear-gradient(90deg,transparent,#b99a52,#e7d59c,#b99a52,transparent)}
.loginLogo{border-color:#C5A66A;border-radius:20px;background:#fff}
.loginCard h2{color:#244B37}
.loginCard .muted{color:#68786c}
.loginCard label{color:#294c39}
.loginCard input{border-color:#dcded1;background:#FFFDF8}
.loginCard input:focus{border-color:#638d72;box-shadow:0 0 0 3px rgba(23,77,56,.13)}
.loginCard .btn.primary{background:linear-gradient(135deg,#244B37,#3F6B4F);border-color:#C5A66A}
#authBootMsg{color:#6d796f}
#saveSuccessOverlay .saveSuccessCard,.modal .modal-content,.waliEditModal>div{border-color:#e2d7b6}
@media(max-width:700px){header{background:linear-gradient(115deg,#1D3D2E,#244B37 70%,#3F6B4F)}.mainNavLabeled button.active{background:linear-gradient(135deg,#244B37,#3F6B4F)}main{padding:12px}.card{background:#FFFDF8}}
@media(prefers-reduced-motion:reduce){.page.active{animation:none}}
</style>


<style id="modern-minimalist-emerald-cream">
/* Shohibul Quran — Modern Minimalist Emerald & Cream; visual-only overrides */
:root{--g:#3F6B4F;--g2:#244B37;--bg:#F6F1E7;--card:#FFFFFF;--line:#E2E5D9;--text:#20372E;--muted:#68776D;--gold:#C5A66A;--header-h:90px; color-scheme:light}
html{scroll-behavior:smooth} body{background:var(--bg);color:var(--text);font-family:Inter,"Segoe UI",Arial,sans-serif;line-height:1.45}
header{background:linear-gradient(120deg,#244B37,#3F6B4F);box-shadow:0 3px 12px #123b2a18;padding:13px 20px}
header h1{font-size:clamp(18px,2vw,22px);letter-spacing:.1px}header small{color:#e3eee6}
.brand img{border-radius:12px;border:1px solid #C5A66A55}
#mainNav.mainNavLabeled{position:fixed;left:0;top:var(--header-h);bottom:0;width:218px;overflow-y:auto;overflow-x:hidden;z-index:4;display:flex;flex-direction:column;align-items:stretch;gap:4px;padding:14px 10px;background:#fff;border-right:1px solid var(--line);border-bottom:0;box-shadow:3px 0 16px #173c2a08}
#mainNav button{display:flex;align-items:center;gap:10px;text-align:left;width:100%;min-height:42px;padding:10px 12px;border-radius:10px;background:transparent;color:#3c5548;font-size:13px;font-weight:600;white-space:normal;transition:background .16s ease,color .16s ease}
#mainNav button:hover{background:#E9EEE5;color:var(--g2)}#mainNav button.active{background:#244B37;color:#fff;box-shadow:inset 3px 0 0 var(--gold)}
.navIcon{width:22px;min-width:22px;text-align:center;font-size:16px;filter:saturate(.75)}
main{max-width:none;margin:0 0 0 218px;padding:22px clamp(14px,2.4vw,30px) 32px}
.card,.dashStat{background:var(--card);border:1px solid var(--line);border-radius:13px;box-shadow:0 2px 8px #173c2a06}
.card{padding:16px;margin-bottom:13px}.dashStat{padding:13px}.dashWelcome{background:#fff;border-color:var(--line);border-radius:13px;padding:16px}.dashDate{background:#F6F1E7;border-color:#e8dfc8}
.dashIcon{background:#E9EEE5;color:var(--g2)}.dashMini{background:#FBF8F1;border-color:var(--line)}.dashBar{background:linear-gradient(to top,var(--g2),var(--g))}
nav button,.btn{border-radius:9px;font-weight:650;transition:background .15s ease,transform .15s ease}.btn{background:#E9EEE5;color:var(--g2)}.btn.primary{background:var(--g2);color:#fff}.btn.edit{background:#f7efd9;color:#755b00;border:1px solid #e5d29c}.btn:hover,nav button:hover{filter:brightness(.98)}
input,select,textarea{border:1px solid #d7dfd4;border-radius:9px;background:#fff;color:var(--text);padding:10px 11px;outline:none}input:focus,select:focus,textarea:focus{border-color:#3F6B4F;box-shadow:0 0 0 3px #3F6B4F18}
th{background:#E9EEE5;color:#234a38}th,td{border-color:var(--line)}.scoreBox{background:#f8f7f1;border-color:var(--line)}.badge{background:#E9EEE5;color:var(--g2)}.reportHead{border-bottom-color:var(--gold)}
/* keep all existing views and controls; responsive hybrid navigation */
@media(max-width:800px){:root{--header-h:0px}header{position:sticky;top:0;padding:10px 12px}.brand img{width:43px;height:43px}.topbar{gap:8px}header h1{font-size:17px}header small{font-size:10px}#mainNav.mainNavLabeled{position:sticky;top:0;bottom:auto;width:100%;max-height:none;flex-direction:row;align-items:stretch;overflow-x:auto;overflow-y:hidden;white-space:nowrap;padding:8px;gap:6px;border-right:0;border-bottom:1px solid var(--line);box-shadow:0 3px 10px #173c2a08;scrollbar-width:thin}#mainNav button{width:auto;min-width:max-content;min-height:40px;padding:9px 11px;white-space:nowrap;font-size:12px}#mainNav button.active{box-shadow:inset 0 -3px 0 var(--gold)}main{margin:0;padding:14px 12px 26px}.card{padding:13px}.dashStats{grid-template-columns:repeat(2,minmax(0,1fr))}.dashStats .dashStat:last-child:nth-child(odd){grid-column:1/-1}}
@media(max-width:420px){.dashStats{gap:8px}.dashStat{padding:10px;gap:7px}.dashIcon{width:32px;height:32px;flex-basis:32px;font-size:16px}.dashStat strong{font-size:21px}.dashStat span{white-space:normal}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
</style>


<style id="forest-green-ivory-final-palette">
/* Color-only palette update: Forest Green & Ivory. Layout and behavior unchanged. */
:root{--g:#3F6B4F;--g2:#244B37;--bg:#F6F1E7;--card:#FFFFFF;--line:#E5DFD2;--text:#243C30;--muted:#6D796F;--gold:#C5A66A;--soft:#E9EEE5;--shq-green:#244B37;--shq-green-light:#3F6B4F;--shq-ivory:#F6F1E7;--shq-gold:#C5A66A}
body{background:linear-gradient(180deg,#F6F1E7 0%,#F1EEE5 100%);color:#243C30}
header{background:linear-gradient(120deg,#244B37,#3F6B4F);border-bottom-color:rgba(197,166,106,.65)}
#mainNav.mainNavLabeled{background:#FFFDF8;border-color:#E5DFD2}
#mainNav button{color:#385344}
#mainNav button:hover{background:#E9EEE5;color:#244B37}
#mainNav button.active{background:#244B37;color:#fff;box-shadow:inset 3px 0 0 #C5A66A}
.card>h2,.card>h3,.dashStatValue,.dashMiniValue,.scheduleTime,.loginCard h2{color:#244B37}
.dashWelcome,#waliPortal .card:first-child{background:linear-gradient(120deg,#E9EEE5 0%,#FFFDF8 100%);border-left-color:#C5A66A}
.dashIcon,.dashQuickIcon,.badge,th{background:#E9EEE5;color:#244B37}
.btn.primary,.loginCard .btn.primary{background:linear-gradient(135deg,#244B37,#3F6B4F);border-color:#C5A66A;color:#fff}
input:focus,select:focus,textarea:focus{border-color:#3F6B4F;box-shadow:0 0 0 3px rgba(63,107,79,.16)}
.loginOverlay{background:radial-gradient(ellipse at 14% 18%,rgba(197,166,106,.2),transparent 31%),radial-gradient(ellipse at 88% 82%,rgba(63,107,79,.24),transparent 34%),linear-gradient(135deg,#183528 0%,#244B37 52%,#3F6B4F 100%)}
.publicTop{background:rgba(255,253,248,.97);color:#244B37}
.publicBrandText b,.publicSectionHead h2,.publicHero h1,.publicCard h3,.publicFaq summary{color:#244B37}
.publicLoginBtn{background:#244B37;color:#fff;border-color:#C5A66A}
.publicHero{color:#244B37}
.publicPrimary,.publicFooter a{background:#C5A66A;color:#243C30}
.publicFooter{background:linear-gradient(120deg,#244B37,#3F6B4F)}
@media(max-width:800px){header{background:linear-gradient(120deg,#244B37,#3F6B4F)}#mainNav button.active{box-shadow:inset 0 -3px 0 #C5A66A}}

.publicFlyerGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.publicFlyerCard{overflow:hidden;background:#fffdf8;border:1px solid #e3d9c3;border-radius:18px;box-shadow:0 8px 24px rgba(36,75,55,.08);display:flex;flex-direction:column;min-width:0}
.publicFlyerOpen{display:block;padding:0;border:0;background:#eee8da;cursor:zoom-in;line-height:0;width:100%;overflow:hidden}
.publicFlyerOpen img{display:block;width:100%;height:auto;aspect-ratio:2/3;object-fit:cover;transition:transform .25s ease}
.publicFlyerOpen:hover img{transform:scale(1.02)}
.publicFlyerInfo{padding:15px;display:flex;flex-direction:column;align-items:flex-start;gap:8px;flex:1}
.publicFlyerInfo h3{margin:0;color:#244B37;font-size:17px;line-height:1.35}
.publicFlyerInfo p{margin:0;color:#687464;font-size:13px;line-height:1.55;flex:1}
.publicFlyerView{border:1px solid #C5A66A;background:#244B37;color:#fff;border-radius:9px;padding:9px 12px;font-weight:750;cursor:pointer;margin-top:4px}
.publicFlyerModal{position:fixed;inset:0;z-index:99999;background:rgba(15,34,24,.88);display:none;align-items:center;justify-content:center;padding:18px}
.publicFlyerModal.open{display:flex}
.publicFlyerModalInner{position:relative;max-width:min(94vw,850px);max-height:94vh;display:flex;align-items:center;justify-content:center}
.publicFlyerModal img{display:block;max-width:100%;max-height:88vh;object-fit:contain;border-radius:8px;background:#fff}
.publicFlyerClose{position:absolute;top:-13px;right:-13px;width:38px;height:38px;border:2px solid #C5A66A;border-radius:50%;background:#244B37;color:#fff;font-size:24px;cursor:pointer;line-height:1}
@media(max-width:760px){.publicFlyerGrid{grid-template-columns:1fr;gap:14px}.publicFlyerCard{display:grid;grid-template-columns:minmax(0,42%) minmax(0,1fr)}.publicFlyerOpen img{height:100%;min-height:200px;aspect-ratio:auto;object-fit:cover}.publicFlyerInfo{padding:12px}.publicFlyerInfo h3{font-size:15px}.publicFlyerInfo p{font-size:12px}.publicFlyerModal{padding:10px}.publicFlyerClose{top:-10px;right:-5px}}
</style>
</head>
<body>
<style id="shq-initial-auth-guard">
/* Hindari beranda publik berkedip sebelum pemeriksaan sesi Supabase selesai. */
#publicLanding{display:none!important}
#publicLanding:not(.hidden).shq-public-ready{display:block!important}
</style>
<div id="publicLanding" class="publicLanding hidden">
  <div class="publicTop">
    <div class="publicBrandMark"><img id="publicBrandLogo" alt="Logo Shohibul Quran"></div>
    <div class="publicBrandText"><b>SHOHIBUL QURAN</b><small>Bertumbuh di Atas Keimanan</small></div>
    <button class="publicLoginBtn" type="button" onclick="openPublicLogin()">Masuk Sistem ↗</button>
  </div>
  <div class="publicWrap">
    <section class="publicHero" id="publicBeranda">
      <div><span class="publicEyebrow">RUANG KENAL SHOHIBUL QURAN</span><h1>Ingin Belajar Baca Al-Qur’an dengan Sistem Privat hingga Lancar dan Didukung Kurikulum yang Terstruktur?</h1><p>Yuk, bergabung di Shohibul Quran Community!</p><div class="publicBtnRow"><a class="publicPrimary" href="#publicProgram">Jelajahi Program ↓</a><a class="publicSecondary" href="#publicKonsultasi">Konsultasi Program</a></div></div>
      <div class="publicHeroArt" aria-label="Ilustrasi buku Al-Qur'an"><div class="publicHeroBook">📖</div></div>
    </section>
    <section class="publicSection" id="publicProgram"><div class="publicSectionHead"><div><h2>Kenali Cara Kami Belajar</h2><p>Mulai dari pengenalan dasar hingga pembelajaran bacaan Al-Qur’an yang lebih terarah.</p></div></div>
      <div class="publicCards">
        <article class="publicCard"><div class="publicCardIcon">🧩</div><h3>Multisensori Hijaiyah</h3><p>Untuk tahap pengenalan dasar, anak diajak melihat, mendengar, menyentuh, mengucapkan, dan mengulang melalui aktivitas yang menyenangkan. Program anak usia 3–6 tahun juga dapat memanfaatkan pendekatan play-based learning.</p></article>
        <article class="publicCard"><div class="publicCardIcon">📗</div><h3>Tahsin Iqra’</h3><p>Belajar membaca secara bertahap melalui buku dan latihan yang disesuaikan dengan kemampuan awal santri, disertai pembiasaan adab belajar.</p></article>
        <article class="publicCard"><div class="publicCardIcon">📖</div><h3>Tahsin Al-Qur’an</h3><p>Untuk santri yang sudah memasuki tahap membaca mushaf, pembelajaran diarahkan pada perbaikan bacaan, makhraj, sifat huruf, dan penerapan tajwid.</p></article>
        <article class="publicCard"><div class="publicCardIcon">🎯</div><h3>Tashih & Intensif</h3><p>Pembelajaran yang berfokus pada evaluasi dan perbaikan bacaan sesuai kebutuhan santri serta arahan pengajar.</p></article>
        <article class="publicCard"><div class="publicCardIcon">🌙</div><h3>Persiapan Tahfizh</h3><p>Mengenalkan proses menghafal dan murojaah secara bertahap dengan memperhatikan kemampuan bacaan santri.</p></article>
        <article class="publicCard"><div class="publicCardIcon">📝</div><h3>Pemantauan Belajar</h3><p>Presensi, catatan pembelajaran, evaluasi, dan rapor membantu orang tua memahami proses perkembangan anak.</p></article>
      </div>
    </section>

    
    <section class="publicSection"><div class="publicSectionHead"><div><h2>Perjalanan Belajar yang Bertahap</h2><p>Gambaran umum tahapan belajar; penempatan setiap santri dikonfirmasi bersama pengajar.</p></div></div><div class="publicSteps"><div class="publicStep"><span>01</span><b>Kenal Huruf</b><small>Mengenal bentuk dan bunyi huruf hijaiyah melalui aktivitas dasar.</small></div><div class="publicStep"><span>02</span><b>Belajar Membaca</b><small>Latihan membaca bertahap sesuai kemampuan dan materi belajar.</small></div><div class="publicStep"><span>03</span><b>Perbaikan Bacaan</b><small>Memperhatikan kelancaran, makhraj, sifat huruf, dan tajwid.</small></div><div class="publicStep"><span>04</span><b>Persiapan Hafalan</b><small>Membangun kesiapan hafalan dan kebiasaan murojaah bila sudah sesuai.</small></div></div></section>
    <section class="publicSection" id="publicPanduan"><div class="publicSectionHead"><div><h2>Temukan Program Awal untuk Anak</h2><p>Jawab tiga pertanyaan singkat untuk memperoleh panduan awal yang bisa didiskusikan dengan pengajar.</p></div></div><div class="publicFinder"><div class="publicFinderForm"><label>Usia anak<select id="publicAge"><option value="3–6 tahun">3–6 tahun</option><option value="7 tahun ke atas">7 tahun ke atas</option><option value="Remaja atau dewasa">Remaja atau dewasa</option></select></label><label>Kemampuan saat ini<select id="publicAbility"><option value="Belum mengenal huruf">Belum mengenal huruf hijaiyah</option><option value="Sedang belajar membaca">Sedang belajar atau belum lancar membaca</option><option value="Sudah membaca Al-Qur'an">Sudah membaca Al-Qur’an</option></select></label><label>Tujuan belajar<select id="publicGoal"><option value="Belajar dari dasar">Belajar dari dasar</option><option value="Memperbaiki bacaan">Memperbaiki bacaan</option><option value="Menghafal Al-Qur'an">Menghafal Al-Qur’an</option></select></label><button class="publicPrimary" style="width:100%;margin-top:15px;border:0" type="button" onclick="generatePublicRecommendation()">Lihat Panduan Program</button></div><div id="publicRecommendation" class="publicResult"><span class="publicEyebrow" style="background:#244B3710;border-color:#cbd9c4;color:#41681c">PANDUAN AWAL</span><h3>Program yang sesuai dimulai dari kebutuhan anak</h3><p>Pilih usia, kemampuan, dan tujuan belajar di samping, lalu tekan <b>Lihat Panduan Program</b> untuk melihat rekomendasi awal.</p><p class="publicNote">Panduan ini bukan diagnosis atau penetapan level. Penempatan akhir perlu dikonfirmasi oleh pengajar.</p></div></div></section>
    <section class="publicSection"><div class="publicSectionHead"><div><h2>Pertanyaan yang Sering Ditanyakan</h2><p>Informasi awal bagi keluarga, remaja, dan orang dewasa yang ingin mengenal program.</p></div></div><div class="publicFaq"><details><summary>Apakah anak yang belum mengenal huruf bisa mulai?</summary><p>Bisa. Silakan berkonsultasi untuk mengenali tahap awal yang sesuai dengan kemampuan dan kebutuhan belajar peserta.</p></details><details><summary>Apakah semua anak langsung masuk level yang sama?</summary><p>Tidak harus. Rekomendasi awal disesuaikan dengan kemampuan, kesiapan, dan hasil konsultasi atau asesmen bersama pengajar, baik untuk anak, remaja, maupun orang dewasa.</p></details><details><summary>Bagaimana keluarga memantau perkembangan belajar?</summary><p>Shohibul Quran menggunakan proses pembelajaran dan evaluasi sesuai program. Rincian pemantauan yang tersedia akan dijelaskan saat konsultasi.</p></details><details><summary>Bagaimana cara mengetahui jadwal dan biaya?</summary><p>Hubungi tim Shohibul Quran untuk memperoleh informasi terbaru tentang ketersediaan program, jadwal, biaya, dan proses pendaftaran.</p></details></div></section>
    <section class="publicFooter" id="publicKonsultasi"><div><h2>Mulai dengan konsultasi</h2><p>Ceritakan usia peserta, kemampuan awal, dan tujuan belajar Anda atau anggota keluarga.<br>Tim Shohibul Quran dapat membantu menjelaskan pilihan program dan langkah berikutnya.</p></div><a id="publicWhatsApp" href="https://wa.me/6282299390661?text=Assalaamu%27alaykum%20warahmatullahi%20wabarakaatuh.%20Saya%20ingin%20berkonsultasi%20mengenai%20program%20Shohibul%20Quran." target="_blank" rel="noopener">Konsultasi via WhatsApp ↗</a></section>
    <p class="publicTiny">Shohibul Quran System · Informasi publik program pembelajaran.<br>Data pribadi santri, nilai, presensi, dan rapor tidak ditampilkan di halaman ini.</p>
  </div>
</div>




<div id="loginOverlay" class="loginOverlay auth-checking">
  <div class="loginCard">
    <img id="loginLogo" class="loginLogo">
    <h2>Shohibul Quran System</h2>
    <p id="authBootMsg" class="muted">Memeriksa sesi login...</p>
    <div id="loginFormArea" class="hidden">
      <label>Email<input id="loginUser" type="email" autocomplete="username" placeholder="Masukkan email"></label>
      <label style="display:block;margin-top:10px">PIN / Password<input id="loginPass" type="password" autocomplete="current-password" onkeydown="if(event.key==='Enter')login()"></label>
      <button class="btn primary" style="width:100%;margin-top:15px" onclick="login()">🔐 Masuk</button>
      <p id="loginMsg" class="muted" style="color:#a51d1d;margin-top:10px"></p>
    </div>
  </div>
</div>
<div id="toastHost" class="toastHost" aria-live="polite"></div>
<div id="saveSuccessOverlay" class="saveSuccessOverlay hidden" role="dialog" aria-modal="true" aria-labelledby="saveSuccessTitle" aria-describedby="saveSuccessMessage" onclick="if(event.target===this)closeSaveSuccess()">
  <div class="saveSuccessCard">
    <div class="saveSuccessIcon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M10 25l9 9L38 14"/></svg></div>
    <h2 id="saveSuccessTitle">Berhasil Disimpan!</h2>
    <p id="saveSuccessMessage">Sesi pembelajaran dan nilai berhasil disimpan ke database.</p>
    <button class="saveSuccessButton" type="button" onclick="closeSaveSuccess()">Selesai</button>
  </div>
</div>
<header><div class="topbar"><div class="brand"><img id="logoHeader"><div><h1>Shohibul Quran System</h1><small>Sistem Data Santri • Pembelajaran • Penilaian • Raport</small></div></div><span id="userBadge" class="userBadge"></span><button id="logoutBtn" class="logoutBtn hidden" onclick="logout()">Keluar</button></div></header>
<nav id="mainNav" class="mainNavLabeled">
<button id="navPortalWali" title="Portal Walisantri" aria-label="Portal Walisantri" onclick="showPage('waliPortal',this)"><span class="navIcon">👨‍👩‍👧</span><span>Portal Walisantri</span></button>
<button id="navDashboard" class="active" title="Dashboard" aria-label="Dashboard" onclick="showPage('dashboard',this)"><span class="navIcon">🏠</span><span>Dashboard</span></button>
<button id="navPresensi" title="Presensi Santri" aria-label="Presensi Santri" onclick="openPresensiAtTarget(this)"><span class="navIcon">📋</span><span>Presensi</span></button>
<button id="navJadwal" title="Jadwal Mengajar" aria-label="Jadwal Mengajar" onclick="showPage('jadwal',this)"><span class="navIcon">📅</span><span>Jadwal</span></button>
<button id="navSantri" title="Data Santri" aria-label="Data Santri" onclick="showPage('santri',this)"><span class="navIcon">👥</span><span>Data Santri</span></button>
<button id="navPembelajaran" title="Pembelajaran dan Nilai" aria-label="Pembelajaran dan Nilai" onclick="showPage('pembelajaran',this)"><span class="navIcon">📝</span><span>Pembelajaran &amp; Nilai</span></button>
<button id="navAdab" title="Catatan Adab Harian" aria-label="Catatan Adab Harian" onclick="showPage('adab',this)"><span class="navIcon">🌿</span><span>Catatan Adab</span></button>
<button id="navPerkembangan" title="Perkembangan Santri" aria-label="Perkembangan Santri" onclick="showPage('perkembangan',this)"><span class="navIcon">📈</span><span>Perkembangan</span></button>
<button id="navKomunikasi" title="Komunikasi" aria-label="Komunikasi" onclick="showPage('komunikasi',this)"><span class="navIcon">🔔</span><span>Komunikasi</span></button>
<button id="navRaport" title="Raport Santri" aria-label="Raport Santri" onclick="showPage('raport',this)"><span class="navIcon">📄</span><span>Raport</span></button>
<button id="navPengajar" title="Data Pengajar" aria-label="Data Pengajar" onclick="showPage('pengajar',this)"><span class="navIcon">👨‍🏫</span><span>Data Pengajar</span></button>
<button id="navAkun" title="Manajemen Akun" aria-label="Manajemen Akun" onclick="showPage('manajemenAkun',this)"><span class="navIcon">🔐</span><span>Manajemen Akun</span></button>
<button id="navDoa" title="Doa Harian" aria-label="Doa Harian" onclick="showPage('doa',this)"><span class="navIcon">🤲</span><span>Doa Harian</span></button>
<button id="navSPP" title="SPP dan Keuangan" aria-label="SPP dan Keuangan" onclick="showPage('spp',this)"><span class="navIcon">💰</span><span>SPP &amp; Keuangan</span></button>
<button title="Pengaturan Sistem" aria-label="Pengaturan Sistem" onclick="showPage('pengaturan',this)"><span class="navIcon">⚙️</span><span>Pengaturan</span></button>
</nav>
<main>
<section id="waliPortal" class="page">
  <div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
      <div><h2 style="margin-bottom:4px">Portal Walisantri</h2><p class="muted" style="margin:0">Pantau perkembangan belajar putra/putri Anda secara online.</p></div>
      
    </div>
  </div>
  <div id="waliPortalData"></div>
</section>
<section id="adab" class="page">
  <div class="card"><h2>🌿 Catatan Adab Harian Santri</h2><p class="muted">Catat perkembangan adab ananda dan nasihat yang benar-benar telah disampaikan selama pembelajaran. Catatan akan terlihat pada akun walisantri yang terhubung.</p>
    <form id="adabForm" onsubmit="event.preventDefault();saveAdabNote()">
      <div class="grid">
        <label>Santri<select id="adabStudent" required></select></label>
        <label>Tanggal<input id="adabTanggal" type="date" required></label>
        <label>Aspek Adab<select id="adabKategori" required><option value="Adab terhadap guru">Adab terhadap guru</option><option value="Kesungguhan belajar">Kesungguhan belajar</option><option value="Kedisiplinan">Kedisiplinan</option><option value="Adab terhadap teman">Adab terhadap teman</option><option value="Kemandirian dan tanggung jawab">Kemandirian dan tanggung jawab</option><option value="Adab umum">Adab umum</option></select></label>
        <label>Kondisi Adab<select id="adabKondisi" required><option value="Baik">Baik dan konsisten</option><option value="Berkembang">Perlu penguatan</option><option value="Perlu perhatian">Perlu perhatian khusus</option></select></label>
        <label style="grid-column:1/-1">Catatan kondisi adab<textarea id="adabCatatan" rows="3" maxlength="3000" placeholder="Contoh: Ananda menyimak arahan guru dengan baik dan mulai membiasakan meminta izin sebelum berbicara."></textarea></label>
        <label style="grid-column:1/-1">Nasihat yang telah disampaikan kepada santri<textarea id="adabNasihat" rows="3" maxlength="3000" placeholder="Tuliskan nasihat yang benar-benar sudah disampaikan oleh pengajar."></textarea></label>
      </div>
      <label style="display:flex;align-items:center;gap:8px;margin-top:12px"><input id="adabNasihatDisampaikan" type="checkbox" style="width:auto"> Nasihat di atas sudah disampaikan langsung kepada santri</label>
      <div class="actions" style="margin-top:14px"><button id="adabSaveBtn" class="btn primary" type="submit">💾 Simpan Catatan</button><button class="btn" type="button" onclick="resetAdabForm()">Bersihkan</button></div>
      <p id="adabFormMsg" class="muted"></p>
    </form>
  </div>
  <div class="card"><h3>Riwayat Catatan Adab</h3><div id="adabRecords"></div></div>
</section>
<section id="dashboard" class="page active"><div class="card"><h2>Dashboard</h2><div id="dashboardData"></div></div></section>
<section id="presensi" class="page">
<div id="presensiFormCard" class="card"><h2 id="presensiTitle">📋 Presensi Santri</h2><p class="muted">Catat kehadiran santri. Satu tanggal dihitung sebagai satu pertemuan.</p><div id="presensiScheduleContext" style="display:none;margin:10px 0;padding:10px;border-radius:10px;background:#eef6e8;border-left:4px solid #4b7f3b"></div>
<div id="presensiStudentFormGrid" class="grid">
<label>Tanggal<input id="presTanggal" type="date"></label>
<label>Santri<select id="presSantri"></select></label>
<label>Status<select id="presStatus"><option value="hadir">Hadir</option><option value="izin">Izin</option><option value="sakit">Sakit</option><option value="tidak_hadir">Tidak Hadir</option></select></label>
<label>Catatan<input id="presCatatan" placeholder="Catatan (opsional)"></label>
</div>
<div id="sessionStatusBox" style="display:none;margin-top:12px;padding:12px;border-radius:12px;background:#f4f8ef;border-left:4px solid #4b7f3b">
<div style="font-weight:700;margin-bottom:7px">📅 Status Pertemuan</div>
<div class="muted" style="margin-bottom:8px">Status ini untuk jadwal pembelajaran, bukan status kehadiran santri.</div>
<div class="grid">
<label>Status Pertemuan<select id="sessionStatus" onchange="applySessionStatusUI()"><option value="berlangsung">🟢 Pembelajaran Berlangsung</option><option value="diliburkan">🔴 Pembelajaran Diliburkan</option><option value="dijadwalkan_ulang">🔄 Dijadwalkan Ulang</option></select></label>
<label>Alasan / Keterangan<input id="sessionStatusReason" placeholder="Contoh: Pengajar berhalangan"></label>
</div>
<div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap"><button id="saveSessionStatusBtn" type="button" class="btn" onclick="saveSessionStatus()">💾 Simpan Status Pertemuan</button></div>
<div id="sessionStatusNotice" class="muted" style="margin-top:8px"></div>
</div>
<div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap"><button id="savePresensiBtn" class="btn primary" onclick="savePresensi()">Simpan Presensi</button><button id="cancelEditPresensiBtn" class="btn" style="display:none" onclick="cancelEditPresensi()">Batal Edit</button><button id="continueSessionBtn" class="btn" style="display:none" onclick="continueToSession()">📖 Lanjut Input Sesi & Nilai</button></div></div>
<div class="card"><h3>Rekap Presensi</h3><div class="grid"><label>Santri<select id="presRekapSantri" onchange="renderPresensi()"></select></label><label>Mulai<input id="presStart" type="date" onchange="renderPresensi()"></label><label>Sampai<input id="presEnd" type="date" onchange="renderPresensi()"></label></div><div id="presensiData" style="margin-top:12px"></div></div>
</section>

<section id="jadwal" class="page">
<div class="card"><h2>📅 Jadwal Mingguan Santri</h2><p class="muted">Setiap santri memiliki 2–5 kali pertemuan per pekan. Pilih santri sekali, lalu centang 2–5 hari dan pilih jam untuk masing-masing hari. Tidak perlu membuat jadwal satu per satu.</p>
<div class="grid">
<label>Santri<select id="jadwalBatchSantri" onchange="onJadwalBatchSantriChange()"></select></label>
<label>Kelas<input id="jadwalBatchKelas" placeholder="Otomatis dari kelas santri" readonly style="background:#f3f7ee"></label>
<label>Jenis Pembelajaran<input id="jadwalBatchJenis" placeholder="Contoh: Tahsin Qur'an"></label>
<label>Status<select id="jadwalBatchStatus"><option value="aktif">Aktif</option><option value="nonaktif">Nonaktif</option></select></label>
</div>
<div class="muted" style="margin-top:8px">💡 Pilih santri → kelas otomatis terisi. Centang 2–5 hari → pilih jam masing-masing.</div>
<div class="jadwalWeeklyBox" style="margin-top:12px">
  <div class="jadwalWeeklyGrid">
    <div class="jadwalWeeklyHead">Hari</div><div class="jadwalWeeklyHead">Jam</div>
    <div class="jadwalWeeklyRow"><label><input type="checkbox" id="batchDay0" onchange="syncBatchDay(0)"> <b>Senin</b></label><label><select id="batchTime0"></select></label></div>
    <div class="jadwalWeeklyRow"><label><input type="checkbox" id="batchDay1" onchange="syncBatchDay(1)"> <b>Selasa</b></label><label><select id="batchTime1"></select></label></div>
    <div class="jadwalWeeklyRow"><label><input type="checkbox" id="batchDay2" onchange="syncBatchDay(2)"> <b>Rabu</b></label><label><select id="batchTime2"></select></label></div>
    <div class="jadwalWeeklyRow"><label><input type="checkbox" id="batchDay3" onchange="syncBatchDay(3)"> <b>Kamis</b></label><label><select id="batchTime3"></select></label></div>
    <div class="jadwalWeeklyRow"><label><input type="checkbox" id="batchDay4" onchange="syncBatchDay(4)"> <b>Jumat</b></label><label><select id="batchTime4"></select></label></div>
    <div class="jadwalWeeklyRow"><label><input type="checkbox" id="batchDay5" onchange="syncBatchDay(5)"> <b>Sabtu</b></label><label><select id="batchTime5"></select></label></div>
    <div class="jadwalWeeklyRow"><label><input type="checkbox" id="batchDay6" onchange="syncBatchDay(6)"> <b>Minggu</b></label><label><select id="batchTime6"></select></label></div>
  </div>
  <div class="muted" style="margin-top:8px">💡 Contoh: Senin 18.30, Selasa 18.30, Rabu 13.00, Kamis 13.00.</div>
  <div class="actions" style="margin-top:12px"><button id="saveJadwalWeeklyBtn" class="btn primary" onclick="saveJadwalBatch()">💾 Simpan Jadwal Mingguan</button><button class="btn" onclick="clearJadwalBatch()">Bersihkan</button></div>
</div></div>
<div class="card"><h3>🗓️ Jadwal Hari Ini</h3><div id="jadwalHariIni"></div></div>
<div class="card"><h3>👤 Rekap Jadwal per Santri</h3><div id="jadwalSummary"></div></div>
<div class="card"><h3>📋 Semua Jadwal</h3><div id="jadwalData"></div></div>
</section>

<section id="komunikasi" class="page">
<div class="card"><h2>🔔 Pusat Komunikasi & Ringkasan</h2><p class="muted">Aktivitas terbaru, catatan perkembangan pengajar, dan ringkasan pekanan berdasarkan data yang tersimpan.</p></div>
<div id="komunikasiData"></div>
</section>

<section id="perkembangan" class="page">
<div class="card"><h2>Profil Perkembangan Santri</h2><p class="muted">Ringkasan perkembangan berdasarkan penilaian yang tersimpan. Satu tanggal dihitung sebagai satu pertemuan.</p>
<div class="grid"><label>Santri<select id="perkSantri" onchange="renderPerkembangan()"></select></label><label>Mulai<input id="perkStart" type="date" onchange="renderPerkembangan()"></label><label>Sampai<input id="perkEnd" type="date" onchange="renderPerkembangan()"></label></div></div>
<div id="perkembanganData"></div>
</section>

<section id="santri" class="page">
<div class="card"><h2>Data Santri</h2><div class="toolbar"><input id="santriSearch" placeholder="🔎 Cari nama santri, wali, kelas, atau pengajar..." oninput="renderSantri()"></div>
<form id="santriForm" class="grid">
<label>Nama<input id="snama" required></label><label>Jenis Kelamin<select id="sGender"><option value="">Pilih jenis kelamin</option><option value="Laki-laki">Laki-laki</option><option value="Perempuan">Perempuan</option></select></label><label>Tempat Lahir<input id="stempatLahir" placeholder="Contoh: Tanjung Selor"></label><label>Tanggal Lahir<input id="stanggalLahir" type="date"></label>
<label>Alamat<input id="salamat"></label><label>Walisantri<input id="swali"></label>
<label>Level Kelas<select id="slevel"><option>Kelas Iqra'</option><option>Kelas Al Qur'an</option><option>Kelas Tashih</option><option>Kelas Tahfizh</option></select></label>
<label>Musyrif/ah / Pengajar<select id="spengajar"><option value="">Pilih pengajar</option></select></label>
</form><div class="actions"><button type="button" class="btn primary" id="santriSaveBtn" onclick="saveSantri()">+ Tambah Santri</button><button type="button" class="btn" onclick="cancelSantriEdit()">Batal</button></div></div>
<div class="card"><h3>Daftar Santri</h3><div id="santriList"></div></div>
</section>

<section id="pembelajaran" class="page">
<div class="card"><h2>Input Sesi Pembelajaran & Nilai</h2><div class="grid">
<label>Tanggal<input type="date" id="pTanggal"></label>
<label>Santri<select id="pSantri" onchange="syncClass();renderLastLearning();renderLearningHistory()"></select><small class="muted">Nama akan mengikuti Jadwal saat masuk dari Presensi.</small></label>
<label>Kelas (otomatis dari Data Santri)<select id="pKelas" disabled onchange="populateJenis()"><option value="">Pilih santri terlebih dahulu</option><option>Kelas Iqra'</option><option>Kelas Al Qur'an</option><option>Kelas Tashih</option><option>Kelas Tahfizh</option></select></label>
<label>Jenis Pembelajaran<select id="pJenis" onchange="buildLearningForm();renderLastLearning();renderLearningHistory()"></select></label>
</div><div id="lastLearningCard" class="card" style="margin-top:12px;border-left:4px solid var(--g);display:none"></div><div id="learningForm" class="grid" style="margin-top:12px"></div>
<div class="actions"><button type="button" class="btn primary" id="sessionSaveBtn" onclick="saveSession()">Simpan Sesi & Nilai</button><button type="button" class="btn" onclick="cancelSessionEdit()">Batal</button></div></div>
<div class="card"><h3>Rekapan Setiap Sesi</h3><div class="toolbar"><input id="sessionSearch" placeholder="🔎 Cari santri atau jenis pembelajaran..." oninput="renderSessions()"></div><div id="sessionList"></div></div>
</section>

<section id="raport" class="page">
<div class="card">
<h2>Raport Pembelajaran</h2>
<div class="grid">
<label>Santri<select id="rSantri" onchange="renderReport()"></select></label>
<label>Periode<select id="rPeriod" onchange="setPeriod()"><option value="1">1 Bulan</option><option value="3">3 Bulan</option><option value="6">6 Bulan</option></select></label>
<label>Dari tanggal<input type="date" id="rStart" onchange="renderReport()"></label>
<label>Sampai tanggal<input type="date" id="rEnd" onchange="renderReport()"></label>
</div>
<p class="muted">Raport hanya mengambil sesi dan pencapaian doa yang tanggalnya berada dalam rentang di atas.</p>
<div id="report"></div>
<div class="actions no-print"><button type="button" class="btn primary" onclick="downloadPDF()">⬇️ Unduh Raport PDF</button></div>
</div>
</section>

<section id="doa" class="page">
<div class="card"><h2>Doa Harian</h2><div class="grid"><label>Santri<select id="dSantri" onchange="renderDoa()"></select></label><label>Tanggal<input type="date" id="dDate" onchange="renderDoa()"></label></div><div id="doaList"></div></div>
</section>

<section id="pengajar" class="page">
<div class="card"><h2>👨‍🏫 Data Pengajar</h2><p class="muted">Kelola data pengajar yang akan digunakan untuk penugasan santri. Pembuatan akun login Pengajar dilakukan pada tahap berikutnya.</p>
<form id="teacherForm" class="grid">
<label>Nama Lengkap<input id="tNama" required></label><label>Nama Panggilan<input id="tPanggilan"></label>
<label>Jenis Kelamin<select id="tGender"><option value="">Pilih</option><option>Laki-laki</option><option>Perempuan</option></select></label>
<label>Tempat Lahir<input id="tTempatLahir"></label><label>Tanggal Lahir<input id="tTanggalLahir" type="date"></label>
<label>No. HP / WhatsApp<input id="tNoHp"></label><label>Alamat<input id="tAlamat"></label>
<label>Pendidikan Terakhir<input id="tPendidikan"></label><label>Kompetensi<input id="tKompetensi" placeholder="Contoh: Tahsin, Tahfizh, Tajwid"></label>
<label>Kelas yang Diampu<input id="tKelas" placeholder="Contoh: Kelas Al Qur'an, Tahfizh"></label>
<label>Status<select id="tStatus"><option>Aktif</option><option>Nonaktif</option></select></label><label>Tanggal Bergabung<input id="tBergabung" type="date"></label>
<label>Email Login<input id="tEmail" type="email" placeholder="Diisi saat akun login dibuat"></label><label>Catatan<textarea id="tCatatan" rows="2"></textarea></label>
</form><div id="teacherSaveMsg" class="muted" style="margin-top:10px"></div><div class="actions"><button type="button" class="btn primary" id="teacherSaveBtn" onclick="saveTeacher()">+ Tambah Pengajar</button><button type="button" class="btn" onclick="cancelTeacherEdit()">Batal</button></div></div>
<div class="card"><h3>Daftar Pengajar</h3><div id="teacherList"></div></div>
<div class="card" id="teacherStudentsCard" style="display:none"><h3 id="teacherStudentsTitle">Santri Binaan</h3><div id="teacherStudentsList"></div></div>
</section>

<section id="manajemenAkun" class="page">
<div class="card"><h2>🔐 Manajemen Akun</h2><p class="muted">Admin membuat email dan password login langsung dari aplikasi. UUID Supabase dibuat otomatis dan tidak perlu dimasukkan manual.</p><div class="notice" style="margin-top:10px">🔒 Pembuatan akun menggunakan layanan server Supabase. Password tidak disimpan di database aplikasi Admin.</div></div>
<div class="card"><h3>👨‍🏫 Akun Pengajar <span class="accountBadge">AKUN LEMBAGA</span></h3><p class="muted">Buat akun dengan identitas lembaga. Contoh: <b>habib@shohibulquran.id</b>. Akun otomatis terhubung dengan data pengajar.</p><div class="grid"><label>Pengajar<select id="accountTeacherSelect"><option value="">Pilih pengajar</option></select></label><label>Email Login Pengajar<input id="accountEmail" type="email" placeholder="contoh: habib@shohibulquran.id" autocomplete="email"></label><label>Password Awal<input id="accountPassword" type="password" minlength="6" placeholder="Minimal 6 karakter" autocomplete="new-password"></label></div><div id="accountLinkMsg" class="muted" style="margin-top:10px"></div><div class="actions"><button type="button" class="btn primary" onclick="createTeacherAccount()">👤 Buat Akun Pengajar</button><button type="button" class="btn" onclick="clearTeacherAccountForm()">Bersihkan</button></div><small class="muted">Password tidak disimpan di Data Pengajar. UUID akun dibuat otomatis oleh Supabase.</small></div>
<div class="card"><h3>👨‍👩‍👧 Akun Walisantri <span class="accountBadge">AKUN LEMBAGA</span></h3><p class="muted">Satu akun Walisantri dapat digunakan untuk beberapa anak. Buat akun untuk anak pertama, lalu hubungkan saudara lainnya ke akun yang sama.</p><div class="grid"><label>Santri pertama<select id="accountWaliStudentSelect"><option value="">Pilih santri</option></select></label><label>Email Walisantri<input id="accountWaliEmail" type="email" placeholder="contoh: wali@shohibulquran.id" autocomplete="email"></label><label>Password Awal<input id="accountWaliPassword" type="password" minlength="6" placeholder="Minimal 6 karakter" autocomplete="new-password"></label></div><div id="accountWaliMsg" class="muted" style="margin-top:10px"></div><div class="actions"><button type="button" class="btn primary" onclick="createWaliAccount()">👤 Buat Akun Walisantri</button><button type="button" class="btn" onclick="clearWaliAccountForm()">Bersihkan</button></div><small class="muted">Password tidak disimpan di Data Santri. UUID akun dibuat otomatis oleh Supabase.</small></div>
<div class="card"><h3>👨‍👩‍👧 Hubungkan Anak ke Akun Walisantri</h3><p class="muted">Gunakan fitur ini untuk keluarga yang memiliki 2–3 anak atau lebih. Tidak membuat akun baru; hanya menambahkan hubungan anak ke akun Walisantri yang sudah ada.</p><div class="grid"><label>Akun Walisantri<select id="existingWaliAccountSelect"><option value="">Pilih akun wali</option></select></label><label>Santri yang akan dihubungkan<select id="linkWaliStudentSelect"><option value="">Pilih santri</option></select></label></div><div id="linkWaliMsg" class="muted" style="margin-top:10px"></div><div class="actions"><button type="button" class="btn primary" onclick="linkExistingWaliStudent()">🔗 Hubungkan Anak</button></div></div>
<div class="card"><h3>📋 Status Akun</h3><div id="accountStatusList" class="muted">Belum ada data.</div></div>
</section>

<div id="waliEditModal" class="waliEditModal hidden" onclick="if(event.target===this)closeWaliEdit()">
  <div class="waliEditCard">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
      <div><h3>✏️ Edit Akun Walisantri</h3><div class="muted">Perbarui akun yang sudah ada tanpa membuat akun baru.</div></div>
      <button type="button" class="btn" onclick="closeWaliEdit()">✕</button>
    </div>
    <div id="waliEditInfo" class="waliEditInfo">Memuat data akun...</div>
    <div class="waliEditGrid">
      <label class="full">Email Login Baru<input id="waliEditEmail" type="email" autocomplete="email" placeholder="contoh: wali@shohibulquran.id"></label>
      <label class="full">Password Baru <small class="muted">(kosongkan jika tidak ingin mengganti)</small><input id="waliEditPassword" type="password" minlength="6" autocomplete="new-password" placeholder="Minimal 6 karakter"></label>
    </div>
    <div id="waliEditMsg" class="muted" style="margin-top:10px"></div>
    <div class="actions" style="margin-top:12px">
      <button type="button" class="btn primary" onclick="saveWaliEdit()">💾 Simpan Perubahan</button>
      <button type="button" class="btn" onclick="closeWaliEdit()">Batal</button>
    </div>
  </div>
</div>

<section id="spp" class="page">
<div class="card"><h2>💰 SPP Fleksibel</h2><p class="muted">Data SPP tersimpan di Supabase. Model pembayaran: SPP Tetap, Per Pertemuan, atau Manual. Untuk Per Pertemuan, tanggal unik dihitung sebagai 1 pertemuan.</p>
<div class="grid"><label>Bulan<input id="sppMonth" type="month" onchange="renderSPP()"></label><label>Cari santri<input id="sppSearch" placeholder="Nama santri..." oninput="renderSPP()"></label></div>
<div id="sppCloudStatus" class="muted" style="margin-top:10px"></div>
<div class="card" id="sppAdminCard"><h3>⚙️ Pengaturan Tarif Santri</h3><div id="sppSettings"></div></div>
<div class="card" id="sppGenerateCard" style="display:none"><h3>🧾 Tagihan Bulanan</h3><p class="muted">Admin dapat membuat/memperbarui tagihan bulan yang dipilih berdasarkan tarif santri dan jumlah pertemuan unik.</p><button class="btn primary" onclick="generateSppBills()">⚡ Buat/Perbarui Tagihan Bulan Ini</button></div>
<div class="card"><h3>🧾 Daftar Tagihan SPP</h3><div id="sppBills"></div></div>
<div class="card" id="sppReportCard" style="display:none"><h3>📊 Laporan SPP</h3><p class="muted">Ringkasan tagihan, pembayaran, dan tunggakan pada periode yang dipilih.</p><div id="sppReport"></div></div>
<div class="card" id="financeManualCard" style="display:none"><h3>💼 Pemasukan & Pengeluaran Lainnya</h3><p class="muted">Catat Infaq, Uang Pendaftaran/DU, donasi, pembelian, operasional, dan transaksi non-SPP lainnya. SPP yang sudah dibayar masuk otomatis ke laporan dan tidak perlu dicatat ulang di sini.</p><form id="financeForm" class="grid">
<label>Jenis<select id="finType"><option value="income">Pemasukan</option><option value="expense">Pengeluaran</option></select></label>
<label>Kategori<select id="finCategory"><option>Infaq</option><option>Uang Pendaftaran / DU</option><option>Donasi</option><option>Pemasukan Lainnya</option><option>Pembelian</option><option>Operasional</option><option>Honor / Insentif</option><option>Pengeluaran Lainnya</option></select></label>
<label>Tanggal<input id="finDate" type="date"></label>
<label>Nominal<input id="finAmount" type="number" min="0" step="1000" placeholder="Rp"></label>
<label style="grid-column:1/-1">Keterangan<textarea id="finNote" rows="2" placeholder="Contoh: Infaq keluarga Pak Ahmad / pembelian alat kebersihan"></textarea></label>
</form><div class="actions"><button type="button" class="btn primary" onclick="saveFinanceTransaction()">+ Simpan Transaksi</button><button type="button" class="btn" onclick="resetFinanceForm()">Bersihkan</button></div></div>
<div class="card" id="financeDashboardCard" style="display:none"><h3>📊 Dashboard Keuangan</h3><p class="muted">Ringkasan kondisi keuangan dari transaksi yang tersimpan.</p><div id="financeDashboard"></div></div>
<div class="card" id="financeSummaryCard" style="display:none"><h3>📊 Laporan Keuangan & Saldo Berjalan</h3><div class="grid"><label>Dari tanggal<input id="finStart" type="date" onchange="renderFinance()"></label><label>Sampai tanggal<input id="finEnd" type="date" onchange="renderFinance()"></label><label>Saldo Awal<input id="financeOpening" type="number" min="0" step="1000" placeholder="Rp" onchange="saveFinanceOpening()"><small class="muted">Saldo awal sebelum periode pertama.</small></label></div><div id="financeSummary" style="margin-top:12px"></div><div id="financeLedger" style="margin-top:12px"></div><div class="actions"><button type="button" class="btn" onclick="saveFinanceOpening()">💾 Simpan Saldo Awal</button><button type="button" class="btn primary" onclick="printFinanceReport()">📄 Cetak Laporan Keuangan</button></div></div>
<div class="card" id="financeSqlCard" style="display:none"><h3>🔐 Setup Keuangan Supabase</h3><p class="muted">Jalankan SQL ini satu kali di Supabase SQL Editor untuk menyimpan Infaq, DU, donasi, dan pengeluaran secara permanen.</p><textarea id="financeSqlText" style="width:100%;min-height:260px" readonly></textarea><button class="btn" onclick="copyFinanceSql()">📋 Salin SQL</button></div>
</section>
<section id="pengaturan" class="page">
<div class="card"><h2>Format Nilai</h2><table><tr><th>Nilai</th><th>Predikat</th><th>Huruf</th></tr><tr><td>90–100</td><td>Mumtaz</td><td>A</td></tr><tr><td>80–89</td><td>Jayyid Jiddan</td><td>B</td></tr><tr><td>70–79</td><td>Jayyid</td><td>C</td></tr><tr><td>60–69</td><td>Maqbul</td><td>D</td></tr></table></div>
<div class="card" id="sppSqlCard" style="display:none"><h2>🔐 Setup SPP Supabase</h2><p class="muted">Jalankan SQL v22 di Supabase SQL Editor satu kali untuk membuat tabel dan RLS SPP.</p><textarea id="sppSqlText" style="width:100%;min-height:220px" readonly></textarea><button class="btn" onclick="copySppSql()">📋 Salin SQL</button></div>
<div class="card" id="adabSqlCard" style="display:none"><h2>🔐 Setup Catatan Adab Supabase</h2><p class="muted">Jalankan SQL ini satu kali di Supabase SQL Editor untuk membuat penyimpanan Catatan Adab dan membatasi akses catatan sesuai akun.</p><textarea id="adabSqlText" style="width:100%;min-height:320px" readonly></textarea><button class="btn" onclick="copyAdabSql()">📋 Salin SQL</button></div>
<div class="card" id="presensiSqlCard" style="display:none"><h2>🔐 Setup & Perbaikan Hak Presensi Supabase</h2><p class="muted">Jalankan SQL terbaru ini di Supabase SQL Editor. SQL V147 memperbaiki hak Pengajar untuk menghapus presensi berdasarkan hubungan akun Pengajar dengan santri.</p><textarea id="presensiSqlText" style="width:100%;min-height:240px" readonly></textarea><button class="btn" onclick="copyPresensiSql()">📋 Salin SQL</button></div>
<div class="card" id="jadwalSqlCard" style="display:none"><h2>🔐 Setup Jadwal Supabase</h2><p class="muted">Jalankan SQL ini satu kali di Supabase SQL Editor agar jadwal tersimpan permanen.</p><textarea id="jadwalSqlText" style="width:100%;min-height:240px" readonly></textarea><button class="btn" onclick="copyJadwalSql()">📋 Salin SQL</button></div>
<div class="card" id="sessionStatusSqlCard" style="display:none"><h2>🔐 Setup Status Pertemuan Supabase</h2><p class="muted">Jalankan SQL ini satu kali untuk mencatat jika pembelajaran diliburkan atau dijadwalkan ulang tanpa mengubah presensi santri.</p><textarea id="sessionStatusSqlText" style="width:100%;min-height:300px" readonly></textarea><button class="btn" onclick="copySessionStatusSql()">📋 Salin SQL</button></div>
<div class="card" id="sessionSqlCard" style="display:none"><h2>🔐 Setup Hasil Pembelajaran Supabase</h2><p class="muted">Jalankan SQL ini satu kali di Supabase SQL Editor. Bagian DELETE memastikan Admin dapat menghapus nilai/sesi secara permanen sehingga data tidak muncul kembali setelah refresh.</p><textarea id="sessionSqlText" style="width:100%;min-height:220px" readonly></textarea><button class="btn" onclick="copySessionSql()">📋 Salin SQL</button></div>
<div class="card" id="backupCard" style="display:none"><h2>🛡️ Backup & Restore Data <span class="badge">v70</span></h2><p class="muted">Khusus Admin. Backup menyimpan snapshot data yang sedang termuat, termasuk data pembelajaran, doa, presensi, jadwal, SPP, pembayaran, dan keuangan.</p><div class="actions"><button type="button" class="btn primary" onclick="downloadBackupJSON()">⬇️ Unduh Backup JSON</button><button type="button" class="btn" onclick="document.getElementById('backupRestoreFile').click()">♻️ Restore Backup</button><button type="button" class="btn" onclick="refresh()">🔄 Muat Ulang Data</button><input id="backupRestoreFile" type="file" accept=".json,application/json" style="display:none" onchange="restoreBackupJSON(event)"></div><small id="backupInfo" class="muted"></small></div>
<div class="card" id="pengajarCard"><h2>👨‍🏫 Manajemen Pengajar</h2><p class="muted">Admin dapat menugaskan santri melalui kolom <b>Musyrif/ah / Pengajar</b> pada Data Santri. Pengajar yang login hanya akan melihat santri yang namanya cocok dengan penugasan tersebut.</p><div id="pengajarManagement"></div></div>
<div class="card" id="akunWaliCard"><h2>Akun Walisantri</h2><p class="muted">Akun login Walisantri dibuat melalui Supabase Auth. Setelah akun dibuat, hubungkan User ID-nya ke data santri agar akses hanya ke anak tersebut.</p><div id="akunWaliList"></div></div>

</section>
</main>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js"></script>
<script>
const SUPABASE_URL="https://mfkybvoituhzogkjifxh.supabase.co";
const SUPABASE_PUBLISHABLE_KEY="sb_publishable_c8aRMa85joR6DInLwIaiqg_OVO7nNpP";
// v155: gunakan storage bawaan Supabase + localStorage pada HTTPS Vercel.
// Storage custom/window.name pada versi sebelumnya dapat membuat sesi tidak pulih
// konsisten saat hard refresh Android.
const AUTH_BACKUP_KEY="shohibul_quran_auth_backup_v2";
const SUPABASE_AUTH_STORAGE_KEY="shohibul_quran_supabase_auth_v2";
// v157: gunakan storage key bawaan Supabase agar sesi tetap kompatibel
// dengan sesi yang sudah tersimpan pada deployment/domain ini.
const supabaseClient=supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY,{auth:{
  persistSession:true,
  autoRefreshToken:true,
  detectSessionInUrl:false,
  storage:window.localStorage
}});
function saveAuthBackup(session){try{if(session)localStorage.setItem(AUTH_BACKUP_KEY,JSON.stringify(session));}catch(e){console.warn('Auth backup:',e)}}
function getAuthBackup(){try{const raw=localStorage.getItem(AUTH_BACKUP_KEY);return raw?JSON.parse(raw):null}catch(e){return null}}
function clearAuthBackup(){try{localStorage.removeItem(AUTH_BACKUP_KEY)}catch(e){}}
const LOGO='data:image/webp;base64,';
try{const publicLogo=document.getElementById('publicBrandLogo');if(publicLogo)publicLogo.src=LOGO;}catch(e){}

document.getElementById('logoHeader').src=LOGO; document.getElementById('loginLogo').src=LOGO;
const KEY='shohibul_quran_system_v3';
const TYPES={
"Kelas Iqra'":{"Tahsin Iqro'":{fields:["jilid","halaman"],rubric:[["Penguasaan Materi Baru",50],["Kelancaran",50]]},"Pendidikan Tauhid":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"},"Pembentukan Adab":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"}},
"Kelas Al Qur'an":{"Tahsin Qur'an":{fields:["juz","surah","halaman","ayat"],rubric:[["Kelancaran Bacaan",40],["Pelafalan Makhroj & Sifat",40],["Pelafalan Tajwid",20]]},"Mutqinul Qiro'ah":{fields:["halaman","materi"],rubric:[["Pelafalan Makhroj & Sifat",60],["Kesempurnaan Harokat dan Ketepatan Bacaan",40]]},"Ilmu Tajwid":{fields:["halaman","materi"],rubric:[["Penguasaan Materi",75],["Ketepatan Mencari/membuat Contoh yang Serupa",25]]},"Pendidikan Tauhid":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"},"Pembentukan Adab":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"}},
"Kelas Tashih":{"Tahsin Intensif":{fields:["juz","surah","halaman","ayat"],rubric:[["Kelancaran Bacaan",40],["Pelafalan Makhroj & Sifat",40],["Pelafalan Tajwid",20]]},"Praktik Tajwid bil Lisany":{fields:["materi"],rubric:[],special:"tajwid_count"},"Pra Hafalan Juz 30":{fields:["juz","surah","halaman","ayat"],rubric:[["Kelancaran & Tajwid",50],["Makhroj & Sifat",50]]},"Pendidikan Tauhid":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"},"Pembentukan Adab":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"}},
"Kelas Tahfizh":{"Tahsin Intensif":{fields:["juz","surah","halaman","ayat"],rubric:[["Kelancaran Bacaan",40],["Pelafalan Makhroj & Sifat",40],["Pelafalan Tajwid",20]]},"Ziyadah":{fields:["juz","surah","halaman","ayat"],rubric:[["Kelancaran & Tajwid",50],["Makhroj & Sifat",50]]},"Muroja'ah":{fields:["juz","surah","halaman","ayat"],rubric:[["Kelancaran & Kekuatan Murojaah",50],["Makhroj, Sifat & Tajwid",50]]},"Teori Makhroj & Sifat":{fields:["halaman","materi"],rubric:[["Penguasaan Materi",100]]},"Pendidikan Tauhid":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"},"Pembentukan Adab":{fields:["halaman","materi"],rubric:[["Pemahaman Materi",null],["Praktik Nyata di Kelas",null]],special:"letter_rubric"}}};
const LABEL={jilid:"Jilid",juz:"Juz",surah:"Surah",halaman:"Halaman",ayat:"Ayat",materi:"Materi yang Dibahas"};
const DOA=["Doa Sebelum Makan","Doa Setelah Makan","Doa Hendak Tidur","Doa Bangun Tidur","Doa Ketika Hujan","Doa Keluar Rumah","Doa Masuk Rumah","Doa Masuk WC","Doa Keluar WC","Doa Lainnya"];
let db={santri:[],sessions:[],doa:{},teachers:[]};
let editSantriId=null,editSessionId=null,editSessionDraft=null,editTeacherId=null,currentUser=null,currentAccessToken=null;
let cloudLoadInProgress=false;
const today=()=>{const d=new Date();const y=d.getFullYear();const m=String(d.getMonth()+1).padStart(2,'0');const day=String(d.getDate()).padStart(2,'0');return `${y}-${m}-${day}`};
function normalizeRole(value){return String(value||'').trim().toLowerCase().replace(/[\s_-]+/g,'')}
function isAdmin(){return ['admin','administrator'].includes(normalizeRole(currentUser?.role))}
function isWali(){return ['wali','walisantri','parent'].includes(normalizeRole(currentUser?.role))}
function isPengajar(){return ['pengajar','teacher'].includes(normalizeRole(currentUser?.role))}
function getCurrentTeacher(){
  if(!isPengajar())return null;
  const uid=String(currentUser?.id||'');
  const email=String(currentUser?.email||currentUser?.username||'').trim().toLowerCase();
  const name=String(currentUser?.full_name||currentUser?.nama_lengkap||'').trim().toLowerCase();
  return (db.teachers||[]).find(t=>String(t.user_id||'')===uid || (email && String(t.email_login||'').trim().toLowerCase()===email) || (name && String(t.nama_lengkap||'').trim().toLowerCase()===name))||null;
}
function getPengajarStudents(){
  if(!isPengajar())return [];
  const me=getCurrentTeacher();
  if(me?.status && String(me.status)!=='Aktif')return [];
  const teacherId=String(me?.id||'');
  const n=String(me?.nama_lengkap||currentUser?.full_name||'').trim().toLowerCase();
  const e=String(currentUser?.username||currentUser?.email||me?.email_login||'').trim().toLowerCase();
  return (db.santri||[]).filter(s=>{
    const sid=String(s.teacher_id||s.pengajar_id||'');
    const p=String(s.pengajar||'').trim().toLowerCase();
    return (teacherId && sid===teacherId) || (p && ((n&&p===n)||(e&&p===e)));
  });
}
function visibleStudents(){return isAdmin()?(db.santri||[]):isPengajar()?getPengajarStudents():isWali()?getWaliStudents():[]}
function canManageStudent(id){return isAdmin()||getPengajarStudents().some(s=>String(s.id)===String(id))}
function getWaliStudents(){if(!isWali())return [];return db.santri.filter(s=>String(s.wali_user_id||'')===String(currentUser.id));}
function getWaliStudent(){
  const list=getWaliStudents();
  if(!list.length)return null;
  const saved=localStorage.getItem('sq_wali_selected_student_'+currentUser.id);
  return list.find(s=>String(s.id)===String(saved))||list[0];
}
function getWaliDisplayName(){
  // Nama wali terbaru diambil dari Data Santri yang diedit Admin, bukan hanya profil login lama.
  if(!isWali())return String(currentUser?.full_name||'').trim();
  const selected=getWaliStudent();
  const selectedName=String(selected?.wali||'').trim();
  if(selectedName)return selectedName;
  const linkedName=getWaliStudents().map(s=>String(s.wali||'').trim()).find(Boolean);
  return linkedName||String(currentUser?.full_name||'Walisantri').trim()||'Walisantri';
}
function selectWaliStudent(id){
  if(!isWali())return;
  const list=getWaliStudents();
  const s=list.find(x=>String(x.id)===String(id));
  if(!s)return;
  localStorage.setItem('sq_wali_selected_student_'+currentUser.id,String(s.id));
  ensureWaliSelection();
  renderWaliPortal();
}
let presensiCloud=[]; let presensiSetupNeeded=false;
let sessionStatusCloud=[]; let sessionStatusSetupNeeded=false;
async function loadSessionStatusCloud(){
  const {data,error}=await supabaseClient.from('session_statuses').select('*').order('tanggal',{ascending:false});
  if(error){
    const msg=String(error.message||'');
    if(/schema cache|relation .* does not exist|could not find the table/i.test(msg)){sessionStatusCloud=[];sessionStatusSetupNeeded=true;return;}
    throw new Error('Gagal membaca status pertemuan: '+msg);
  }
  sessionStatusCloud=data||[]; sessionStatusSetupNeeded=false;
}
async function loadPresensiCloud(){
  const {data,error}=await supabaseClient.from('attendance_records').select('*').order('tanggal',{ascending:false});
  if(error){
    const msg=String(error.message||'');
    if(/schema cache|relation .* does not exist|could not find the table/i.test(msg)){presensiCloud=[];presensiSetupNeeded=true;return;}
    throw new Error('Gagal membaca data presensi: '+msg);
  }
  presensiCloud=data||[]; presensiSetupNeeded=false;
}

let adabNotesCloud=[]; let adabSetupNeeded=false; let editAdabNoteId=null;
async function loadAdabNotesCloud(){
  const {data,error}=await supabaseClient.from('student_adab_notes').select('*').order('tanggal',{ascending:false}).order('created_at',{ascending:false});
  if(error){const msg=String(error.message||'');if(/schema cache|relation .* does not exist|could not find the table/i.test(msg)){adabNotesCloud=[];adabSetupNeeded=true;return;}throw new Error('Gagal membaca Catatan Adab: '+msg);}
  adabNotesCloud=data||[];adabSetupNeeded=false;
}

async function loadCloudData(){
  // Pastikan sesi Auth terbaru tersedia sebelum query RLS.
  const {data:authData,error:authError}=await supabaseClient.auth.getSession();
  if(authError) throw authError;
  const authUser=authData?.session?.user;
  if(authData?.session?.access_token) currentAccessToken=authData.session.access_token;
  if(!authUser){ throw new Error('Sesi login Supabase tidak tersedia. Silakan login kembali.'); }
  if(!currentUser || String(currentUser.id)!==String(authUser.id)){
    currentUser=currentUser||{};
    currentUser.id=authUser.id;
    currentUser.username=authUser.email||currentUser.username||'';
  }
  const [st,se,pr,tr]=await Promise.all([
    supabaseClient.from('students').select('*').order('nama'),
    supabaseClient.from('learning_sessions').select('*').order('tanggal',{ascending:false}),
    supabaseClient.from('prayer_records').select('*').order('tanggal',{ascending:false}),
    supabaseClient.from('teachers').select('*').order('nama_lengkap')
  ]);
  if(st.error)throw new Error('Gagal membaca data santri: '+st.error.message);
  if(se.error)throw new Error('Gagal membaca hasil pembelajaran: '+se.error.message);
  if(pr.error)throw new Error('Gagal membaca data doa: '+pr.error.message);
  if(tr.error)throw new Error('Gagal membaca data pengajar: '+tr.error.message);
  // Optimasi: data tambahan tidak perlu menunggu satu sama lain.
  await Promise.all([
    loadPresensiCloud(),
    loadSessionStatusCloud(),
    loadAdabNotesCloud()
  ]);

  const allStudents=(st.data||[]).map(x=>({id:x.id,nama:x.nama,ttl:[x.tempat_lahir,x.tanggal_lahir].filter(Boolean).join(', '),jenis_kelamin:x.jenis_kelamin||'',tempat_lahir:x.tempat_lahir||'',tanggal_lahir:x.tanggal_lahir||'',alamat:x.alamat||'',wali:x.walisantri||'',wali_user_id:x.wali_user_id||'',waliUser:x.wali_user_id||'',wali_email_login:x.wali_email_login||'',waliPin:'',level:x.kelas||'',pengajar:x.pengajar||'',teacher_id:x.teacher_id||'',aktif:x.aktif!==false}));
  db.teachers=(tr.data||[]).map(x=>({id:x.id,nama_lengkap:x.nama_lengkap||'',nama_panggilan:x.nama_panggilan||'',jenis_kelamin:x.jenis_kelamin||'',tempat_lahir:x.tempat_lahir||'',tanggal_lahir:x.tanggal_lahir||'',no_hp:x.no_hp||'',alamat:x.alamat||'',pendidikan_terakhir:x.pendidikan_terakhir||'',kompetensi:x.kompetensi||'',kelas_diampu:x.kelas_diampu||'',status:x.status||'Aktif',tanggal_bergabung:x.tanggal_bergabung||'',email_login:x.email_login||'',role:x.role||'pengajar',catatan:x.catatan||'',user_id:x.user_id||''}));

  let allowedStudents=allStudents;
  if(isPengajar()){
    const me=getCurrentTeacher();
    const teacherId=String(me?.id||'');
    const n=String(me?.nama_lengkap||currentUser?.full_name||'').trim().toLowerCase();
    const e=String(currentUser?.username||currentUser?.email||me?.email_login||'').trim().toLowerCase();
    if(!me || (me.status && String(me.status)!=='Aktif')) allowedStudents=[];
    else allowedStudents=allStudents.filter(st=>{
      const sid=String(st.teacher_id||st.pengajar_id||'');
      const p=String(st.pengajar||'').trim().toLowerCase();
      return (teacherId && sid===teacherId) || (p && ((n&&p===n)||(e&&p===e)));
    });
  }else if(isWali()){
    allowedStudents=allStudents.filter(st=>String(st.wali_user_id||'')===String(currentUser.id));
  }
  db.santri=allowedStudents;
  const allowedIds=new Set(allowedStudents.map(st=>String(st.id)));
  const allSessions=(se.data||[]).map(x=>({id:x.id,date:x.tanggal,santriId:x.student_id,kelas:x.kelas,jenis:x.jenis_pembelajaran,fields:x.fields||{},scores:x.scores||[],nilai:Number(x.nilai||0),predikat:x.predikat||grade(x.nilai),rubricScores:x.rubric_scores||[],catatan:x.catatan||'',created_by:x.created_by||'',created_at:x.created_at||'',updated_at:x.updated_at||''}));
  // SELECT RLS sudah membatasi data di database. Filter client hanya sebagai lapisan tambahan.
  db.sessions=(isAdmin()?allSessions:allSessions.filter(x=>allowedIds.has(String(x.santriId))));
  if(!isAdmin() && allSessions.length>0 && db.sessions.length===0){
    throw new Error('Data hasil pembelajaran terbaca dari database, tetapi tidak cocok dengan daftar santri yang boleh diakses akun ini. Periksa teacher_id/wali_user_id.');
  }
  db.doa={};
  (pr.data||[]).forEach(x=>{
    if(!isAdmin()&&!allowedIds.has(String(x.student_id)))return;
    const idx=DOA.indexOf(x.doa); const k=String(x.student_id)+'_'+x.tanggal+'_'+(idx>=0?idx:x.doa);
    if(x.tercapai)db.doa[k]=true;if(x.catatan)db.doa[k+'_note']=x.catatan;
  });
  if(isAdmin()){renderWaliAccountSelect();renderAccountStatus();}
}
function closeSaveSuccess(){const el=document.getElementById('saveSuccessOverlay');if(el)el.classList.add('hidden')}
function showSaveSuccess(message='Sesi pembelajaran dan nilai berhasil disimpan ke database.'){const el=document.getElementById('saveSuccessOverlay');const p=document.getElementById('saveSuccessMessage');if(p)p.textContent=message;if(el){el.classList.remove('hidden');document.getElementById('saveSuccessOverlay')?.querySelector('button')?.focus();}}
function toast(message,type='success',duration=3000){
  const host=document.getElementById('toastHost'); if(!host)return;
  const el=document.createElement('div'); el.className='toast '+type; el.textContent=message; host.appendChild(el);
  setTimeout(()=>{el.style.opacity='0';el.style.transform='translateY(-6px)';el.style.transition='opacity .2s,transform .2s';setTimeout(()=>el.remove(),220)},duration);
}
let publicLoginRequested=false;
function showPublicLanding(){const el=document.getElementById('publicLanding');if(el){el.classList.remove('hidden');el.classList.add('shq-public-ready');}const login=document.getElementById('loginOverlay');if(login){login.classList.add('hidden');login.classList.remove('auth-checking');}}
function openPublicLogin(){publicLoginRequested=true;const pub=document.getElementById('publicLanding');if(pub)pub.classList.add('hidden');showLoginForm('Silakan masuk sesuai akun Anda');}
function generatePublicRecommendation(){
  const age=document.getElementById('publicAge')?.value||'3–6 tahun';
  const ability=document.getElementById('publicAbility')?.value||'Belum mengenal huruf';
  const goal=document.getElementById('publicGoal')?.value||'Belajar dari dasar';
  let title='Konsultasi Penempatan Level',program='Konsultasi awal bersama pengajar',description='Pengajar akan membantu memahami kemampuan awal dan tujuan belajar sebelum menentukan program yang sesuai.',steps=['Diskusikan pengalaman belajar anak.','Kenali kesiapan dan kebutuhan belajar.','Konfirmasikan program dan level bersama pengajar.'];
  if(ability==='Belum mengenal huruf' && (age==='3–6 tahun'||goal==='Belajar dari dasar')){title='Multisensori Hijaiyah';program='Rekomendasi awal: pengenalan dasar huruf hijaiyah';description='Program pengenalan dasar dapat dipertimbangkan, terutama melalui aktivitas melihat, mendengar, menyentuh, mengucapkan, dan mengulang. Untuk usia 3–6 tahun, aktivitas dapat dikemas dengan pendekatan bermain yang terarah.';steps=['Mengenal bentuk huruf hijaiyah secara bertahap.','Mendengar dan menirukan bunyi bersama pengajar.','Menggunakan aktivitas sensorik dan motorik yang sesuai usia.'];}
  else if(ability==='Sedang belajar membaca'){title='Tahsin Iqra’ atau penguatan dasar';program='Rekomendasi awal: evaluasi kemampuan membaca';description='Jika anak sedang belajar membaca, pengajar dapat meninjau materi terakhir dan kemampuan membaca untuk menentukan apakah melanjutkan tahap Iqra’ atau menguatkan materi sebelumnya lebih sesuai.';steps=['Meninjau kemampuan membaca saat ini.','Mengidentifikasi huruf atau harakat yang perlu dilatih.','Menentukan materi lanjutan bersama pengajar.'];}
  else if(ability==="Sudah membaca Al-Qur'an" && goal==='Memperbaiki bacaan'){title='Tahsin Al-Qur’an';program='Rekomendasi awal: konsultasi perbaikan bacaan';description='Pengajar dapat menilai kelancaran, makhraj, sifat huruf, dan penerapan tajwid untuk menentukan bentuk pembelajaran yang tepat.';steps=['Mendengarkan contoh bacaan santri.','Mengidentifikasi aspek yang perlu diperbaiki.','Menyepakati target belajar yang realistis.'];}
  else if(goal==="Menghafal Al-Qur'an"){title='Persiapan Tahfizh';program='Rekomendasi awal: cek kesiapan bacaan dan hafalan';description='Tujuan menghafal dapat dikonsultasikan dengan pengajar. Kesiapan bacaan dan kebiasaan murojaah perlu dipertimbangkan sebelum menentukan tahap awal.';steps=['Mengenali kemampuan bacaan saat ini.','Membahas target hafalan yang sesuai.','Menyusun kebiasaan setoran dan murojaah bersama pengajar.'];}
  const waText=`Assalaamu'alaykum warahmatullahi wabarakaatuh. Saya ingin berkonsultasi tentang program Shohibul Quran. Usia: ${age}. Kemampuan: ${ability}. Tujuan: ${goal}. Mohon bantuan untuk mengetahui program awal yang sesuai dan proses konsultasi/asesmen. Jazaakumullahu khairan.`;
  const el=document.getElementById('publicRecommendation');if(el)el.innerHTML=`<span class="publicEyebrow" style="background:#244B3710;border-color:#cbd9c4;color:#41681c">REKOMENDASI AWAL</span><h3>${title}</h3><b>${program}</b><p>${description}</p><ul>${steps.map(x=>`<li>${x}</li>`).join('')}</ul><p><b>Data pilihan:</b> ${age} · ${ability} · ${goal}</p><p class="publicNote">Rekomendasi ini bersifat awal, bukan penetapan level resmi. Penempatan program dan level harus dikonfirmasi oleh pengajar melalui konsultasi atau asesmen.</p><a class="publicPrimary" style="display:inline-flex" href="https://wa.me/6282299390661?text=${encodeURIComponent(waText)}" target="_blank" rel="noopener">Konsultasikan Pilihan Ini ↗</a>`;
}
function showLoginForm(message=''){
  const overlay=document.getElementById('loginOverlay');
  const area=document.getElementById('loginFormArea');
  const msg=document.getElementById('authBootMsg');
  if(!publicLoginRequested && !currentUser){showPublicLanding();return;}
  if(overlay){overlay.classList.remove('hidden');overlay.classList.remove('auth-checking');}
  if(msg) msg.textContent=message||'Silakan masuk sesuai akun Anda';
  if(area) area.classList.remove('hidden');
  setTimeout(()=>document.getElementById('loginUser')?.focus(),0);
}
async function login(){
  const u=(loginUser.value||'').trim(),p=loginPass.value||'';
  if(!u||!p){loginMsg.textContent='Masukkan email dan password.';return}
  loginMsg.textContent='Memproses login...';
  const {data,error}=await supabaseClient.auth.signInWithPassword({email:u,password:p});
  if(error){loginMsg.textContent='Login gagal: '+error.message;toast('Login gagal: '+error.message,'error');return}
  const {data:prof,error:pe}=await supabaseClient.from('profiles').select('id,full_name,role').eq('id',data.user.id).single();
  if(pe||!prof){await supabaseClient.auth.signOut();loginMsg.textContent='Profil pengguna belum terdaftar di profiles.';toast('Profil pengguna belum terdaftar.','error');return}
  currentUser={id:data.user.id,role:prof.role,username:data.user.email,full_name:prof.full_name};
  currentAccessToken=data.session?.access_token||currentAccessToken;
  saveAuthBackup(data.session);
  try{await loadCloudData();startApp(true)}catch(e){loginMsg.textContent='Gagal mengambil data: '+e.message;toast('Gagal mengambil data: '+e.message,'error');await supabaseClient.auth.signOut();currentUser=null}
}
function getLastPageKey(){return currentUser?.id?('sq_last_page_'+String(currentUser.id)):'sq_last_page_guest'}
function saveLastPage(id){
  if(!currentUser||!id)return;
  try{localStorage.setItem(getLastPageKey(),String(id));}catch(e){}
}
function getLastPage(){
  if(!currentUser)return 'dashboard';
  try{return localStorage.getItem(getLastPageKey())||'dashboard';}catch(e){return 'dashboard'}
}
function findNavButtonForPage(id){
  if(id==='presensi')return document.getElementById('navPresensi');
  return [...document.querySelectorAll('#mainNav button')].find(b=>String(b.getAttribute('onclick')||'').includes("showPage('"+id+"'"))||null;
}
function restoreLastPage(){
  if(!currentUser)return;
  if(isWali()){const b=document.getElementById('navPortalWali');showPage('waliPortal',b,{persist:false});return;}
  let id=getLastPage();
  const page=document.getElementById(id);
  const btn=findNavButtonForPage(id);
  const visible=!!btn && getComputedStyle(btn).display!=='none' && !btn.classList.contains('hidden');
  if(!page||!visible){id='dashboard';}
  const targetBtn=findNavButtonForPage(id)||document.getElementById('navDashboard');
  showPage(id,targetBtn,{persist:false});
  setTimeout(()=>{try{window.scrollTo({top:0,behavior:'auto'});}catch(e){}},50);
}
function startApp(showWelcome=false){
  publicLoginRequested=false;
  const publicLanding=document.getElementById('publicLanding');if(publicLanding)publicLanding.classList.add('hidden');
  const overlay=document.getElementById('loginOverlay');
  if(overlay) overlay.classList.add('hidden');
  const area=document.getElementById('loginFormArea');
  if(area) area.classList.add('hidden');
  logoutBtn.classList.remove('hidden');
  const badgeName=isPengajar()?(getCurrentTeacher()?.nama_lengkap||currentUser.full_name||'Pengajar'):(isWali()?getWaliDisplayName():(currentUser.full_name||''));
  userBadge.textContent=badgeName+' • '+(isAdmin()?'Admin':isPengajar()?'Pengajar':'Walisantri');
  applyRole(); Promise.allSettled([loadSppCloud(),loadFinanceCloud()]).then(()=>{renderSPP();renderFinance()}); refresh();
  restoreLastPage();
  if(document.getElementById('manajemenAkun')?.classList.contains('active')&&isAdmin())setTimeout(()=>loadAccountManagementData().catch(e=>console.error('Account management load:',e)),100);
  // v50: jadwal selalu mencoba memuat dari Supabase setelah login. Jika tabel belum dibuat,
  // aplikasi tetap memakai data lokal sementara dan menampilkan kartu Setup Jadwal di Pengaturan.
  // v51: muat jadwal setelah seluruh data akun/santri tersedia, lalu render.
  // v162: Dashboard jangan dihitung sebelum jadwal Supabase selesai dimuat.
  // Render ulang kedua dashboard setelah jadwal final tersedia agar angka/jadwal tidak
  // sesaat menjadi 0 lalu berubah, atau kosong setelah refresh.
  loadJadwalCloud().then(()=>{
    renderJadwal();
    renderAdminDashboard();
    renderPengajarDashboard();
  }).catch(e=>{
    console.error('Jadwal cloud:',e);
    jadwalSetupNeeded=true;
    renderJadwal();
    // Jika cloud gagal, jangan biarkan dashboard tetap menampilkan hasil render awal.
    renderAdminDashboard();
    renderPengajarDashboard();
  });
  if(showWelcome)toast('✅ Login berhasil. Selamat datang, '+(currentUser.full_name||currentUser.username||'pengguna')+'!','success',3500);
}
async function logout(){publicLoginRequested=false;const key=currentUser?.id?('sq_last_page_'+String(currentUser.id)):null;await supabaseClient.auth.signOut();if(key){try{localStorage.removeItem(key)}catch(e){}}currentUser=null;currentAccessToken=null;loginUser.value='';loginPass.value='';loginMsg.textContent='';logoutBtn.classList.add('hidden');userBadge.textContent='';document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById('dashboard').classList.add('active');showLoginForm('Silakan masuk sesuai akun Anda');toast('👋 Anda telah keluar dari sistem.','info')}
function applyRole(){
  const financeAdminIds=['financeManualCard','financeDashboardCard','financeSummaryCard','financeSqlCard'];
  financeAdminIds.forEach(id=>{const el=document.getElementById(id);if(el)el.style.display=isAdmin()?'block':'none'});
  const buttons=[...document.querySelectorAll('#mainNav button')];
  const portal=document.getElementById('navPortalWali');
  buttons.forEach(b=>b.style.display='inline-block');
  if(portal)portal.style.display='none';
  const navPengajar=document.getElementById('navPengajar'); if(navPengajar)navPengajar.style.display='none'; const navAkun=document.getElementById('navAkun'); if(navAkun)navAkun.style.display='none';
  const navPerk=document.getElementById('navPerkembangan'); if(navPerk)navPerk.style.display='none';
  const navPresensi=document.getElementById('navPresensi'); if(navPresensi)navPresensi.style.display=(isAdmin()||isPengajar())?'inline-block':'none'; const navJadwal=document.getElementById('navJadwal'); if(navJadwal)navJadwal.style.display=(isAdmin()||isPengajar())?'inline-block':'none';
  const navKom=document.getElementById('navKomunikasi'); if(navKom)navKom.style.display='none';
  if(isWali()){
    buttons.forEach(b=>b.style.display='none');
    if(portal)portal.style.display='inline-block';
    if(document.getElementById('navSPP'))document.getElementById('navSPP').style.display='inline-block';
    if(document.getElementById('navRaport'))document.getElementById('navRaport').style.display='inline-block';
    document.getElementById('akunWaliCard')?.classList.add('hidden');
    document.getElementById('dashboard')?.classList.remove('active');
  }else if(isPengajar()){
    // Pengajar: tampilkan menu berdasarkan ID, bukan textContent, agar ikon tidak membuat menu hilang.
    buttons.forEach(b=>b.style.display='none');
    ['navDashboard','navSantri','navPresensi','navJadwal','navPembelajaran','navAdab','navPerkembangan','navRaport','navDoa','navKomunikasi'].forEach(id=>{
      const b=document.getElementById(id); if(b)b.style.display='inline-flex';
    });
    // Pengajar tidak boleh mengisi/mengubah identitas santri.
    document.getElementById('santriForm')?.closest('.card')?.classList.add('hidden');
    document.getElementById('akunWaliCard')?.classList.add('hidden');
    document.getElementById('pengajarCard')?.classList.add('hidden');
  }else{ 
    if(navPerk)navPerk.style.display='inline-block';
    if(navKom)navKom.style.display='inline-block';
    if(navPresensi)navPresensi.style.display='inline-block'; const navJadwal=document.getElementById('navJadwal'); if(navJadwal)navJadwal.style.display='inline-block';
    document.getElementById('santriForm')?.closest('.card')?.classList.remove('hidden');
    if(navPengajar)navPengajar.style.display='inline-block'; if(navAkun)navAkun.style.display='inline-block';
    document.getElementById('santriForm')?.closest('.card')?.classList.remove('hidden');
    document.getElementById('pengajarCard')?.classList.remove('hidden');
    document.getElementById('akunWaliCard')?.classList.remove('hidden');
  }
}
function ensureWaliSelection(){
  if(!isWali())return;
  const s=getWaliStudent();
  ['rSantri','dSantri','pSantri'].forEach(id=>{
    const el=document.getElementById(id);
    if(el){el.value=s?String(s.id):'';el.disabled=true;}
  });
}
function sessionFieldText(x,key){
  const fields=x?.fields&&typeof x.fields==='object'?x.fields:{};
  const v=fields[key];
  if(v===undefined||v===null||String(v).trim()==='')return '—';
  if(Array.isArray(v))return v.map(z=>String(z)).filter(Boolean).join(', ')||'—';
  if(typeof v==='object')return String(v.label??v.name??v.value??'—');
  return String(v);
}
function sessionQuranDetails(x){
  const surah=sessionFieldText(x,'surah');
  const ayat=sessionFieldText(x,'ayat');
  const juz=sessionFieldText(x,'juz');
  const halaman=sessionFieldText(x,'halaman');
  return {surah,ayat,juz,halaman};
}
function renderAdabPage(){
  const sel=document.getElementById('adabStudent'),records=document.getElementById('adabRecords');
  if(!sel||!records)return;
  const students=visibleStudents().slice().sort((a,b)=>String(a.nama||'').localeCompare(String(b.nama||'')));
  const old=sel.value;sel.innerHTML='<option value="">Pilih santri</option>'+students.map(x=>`<option value="${esc(x.id)}">${esc(x.nama)}</option>`).join('');
  if(students.some(x=>String(x.id)===String(old)))sel.value=old;
  if(!document.getElementById('adabTanggal').value)document.getElementById('adabTanggal').value=today();
  const noteSetup=adabSetupNeeded?'<div class="notice warning">Tabel Catatan Adab belum tersedia. Admin perlu membuka Pengaturan, menyalin SQL Setup Catatan Adab, lalu menjalankannya di Supabase SQL Editor.</div>':'';
  const rows=adabNotesCloud.filter(n=>students.some(st=>String(st.id)===String(n.student_id))).slice().sort((a,b)=>String(b.tanggal||'').localeCompare(String(a.tanggal||'')));
  records.innerHTML=noteSetup+(rows.length?'<div class="waliTableWrap"><table><thead><tr><th>Tanggal</th><th>Santri</th><th>Aspek</th><th>Kondisi</th><th>Catatan & Nasihat</th><th>Aksi</th></tr></thead><tbody>'+rows.map(n=>{const st=db.santri.find(x=>String(x.id)===String(n.student_id));return `<tr><td>${esc(fmt(n.tanggal))}</td><td>${esc(st?.nama||'-')}</td><td>${esc(n.kategori||'-')}</td><td>${esc(n.kondisi||'-')}</td><td><b>Catatan:</b> ${esc(n.catatan||'-')}<br><b>Nasihat:</b> ${esc(n.nasihat||'-')}<br><small class="muted">${n.nasihat_disampaikan?'Nasihat telah disampaikan kepada santri':'Status penyampaian nasihat belum dikonfirmasi'}</small></td><td><div class="actions"><button class="btn edit" onclick="editAdabNote('${esc(n.id)}')">Edit</button><button class="btn danger" onclick="deleteAdabNote('${esc(n.id)}')">Hapus</button></div></td></tr>`}).join('')+'</tbody></table></div>':'<div class="muted">Belum ada catatan adab untuk santri yang dapat Anda akses.</div>');
  const form=document.getElementById('adabForm');if(form)form.style.display=(isAdmin()||isPengajar())?'block':'none';
}
function resetAdabForm(){editAdabNoteId=null;const f=document.getElementById('adabForm');f?.reset();document.getElementById('adabTanggal').value=today();document.getElementById('adabSaveBtn').textContent='💾 Simpan Catatan';document.getElementById('adabFormMsg').textContent='';}
function editAdabNote(id){const n=adabNotesCloud.find(x=>String(x.id)===String(id));if(!n||!canManageStudent(n.student_id))return alert('Anda tidak memiliki akses untuk mengubah catatan ini.');editAdabNoteId=n.id;adabStudent.value=n.student_id;adabTanggal.value=n.tanggal||today();adabKategori.value=n.kategori||'Adab umum';adabKondisi.value=n.kondisi||'Baik';adabCatatan.value=n.catatan||'';adabNasihat.value=n.nasihat||'';adabNasihatDisampaikan.checked=!!n.nasihat_disampaikan;adabSaveBtn.textContent='💾 Perbarui Catatan';document.getElementById('adabFormMsg').textContent='Mode edit catatan.';document.getElementById('adabForm').scrollIntoView({behavior:'smooth',block:'start'});}
async function saveAdabNote(){
  if(!(isAdmin()||isPengajar()))return alert('Hanya Admin atau Pengajar yang dapat membuat catatan adab.');
  const student_id=adabStudent.value;if(!student_id)return alert('Pilih santri terlebih dahulu.');if(!canManageStudent(student_id))return alert('Santri ini tidak berada dalam penugasan Anda.');
  if(adabSetupNeeded)return alert('Tabel Catatan Adab belum dibuat. Admin perlu menjalankan SQL Setup Catatan Adab di menu Pengaturan.');
  const nasihat=adabNasihat.value.trim();if(adabNasihatDisampaikan.checked&&!nasihat)return alert('Isi nasihat terlebih dahulu atau hilangkan centang status sudah disampaikan.');
  const payload={student_id,tanggal:adabTanggal.value||today(),kategori:adabKategori.value,kondisi:adabKondisi.value,catatan:adabCatatan.value.trim()||null,nasihat:nasihat||null,nasihat_disampaikan:!!adabNasihatDisampaikan.checked,updated_by:currentUser.id,updated_at:new Date().toISOString()};
  if(!payload.catatan&&!payload.nasihat)return alert('Isi minimal catatan kondisi adab atau nasihat guru.');
  const btn=adabSaveBtn;btn.disabled=true;const old=btn.textContent;btn.textContent='⏳ Menyimpan...';
  try{let res;if(editAdabNoteId)res=await supabaseClient.from('student_adab_notes').update(payload).eq('id',editAdabNoteId).select('*').single();else res=await supabaseClient.from('student_adab_notes').insert({...payload,created_by:currentUser.id}).select('*').single();if(res.error)throw res.error;
    const i=adabNotesCloud.findIndex(x=>String(x.id)===String(res.data.id));if(i>=0)adabNotesCloud[i]=res.data;else adabNotesCloud.unshift(res.data);resetAdabForm();renderAdabPage();renderWaliPortal();toast('Catatan adab berhasil disimpan.','success');
  }catch(e){console.error(e);alert('Catatan belum berhasil disimpan: '+(e.message||e));}finally{btn.disabled=false;btn.textContent=editAdabNoteId?'💾 Perbarui Catatan':old;}
}
async function deleteAdabNote(id){const n=adabNotesCloud.find(x=>String(x.id)===String(id));if(!n||!canManageStudent(n.student_id))return alert('Anda tidak memiliki akses untuk menghapus catatan ini.');if(!confirm('Hapus catatan adab ini?'))return;const {error}=await supabaseClient.from('student_adab_notes').delete().eq('id',id);if(error){alert('Gagal menghapus catatan: '+error.message);return;}adabNotesCloud=adabNotesCloud.filter(x=>String(x.id)!==String(id));renderAdabPage();renderWaliPortal();toast('Catatan adab dihapus.','success');}

function renderWaliPortal(){
  const el=document.getElementById('waliPortalData');
  if(!el||!isWali())return;
  const s=getWaliStudent();
  if(!s){el.innerHTML='<div class="card"><h3>Akun belum terhubung</h3><p class="muted">Akun Walisantri ini belum terhubung dengan data santri.</p></div>';return;}
  const waliStudents=getWaliStudents();
  const childPicker=waliStudents.length>1?`<div class="card"><label style="display:block;font-weight:700">Pilih Anak<select onchange="selectWaliStudent(this.value)" style="margin-top:7px">${waliStudents.map(ch=>`<option value="${esc(ch.id)}" ${String(ch.id)===String(s.id)?'selected':''}>${esc(ch.nama)} — ${esc(ch.level||'-')}</option>`).join('')}</select></label><div class="waliFilterNote">Akun ini terhubung dengan ${waliStudents.length} anak.</div></div>`:'';
  const quickActions=`<div class="waliQuick">
    <button class="waliQuickBtn" onclick="openWaliPerkembangan()"><span class="waliQuickIcon">📊</span><span><b>Perkembangan</b><small>Ringkasan belajar</small></span></button>
    <button class="waliQuickBtn" onclick="openWaliPresensi()"><span class="waliQuickIcon">📋</span><span><b>Presensi</b><small>Kehadiran anak</small></span></button>
    <button class="waliQuickBtn" onclick="openWaliReport()"><span class="waliQuickIcon">📄</span><span><b>Raport PDF</b><small>Unduh raport</small></span></button>
    <button class="waliQuickBtn" onclick="showPage('spp',document.getElementById('navSPP'))"><span class="waliQuickIcon">💰</span><span><b>SPP</b><small>Status pembayaran</small></span></button>
  </div>`;
  const rows=db.sessions.filter(x=>String(x.santriId)===String(s.id));
  const avg=rows.length?rows.reduce((a,x)=>a+Number(x.nilai||0),0)/rows.length:0;
  const meetings=meetingGroups(rows);
  const groups={}; rows.forEach(x=>(groups[x.jenis]??=[]).push(Number(x.nilai)||0));
  const summaryRows=Object.entries(groups).map(([jenis,vals])=>{const n=vals.reduce((a,b)=>a+b,0)/vals.length;const count=new Set(rows.filter(x=>x.jenis===jenis).map(x=>x.date)).size;return `<tr><td>${esc(jenis)}</td><td style="text-align:center">${count}</td><td style="text-align:center"><b>${n.toFixed(1)}</b></td><td style="text-align:center">${esc(grade(n))}</td></tr>`;}).join('')||'<tr><td colspan="4" class="muted">Belum ada data pembelajaran.</td></tr>';
  const dailyRows=rows.slice().sort((a,b)=>String(b.date||'').localeCompare(String(a.date||''))).map(x=>{const q=sessionQuranDetails(x);return `<tr><td>${fmt(x.date)}</td><td>${esc(x.jenis||'-')}</td><td>${esc(q.surah)}</td><td>${esc(q.ayat)}</td><td>${esc(q.juz)}</td><td>${esc(q.halaman)}</td><td style="text-align:center"><b>${esc(visibleSessionValue(x))}</b></td><td style="text-align:center">${esc(visibleSessionPredikat(x))}</td><td>${esc(String(x.catatan||'').trim()||'-')}</td></tr>`}).join('')||'<tr><td colspan="9" class="muted">Belum ada data pembelajaran.</td></tr>';
  const prayers=DOA.map((name,i)=>{let done=false;Object.keys(db.doa||{}).forEach(k=>{if(k.endsWith('_note'))return;const parts=k.split('_');const idx=parts.pop(),date=parts.pop(),sid=parts.join('_');if(sid===String(s.id)&&String(idx)===String(i)&&db.doa[k]===true)done=true;});return {name,done};});
  const prayerTotal=prayers.filter(x=>x.done).length;
  const hasPrayerRecords=Object.keys(db.doa||{}).some(k=>{if(k.endsWith('_note'))return false;const parts=k.split('_');const idx=parts.pop(),date=parts.pop(),sid=parts.join('_');return sid===String(s.id)&&(db.doa[k]===true||!!db.doa[k+'_note']);});
  const chartRows=meetings.map(m=>({date:m.date,nilai:m.avg,jenis:`${m.items.length} pembelajaran`}));
  const chart=buildWaliProgressChart(chartRows);
  const lastMeeting=meetings.length?meetings[meetings.length-1]:null;
  const lastValue=lastMeeting?Number(lastMeeting.avg||0):0;
  const firstMeeting=meetings.length?meetings[0]:null;
  const firstValue=firstMeeting?Number(firstMeeting.avg||0):0;
  const delta=meetings.length>1?lastValue-firstValue:0;
  const attendanceRows=presensiLoad().filter(x=>String(x.student_id)===String(s.id));
  const attCount={hadir:0,izin:0,sakit:0,tidak_hadir:0}; attendanceRows.forEach(x=>attCount[x.status]=(attCount[x.status]||0)+1);
  const attMeetings=new Set(attendanceRows.map(x=>String(x.tanggal))).size;
  const attPct=attendanceRows.length?Math.round(attCount.hadir/attendanceRows.length*100):0;
  const attendanceCard=`<div id="waliAttendanceCard" class="card"><div class="waliSectionTitle"><div><h3 style="margin:0">📋 Kehadiran</h3><div class="muted">Ringkasan presensi santri. Satu tanggal dihitung sebagai satu pertemuan.</div></div><span class="badge">${attPct}% Hadir</span></div><div class="dashMiniGrid" style="margin-top:10px"><div class="dashMini"><div class="dashMiniTitle">Pertemuan</div><div class="dashMiniValue">${attMeetings}</div></div><div class="dashMini"><div class="dashMiniTitle">Hadir</div><div class="dashMiniValue">${attCount.hadir}</div></div><div class="dashMini"><div class="dashMiniTitle">Izin</div><div class="dashMiniValue">${attCount.izin}</div></div><div class="dashMini"><div class="dashMiniTitle">Sakit</div><div class="dashMiniValue">${attCount.sakit}</div></div><div class="dashMini"><div class="dashMiniTitle">Tidak Hadir</div><div class="dashMiniValue">${attCount.tidak_hadir}</div></div></div></div>`;
  const hasZiyadah=rows.some(x=>/ziyadah|pra hafalan/i.test(String(x.jenis||'')));
  const hasMurojaah=rows.some(x=>/muroja.?ah/i.test(String(x.jenis||'')));
  const rewardItems=[
    {icon:'🌱',title:'Mulai Bertumbuh',desc:'Catatan belajar pertama tersimpan',earned:rows.length>0},
    {icon:'📖',title:'Rajin Mengaji',desc:'Mengikuti minimal 4 pertemuan',earned:attCount.hadir>=4},
    {icon:'⭐',title:'Hafalan Bertambah',desc:'Ada catatan Pra Hafalan atau Ziyadah',earned:hasZiyadah},
    {icon:'💚',title:'Penjaga Murojaah',desc:'Ada catatan pembelajaran murojaah',earned:hasMurojaah}
  ];
  const rewardMessage=meetings.length>1&&delta>0
    ?'Alhamdulillah, nilai rata-rata menunjukkan perkembangan dibandingkan awal periode. Terus jaga semangat belajar dan murojaah.'
    :rows.length
      ?'Setiap langkah kecil adalah kemajuan. Dampingi ananda untuk terus belajar, berlatih, dan mencintai Al-Qur’an.'
      :'Pencapaian akan muncul seiring data pembelajaran ananda tercatat. Mari mulai langkah kecil bersama Al-Qur’an.';
  const rewardCard=`<div class="card waliRewardCard"><div class="waliSectionTitle"><div><h3 style="margin:0">🏅 Apresiasi Perkembangan</h3><div class="muted">Penghargaan berdasarkan catatan belajar yang tersimpan, bukan sekadar nilai tertinggi.</div></div></div><div class="waliRewardGrid">${rewardItems.map(r=>`<div class="waliRewardItem ${r.earned?'is-earned':''}"><div class="waliRewardIcon">${r.icon}</div><b>${esc(r.title)}</b><small>${r.earned?'✓ Diperoleh':r.desc}</small></div>`).join('')}</div><div class="waliRewardMessage">${esc(rewardMessage)}</div></div>`;
  const doaItems=prayers.map(x=>`<div class="waliDoaItem"><span>${esc(x.name)}</span><b>${x.done?'✅ Tuntas':'⬜ Belum'}</b></div>`).join('');
  const welcomeBlock=`<div class="waliWelcome">
      <div class="waliWelcomeTop">
        <div><h3>Selamat datang, ${esc(getWaliDisplayName()||'Walisantri')}</h3><p class="muted">Berikut ringkasan perkembangan belajar ${esc(s.nama)}.</p></div>
      </div>
    </div>`;
  el.innerHTML=`${welcomeBlock}
    ${childPicker}
    ${quickActions}
    ${rewardCard}
    <div class="waliHero">
      <div class="waliHeroTop"><div><div class="muted">Profil Santri</div><h2 class="waliChildName">${esc(s.nama)}</h2><div class="waliMeta"><span>${esc(s.level||'Kelas belum diatur')}</span><span>Pengajar: ${esc(s.pengajar||'-')}</span></div></div><button class="btn primary" onclick="openWaliReport()">📄 Unduh Raport PDF</button></div>
    </div>
    <div class="waliStats">
      <div class="waliStat"><div class="muted">Pertemuan</div><div class="num">${meetings.length}</div><div class="muted">1 tanggal = 1 pertemuan</div></div>
      <div class="waliStat"><div class="muted">Rata-rata Nilai</div><div class="num">${rows.length?avg.toFixed(1):'-'}</div><div class="muted">${rows.length?esc(grade(avg)):'Belum ada nilai'}</div></div>
      <div class="waliStat"><div class="muted">Perubahan</div><div class="num">${meetings.length>1?(delta>0?'+':'')+delta.toFixed(1):'-'}</div><div class="muted">${meetings.length>1?(delta>0?'dari awal periode':delta<0?'dari awal periode':'tetap'):'Belum cukup data'}</div></div>
      ${hasPrayerRecords?`<div class="waliStat"><div class="muted">Capaian Doa</div><div class="num">${prayerTotal}/${DOA.length}</div><div class="muted">Doa tuntas</div></div>`:''}
    </div>
    <div id="waliPerkembanganCard" class="card progressChart"><div class="waliSectionTitle"><div><h3 style="margin:0">📈 Perkembangan Nilai</h3><div class="muted">Rata-rata nilai per tanggal; beberapa pembelajaran pada hari yang sama menjadi satu titik.</div></div></div>${chart}</div>
    <div class="card"><div class="waliSectionTitle"><div><h3 style="margin:0">Rekap Pembelajaran</h3><div class="muted">Ringkasan berdasarkan jenis pembelajaran.</div></div></div><div class="waliTableWrap"><table><tr><th>Jenis Pembelajaran</th><th>Pertemuan</th><th>Rata-rata</th><th>Predikat</th></tr>${summaryRows}</table></div><div class="muted" style="margin-top:8px">Total ${meetings.length} pertemuan. Satu tanggal dihitung sebagai satu pertemuan.</div></div>
    <div class="card"><div class="waliSectionTitle"><div><h3 style="margin:0">📅 Monitoring Belajar Harian</h3><div class="muted">Surah, ayat, juz, dan halaman mengikuti catatan yang diinput pengajar. Tanda — berarti tidak diisi atau tidak relevan untuk jenis pembelajaran tersebut.</div></div></div><div class="waliTableWrap"><table><tr><th>Tanggal</th><th>Jenis Pembelajaran</th><th>Surah</th><th>Ayat</th><th>Juz</th><th>Halaman</th><th>Nilai</th><th>Predikat</th><th>Catatan Evaluasi</th></tr>${dailyRows}</table></div></div>
    ${attendanceCard}
    ${hasPrayerRecords?`<div class="card"><div class="waliSectionTitle"><div><h3 style="margin:0">🤲 Capaian Hafalan Doa</h3><div class="muted">Satu ceklis = satu doa tuntas, bukan jumlah hari.</div></div><span class="badge">${prayerTotal} / ${DOA.length} Tuntas</span></div><div class="waliDoaGrid" style="margin-top:10px">${doaItems}</div></div>`:''}
    <div class="card"><div class="waliSectionTitle"><div><h3 style="margin:0">📅 Ringkasan 7 Hari Terakhir</h3><div class="muted">Ringkasan aktivitas belajar berdasarkan data yang tersimpan.</div></div></div>${(()=>{const now=new Date(),st=new Date(now);st.setDate(st.getDate()-6);const a=rows.filter(x=>String(x.date)>=st.toISOString().slice(0,10)&&String(x.date)<=now.toISOString().slice(0,10));const ds=new Set(a.map(x=>String(x.date)));const av=a.length?a.reduce((u,v)=>u+Number(v.nilai||0),0)/a.length:0;return `<div class="dashMiniGrid"><div class="dashMini"><div class="dashMiniTitle">Pertemuan</div><div class="dashMiniValue">${ds.size}</div></div><div class="dashMini"><div class="dashMiniTitle">Rata-rata</div><div class="dashMiniValue">${a.length?av.toFixed(1):'-'}</div></div><div class="dashMini"><div class="dashMiniTitle">Predikat</div><div class="dashMiniValue" style="font-size:20px">${a.length?esc(grade(av)):'-'}</div></div></div>`})()}</div>
`;
  // Sisipkan riwayat adab pada portal orang tua tanpa menampilkan catatan anak lain.
  const adabRows=adabNotesCloud.filter(n=>String(n.student_id)===String(s.id)).slice().sort((a,b)=>String(b.tanggal||'').localeCompare(String(a.tanggal||'')));
  const adabCard=document.createElement('div');adabCard.className='card';adabCard.id='waliAdabNotesCard';
  adabCard.innerHTML='<div class="waliSectionTitle"><div><h3 style="margin:0">🌿 Catatan Adab & Nasihat Guru</h3><div class="muted">Catatan adab ananda selama belajar dan nasihat yang disampaikan pengajar.</div></div></div>'+(adabRows.length?'<div class="adabTimeline">'+adabRows.map(n=>`<article style="padding:12px 0;border-bottom:1px solid var(--border,#e5e7eb)"><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><b>${esc(fmt(n.tanggal))}</b><span class="badge">${esc(n.kategori||'Adab umum')}</span><span class="badge">${esc(n.kondisi||'')}</span></div><p style="margin:8px 0"><b>Catatan pengajar:</b><br>${esc(n.catatan||'Tidak ada catatan tambahan.')}</p><p style="margin:8px 0"><b>Nasihat guru:</b><br>${esc(n.nasihat||'Tidak ada nasihat tertulis.')}</p><small class="muted">${n.nasihat_disampaikan?'✓ Nasihat telah disampaikan langsung kepada ananda.':'Nasihat belum ditandai telah disampaikan.'}</small></article>`).join('')+'</div>':'<p class="muted">Belum ada catatan adab. Catatan akan tampil di sini setelah pengajar menyimpannya.</p>');
  const portal=document.getElementById('waliPortalData');const existing=document.getElementById('waliAdabNotesCard');if(existing)existing.remove();portal?.appendChild(adabCard);
}

function buildWaliProgressChart(rows){
  if(!rows.length)return '<div class="chartEmpty">Belum ada nilai pembelajaran untuk dibuat grafik.<br>Grafik akan muncul setelah nilai pembelajaran dicatat.</div>';
  const data=rows.map((x,i)=>({date:x.date,value:Math.max(0,Math.min(100,Number(x.nilai)||0)),label:x.jenis||'Pembelajaran'}));
  const W=900,H=250,L=48,R=20,T=20,B=42,innerW=W-L-R,innerH=H-T-B;
  const max=100,min=0;
  const px=i=>L+(data.length===1?innerW/2:(i/(data.length-1))*innerW);
  const py=v=>T+(max-v)/(max-min)*innerH;
  const pts=data.map((d,i)=>`${px(i).toFixed(1)},${py(d.value).toFixed(1)}`);
  const area=`${L},${T+innerH} ${pts.join(' ')} ${L+innerW},${T+innerH}`;
  const grid=[0,25,50,75,100].map(v=>{const y=py(v);return `<line class="chartGrid" x1="${L}" y1="${y}" x2="${L+innerW}" y2="${y}"/><text class="chartText" x="${L-8}" y="${y+4}" text-anchor="end">${v}</text>`}).join('');
  const maxLabels=Math.min(data.length,8);
  const labels=data.filter((_,i)=>data.length<=8||i===0||i===data.length-1||i%Math.ceil(data.length/7)===0).map((d)=>{const i=data.indexOf(d),x=px(i);return `<text class="chartText" x="${x}" y="${H-14}" text-anchor="middle">${fmt(d.date)}</text>`}).join('');
  const dots=data.map((d,i)=>`<circle class="chartDot" cx="${px(i)}" cy="${py(d.value)}" r="4"><title>${fmt(d.date)} — ${d.value.toFixed(1)} — ${esc(d.label)}</title></circle>`).join('');
  const last=data[data.length-1], first=data[0];
  const change=data.length>1?last.value-first.value:0;
  const changeText=data.length>1?(change>0?'Naik ':change<0?'Turun ':'Tetap ')+Math.abs(change).toFixed(1)+' poin':'Satu sesi tercatat';
  return `<div class="chartWrap"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Grafik pencapaian nilai santri">${grid}<polygon class="chartArea" points="${area}"/><polyline class="chartLine" points="${pts.join(' ')}"/>${dots}${labels}</svg></div><div class="progressLegend"><span>Nilai awal: <b>${first.value.toFixed(1)}</b></span><span>Nilai terbaru: <b>${last.value.toFixed(1)}</b></span><span>${esc(changeText)}</span></div>`;
}

function openWaliPresensi(){
  if(!isWali())return;
  showPage('waliPortal',document.getElementById('navPortalWali'));
  renderWaliPortal();
  setTimeout(()=>{
    const target=document.getElementById('waliAttendanceCard');
    if(!target)return;
    const header=document.querySelector('header');
    const headerHeight=header?.getBoundingClientRect().height||0;
    const top=window.scrollY+target.getBoundingClientRect().top-headerHeight-10;
    window.scrollTo({top:Math.max(0,top),behavior:'smooth'});
  },220);
}

function openWaliPerkembangan(){
  if(!isWali())return;
  showPage('waliPortal',document.getElementById('navPortalWali'));
  renderWaliPortal();
  setTimeout(()=>{
    const target=document.getElementById('waliPerkembanganCard');
    if(!target)return;
    const header=document.querySelector('header');
    const offset=(header?.getBoundingClientRect().height||0)+12;
    const top=window.scrollY+target.getBoundingClientRect().top-offset;
    window.scrollTo({top:Math.max(0,top),behavior:'smooth'});
  },120);
}
function openWaliReport(){
  if(!isWali())return;
  const btn=document.getElementById('navRaport');
  showPage('raport',btn);
  ensureWaliSelection();
  renderReport();
}
async function save(){
  if(!currentUser||!isAdmin())return;
  const students=db.santri.map(s=>({id:s.id||crypto.randomUUID(),nama:s.nama,tempat_lahir:s.tempat_lahir||'',tanggal_lahir:s.tanggal_lahir||null,alamat:s.alamat||'',walisantri:s.wali||'',wali_email_login:s.wali_email_login||null,wali_user_id:(s.wali_user_id||s.waliUser)||null,kelas:s.level||'',pengajar:s.pengajar||'',jenis_kelamin:s.jenis_kelamin||'',aktif:true}));
  if(students.length){const {error}=await supabaseClient.from('students').upsert(students);if(error){console.error(error);alert('Gagal menyimpan data santri: '+error.message);return}}
  const sessions=db.sessions.map(x=>({id:x.id,student_id:x.santriId,tanggal:x.date,kelas:x.kelas,jenis_pembelajaran:x.jenis,fields:x.fields||{},scores:x.scores||[],nilai:Number(x.nilai||0),predikat:x.predikat||grade(x.nilai),rubric_scores:x.rubricScores||[],catatan:x.catatan||'',created_by:currentUser.id}));
  if(sessions.length){const {error}=await supabaseClient.from('learning_sessions').upsert(sessions);if(error){console.error(error);alert('Gagal menyimpan sesi: '+error.message);return}}
  const prayers=[];Object.keys(db.doa||{}).forEach(k=>{if(k.endsWith('_note'))return;const parts=k.split('_');const idx=parts.pop(),date=parts.pop(),student_id=parts.join('_');const doaName=DOA[Number(idx)]||idx;if(db.doa[k]||db.doa[k+'_note'])prayers.push({student_id,tanggal:date,doa:doaName,tercapai:!!db.doa[k],catatan:db.doa[k+'_note']||null,created_by:currentUser.id});});
  for(const prayer of prayers){const q=await supabaseClient.from('prayer_records').select('id').eq('student_id',prayer.student_id).eq('tanggal',prayer.tanggal).eq('doa',prayer.doa).maybeSingle();if(q.error){console.error(q.error);continue}let res=q.data?await supabaseClient.from('prayer_records').update({tercapai:prayer.tercapai,catatan:prayer.catatan,updated_at:new Date().toISOString()}).eq('id',q.data.id):await supabaseClient.from('prayer_records').insert(prayer);if(res.error)console.error(res.error)}
}
function esc(x){return String(x??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function grade(n){n=Number(n)||0;if(n>=90)return'Mumtaz (A)';if(n>=80)return'Jayyid Jiddan (B)';if(n>=70)return'Jayyid (C)';if(n>=60)return'Maqbul (D)';return'Belum Tuntas'}
const LETTER_VALUES={A:95,B:85,C:75,D:60};
function letterFromValue(n){n=Number(n)||0;return n>=90?'A':n>=80?'B':n>=70?'C':n>=60?'D':'D';}
function letterDescription(l){return ({A:'Sangat Baik',B:'Baik',C:'Berkembang / Perlu Bimbingan',D:'Perlu Pembinaan Lebih Lanjut'})[l]||'';}
function isLetterAssessment(x){return !!(x&&TYPES?.[x.kelas]?.[x.jenis]?.special==='letter_rubric');}
function visibleSessionValue(x){return isLetterAssessment(x)?(x.predikat&&/^[ABCD]$/.test(x.predikat)?x.predikat:letterFromValue(x.nilai)):Number(x.nilai||0).toFixed(1);}
function visibleSessionPredikat(x){return isLetterAssessment(x)?letterDescription(x.predikat&&/^[ABCD]$/.test(x.predikat)?x.predikat:letterFromValue(x.nilai)):(x.predikat||grade(x.nilai));}
function fmt(d){if(!d)return'-';let p=String(d).split('-');if(p.length!==3)return d;let dt=new Date(Number(p[0]),Number(p[1])-1,Number(p[2]));if(Number.isNaN(dt.getTime()))return d;const hari=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];const bulan=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];return hari[dt.getDay()]+', '+dt.getDate()+' '+bulan[dt.getMonth()]+' '+dt.getFullYear()}
function fmtTTL(d){
 if(!d)return'-';
 const raw=String(d).trim();
 const m=raw.match(/^(.*?)[,\s]+(\d{4})-(\d{1,2})-(\d{1,2})$/);
 if(m){const bulan=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];return m[1].trim()+', '+String(Number(m[4])).padStart(2,'0')+' '+bulan[Number(m[3])-1]+' '+m[2];}
 const p=raw.split('-');
 if(p.length===3){const y=Number(p[0]),mo=Number(p[1]),day=Number(p[2]);if(y>0&&mo>0&&day>0){const bulan=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];return String(day).padStart(2,'0')+' '+bulan[mo-1]+' '+y;}}
 return raw;
}
function tanggalBerikutnyaUntukHari(hari){const nama=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];const target=nama.indexOf(String(hari||''));if(target<0)return '-';const now=new Date();now.setHours(0,0,0,0);const diff=(target-now.getDay()+7)%7;const d=new Date(now);d.setDate(now.getDate()+diff);return fmt(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'))}
function updateStickyHeaderHeight(){
  const header=document.querySelector('header');
  if(!header)return;
  document.documentElement.style.setProperty('--header-h',(header.getBoundingClientRect().height||0)+'px');
}
function scrollToPageTarget(targetId, delay=180){
  setTimeout(()=>{
    updateStickyHeaderHeight();
    const target=document.getElementById(targetId);
    if(!target)return;
    const header=document.querySelector('header');
    const nav=document.getElementById('mainNav');
    const headerHeight=header?.getBoundingClientRect().height||0;
    const navHeight=nav?.getBoundingClientRect().height||0;
    const offset=Math.max(0,headerHeight+navHeight+90);
    const top=window.scrollY+target.getBoundingClientRect().top-offset;
    window.scrollTo({top:Math.max(0,top),behavior:'smooth'});
  },delay);
}
function openPresensiAtTarget(btn){
  showPage('presensi',btn||document.getElementById('navPresensi'));
  scrollToPageTarget('presensiTitle',180);
}
function showPage(id,btn,options={}){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));const page=document.getElementById(id);if(!page)return;page.classList.add('active');document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));if(btn)btn.classList.add('active');if(options.persist!==false)saveLastPage(id);if(id==='jadwal'){setTimeout(()=>{fillJadwalSantri();ensureJadwalTimePickers();},0)}refresh();if(id==='manajemenAkun'&&isAdmin())setTimeout(()=>loadAccountManagementData().catch(e=>{console.error('Account management load:',e);const el=document.getElementById('accountStatusList');if(el)el.innerHTML='<div class="notice warning">Gagal memuat Manajemen Akun: '+esc(e?.message||e)+'</div>'}),0)}
async function saveSantri(){
  if(!isAdmin())return alert('Hanya Admin yang dapat mengubah data santri.');
  const btn=document.getElementById('santriSaveBtn');
  const oldText=btn.textContent;
  const isEdit=!!editSantriId;
  const id=editSantriId||makeUUID();
  const row={
    id,
    nama:snama.value.trim(),
    tempat_lahir:(document.getElementById('stempatLahir')?.value||'').trim(),
    tanggal_lahir:document.getElementById('stanggalLahir')?.value||null,
    jenis_kelamin:document.getElementById('sGender')?.value||'',
    alamat:salamat.value.trim(),
    walisantri:swali.value.trim(),
    wali_user_id:isEdit ? (db.santri.find(x=>String(x.id)===String(id))?.wali_user_id||null) : null,
    kelas:slevel.value,
    pengajar:(db.teachers||[]).find(t=>String(t.id)===String(spengajar.value))?.nama_lengkap||'',
    teacher_id:spengajar.value||null,
    aktif:true
  };
  if(!row.nama)return alert('Nama wajib diisi');
  btn.disabled=true;btn.textContent=isEdit?'⏳ Menyimpan perubahan...':'⏳ Menyimpan santri...';
  try{
    const {data,error}=await supabaseClient.from('students').upsert(row,{onConflict:'id'}).select().single();
    if(error)throw error;
    const x=data||row;
    const mapped={id:x.id,nama:x.nama,ttl:[x.tempat_lahir,x.tanggal_lahir].filter(Boolean).join(', '),jenis_kelamin:x.jenis_kelamin||'',tempat_lahir:x.tempat_lahir||'',tanggal_lahir:x.tanggal_lahir||'',alamat:x.alamat||'',wali:x.walisantri||'',wali_user_id:x.wali_user_id||'',waliUser:x.wali_user_id||'',wali_email_login:x.wali_email_login||'',waliPin:'',level:x.kelas||'',pengajar:x.pengajar||'',teacher_id:x.teacher_id||''};
    const idx=db.santri.findIndex(s=>String(s.id)===String(id));
    if(idx>=0)db.santri[idx]=mapped;else db.santri.push(mapped);
    editSantriId=null;
    document.getElementById('santriForm').reset();
    btn.textContent='+ Tambah Santri';
    fillTeachers();renderSantri();fill('pSantri');fill('rSantri');fill('dSantri');
    toast(isEdit?'Data santri berhasil diperbarui.':'Data santri berhasil disimpan.','success');
  }catch(e){
    console.error('saveSantri:',e);
    toast('Gagal menyimpan santri: '+(e?.message||e||'Kesalahan tidak diketahui'),'error',6000);
  }finally{btn.disabled=false;if(!editSantriId)btn.textContent='+ Tambah Santri';else btn.textContent=oldText;}
}
function editSantri(id){let x=db.santri.find(s=>String(s.id)===String(id));if(!x)return;editSantriId=id;snama.value=x.nama||'';document.getElementById('sGender').value=x.jenis_kelamin||'';document.getElementById('stempatLahir').value=x.tempat_lahir||'';document.getElementById('stanggalLahir').value=x.tanggal_lahir||'';salamat.value=x.alamat||'';swali.value=x.wali||'';slevel.value=x.level||'';fillTeachers();const teacherId=x.teacher_id||((db.teachers||[]).find(t=>String(t.nama_lengkap||'').trim().toLowerCase()===String(x.pengajar||'').trim().toLowerCase())?.id||'');spengajar.value=teacherId||'';document.getElementById('santriSaveBtn').textContent='💾 Simpan Perubahan';showPage('santri',document.querySelector('nav button:nth-child(2)'))}
function cancelSantriEdit(){editSantriId=null;document.getElementById('santriForm').reset();document.getElementById('santriSaveBtn').textContent='+ Tambah Santri'}
async function delSantri(id){if(confirm('Hapus santri dan seluruh sesi pembelajarannya?')){const a=await supabaseClient.from('learning_sessions').delete().eq('student_id',id);if(a.error)return alert('Gagal menghapus sesi: '+a.error.message);const b=await supabaseClient.from('prayer_records').delete().eq('student_id',id);if(b.error)return alert('Gagal menghapus doa: '+b.error.message);const c=await supabaseClient.from('students').delete().eq('id',id);if(c.error)return alert('Gagal menghapus santri: '+c.error.message);db.santri=db.santri.filter(x=>String(x.id)!==String(id));db.sessions=db.sessions.filter(x=>String(x.santriId)!==String(id));Object.keys(db.doa).filter(k=>k.startsWith(String(id)+'_')).forEach(k=>delete db.doa[k]);refresh()}}
function fill(id){let el=document.getElementById(id),old=el.value;el.innerHTML='<option value="">Pilih santri</option>';visibleStudents().forEach(s=>{let o=document.createElement('option');o.value=s.id;o.textContent=s.nama;el.appendChild(o)});if([...el.options].some(o=>o.value===old))el.value=old}
function syncClass(){let s=visibleStudents().find(x=>String(x.id)===String(pSantri.value));if(!s){pKelas.value='';populateJenis();return}pKelas.value=s.level;populateJenis()}
function populateJenis(){pJenis.innerHTML='';Object.keys(TYPES[pKelas.value]||{}).forEach(t=>{let o=document.createElement('option');o.value=t;o.textContent=t;pJenis.appendChild(o)});buildLearningForm()}
function renderLastLearning(){
  const box=document.getElementById('lastLearningCard');
  if(!box)return;
  const sid=document.getElementById('pSantri')?.value||'';
  const jenis=document.getElementById('pJenis')?.value||'';
  if(!sid||!jenis){box.style.display='none';box.innerHTML='';return;}
  const rows=(db.sessions||[]).filter(x=>String(x.santriId)===String(sid)&&String(x.jenis||'')===String(jenis)).sort((a,b)=>String(b.date||'').localeCompare(String(a.date||'')));
  if(!rows.length){
    box.style.display='block';
    box.innerHTML='<h3 style="margin:0 0 6px">📖 Riwayat Belajar Terakhir</h3><p class="muted" style="margin:0">Belum ada riwayat untuk jenis pembelajaran ini. Ini akan menjadi sesi pertama.</p>';
    return;
  }
  const x=rows[0], fields=x.fields||{};
  const data=Object.entries(fields).filter(([k,v])=>String(v??'').trim()!=='').map(([k,v])=>`<span style="display:inline-block;margin:3px 6px 3px 0;padding:5px 8px;border-radius:8px;background:#f4f7f5"><b>${esc(LABEL[k]||k)}:</b> ${esc(v)}</span>`).join('');
  let next='';
  const rawPage=fields.halaman;
  if(rawPage!=null&&String(rawPage).trim()!==''){
    const m=String(rawPage).match(/^(\d+)$/);
    if(m) next=`<div style="margin-top:8px"><b>➡️ Acuan halaman berikutnya:</b> ${Number(m[1])+1} <span class="muted">(silakan sesuaikan jika perlu)</span></div>`;
  }
  box.style.display='block';
  box.innerHTML=`<h3 style="margin:0 0 6px">📖 Riwayat Belajar Terakhir</h3><div class="muted" style="margin-bottom:7px">${fmt(x.date)} • ${esc(x.jenis)}</div><div>${data||'<span class="muted">Tidak ada detail halaman/materi tersimpan.</span>'}</div><div style="margin-top:7px"><b>Nilai:</b> ${esc(visibleSessionValue(x))} — ${esc(visibleSessionPredikat(x))}</div>${x.catatan?`<div style="margin-top:5px"><b>Catatan:</b> ${esc(x.catatan)}</div>`:''}${next}`;
}
function renderLearningHistory(){
  // Panel Rekam Jejak Belajar sengaja tidak ditampilkan.
  // Riwayat yang diperlukan sudah tersedia pada kartu Riwayat Belajar Terakhir.
  const box=document.getElementById('learningHistoryCard');
  if(box){box.style.display='none';box.innerHTML='';}
}
