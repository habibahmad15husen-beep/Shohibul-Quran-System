{name:'Al-Fatihah',ayahs:7,pages:[1,1]},{name:'Al-Baqarah',ayahs:286,pages:[2,49]},{name:"Ali 'Imran",ayahs:200,pages:[50,76]},{name:"An-Nisa'",ayahs:176,pages:[77,106]},{name:"Al-Ma'idah",ayahs:120,pages:[106,127]},{name:"Al-An'am",ayahs:165,pages:[128,150]},{name:"Al-A'raf",ayahs:206,pages:[151,176]},{name:'Al-Anfal',ayahs:75,pages:[177,186]},{name:'At-Taubah',ayahs:129,pages:[187,207]},{name:'Yunus',ayahs:109,pages:[208,221]},{name:'Hud',ayahs:123,pages:[221,235]},{name:'Yusuf',ayahs:111,pages:[235,248]},{name:"Ar-Ra'd",ayahs:43,pages:[249,255]},{name:'Ibrahim',ayahs:52,pages:[255,261]},{name:'Al-Hijr',ayahs:99,pages:[262,267]},{name:'An-Nahl',ayahs:128,pages:[267,281]},{name:"Al-Isra'",ayahs:111,pages:[282,293]},{name:'Al-Kahfi',ayahs:110,pages:[293,304]},{name:'Maryam',ayahs:98,pages:[305,312]},{name:'Taha',ayahs:135,pages:[312,321]},{name:"Al-Anbiya'",ayahs:112,pages:[322,331]},{name:'Al-Hajj',ayahs:78,pages:[332,341]},{name:"Al-Mu'minun",ayahs:118,pages:[342,349]},{name:'An-Nur',ayahs:64,pages:[350,359]},{name:'Al-Furqan',ayahs:77,pages:[359,366]},{name:"Asy-Syu'ara'",ayahs:227,pages:[367,376]},{name:'An-Naml',ayahs:93,pages:[377,385]},{name:'Al-Qasas',ayahs:88,pages:[385,396]},{name:"Al-'Ankabut",ayahs:69,pages:[396,404]},{name:'Ar-Rum',ayahs:60,pages:[404,410]},{name:'Luqman',ayahs:34,pages:[411,414]},{name:'As-Sajdah',ayahs:30,pages:[415,417]},{name:'Al-Ahzab',ayahs:73,pages:[418,427]},{name:'Saba',ayahs:54,pages:[428,434]},{name:'Fatir',ayahs:45,pages:[434,440]},{name:'Yasin',ayahs:83,pages:[440,445]},{name:'As-Saffat',ayahs:182,pages:[446,452]},{name:'Sad',ayahs:88,pages:[453,458]},{name:'Az-Zumar',ayahs:75,pages:[458,467]},{name:'Ghafir',ayahs:85,pages:[467,476]},{name:'Fussilat',ayahs:54,pages:[477,482]},{name:'Asy-Syura',ayahs:53,pages:[483,489]},{name:'Az-Zukhruf',ayahs:89,pages:[489,495]},{name:'Ad-Dukhan',ayahs:59,pages:[496,498]},{name:'Al-Jatsiyah',ayahs:37,pages:[499,502]},{name:'Al-Ahqaf',ayahs:35,pages:[502,506]},{name:'Muhammad',ayahs:38,pages:[507,510]},{name:'Al-Fath',ayahs:29,pages:[511,515]},{name:'Al-Hujurat',ayahs:18,pages:[515,517]},{name:'Qaf',ayahs:45,pages:[518,520]},{name:'Az-Zariyat',ayahs:60,pages:[520,523]},{name:'At-Tur',ayahs:49,pages:[523,525]},{name:'An-Najm',ayahs:62,pages:[526,528]},{name:'Al-Qamar',ayahs:55,pages:[528,531]},{name:'Ar-Rahman',ayahs:78,pages:[531,534]},{name:"Al-Waqi'ah",ayahs:96,pages:[534,537]},{name:'Al-Hadid',ayahs:29,pages:[537,541]},{name:'Al-Mujadilah',ayahs:22,pages:[542,545]},{name:'Al-Hasyr',ayahs:24,pages:[545,548]},{name:'Al-Mumtahanah',ayahs:13,pages:[549,551]},{name:'As-Saff',ayahs:14,pages:[551,552]},{name:"Al-Jumu'ah",ayahs:11,pages:[553,553]},{name:'Al-Munafiqun',ayahs:11,pages:[554,554]},{name:'At-Taghabun',ayahs:18,pages:[556,556]},{name:'At-Talaq',ayahs:12,pages:[558,558]},{name:'At-Tahrim',ayahs:12,pages:[560,560]},{name:'Al-Mulk',ayahs:30,pages:[562,562]},{name:'Al-Qalam',ayahs:52,pages:[564,564]},{name:'Al-Haqqah',ayahs:52,pages:[566,566]},{name:'Al-Ma’arij',ayahs:44,pages:[568,568]},{name:'Nuh',ayahs:28,pages:[570,570]},{name:'Al-Jinn',ayahs:28,pages:[572,572]},{name:'Al-Muzzammil',ayahs:20,pages:[574,574]},{name:'Al-Muddassir',ayahs:56,pages:[575,575]},{name:'Al-Qiyamah',ayahs:40,pages:[577,577]},{name:'Al-Insan',ayahs:31,pages:[578,578]},{name:'Al-Mursalat',ayahs:50,pages:[580,580]},{name:"An-Naba'",ayahs:40,pages:[582,582]},{name:"An-Nazi'at",ayahs:46,pages:[583,583]},{name:"'Abasa",ayahs:42,pages:[585,585]},{name:'At-Takwir',ayahs:29,pages:[586,586]},{name:'Al-Infitar',ayahs:19,pages:[587,587]},{name:'Al-Mutaffifin',ayahs:36,pages:[587,587]},{name:'Al-Insyiqaq',ayahs:25,pages:[589,589]},{name:'Al-Buruj',ayahs:22,pages:[590,590]},{name:'At-Tariq',ayahs:17,pages:[591,591]},{name:"Al-A'la",ayahs:19,pages:[591,591]},{name:'Al-Ghasyiyah',ayahs:26,pages:[592,592]},{name:'Al-Fajr',ayahs:30,pages:[593,593]},{name:'Al-Balad',ayahs:20,pages:[594,594]},{name:'Asy-Syams',ayahs:15,pages:[595,595]},{name:'Al-Lail',ayahs:21,pages:[595,595]},{name:'Ad-Duha',ayahs:11,pages:[596,596]},{name:'Asy-Syarh',ayahs:8,pages:[596,596]},{name:'At-Tin',ayahs:8,pages:[597,597]},{name:"Al-'Alaq",ayahs:19,pages:[597,597]},{name:'Al-Qadr',ayahs:5,pages:[598,598]},{name:'Al-Bayyinah',ayahs:8,pages:[598,598]},{name:'Az-Zalzalah',ayahs:8,pages:[599,599]},{name:"Al-'Adiyat",ayahs:11,pages:[599,599]},{name:"Al-Qari'ah",ayahs:11,pages:[600,600]},{name:'At-Takasur',ayahs:8,pages:[600,600]},{name:"Al-'Asr",ayahs:3,pages:[601,601]},{name:'Al-Humazah',ayahs:9,pages:[601,601]},{name:'Al-Fil',ayahs:5,pages:[601,601]},{name:'Quraisy',ayahs:4,pages:[602,602]},{name:"Al-Ma'un",ayahs:7,pages:[602,602]},{name:'Al-Kausar',ayahs:3,pages:[602,602]},{name:'Al-Kafirun',ayahs:6,pages:[603,603]},{name:'An-Nasr',ayahs:3,pages:[603,603]},{name:'Al-Lahab',ayahs:5,pages:[603,603]},{name:'Al-Ikhlas',ayahs:4,pages:[604,604]},{name:'Al-Falaq',ayahs:5,pages:[604,604]},{name:'An-Nas',ayahs:6,pages:[604,604]}];
const JUZ_RANGES=[
[1,1,1,2,141],[2,2,142,2,252],[3,2,253,3,92],[4,3,93,4,23],[5,4,24,4,147],
[6,4,148,5,81],[7,5,82,6,110],[8,6,111,7,87],[9,7,88,8,40],[10,8,41,9,92],
[11,9,93,11,5],[12,11,6,12,52],[13,12,53,14,52],[14,15,1,16,128],[15,17,1,18,74],
[16,18,75,20,135],[17,21,1,22,78],[18,23,1,25,20],[19,25,21,27,55],[20,27,56,29,45],
[21,29,46,33,30],[22,33,31,36,27],[23,36,28,39,31],[24,39,32,41,46],[25,41,47,45,37],
[26,46,1,51,30],[27,51,31,57,29],[28,58,1,66,12],[29,67,1,77,50],[30,78,1,114,6]];
function getJuzRange(juz){const r=JUZ_RANGES.find(x=>x[0]===Number(juz));return r?{startSurah:r[1],startAyah:r[2],endSurah:r[3],endAyah:r[4]}:null;}
function updateQuranSurahOptions(){const juz=document.getElementById('f_juz'),sel=document.getElementById('f_surah');if(!juz||!sel)return;const range=getJuzRange(juz.value);const previous=sel.value;const allowed=QURAN_SURAHS.filter(s=>{const i=QURAN_SURAHS.indexOf(s)+1;return range&&i>=range.startSurah&&i<=range.endSurah;});sel.innerHTML='<option value="">Pilih surah dalam Juz '+juz.value+'</option>'+allowed.map(s=>{const i=QURAN_SURAHS.indexOf(s)+1;return `<option value="${s.name}">${i}. ${s.name}</option>`}).join('');if(allowed.some(s=>s.name===previous))sel.value=previous;else sel.value='';const page=document.getElementById('f_halaman'),a=document.getElementById('f_ayat_awal'),b=document.getElementById('f_ayat_akhir'),hidden=document.getElementById('f_ayat'),hint=document.getElementById('quranPageRangeHint');if(page){page.innerHTML='<option value="">Pilih surah dahulu</option>';page.disabled=true;}if(a)a.innerHTML='<option value="">Pilih surah dahulu</option>';if(b)b.innerHTML='<option value="">Pilih surah dahulu</option>';if(hidden)hidden.value='';if(hint)hint.textContent='Pilih surah untuk menampilkan rentang halaman Mushaf Madinah.';if(sel.value)updateQuranAyatOptions();}
function updateQuranAyatOptions(){const sel=document.getElementById('f_surah'),item=QURAN_SURAHS.find(x=>x.name===sel?.value),a=document.getElementById('f_ayat_awal'),b=document.getElementById('f_ayat_akhir'),page=document.getElementById('f_halaman');if(!item)return;if(a&&b){const opts=Array.from({length:item.ayahs},(_,i)=>`<option value="${i+1}">${i+1}</option>`).join('');a.innerHTML=opts;b.innerHTML=opts;a.value='1';b.value=String(Math.min(15,item.ayahs));syncAyatRange();}if(page){const start=item.pages[0],end=item.pages[1];page.disabled=false;page.innerHTML=Array.from({length:end-start+1},(_,i)=>{const n=start+i;return `<option value="${n}">Halaman ${n}</option>`}).join('');page.value=String(start);const hint=document.getElementById('quranPageRangeHint');if(hint)hint.textContent=`Rentang halaman surah ini pada Mushaf Madinah: ${start}${end!==start?'–'+end:''}.`;}}
function syncAyatRange(){const a=document.getElementById('f_ayat_awal'),b=document.getElementById('f_ayat_akhir'),hidden=document.getElementById('f_ayat');if(!a||!b||!hidden)return;let av=Number(a.value||1),bv=Number(b.value||av);if(bv<av){b.value=String(av);bv=av;}hidden.value=`${av}-${bv}`;}
function buildLearningForm(){
  let cfg=(TYPES[pKelas.value]||{})[pJenis.value];
  if(!cfg)return;
  let h='';
  cfg.fields.forEach(f=>{
    if(pKelas.value==="Kelas Iqra'" && f==='jilid'){
      h+=`<label>Jilid<select id="f_jilid" required>${Array.from({length:6},(_,i)=>`<option value="${i+1}">Jilid ${i+1}</option>`).join('')}</select></label>`;
    }else if(pKelas.value==="Kelas Iqra'" && f==='halaman'){
      h+=`<label>Halaman<select id="f_halaman" required>${Array.from({length:30},(_,i)=>`<option value="${i+1}">Halaman ${i+1}</option>`).join('')}</select><span class="muted">Jika membaca beberapa halaman, isi rentang pada kolom tambahan.</span></label><label>Rentang halaman (opsional)<input id="f_halaman_rentang" placeholder="Contoh: 19–21"></label>`;
    }else if(f==='juz'){
      const juzHasSurahAyat=['Tahsin Qur\'an','Tahsin Intensif','Pra Hafalan Juz 30','Ziyadah',"Muroja'ah"].includes(pJenis.value);
      h+=`<label>Juz<select id="f_juz" required ${juzHasSurahAyat?'onchange="updateQuranSurahOptions()"':''}>${Array.from({length:30},(_,i)=>`<option value="${i+1}" ${pJenis.value==='Pra Hafalan Juz 30'&&i===29?'selected':''}>Juz ${i+1}</option>`).join('')}</select></label>`;
    }else if(['surah','halaman','ayat'].includes(f) && (["Tahsin Qur'an",'Tahsin Intensif','Pra Hafalan Juz 30','Ziyadah',"Muroja'ah"].includes(pJenis.value))){
      if(f==='surah')h+=`<label>Surah<select id="f_surah" required onchange="updateQuranAyatOptions()"><option value="">Pilih Juz dahulu</option></select></label>`;
      if(f==='halaman')h+=`<label>Halaman Mushaf Madinah<select id="f_halaman" required disabled><option value="">Pilih surah dahulu</option></select><span id="quranPageRangeHint" class="muted">Pilih Juz dan surah untuk menampilkan rentang halaman.</span></label><label>Rentang halaman manual (opsional)<input id="f_halaman_rentang" placeholder="Contoh: 250–252"><span class="muted">Isi jika santri membaca atau menyetorkan lebih dari satu halaman. Jika diisi, rentang ini yang disimpan.</span></label>`;
      if(f==='ayat')h+=`<div class="grid"><label>Dari ayat<select id="f_ayat_awal" onchange="syncAyatRange()"><option value="">Pilih surah dahulu</option></select></label><label>Sampai ayat<select id="f_ayat_akhir" onchange="syncAyatRange()"><option value="">Pilih surah dahulu</option></select></label></div><input id="f_ayat" type="hidden" value="">`;
    }else h+=`<label>${LABEL[f]}<input id="f_${f}" placeholder="${f==='juz'?'Contoh: 30':f==='surah'?"Pilih nama surah":f==='halaman'?'Pilih halaman':f==='ayat'?'Pilih rentang ayat':''}" required></label>`;
  });
  if(cfg.special==='tajwid_count'){
    h+=`<div class="scoreBox"><h3>Penilaian Praktik Tajwid Bil Lisany</h3><p class="muted" style="margin:4px 0 10px">Nilai otomatis = Hukum benar ÷ (Hukum benar + Hukum kurang tepat) × 100.</p><table><tr><th>Komponen</th><th>Jumlah</th></tr><tr><td>Penyebutan Hukum Yang benar</td><td><input id="benar" type="number" min="0" step="1" value="" placeholder="0" oninput="calc()"></td></tr><tr><td>Penyebutan Hukum Yang Kurang tepat</td><td><input id="kurang" type="number" min="0" step="1" value="" placeholder="0" oninput="calc()"></td></tr></table><div id="scoreValidation" class="muted" style="margin-top:8px"></div></div>`;
  }else if(cfg.special==='letter_rubric'){
    h+=`<div class="scoreBox"><h3>Penilaian Pendidikan Tauhid & Pembentukan Adab</h3><p class="muted">Pilih penilaian huruf untuk setiap komponen. Tidak menggunakan angka.</p><div class="scoreTableWrap"><table class="scoreTable"><thead><tr><th>Komponen</th><th>Penilaian</th></tr></thead><tbody>`;
    cfg.rubric.forEach((r,i)=>h+=`<tr><td>${esc(r[0])}</td><td><select class="letterScore" id="sc${i}" onchange="calc()"><option value="">Pilih huruf</option><option value="A">A — Sangat Baik</option><option value="B">B — Baik</option><option value="C">C — Berkembang / Perlu Bimbingan</option><option value="D">D — Perlu Pembinaan Lebih Lanjut</option></select></td></tr>`);
    h+=`</tbody></table></div><div id="scoreValidation" class="muted" style="margin-top:8px"></div></div>`;
  }else if(!cfg.rubric.length){
    h+=`<div class="scoreBox"><h3>Nilai Penilaian</h3><p class="muted" style="margin:4px 0 10px">Masukkan satu nilai akhir dari 0–100. Predikat akan dihitung otomatis.</p><input id="singleScore" type="number" min="0" max="100" step="0.1" value="" placeholder="0–100" oninput="calc()"><div id="scoreValidation" class="muted" style="margin-top:8px"></div></div>`;
  }else{
    const totalWeight=cfg.rubric.reduce((a,r)=>a+Number(r[1]||0),0);
    h+=`<div class="scoreBox"><h3>Lembar Penilaian</h3><p class="muted" style="margin:4px 0 10px">Masukkan nilai setiap komponen 0–100. Nilai akhir dihitung berdasarkan bobot.</p><div class="scoreTableWrap"><table class="scoreTable"><colgroup><col class="scoreColName"><col class="scoreColWeight"><col class="scoreColValue"></colgroup><thead><tr><th>Komponen</th><th>Bobot</th><th>Nilai 0–100</th></tr></thead><tbody>`;
    cfg.rubric.forEach((r,i)=>h+=`<tr><td>${esc(r[0])}</td><td class="scoreWeight">${r[1]}%</td><td><input class="score" id="sc${i}" type="number" min="0" max="100" step="0.1" value="" placeholder="0–100" data-w="${r[1]}"></td></tr>`);
    h+=`</tbody></table></div><div class="muted" style="margin-top:8px;font-size:12px">Total bobot: ${totalWeight}%</div><div id="scoreValidation" class="muted" style="margin-top:8px"></div></div>`;
  }
  h+=`<label>Nilai Akhir<input id="final" readonly></label><input id="numericFinal" type="hidden" value=""><label>Predikat<input id="pred" readonly></label><label style="grid-column:1/-1">Catatan Evaluasi<textarea id="note" placeholder="Tuliskan perkembangan, kelebihan, kesalahan, dan target berikutnya"></textarea></label>`;
  learningForm.innerHTML=h;
  if(document.getElementById('f_surah'))updateQuranSurahOptions();
  renderLastLearning();
  document.querySelectorAll('.score').forEach(x=>x.oninput=calc);
  calc();
}
function getScoreValidation(){
  const cfg=(TYPES[pKelas.value]||{})[pJenis.value];
  if(!cfg)return {ok:false,message:'Jenis pembelajaran tidak valid.'};
  if(cfg.special==='letter_rubric'){
    const missing=[...document.querySelectorAll('.letterScore')].some(x=>!x.value);
    if(missing)return {ok:false,message:'Pilih penilaian huruf untuk semua komponen.'};
  }else if(cfg.rubric?.length){
    const total=cfg.rubric.reduce((a,r)=>a+Number(r[1]||0),0);
    if(total!==100)return {ok:false,message:`Konfigurasi penilaian tidak valid. Total bobot saat ini ${total}%. Harus tepat 100%.`};
    const missing=[...document.querySelectorAll('.score')].some(x=>x.value.trim()==='');
    if(missing)return {ok:false,message:'Lengkapi semua komponen penilaian sebelum menyimpan.'};
    const bad=[...document.querySelectorAll('.score')].some(x=>!Number.isFinite(Number(x.value))||Number(x.value)<0||Number(x.value)>100);
    if(bad)return {ok:false,message:'Setiap nilai komponen harus berada di antara 0–100.'};
  }else if(cfg.special==='tajwid_count'){
    const b=document.getElementById('benar')?.value.trim()||'',k=document.getElementById('kurang')?.value.trim()||'';
    if(b===''||k==='')return {ok:false,message:'Isi jumlah hukum yang benar dan kurang tepat.'};
    if(!Number.isInteger(Number(b))||!Number.isInteger(Number(k))||Number(b)<0||Number(k)<0)return {ok:false,message:'Jumlah hukum harus berupa bilangan bulat 0 atau lebih.'};
    if(Number(b)+Number(k)===0)return {ok:false,message:'Jumlah hukum benar + kurang tepat harus lebih dari 0.'};
  }else{
    const v=document.getElementById('singleScore')?.value.trim()||'';
    if(v==='')return {ok:false,message:'Nilai akhir wajib diisi.'};
    if(!Number.isFinite(Number(v))||Number(v)<0||Number(v)>100)return {ok:false,message:'Nilai akhir harus berada di antara 0–100.'};
  }
  return {ok:true,message:''};
}
function calc(){
  let cfg=(TYPES[pKelas.value]||{})[pJenis.value],n=0,valid=true;
  if(cfg?.special==='letter_rubric'){
    const values=[...document.querySelectorAll('.letterScore')].map(x=>x.value);valid=values.length===cfg.rubric.length&&values.every(Boolean);n=valid?values.reduce((sum,l)=>sum+LETTER_VALUES[l],0)/values.length:0;
  }else if(cfg?.special==='tajwid_count'){
    const bs=document.getElementById('benar')?.value.trim()||'',ks=document.getElementById('kurang')?.value.trim()||'';
    const b=Number(bs),k=Number(ks);
    valid=bs!==''&&ks!==''&&Number.isInteger(b)&&Number.isInteger(k)&&b>=0&&k>=0&&(b+k)>0;
    n=valid?(b/(b+k))*100:0;
  }else if(!cfg?.rubric?.length){
    const vs=document.getElementById('singleScore')?.value.trim()||'',v=Number(vs);
    valid=vs!==''&&Number.isFinite(v)&&v>=0&&v<=100;
    n=valid?v:0;
  }else{
    const totalWeight=cfg.rubric.reduce((a,r)=>a+Number(r[1]||0),0);
    valid=totalWeight===100;
    document.querySelectorAll('.score').forEach(x=>{
      const raw=x.value.trim();
      if(raw===''){valid=false;return;}
      const v=Number(raw);if(!Number.isFinite(v)||v<0||v>100){valid=false;return} n+=v*Number(x.dataset.w||0)/100;
    });
  }
  const finalEl=document.getElementById('final'),predEl=document.getElementById('pred'),msg=document.getElementById('scoreValidation');
  if(finalEl){finalEl.value=valid?(cfg?.special==='letter_rubric'?letterFromValue(n):n.toFixed(1)):'';predEl.value=valid?(cfg?.special==='letter_rubric'?letterDescription(letterFromValue(n)):grade(n)):'';const nf=document.getElementById('numericFinal');if(nf)nf.value=valid?n.toFixed(1):'';}
  if(msg){const v=getScoreValidation();msg.textContent=v.ok?'✓ Penilaian lengkap dan siap disimpan.':'⚠️ '+v.message;msg.style.color=v.ok?'var(--g)':'#a51d1d';msg.style.fontWeight='700';}
  return n;
}
async function getActiveAuthUser(){
  try{
    const {data,error}=await supabaseClient.auth.getSession();
    if(error) throw error;
    if(data?.session?.user) return data.session.user;
    return null;
  }catch(e){
    console.error('getActiveAuthUser:',e);
    return null;
  }
}

function isFetchError(error){
  const m=String(error?.message||error||'').toLowerCase();
  return m.includes('failed to fetch') || m.includes('networkerror') || m.includes('fetch failed');
}

async function dbWriteWithRetry(operation,label){
  let lastError=null;
  for(let attempt=1;attempt<=2;attempt++){
    try{
      const result=await operation();
      if(!result?.error) return result;
      lastError=result.error;
      if(!isFetchError(lastError) || attempt===2) return result;
    }catch(e){
      lastError=e;
      if(!isFetchError(e) || attempt===2) return {data:null,error:e};
    }
    await new Promise(resolve=>setTimeout(resolve,800));
    try{ await supabaseClient.auth.getSession(); }catch(e){ console.warn(label+' session refresh check:',e); }
  }
  return {data:null,error:lastError};
}

async function saveSession(){
  if(!(isAdmin()||isPengajar()))return alert('Anda tidak memiliki hak untuk menginput nilai.');
  let sid=pSantri.value,cfg=(TYPES[pKelas.value]||{})[pJenis.value];
  if(!sid)return alert('Pilih santri terlebih dahulu.');
  if(!canManageStudent(sid))return alert('Santri ini tidak berada dalam daftar binaan Anda.');
  if(!cfg)return alert('Jenis pembelajaran tidak valid.');
  if(document.getElementById('f_ayat_awal')&&document.getElementById('f_ayat_akhir'))syncAyatRange();
  for(const f of cfg.fields){const el=document.getElementById('f_'+f);if(!el||el.value.trim()==='')return alert(`Field ${LABEL[f]} wajib diisi.`);}
  const validation=getScoreValidation();
  if(!validation.ok){calc();return alert(validation.message);}
  const date=pTanggal.value||today();
  if(!/^\d{4}-\d{2}-\d{2}$/.test(date))return alert('Tanggal pembelajaran tidak valid.');

  // Ambil sesi Auth Supabase yang benar-benar aktif sebelum menulis ke database.
  const authUser=await getActiveAuthUser();
  if(!authUser?.id){
    return alert('Sesi login Supabase tidak ditemukan. Silakan logout lalu login kembali.');
  }
  if(currentUser?.id && String(currentUser.id)!==String(authUser.id)){
    console.warn('ID currentUser berbeda dengan Auth user. Menggunakan Auth user sebagai sumber kebenaran.',currentUser.id,authUser.id);
  }
  const authUserId=authUser.id;

  let fields={};cfg.fields.forEach(f=>{const el=document.getElementById('f_'+f);fields[f]=el?el.value.trim():'';}); if(document.getElementById('f_halaman_rentang')?.value.trim())fields.halaman=document.getElementById('f_halaman_rentang').value.trim();
  let scores=[];
  if(cfg.special==='tajwid_count')scores=[Number(document.getElementById('benar').value),Number(document.getElementById('kurang').value)];
  else if(cfg.special==='letter_rubric')scores=[...document.querySelectorAll('.letterScore')].map(x=>x.value);
  else if(cfg.rubric.length)scores=[...document.querySelectorAll('.score')].map(x=>Number(x.value));
  else scores=[Number(document.getElementById('singleScore').value)];
  const finalValue=Number(document.getElementById('numericFinal')?.value||document.getElementById('final').value);
  const obj={id:editSessionId||makeUUID(),date,santriId:sid,kelas:pKelas.value,jenis:pJenis.value,fields,scores,nilai:finalValue,
    rubricScores:cfg.special==='tajwid_count'?[{komponen:'Penyebutan Hukum Yang benar',bobot:null,nilai:scores[0]},{komponen:'Penyebutan Hukum Yang Kurang tepat',bobot:null,nilai:scores[1]}]:cfg.rubric.map((r,i)=>({komponen:r[0],bobot:r[1]??(cfg.special==='letter_rubric'?50:null),nilai:scores[i]})),
    catatan:document.getElementById('note')?.value||''};
  const row={id:obj.id,student_id:obj.santriId,tanggal:obj.date,kelas:obj.kelas,jenis_pembelajaran:obj.jenis,fields:obj.fields,scores:obj.scores,nilai:obj.nilai,predikat:cfg.special==='letter_rubric'?letterFromValue(obj.nilai):grade(obj.nilai),rubric_scores:obj.rubricScores,catatan:obj.catatan,created_by:authUserId};

  const btn=document.getElementById('sessionSaveBtn');
  if(btn){btn.disabled=true;btn.setAttribute('aria-busy','true');btn.textContent=editSessionId?'⏳ Menyimpan perubahan ke database...':'⏳ Menyimpan ke database...';btn.style.opacity='.78';btn.style.cursor='wait';}
  let error=null;
  try{
    if(editSessionId){
      // UPDATE terpisah agar tidak memicu INSERT/RLS ketika mengedit data lama.
      const result=await dbWriteWithRetry(
        ()=>supabaseClient.from('learning_sessions').update({
          student_id:row.student_id,tanggal:row.tanggal,kelas:row.kelas,jenis_pembelajaran:row.jenis_pembelajaran,
          fields:row.fields,scores:row.scores,nilai:row.nilai,predikat:row.predikat,
          rubric_scores:row.rubric_scores,catatan:row.catatan,updated_at:new Date().toISOString()
        }).eq('id',row.id),
        'learning_sessions UPDATE'
      );
      error=result?.error||null;
    }else{
      const result=await dbWriteWithRetry(
        ()=>supabaseClient.from('learning_sessions').insert(row),
        'learning_sessions INSERT'
      );
      error=result?.error||null;
    }
  }finally{
    if(btn){btn.disabled=false;btn.removeAttribute('aria-busy');btn.textContent=editSessionId?'💾 Simpan Perubahan':'Simpan Sesi & Nilai';btn.style.opacity='';btn.style.cursor='';}
  }

  if(error){
    console.error('learning_sessions write error:',error);
    const msg=String(error.message||error);
    if(isFetchError(error)){
      return alert('Gagal terhubung ke Supabase. Pastikan koneksi internet aktif, lalu coba simpan kembali.\n\nJika koneksi normal tetapi tetap gagal, logout lalu login kembali.');
    }
    if(/row-level security|permission denied|violates/i.test(msg)){
      return alert((editSessionId?'Gagal memperbarui nilai: ':'Gagal menyimpan nilai: ')+msg+'\n\nPastikan akun Pengajar dan santri sudah terhubung.');
    }
    return alert((editSessionId?'Gagal memperbarui nilai: ':'Gagal menyimpan nilai: ')+msg);
  }

  // Verifikasi bahwa baris benar-benar sudah tersimpan di Supabase sebelum UI diperbarui.
  const verify=await supabaseClient.from('learning_sessions').select('id,student_id,tanggal,kelas,jenis_pembelajaran,nilai,predikat').eq('id',obj.id).maybeSingle();
  if(verify.error){
    console.error('learning_sessions verify error:',verify.error);
    return alert('Nilai sudah dikirim tetapi belum dapat diverifikasi dari database: '+verify.error.message+'\n\nSilakan cek koneksi lalu coba lagi.');
  }
  if(!verify.data){
    return alert('Perubahan belum benar-benar tersimpan di database. Kemungkinan policy UPDATE learning_sessions belum aktif untuk akun ini. Buka Pengaturan → Setup Hasil Pembelajaran, jalankan SQL terbaru, lalu coba Simpan Perubahan lagi.');
  }
  // Data sudah diverifikasi langsung di Supabase. Perbarui sesi lokal tanpa
  // memuat ulang seluruh tabel santri, sesi, doa, pengajar, presensi, dan status.
  // Ini mengurangi waktu tunggu setelah penyimpanan.
  const wasEditing=Boolean(editSessionId);
  const savedObj={...obj,created_by:authUserId};
  const i=db.sessions.findIndex(x=>String(x.id)===String(obj.id));
  if(i>=0)db.sessions[i]=savedObj;else db.sessions.unshift(savedObj);
  editSessionId=null; editSessionDraft=null;
  document.getElementById('editSessionNotice')?.remove();
  if(btn){btn.disabled=false;btn.removeAttribute('aria-busy');btn.textContent='Simpan Sesi & Nilai';btn.style.opacity='';btn.style.cursor='';}
  showSaveSuccess(wasEditing?'Perubahan sesi dan nilai berhasil disimpan ke database.':'Sesi pembelajaran dan nilai berhasil disimpan ke database.');
  refresh();
}
function restoreSessionEditForm(){
  const x=editSessionDraft;
  if(!x||String(editSessionId)!==String(x.id))return;
  // Pastikan selector santri sudah terisi sebelum memasukkan nilai lama.
  fill('pSantri');
  pTanggal.value=x.date||today();
  pSantri.value=String(x.santriId||'');
  pKelas.value=x.kelas||'';
  populateJenis();
  pJenis.value=x.jenis||'';
  buildLearningForm();
  Object.entries(x.fields||{}).forEach(([k,v])=>{const e=document.getElementById('f_'+k);if(e)e.value=v??'';});
  const cfg=(TYPES[x.kelas]||{})[x.jenis];
  const scores=Array.isArray(x.scores)?x.scores:[];
  if(cfg?.special==='tajwid_count'){
    const b=document.getElementById('benar'),k=document.getElementById('kurang');
    if(b)b.value=scores[0]??'';if(k)k.value=scores[1]??'';
  }else if(cfg?.special==='letter_rubric'){
    cfg.rubric.forEach((_,i)=>{const e=document.getElementById('sc'+i);if(e)e.value=scores[i]??x.rubricScores?.[i]?.nilai??'';});
  }else if(cfg?.rubric?.length){
    cfg.rubric.forEach((_,i)=>{const e=document.getElementById('sc'+i);if(e)e.value=scores[i]??'';});
  }else{
    const e=document.getElementById('singleScore');if(e)e.value=scores[0]??x.nilai??'';
  }
  const n=document.getElementById('note');if(n)n.value=x.catatan||'';
  // Untuk rekaman lama yang belum menyimpan scores sebagai array, gunakan nilai akhir tersimpan.
  if(!scores.length && Number.isFinite(Number(x.nilai))){
    const single=document.getElementById('singleScore');
    if(single)single.value=String(x.nilai);
  }
  calc();
  const title=document.querySelector('#pembelajaran h2, #pembelajaran h3');
  const card=document.getElementById('learningForm')?.closest('.card');
  if(card && !document.getElementById('editSessionNotice')){
    const notice=document.createElement('div'); notice.id='editSessionNotice'; notice.className='notice';
    notice.innerHTML='<b>✏️ Mode Edit Sesi</b><br><span class="muted">Semua data sesi lama sudah dimuat. Anda cukup mengubah bagian yang salah, misalnya Surah, Ayat, Halaman, atau Nilai.</span>';
    card.insertBefore(notice,document.getElementById('learningForm'));
  }
  const btn=document.getElementById('sessionSaveBtn');if(btn)btn.textContent='💾 Simpan Perubahan';
}
function editSession(id){
  const x=db.sessions.find(s=>String(s.id)===String(id));
  if(!x||!visibleStudents().some(st=>String(st.id)===String(x.santriId))||!canManageStudent(x.santriId))return alert('Sesi ini bukan milik santri binaan Anda.');
  // Hentikan konteks jadwal sebelumnya agar tidak menimpa data yang sedang diedit.
  activeScheduleContext=null;
  editSessionId=x.id;
  editSessionDraft=JSON.parse(JSON.stringify(x));
  showPage('pembelajaran',document.querySelector('nav button:nth-child(4)'));
  // showPage/refresh membangun ulang formulir; pulihkan data setelah proses itu selesai.
  setTimeout(()=>{
    if(String(editSessionId)!==String(x.id))return;
    restoreSessionEditForm();
    // Pengaman untuk perangkat lambat: pulihkan lagi jika form baru saja dirender ulang.
    setTimeout(()=>{if(String(editSessionId)===String(x.id))restoreSessionEditForm();},180);
  },60);
}
async function delSession(id){
  if(!isAdmin())return alert('Hanya Admin yang dapat menghapus sesi.');
  if(!confirm('Hapus sesi ini secara permanen?'))return;
  const rowBefore=db.sessions.find(x=>String(x.id)===String(id));
  try{
    // DELETE pada Supabase + RLS dapat mengembalikan 204 tanpa error walaupun tidak ada
    // baris yang benar-benar terhapus. Karena itu kita wajib verifikasi setelah DELETE.
    const result=await supabaseClient.from('learning_sessions').delete().eq('id',id).select('id').maybeSingle();
    if(result.error){
      console.error(result.error);
      return alert('Gagal menghapus sesi dari database: '+result.error.message+'\n\nJika muncul pesan RLS/permission, buka Pengaturan → Setup Hasil Pembelajaran dan jalankan SQL yang tersedia.');
    }
    const verify=await supabaseClient.from('learning_sessions').select('id').eq('id',id).maybeSingle();
    if(verify.error){
      console.error(verify.error);
      return alert('Penghapusan belum dapat diverifikasi: '+verify.error.message+'\n\nData lokal tidak diubah agar aman.');
    }
    if(verify.data){
      console.error('DELETE learning_sessions tidak menghapus baris. Kemungkinan policy RLS DELETE belum aktif.',{id,deletedResult:result.data,remaining:verify.data});
      return alert('Data belum benar-benar terhapus dari database.\n\nKemungkinan besar RLS DELETE untuk learning_sessions belum diaktifkan. Buka Pengaturan → Setup Hasil Pembelajaran, jalankan SQL yang tersedia, lalu coba lagi.');
    }
    db.sessions=db.sessions.filter(x=>String(x.id)!==String(id));
    if(String(editSessionId)===String(id))cancelSessionEdit();
    await loadCloudData();
    refresh();
    toast('Sesi berhasil dihapus permanen dari database.','success');
  }catch(e){
    console.error('delSession error:',e);
    alert('Gagal menghapus sesi: '+(e?.message||e));
  }
}
function renderSessions(){
  if(!(isAdmin()||isPengajar())){sessionList.innerHTML='';return}
  const q=String(document.getElementById('sessionSearch')?.value||'').trim().toLowerCase();
  const allowed=new Set(visibleStudents().map(s=>String(s.id)));
  const rows=db.sessions.filter(x=>allowed.has(String(x.santriId))).filter(x=>{
    const st=db.santri.find(z=>String(z.id)===String(x.santriId));
    return !q||[st?.nama,x.jenis,x.kelas,x.date,x.catatan].some(v=>String(v||'').toLowerCase().includes(q));
  });
  const timeOf=x=>{
    const t=Date.parse(x.created_at||x.updated_at||'');
    return Number.isFinite(t)?t:Date.parse(String(x.date||'')+'T00:00:00');
  };
  // Kelompok utama adalah level/kelas, kemudian jenis pembelajaran. Jangan satukan sesi lintas level.
  const byLevel=new Map();
  rows.forEach(x=>{
    const level=String(x.kelas||db.santri.find(z=>String(z.id)===String(x.santriId))?.kelas||'Level belum ditentukan').trim()||'Level belum ditentukan';
    const type=String(x.jenis||'Jenis pembelajaran belum ditentukan').trim()||'Jenis pembelajaran belum ditentukan';
    if(!byLevel.has(level))byLevel.set(level,new Map());
    const byType=byLevel.get(level);
    if(!byType.has(type))byType.set(type,[]);
    byType.get(type).push(x);
  });
  const levelOrder=["Kelas Iqra'","Kelas Al Qur'an","Kelas Tashih","Kelas Tahfizh"]; const levelNames=[...byLevel.keys()].sort((a,b)=>{const ia=levelOrder.indexOf(a),ib=levelOrder.indexOf(b);return (ia<0?999:ia)-(ib<0?999:ib)||a.localeCompare(b,'id');});
  const levelHtml=levelNames.map(level=>{
    const types=byLevel.get(level);
    const typeNames=[...types.keys()].sort((a,b)=>{const rank=t=>{t=String(t).toLowerCase();if(t.includes('iqro'))return 0;if(t.includes('tahsin qur'))return 1;if(t.includes('mutqin'))return 2;if(t.includes('tajwid'))return 3;if(t.includes('tashih')||t.includes('intensif'))return 4;if(t.includes('tahfizh')||t.includes('hafalan')||t.includes('muroja'))return 5;return 20};return rank(a)-rank(b)||a.localeCompare(b,'id');});
    const typeHtml=typeNames.map(type=>{
      const items=types.get(type).slice().sort((a,b)=>timeOf(b)-timeOf(a));
      return `<div class="card" style="margin:10px 0;padding:12px"><h4 style="margin:0 0 8px">${esc(type)} <span class="muted" style="font-weight:400">(${items.length} sesi)</span></h4><div style="overflow-x:auto"><table><tr><th>Tanggal</th><th>Jam Input</th><th>Santri</th><th>Data</th><th>Nilai</th><th>Evaluasi</th><th>Aksi</th></tr>${items.map(x=>{
        const st=db.santri.find(z=>String(z.id)===String(x.santriId));
        const rawTime=x.created_at||x.updated_at||'';
        const clock=rawTime?new Date(rawTime).toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}):'—';
        const data=Object.entries(x.fields&&typeof x.fields==='object'?x.fields:{}).map(([k,v])=>(LABEL[k]||k)+': '+esc(v)).join('<br>')||'—';
        return `<tr><td>${fmt(x.date)}</td><td>${clock}</td><td>${esc(st?.nama||'Santri tidak ditemukan')}</td><td>${data}</td><td><b>${esc(visibleSessionValue(x))}</b><br>${esc(visibleSessionPredikat(x))}</td><td>${esc(x.catatan||'—')}</td><td><button class="btn edit" onclick="editSession('${String(x.id).replace(/'/g,'\\\'')}')">Edit</button> ${isAdmin()?`<button class="btn danger" onclick="delSession('${String(x.id).replace(/'/g,'\\\'')}')">Hapus</button>`:''}</td></tr>`;
      }).join('')}</table></div></div>`;
    }).join('');
    return `<section style="margin:14px 0;padding:12px;border:1px solid var(--line,#d9dfd2);border-radius:14px"><h3 style="margin:0 0 8px">📚 ${esc(level)}</h3>${typeHtml}</section>`;
  }).join('');
  sessionList.innerHTML=rows.length?`<p class="muted">Diurutkan berdasarkan jam input terbaru pada setiap jenis pembelajaran. Rekapan dipisahkan menurut level/kelas agar tidak tercampur.</p>${levelHtml}`:'<p class="muted">Belum ada sesi pembelajaran.</p>';
}
function makeUUID(){
  if(window.crypto && typeof window.crypto.randomUUID==='function') return window.crypto.randomUUID();
  if(window.crypto && typeof window.crypto.getRandomValues==='function'){
    const a=new Uint8Array(16); window.crypto.getRandomValues(a); a[6]=(a[6]&15)|64; a[8]=(a[8]&63)|128; const h=[...a].map(x=>x.toString(16).padStart(2,'0')).join(''); return h.slice(0,8)+'-'+h.slice(8,12)+'-'+h.slice(12,16)+'-'+h.slice(16,20)+'-'+h.slice(20);
  }
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.random()*16|0,v=c==='x'?r:(r&3)|8;return v.toString(16)});
}
function fillTeachers(){
  const el=document.getElementById('spengajar'); if(!el)return;
  const old=el.value;
  el.innerHTML='<option value="">Pilih pengajar</option>'+(db.teachers||[]).map(t=>`<option value="${esc(t.id)}" ${String(t.status||'Aktif')!=='Aktif'?'disabled':''}>${esc(t.nama_lengkap)}${t.kompetensi?' — '+esc(t.kompetensi):''}${String(t.status||'Aktif')!=='Aktif'?' (Nonaktif)':''}</option>`).join('');
  if(old && [...el.options].some(o=>o.value===old))el.value=old;
}
async function saveTeacher(){
  const msg=document.getElementById('teacherSaveMsg');
  const btn=document.getElementById('teacherSaveBtn');
  const setMsg=(t,err=false)=>{if(msg){msg.textContent=t;msg.style.color=err?'#a51d1d':'var(--g)';msg.style.fontWeight='700';}};
  const g=id=>document.getElementById(id);
  if(!isAdmin()){setMsg('Hanya Admin yang dapat mengelola data pengajar.',true);return alert('Hanya Admin yang dapat mengelola data pengajar.');}
  const oldTeacher=editTeacherId?(db.teachers||[]).find(x=>String(x.id)===String(editTeacherId)):null;
  const oldName=oldTeacher?.nama_lengkap||'';
  const isEdit=!!editTeacherId;
  const id=editTeacherId||makeUUID();
  const o={
    id,
    nama_lengkap:g('tNama')?.value.trim()||'',
    nama_panggilan:g('tPanggilan')?.value.trim()||'',
    jenis_kelamin:g('tGender')?.value||'',
    tempat_lahir:g('tTempatLahir')?.value.trim()||'',
    tanggal_lahir:g('tTanggalLahir')?.value||null,
    no_hp:g('tNoHp')?.value.trim()||'',
    alamat:g('tAlamat')?.value.trim()||'',
    pendidikan_terakhir:g('tPendidikan')?.value.trim()||'',
    kompetensi:g('tKompetensi')?.value.trim()||'',
    kelas_diampu:g('tKelas')?.value.trim()||'',
    status:g('tStatus')?.value||'Aktif',
    tanggal_bergabung:g('tBergabung')?.value||null,
    email_login:g('tEmail')?.value.trim()||'',
    role:'pengajar',
    catatan:g('tCatatan')?.value.trim()||''
  };
  if(!o.nama_lengkap){setMsg('Nama lengkap pengajar wajib diisi.',true);return alert('Nama lengkap pengajar wajib diisi.');}
  const dup=(db.teachers||[]).find(x=>String(x.id)!==String(o.id)&&String(x.nama_lengkap||'').trim().toLowerCase()===o.nama_lengkap.toLowerCase());
  if(dup){setMsg('Nama pengajar tersebut sudah terdaftar.',true);return alert('Nama pengajar tersebut sudah terdaftar.');}

  if(btn){btn.disabled=true;btn.textContent=isEdit?'Menyimpan perubahan...':'Menyimpan pengajar...';}
  setMsg('⏳ Menyimpan ke Supabase...');
  toast('Menyimpan data pengajar...','info',2500);

  try{
    // Gunakan INSERT/UPDATE terpisah. Ini lebih sederhana dan tidak memicu jalur UPSERT.
    let error=null;
    if(isEdit){
      const res=await supabaseClient.from('teachers').update(o).eq('id',id);
      error=res.error||null;
    }else{
      const res=await supabaseClient.from('teachers').insert(o);
      error=res.error||null;
    }
    if(error){
      console.error('Supabase teachers error:',error);
      const detail=[error.message,error.details,error.hint].filter(Boolean).join(' | ');
      setMsg('❌ Gagal menyimpan: '+detail,true);
      toast('Gagal menyimpan pengajar.','error',5000);
      alert('Gagal menyimpan pengajar.\n\n'+detail);
      return;
    }

    // Perbarui tampilan lokal tanpa memuat ulang seluruh database.
    const i=(db.teachers||[]).findIndex(x=>String(x.id)===String(id));
    if(i>=0)db.teachers[i]={...db.teachers[i],...o}; else db.teachers.push(o);

    // Jika nama pengajar berubah, perbarui penugasan santri tanpa menahan konfirmasi utama.
    if(isEdit && oldName && oldName.trim().toLowerCase()!==o.nama_lengkap.trim().toLowerCase()){
      const affected=(db.santri||[]).filter(s=>String(s.pengajar||'').trim().toLowerCase()===oldName.trim().toLowerCase());
      affected.forEach(s=>s.pengajar=o.nama_lengkap);
      if(affected.length){
        // Jalankan setelah status berhasil ditampilkan agar UI tidak terasa menggantung.
        setTimeout(async()=>{
          const rows=affected.map(s=>({id:s.id,nama:s.nama,tempat_lahir:s.tempat_lahir||'',tanggal_lahir:s.tanggal_lahir||null,alamat:s.alamat||'',walisantri:s.wali||'',wali_email_login:s.wali_email_login||null,wali_user_id:(s.wali_user_id||s.waliUser)||null,kelas:s.level||'',pengajar:s.pengajar||'',jenis_kelamin:s.jenis_kelamin||'',aktif:true}));
          const up=await supabaseClient.from('students').upsert(rows,{onConflict:'id'});
          if(up.error)toast('Nama pengajar tersimpan, tetapi penugasan santri belum diperbarui.','error',5000);
        },0);
      }
    }

    editTeacherId=null;
    g('teacherForm')?.reset();
    fillTeachers();
    renderTeacherList();
    renderTeacherStudents();
    setMsg('✓ Data pengajar berhasil disimpan.');
    toast('✓ Data pengajar berhasil disimpan.','success',4000);
  }catch(err){
    console.error('saveTeacher exception:',err);
    const detail=err?.message||String(err);
    setMsg('❌ Gagal menyimpan: '+detail,true);
    toast('Gagal menyimpan pengajar.','error',5000);
    alert('Gagal menyimpan pengajar.\n\n'+detail);
  }finally{
    if(btn){btn.disabled=false;btn.textContent=editTeacherId===null?'+ Tambah Pengajar':'💾 Simpan Perubahan';}
  }
}
function renderTeacherAccountSelect(){
  const el=document.getElementById('accountTeacherSelect'); if(!el||!isAdmin())return;
  const rows=(db.teachers||[]).slice().sort((a,b)=>String(a.nama_lengkap).localeCompare(String(b.nama_lengkap)));
  el.innerHTML='<option value="">Pilih pengajar</option>'+rows.map(t=>`<option value="${esc(t.id)}">${esc(t.nama_lengkap)}${t.user_id?' — akun terhubung':''}</option>`).join('');
  renderWaliAccountSelect();
}
function fillTeacherAccountEmail(){
  const sel=document.getElementById('accountTeacherSelect'),email=document.getElementById('accountEmail');
  if(!sel||!email)return; const t=db.teachers.find(x=>String(x.id)===String(sel.value)); email.value=t?.email_login||'';
}
let accountProfilesCache=[];
let accountManagementLoadId=0;
function renderWaliAccountSelect(){
  if(!isAdmin())return;
  const students=(db.santri||[]).slice().sort((a,b)=>String(a.nama||'').localeCompare(String(b.nama||'')));
  const el=document.getElementById('accountWaliStudentSelect');
  if(el)el.innerHTML='<option value="">Pilih santri</option>'+students.map(s=>`<option value="${esc(s.id)}">${esc(s.nama||'Tanpa nama')}${s.wali?' — '+esc(s.wali):''}${s.wali_user_id?' — akun terhubung':''}</option>`).join('');
  const child=document.getElementById('linkWaliStudentSelect');
  if(child)child.innerHTML='<option value="">Pilih santri</option>'+students.map(s=>`<option value="${esc(s.id)}">${esc(s.nama||'Tanpa nama')}${s.wali_user_id?' — sudah terhubung':''}</option>`).join('');
  const byUid=new Map();
  students.forEach(s=>{if(s.wali_user_id){const uid=String(s.wali_user_id);if(!byUid.has(uid))byUid.set(uid,{uid,wali:s.wali||'Walisantri',children:[]});byUid.get(uid).children.push(s.nama||'Santri');}});
  const accounts=[...byUid.values()].sort((a,b)=>String(a.wali).localeCompare(String(b.wali)));
  const acct=document.getElementById('existingWaliAccountSelect');
  if(acct){const previous=acct.value;acct.innerHTML='<option value="">Pilih akun wali</option>'+accounts.map(a=>`<option value="${esc(a.uid)}">${esc(a.wali)} — ${a.children.length} anak</option>`).join('');if(accounts.some(a=>a.uid===previous))acct.value=previous;}
  renderAccountStatus();
}
async function loadAccountManagementData(){
  if(!isAdmin())return;
  const loadId=++accountManagementLoadId;
  const status=document.getElementById('accountStatusList');
  if(status)status.innerHTML='<p class="muted">⏳ Memuat daftar akun dari Supabase...</p>';
  // Ambil ulang data khusus untuk menu ini, terpisah dari render halaman lainnya.
  const [stResult,profileResult]=await Promise.all([
    supabaseClient.from('students').select('id,nama,walisantri,wali_user_id,wali_email_login,kelas,pengajar,teacher_id,jenis_kelamin,tempat_lahir,tanggal_lahir,alamat').order('nama'),
    supabaseClient.from('profiles').select('id,full_name,role').order('full_name')
  ]);
  if(loadId!==accountManagementLoadId)return;
  let loadWarning='';
  if(!stResult.error&&Array.isArray(stResult.data)){
    db.santri=stResult.data.map(x=>({id:x.id,nama:x.nama||'',ttl:[x.tempat_lahir,x.tanggal_lahir].filter(Boolean).join(', '),jenis_kelamin:x.jenis_kelamin||'',tempat_lahir:x.tempat_lahir||'',tanggal_lahir:x.tanggal_lahir||'',alamat:x.alamat||'',wali:x.walisantri||'',wali_user_id:x.wali_user_id||'',waliUser:x.wali_user_id||'',wali_email_login:x.wali_email_login||'',waliPin:'',level:x.kelas||'',pengajar:x.pengajar||'',teacher_id:x.teacher_id||'',aktif:true}));
  }else{loadWarning='Data santri tidak dapat dimuat ulang: '+(stResult.error?.message||'respons tidak valid')+'. ';}
  if(!profileResult.error&&Array.isArray(profileResult.data)){
    accountProfilesCache=profileResult.data.filter(p=>['wali','walisantri','parent'].includes(normalizeRole(p.role)));
  }else{
    accountProfilesCache=null;
    loadWarning+='Daftar seluruh profil tidak dapat dibaca dari aplikasi ('+(profileResult.error?.message||'respons tidak valid')+'). Status akan menampilkan akun yang bisa dikenali dari data santri.';
  }
  renderWaliAccountSelect();
  if(loadWarning&&status){status.insertAdjacentHTML('afterbegin','<div class="notice warning" style="margin-bottom:10px">'+esc(loadWarning)+'</div>');}
}
function renderAccountStatus(){
  const el=document.getElementById('accountStatusList'); if(!el||!isAdmin())return;
  const teacherRows=(db.teachers||[]).map(t=>({type:'Pengajar',name:t.nama_lengkap||'-',student:'-',email:t.email_login||'-',linked:!!t.user_id,uid:t.user_id||'',edit:false}));
  const childrenByUid=new Map();
  (db.santri||[]).forEach(s=>{if(!s.wali_user_id)return;const uid=String(s.wali_user_id);if(!childrenByUid.has(uid))childrenByUid.set(uid,{names:[],wali:s.wali||'Walisantri',email:s.wali_email_login||'-'});const row=childrenByUid.get(uid);if(s.nama)row.names.push(s.nama);if(row.wali==='Walisantri'&&s.wali)row.wali=s.wali;if(row.email==='-'&&s.wali_email_login)row.email=s.wali_email_login;});
  let waliRows=[];
  if(Array.isArray(accountProfilesCache)){
    waliRows=accountProfilesCache.map(p=>{const linked=childrenByUid.get(String(p.id));return {type:'Walisantri',name:p.full_name||linked?.wali||'Walisantri',student:linked?.names||[],email:linked?.email||'-',linked:!!linked,uid:String(p.id),edit:true};});
    // Jaga akun yang punya relasi santri meskipun profil tidak lolos filter role.
    for(const [uid,row] of childrenByUid){if(!waliRows.some(x=>x.uid===uid))waliRows.push({type:'Walisantri',name:row.wali,student:row.names,email:row.email,linked:true,uid,edit:true});}
  }else{
    waliRows=[...childrenByUid.entries()].map(([uid,row])=>({type:'Walisantri',name:row.wali,student:row.names,email:row.email,linked:true,uid,edit:true}));
  }
  const rows=[...teacherRows,...waliRows].sort((a,b)=>a.type.localeCompare(b.type)||a.name.localeCompare(b.name));
  if(!rows.length){el.innerHTML='<p class="muted">Belum ada data akun yang dapat ditampilkan.</p>';return;}
  el.innerHTML='<div class="table-scroll account-status-scroll" style="overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y"><table><tr><th>Jenis</th><th>Nama</th><th>Santri</th><th>Email</th><th>Status</th><th>Aksi</th></tr>'+rows.map(x=>{
    const action=x.edit?`<div style="display:flex;gap:6px;flex-wrap:wrap"><button type="button" class="btn edit" onclick="openWaliEdit('${esc(x.uid)}')">✏️ Edit</button><button type="button" class="btn danger" onclick="deleteWaliAccount('${esc(x.uid)}')">🗑️ Hapus Akun</button></div>`:'-';
    return `<tr><td>${esc(x.type)}</td><td>${esc(x.name)}</td><td>${esc(Array.isArray(x.student)?(x.student.join(', ')||'-'):(x.student==null||x.student===''?'-':String(x.student)))}</td><td>${esc(x.email)}</td><td><span class="badge">${x.linked?'Aktif / Terhubung':'Akun ada, belum terhubung'}</span></td><td>${action}</td></tr>`;
  }).join('')+'</table></div>';
}
function clearTeacherAccountForm(){const a=document.getElementById('accountTeacherSelect'),e=document.getElementById('accountEmail'),pw=document.getElementById('accountPassword'),m=document.getElementById('accountLinkMsg');if(a)a.value='';if(e)e.value='';if(pw)pw.value='';if(m)m.textContent='';}
function clearWaliAccountForm(){const a=document.getElementById('accountWaliStudentSelect'),e=document.getElementById('accountWaliEmail'),pw=document.getElementById('accountWaliPassword'),m=document.getElementById('accountWaliMsg');if(a)a.value='';if(e)e.value='';if(pw)pw.value='';if(m)m.textContent='';}
async function createAuthUserFromAdmin(email,password,kind,recordId){
  if(!isAdmin())throw new Error('Hanya Admin yang dapat membuat akun.');
  if(!email||!password||password.length<6)throw new Error('Email dan password minimal 6 karakter wajib diisi.');

  // v79: selalu ambil sesi Auth terbaru sebelum memanggil Edge Function.
  // Pesan diagnostik dibuat unik agar tidak tertukar dengan file HTML lama/cache.
  let sessionData,sessionError;
  try{
    const res=await supabaseClient.auth.getSession();
    sessionData=res?.data||null;
    sessionError=res?.error||null;
  }catch(e){
    throw new Error('V79-AUTH-READ: '+(e?.message||e));
  }
  if(sessionError)throw new Error('V79-AUTH-ERROR: '+(sessionError.message||sessionError));

  const session=sessionData?.session;
  const accessToken=session?.access_token||currentAccessToken||null;
  if(session?.access_token)currentAccessToken=session.access_token;

  if(!session || !accessToken){
    throw new Error('V79-NO-SESSION: Sesi login Admin belum tersedia di halaman ini. Silakan logout, lalu login Admin kembali.');
  }

  let result;
  try{
    result=await supabaseClient.functions.invoke('admin-create-user',{
      body:{email,password,kind,record_id:String(recordId)},
      headers:{Authorization:'Bearer '+accessToken}
    });
  }catch(e){
    throw new Error('V79-FUNCTION: '+(e?.message||e));
  }

  const data=result?.data;
  const error=result?.error;
  if(error){
    let detail=error.message||String(error);
    try{
      if(error.context?.body){
        const raw=await error.context.json();
        if(raw?.error)detail=raw.error;
      }
    }catch(_){}
    throw new Error('V79-EDGE: '+detail);
  }

  if(!data?.user_id)throw new Error('V79-RESPONSE: '+(data?.message||'Akun tidak berhasil dibuat.'));
  return {id:data.user_id,email:data.email||email};
}
async function createTeacherAccount(){
  const msg=document.getElementById('accountLinkMsg'),tid=document.getElementById('accountTeacherSelect')?.value,email=document.getElementById('accountEmail')?.value.trim(),pw=document.getElementById('accountPassword')?.value;
  if(!isAdmin()){if(msg)msg.textContent='Hanya Admin yang dapat membuat akun.';return;}
  const t=(db.teachers||[]).find(x=>String(x.id)===String(tid)); if(!t)return msg.textContent='Pilih pengajar terlebih dahulu.';
  if(!email||!pw||pw.length<6)return msg.textContent='Email dan password minimal 6 karakter wajib diisi.';
  if(t.user_id)return msg.textContent='Pengajar ini sudah memiliki akun.';
  msg.textContent='⏳ Membuat akun...';
  try{
    const user=await createAuthUserFromAdmin(email,pw,'teacher',t.id);
    // v80: Edge Function sudah menautkan akun ke data pengajar di server.
    t.user_id=user.id;t.email_login=email;renderTeacherList();renderTeacherAccountSelect();renderAccountStatus();
    msg.textContent='✓ Akun Pengajar berhasil dibuat dan dihubungkan.';toast('✓ Akun Pengajar berhasil dibuat.','success',5000);document.getElementById('accountPassword').value='';
  }catch(err){console.error(err);msg.textContent='❌ '+(err?.message||err);toast('Gagal membuat akun Pengajar.','error',5000);}
}
async function linkExistingWaliStudent(){
  const msg=document.getElementById('linkWaliMsg'),uid=document.getElementById('existingWaliAccountSelect')?.value,sid=document.getElementById('linkWaliStudentSelect')?.value;
  if(!isAdmin()){if(msg)msg.textContent='Hanya Admin yang dapat menghubungkan akun.';return;}
  if(!uid||!sid){if(msg)msg.textContent='Pilih akun Walisantri dan santri terlebih dahulu.';return;}
  const s=(db.santri||[]).find(x=>String(x.id)===String(sid));
  if(!s){if(msg)msg.textContent='Santri tidak ditemukan.';return;}
  if(String(s.wali_user_id||'')===String(uid)){if(msg)msg.textContent='✓ Santri ini sudah terhubung dengan akun tersebut.';return;}
  if(s.wali_user_id && String(s.wali_user_id)!==String(uid)){if(msg)msg.textContent='Santri ini sudah terhubung dengan akun Walisantri lain. Lepaskan hubungan lama terlebih dahulu.';return;}
  msg.textContent='⏳ Menghubungkan santri...';
  try{
    const {error}=await supabaseClient.from('students').update({wali_user_id:uid,updated_at:new Date().toISOString()}).eq('id',s.id);
    if(error)throw error;
    s.wali_user_id=uid;s.waliUser=uid;
    renderSantri();renderWaliAccountSelect();renderAccountStatus();renderWaliPortal();
    msg.textContent='✓ Santri berhasil dihubungkan ke akun Walisantri.';
    toast('✓ Anak berhasil ditambahkan ke akun Walisantri.','success',5000);
  }catch(err){console.error(err);msg.textContent='❌ '+(err?.message||err);toast('Gagal menghubungkan anak.','error',5000);}
}
async function getAdminAccessToken(){
  const res=await supabaseClient.auth.getSession();
  const session=res?.data?.session; const token=session?.access_token||currentAccessToken||null;
  if(!session||!token)throw new Error('Sesi Admin belum tersedia. Silakan login ulang.');
  currentAccessToken=token; return token;
}
async function adminUpdateWaliAuth(action,userId,email,password){
  if(!isAdmin())throw new Error('Hanya Admin yang dapat mengubah akun.');
  const token=await getAdminAccessToken();
  const {data,error}=await supabaseClient.functions.invoke('ain-update-wali',{body:{action,user_id:String(userId),email:email||null,password:password||null},headers:{Authorization:'Bearer '+token}});
  if(error){let detail=error.message||String(error);try{if(error.context?.body){const raw=await error.context.json();if(raw?.error)detail=raw.error;}}catch(_){}throw new Error(detail);}
  if(!data?.user_id)throw new Error(data?.message||'Akun tidak berhasil diproses.');
  return data;
}
async function deleteWaliAccount(uid){
  if(!isAdmin())return toast('Hanya Admin yang dapat menghapus akun.','error',4000);
  const linked=(db.santri||[]).filter(s=>String(s.wali_user_id||'')===String(uid));
  const waliName=linked.find(s=>s.wali)?.wali||accountProfilesCache?.find(p=>String(p.id)===String(uid))?.full_name||'Walisantri';
  const childNames=linked.map(s=>s.nama).filter(Boolean);
  const detail=childNames.length?'\n\nAkun ini terhubung dengan: '+childNames.join(', ')+'.\nData santri dan riwayat pembelajaran tetap dipertahankan, tetapi hubungan akun akan dilepas.':'\n\nAkun ini tidak sedang terhubung dengan santri.';
  if(!confirm('HAPUS AKUN WALISANTRI?\n\nNama: '+waliName+detail+'\n\nAkun login akan dihapus permanen dan tidak dapat digunakan lagi. Lanjutkan?'))return;
  const status=document.getElementById('accountStatusList');
  if(status)status.insertAdjacentHTML('afterbegin','<div class="notice" style="margin-bottom:10px">⏳ Menghapus akun Walisantri...</div>');
  try{
    await adminUpdateWaliAuth('delete',uid,null,null);
    (db.santri||[]).forEach(s=>{if(String(s.wali_user_id||'')===String(uid)){s.wali_user_id='';s.waliUser='';s.wali_email_login='';}});
    if(Array.isArray(accountProfilesCache))accountProfilesCache=accountProfilesCache.filter(p=>String(p.id)!==String(uid));
    renderSantri();renderWaliAccountSelect();renderAccountStatus();renderWaliPortal();
    toast('✓ Akun Walisantri berhasil dihapus. Data santri tetap tersimpan.','success',6000);
  }catch(err){
    console.error('deleteWaliAccount:',err);
    toast('Gagal menghapus akun Walisantri: '+(err?.message||err)+'. Jika error menyebut Edge Function, periksa deployment admin-update-wali di Supabase.','error',8000);
    await loadAccountManagementData().catch(()=>{});
  }
}
async function openWaliEdit(uid){
  if(!isAdmin())return toast('Hanya Admin yang dapat mengubah akun.','error',4000);
  const modal=document.getElementById('waliEditModal'),msg=document.getElementById('waliEditMsg'),info=document.getElementById('waliEditInfo'),emailEl=document.getElementById('waliEditEmail'),pwEl=document.getElementById('waliEditPassword');
  if(!modal||!msg||!info||!emailEl||!pwEl)return toast('Form edit akun tidak ditemukan. Muat ulang aplikasi.','error',5000);
  const children=(db.santri||[]).filter(s=>String(s.wali_user_id||'')===String(uid));
  const profile=Array.isArray(accountProfilesCache)?accountProfilesCache.find(p=>String(p.id)===String(uid)):null;
  modal.dataset.uid=String(uid);modal.classList.remove('hidden');msg.textContent='⏳ Memuat akun dari Supabase...';emailEl.value='';pwEl.value='';
  info.innerHTML='<b>Walisantri:</b> '+esc(children[0]?.wali||profile?.full_name||'Walisantri')+'<br><b>Santri:</b> '+esc(children.map(s=>s.nama).join(', ')||'Belum terhubung dengan data santri');
  try{
    const data=await adminUpdateWaliAuth('get',uid,null,null);
    const current=data.email||children.find(s=>s.wali_email_login)?.wali_email_login||'';
    emailEl.value=current;msg.textContent='Email saat ini: '+(current||'-')+'. Isi password baru hanya jika ingin menggantinya.';
  }catch(err){
    const current=children.find(s=>s.wali_email_login)?.wali_email_login||'';
    emailEl.value=current;msg.textContent='❌ Gagal memuat data akun: '+(err?.message||err)+' Pastikan Edge Function admin-update-wali sudah tersedia dan ter-deploy.';
  }
}
function closeWaliEdit(){const m=document.getElementById('waliEditModal');if(m)m.classList.add('hidden');}
async function saveWaliEdit(){
  const modal=document.getElementById('waliEditModal'),uid=modal?.dataset.uid,email=document.getElementById('waliEditEmail')?.value.trim(),pw=document.getElementById('waliEditPassword')?.value||'',msg=document.getElementById('waliEditMsg');
  if(!uid)return;if(!email)return msg.textContent='Email login wajib diisi.';if(pw&&pw.length<6)return msg.textContent='Password baru minimal 6 karakter.';msg.textContent='⏳ Menyimpan perubahan...';
  try{
    const data=await adminUpdateWaliAuth('update',uid,email,pw||null);
    const linked=(db.santri||[]).filter(s=>String(s.wali_user_id||'')===String(uid));
    for(const s of linked){
      const updatedEmail=data.email||email;
      const {error}=await supabaseClient.from('students').update({wali_email_login:updatedEmail,updated_at:new Date().toISOString()}).eq('id',s.id);
      if(error)throw new Error('Akun Auth berhasil diperbarui, tetapi email pada data santri gagal disinkronkan: '+error.message);
      s.wali_email_login=updatedEmail;
    }
    if(Array.isArray(accountProfilesCache)){
      accountProfilesCache=accountProfilesCache.map(p=>String(p.id)===String(uid)?{...p,email:data.email||email}:p);
    }
    renderAccountStatus();renderSantri();renderWaliAccountSelect();
    msg.textContent='✓ Akun Walisantri berhasil diperbarui.';
    toast('✓ Akun Walisantri berhasil diperbarui.','success',5000);
    setTimeout(closeWaliEdit,700);
  }catch(err){
    console.error('saveWaliEdit:',err);
    msg.textContent='❌ Gagal memperbarui akun: '+(err?.message||err)+' Jika muncul error Edge Function, fungsi admin-update-wali di Supabase perlu diperiksa.';
    toast('Gagal memperbarui akun Walisantri: '+(err?.message||err),'error',7000);
  }
}

async function createWaliAccount(){
  const msg=document.getElementById('accountWaliMsg'),sid=document.getElementById('accountWaliStudentSelect')?.value,email=document.getElementById('accountWaliEmail')?.value.trim(),pw=document.getElementById('accountWaliPassword')?.value;
  if(!isAdmin()){if(msg)msg.textContent='Hanya Admin yang dapat membuat akun.';return;}
  const s=(db.santri||[]).find(x=>String(x.id)===String(sid)); if(!s)return msg.textContent='Pilih santri terlebih dahulu.';
  if(!email||!pw||pw.length<6)return msg.textContent='Email dan password minimal 6 karakter wajib diisi.';
  if(s.wali_user_id)return msg.textContent='Santri ini sudah terhubung. Untuk akun yang sama, gunakan menu “Hubungkan Anak ke Akun Walisantri”.';
  msg.textContent='⏳ Membuat akun...';
  try{
    const user=await createAuthUserFromAdmin(email,pw,'wali',s.id);
    // v80: Edge Function sudah menautkan akun ke data santri di server.
    s.wali_user_id=user.id;s.waliUser=user.id;s.wali_email_login=user.email||email;try{await supabaseClient.from('students').update({wali_user_id:user.id,wali_email_login:s.wali_email_login,updated_at:new Date().toISOString()}).eq('id',s.id)}catch(_){ }renderSantri();renderWaliAccountSelect();renderAccountStatus();
    msg.textContent='✓ Akun Walisantri berhasil dibuat dan dihubungkan.';toast('✓ Akun Walisantri berhasil dibuat.','success',5000);document.getElementById('accountWaliPassword').value='';
  }catch(err){console.error(err);msg.textContent='❌ '+(err?.message||err);toast('Gagal membuat akun Walisantri.','error',5000);}
}

function editTeacher(id){
  const x=(db.teachers||[]).find(t=>String(t.id)===String(id)); if(!x)return;
  editTeacherId=x.id;tNama.value=x.nama_lengkap||'';tPanggilan.value=x.nama_panggilan||'';tGender.value=x.jenis_kelamin||'';tTempatLahir.value=x.tempat_lahir||'';tTanggalLahir.value=x.tanggal_lahir||'';tNoHp.value=x.no_hp||'';tAlamat.value=x.alamat||'';tPendidikan.value=x.pendidikan_terakhir||'';tKompetensi.value=x.kompetensi||'';tKelas.value=x.kelas_diampu||'';tStatus.value=x.status||'Aktif';tBergabung.value=x.tanggal_bergabung||'';tEmail.value=x.email_login||'';tCatatan.value=x.catatan||'';
  document.getElementById('teacherSaveBtn').textContent='💾 Simpan Perubahan';showPage('pengajar',document.getElementById('navPengajar'));window.scrollTo({top:0,behavior:'smooth'});
}
function cancelTeacherEdit(){editTeacherId=null;document.getElementById('teacherForm')?.reset();document.getElementById('teacherSaveBtn').textContent='+ Tambah Pengajar';}
async function toggleTeacherStatus(id){
  if(!isAdmin())return;const x=(db.teachers||[]).find(t=>String(t.id)===String(id));if(!x)return;const next=x.status==='Aktif'?'Nonaktif':'Aktif';
  const {error}=await supabaseClient.from('teachers').update({status:next,updated_at:new Date().toISOString()}).eq('id',id);if(error)return alert('Gagal mengubah status: '+error.message);x.status=next;fillTeachers();renderTeacherList();toast('Status pengajar diubah menjadi '+next+'.','success');
}
async function delTeacher(id){
  if(!isAdmin())return;const x=(db.teachers||[]).find(t=>String(t.id)===String(id));if(!x)return;
  const assigned=(db.santri||[]).filter(s=>String(s.pengajar||'').trim().toLowerCase()===String(x.nama_lengkap||'').trim().toLowerCase());
  if(assigned.length)return alert('Pengajar tidak dapat dihapus karena masih ditugaskan kepada '+assigned.length+' santri. Nonaktifkan pengajar jika sudah tidak mengajar.');
  if(!confirm('Hapus data pengajar '+x.nama_lengkap+' secara permanen?'))return;
  const {error}=await supabaseClient.from('teachers').delete().eq('id',id);if(error)return alert('Gagal menghapus pengajar: '+error.message);db.teachers=db.teachers.filter(t=>String(t.id)!==String(id));renderTeacherList();fillTeachers();toast('Data pengajar berhasil dihapus.','success');
}
function renderTeacherList(){
  const el=document.getElementById('teacherList');if(!el||!isAdmin())return;
  const rows=(db.teachers||[]).slice().sort((a,b)=>String(a.nama_lengkap).localeCompare(String(b.nama_lengkap)));
  if(!rows.length){el.innerHTML='<p class="muted">Belum ada data pengajar. Silakan tambahkan pengajar pertama.</p>';return;}
  el.innerHTML='<div class="table-scroll teacher-list-scroll" style="overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y"><table><tr><th>Nama</th><th>Gender</th><th>Tempat Lahir</th><th>Tanggal Lahir</th><th>No. HP</th><th>Alamat</th><th>Pendidikan</th><th>Kompetensi</th><th>Kelas</th><th>Tanggal Bergabung</th><th>Catatan</th><th>Santri</th><th>Status</th><th>Aksi</th></tr>'+rows.map(x=>{const c=(db.santri||[]).filter(s=>String(s.pengajar||'').trim().toLowerCase()===String(x.nama_lengkap||'').trim().toLowerCase()).length;return `<tr><td><b>${esc(x.nama_lengkap)}</b>${x.nama_panggilan?'<br><small class="muted">Panggilan: '+esc(x.nama_panggilan)+'</small>':''}</td><td>${esc(x.jenis_kelamin||'-')}</td><td>${esc(x.tempat_lahir||'-')}</td><td>${esc(x.tanggal_lahir||'-')}</td><td>${esc(x.no_hp||'-')}</td><td>${esc(x.alamat||'-')}</td><td>${esc(x.pendidikan_terakhir||'-')}</td><td>${esc(x.kompetensi||'-')}</td><td>${esc(x.kelas_diampu||'-')}</td><td>${esc(x.tanggal_bergabung||'-')}</td><td>${esc(x.catatan||'-')}</td><td style="text-align:center"><b>${c}</b><br><button class="btn" style="margin-top:4px" onclick="viewTeacherStudents('${x.id}')">Lihat</button></td><td><span class="badge">${esc(x.status||'Aktif')}</span></td><td><div class="row-actions"><button class="btn edit" onclick="editTeacher('${x.id}')">Edit</button> <button class="btn" onclick="toggleTeacherStatus('${x.id}')">${x.status==='Aktif'?'Nonaktifkan':'Aktifkan'}</button> <button class="btn danger" onclick="delTeacher('${x.id}')">Hapus</button></div></td></tr>`}).join('')+'</table></div>';
  renderTeacherAccountSelect();
}
function viewTeacherStudents(id){
  const x=(db.teachers||[]).find(t=>String(t.id)===String(id));
  if(!x)return;
  const card=document.getElementById('teacherStudentsCard'),title=document.getElementById('teacherStudentsTitle'),el=document.getElementById('teacherStudentsList');
  if(!card||!title||!el)return;
  const rows=(db.santri||[]).filter(s=>String(s.pengajar||'').trim().toLowerCase()===String(x.nama_lengkap||'').trim().toLowerCase()).sort((a,b)=>String(a.nama).localeCompare(String(b.nama)));
  title.textContent='Santri Binaan — '+x.nama_lengkap;
  el.innerHTML=rows.length?'<div style="overflow:auto"><table><tr><th>No.</th><th>Nama Santri</th><th>Kelas</th><th>Walisantri</th><th>Status</th></tr>'+rows.map((s,i)=>`<tr><td>${i+1}</td><td><b>${esc(s.nama)}</b></td><td>${esc(s.level||'-')}</td><td>${esc(s.wali||'-')}</td><td>${s.aktif===false?'Nonaktif':'Aktif'}</td></tr>`).join('')+'</table></div>':'<p class="muted">Belum ada santri yang ditugaskan kepada pengajar ini.</p>';
  card.style.display='block';
  card.scrollIntoView({behavior:'smooth',block:'start'});
}
function renderTeacherStudents(){
  const card=document.getElementById('teacherStudentsCard');
  if(card)card.style.display='none';
}

function renderSantri(){if(!(isAdmin()||isPengajar())){santriList.innerHTML='';return}const q=String(document.getElementById('santriSearch')?.value||'').trim().toLowerCase();const rows=visibleStudents().filter(x=>!q||[x.nama,x.wali,x.level,x.pengajar,x.jenis_kelamin,x.ttl].some(v=>String(v||'').toLowerCase().includes(q)));santriList.innerHTML=rows.length?'<div class="table-scroll santri-list-scroll" style="overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y"><table><tr><th>Nama</th><th>Jenis Kelamin</th><th>TTL</th><th>Wali</th><th>Kelas</th><th>Pengajar</th><th>Aksi</th></tr>'+rows.map(x=>`<tr><td>${esc(x.nama)}</td><td>${esc(x.jenis_kelamin||'-')}</td><td>${esc(x.ttl)}</td><td>${esc(x.wali)}</td><td>${esc(x.level)}</td><td>${esc(x.pengajar)}</td><td><div class="row-actions">${isAdmin()?`<button class="btn edit" onclick="editSantri('${x.id}')">Edit</button> <button class="btn danger" onclick="delSantri('${x.id}')">Hapus</button>`:'<span class="muted">Read only</span>'}</div></td></tr>`).join('')+'</table></div>':'<p class="muted">Belum ada santri binaan.</p>'}
function reportData(){
  if(isWali()&&getWaliStudent())rSantri.value=String(getWaliStudent().id);
  const allowedIds=new Set(visibleStudents().map(x=>String(x.id)));
  let sid=String(rSantri.value||'');
  if(!allowedIds.has(sid)){sid='';if(rSantri)rSantri.value='';}
  let s=db.santri.find(x=>String(x.id)===sid);
  const startStr=String(rStart.value||'1900-01-01');
  const endStr=String(rEnd.value||'2999-12-31');
  if(startStr>endStr){
    if(report) report.innerHTML='<div class=\"card\"><p class=\"muted\">Tanggal mulai tidak boleh melewati tanggal akhir.</p></div>';
    return{sid,s,st:new Date(startStr+'T00:00:00'),en:new Date(endStr+'T23:59:59'),rows:[]};
  }
  const st=new Date(startStr+'T00:00:00'), en=new Date(endStr+'T23:59:59');
  // Filter berdasarkan tanggal kalender YYYY-MM-DD, bukan jam/timezone, agar sesi tepat berada di periode yang dipilih.
  let rows=db.sessions.filter(x=>{
    if(!allowedIds.has(String(x.santriId))||String(x.santriId)!==sid)return false;
    const ds=String(x.date||'').slice(0,10);
    return ds>=startStr && ds<=endStr;
  });
  const attendance=(presensiCloud||[]).filter(x=>String(x.student_id)===sid && String(x.tanggal||x.date||'').slice(0,10)>=startStr && String(x.tanggal||x.date||'').slice(0,10)<=endStr);
  return{sid,s,st,en,rows,attendance}
}
function setPeriod(){let base=String(rEnd.value||today());let e=new Date(base+'T12:00:00');let m=Number(rPeriod.value);e.setMonth(e.getMonth()-m);rStart.value=e.getFullYear()+'-'+String(e.getMonth()+1).padStart(2,'0')+'-'+String(e.getDate()).padStart(2,'0');renderReport()}
function doaRows(sid,st,en){
 // Konsep capaian doa: 1 ceklis = 1 doa TUNTAS.
 // Riwayat tanggal tetap disimpan di database, tetapi tidak dihitung sebagai jumlah hari.
 const out=[];
 const start=new Date(st); const end=new Date(en);
 for(let i=0;i<DOA.length;i++){
   let done=false,note='';
   for(let d=new Date(start);d<=end;d.setDate(d.getDate()+1)){
     const ds=d.toISOString().slice(0,10);
     const key=String(sid)+'_'+ds+'_'+i;
     if(db.doa && db.doa[key]===true) done=true;
     const savedNote=db.doa && db.doa[key+'_note'];
     if(savedNote) note=String(savedNote);
   }
   out.push({name:DOA[i],done,note,status:done?'Tuntas':'Belum Tuntas'});
 }
 return out;
}
function sessionScoreRows(x){
 const type=TYPES?.[x.kelas]?.[x.jenis];
 const rubric=type?.rubric||[];
 if(rubric.length){
   return rubric.map((r,i)=>{
     const raw=x.rubricScores?.[i]??x.scores?.[i]??'-';
     const score=(raw&&typeof raw==='object') ? (raw.nilai??raw.score??'-') : raw;
     return {name:r[0],weight:type?.special==='letter_rubric'?50:r[1],score};
   });
 }
 if(x.jenis==='Praktik Tajwid bil Lisany'){
   const benar=x.fields?.benar??x.scores?.benar??'-', kurang=x.fields?.kurang??x.scores?.kurang??'-';
   return [{name:'Bacaan Benar',weight:'-',score:benar},{name:'Bacaan Kurang',weight:'-',score:kurang}];
 }
 return [{name:'Nilai Akhir',weight:'100%',score:isLetterAssessment(x)?letterFromValue(x.nilai):(x.nilai??'-')}];
}
function sessionScoreDetail(x){
 return sessionScoreRows(x).map(r=>r.name+': '+r.score+(r.weight!=='-'?' ('+r.weight+'%)':'')).join(' | ');
}
function meetingGroups(rows){
 const map=new Map();
 rows.slice().sort((a,b)=>String(a.date).localeCompare(String(b.date))||String(a.id||'').localeCompare(String(b.id||''))).forEach(x=>{
   const key=String(x.date||'');
   if(!map.has(key)) map.set(key,[]);
   map.get(key).push(x);
 });
 return Array.from(map.entries()).map(([date,items],i)=>({date,items,index:i+1,avg:items.length?items.reduce((a,x)=>a+Number(x.nilai||0),0)/items.length:0}));
}
function renderReport(){
 let d=reportData();
 if(isWali()&&d.s)rSantri.disabled=true; else if(rSantri)rSantri.disabled=false;
 if(!d.s){report.innerHTML='<p class="muted">Pilih santri untuk menampilkan raport.</p>';return}
 const rowsSorted=d.rows.slice().sort((a,b)=>String(a.date).localeCompare(String(b.date)) || String(a.id||'').localeCompare(String(b.id||'')));
 const meetings=meetingGroups(rowsSorted);
 let groups={};rowsSorted.forEach(x=>(groups[x.jenis]??=[]).push(Number(x.nilai)||0));
 let avg=rowsSorted.length?rowsSorted.reduce((a,x)=>a+Number(x.nilai||0),0)/rowsSorted.length:0;
 let dr=doaRows(d.sid,d.st,d.en);
 const att=d.attendance||[];
 const attCount={hadir:0,izin:0,sakit:0,tidak_hadir:0};
 att.forEach(x=>{const k=String(x.status||''); if(k in attCount) attCount[k]++;});
 const attMeetings=new Set(att.map(x=>String(x.tanggal||x.date||'').slice(0,10)).filter(Boolean)).size;
 const attPct=att.length?Math.round(attCount.hadir/att.length*100):0;
 const attendanceTable=`<table class=\"summaryTable\"><tr><th>Hadir</th><th>Izin</th><th>Sakit</th><th>Tidak Hadir</th><th>% Hadir</th></tr><tr><td>${attCount.hadir}</td><td>${attCount.izin}</td><td>${attCount.sakit}</td><td>${attCount.tidak_hadir}</td><td>${attPct}%</td></tr></table>`;
 const summaryRows=Object.entries(groups).map(([k,v])=>{
   const n=v.reduce((a,b)=>a+b,0)/v.length;
   const dates=new Set(rowsSorted.filter(x=>x.jenis===k).map(x=>x.date));
   return `<tr><td>${esc(k)}</td><td style="text-align:center">${dates.size}</td><td style="text-align:center">${n.toFixed(1)}</td><td style="text-align:center">${grade(n)}</td></tr>`;
 }).join('')||'<tr><td colspan="4">Belum ada nilai pada periode ini.</td></tr>';
 const doaTable=dr.map(x=>`<tr><td>${esc(x.name)}</td><td style="text-align:center">${x.done?'✅ Tuntas':'⬜ Belum Tuntas'}</td><td>${esc(x.note||'-')}</td></tr>`).join('');
 const hasReportPrayer=dr.some(x=>x.done||String(x.note||'').trim());
 // RAPORT WALI: ringkas, tanpa detail pertemuan/rubrik. Detail tetap tersedia untuk Admin/Pengajar.
 if(isWali()){
   report.innerHTML=`<div class="reportHead"><img src="${LOGO}"><div><h2>RAPORT PEMBELAJARAN</h2><b>Shohibul Quran</b><br>Periode: <b>${fmt(rStart.value)}</b> s/d <b>${fmt(rEnd.value)}</b></div></div>
   <div class="reportStudent"><b>Nama:</b> ${esc(d.s.nama)} &nbsp; <b>TTL:</b> ${esc(d.s.ttl||'-')} &nbsp; <b>Jenis Kelamin:</b> ${esc(d.s.jenis_kelamin||'-')} &nbsp; <b>Kelas:</b> ${esc(d.s.level)} &nbsp; <b>Pengajar:</b> ${esc(d.s.pengajar||'-')}</div>
   <div class="reportAverage"><b>Rata-rata keseluruhan:</b> ${rowsSorted.length?avg.toFixed(1):'-'} ${rowsSorted.length?'— '+grade(avg):''} &nbsp; <b>Total Pertemuan:</b> ${meetings.length}</div>
   <h3>Rekap Pembelajaran</h3><table class="summaryTable"><tr><th>Jenis Pembelajaran</th><th>Pertemuan</th><th>Rata-rata</th><th>Predikat</th></tr>${summaryRows}</table>
   <h3>Rekap Kehadiran</h3>${attendanceTable}<div class="muted" style="margin-bottom:12px">Total hari/pertemuan tercatat: ${attMeetings}</div>${hasReportPrayer?`<h3>Capaian Hafalan Doa</h3><table class="summaryTable"><tr><th>Doa</th><th>Status</th><th>Catatan</th></tr>${doaTable}</table>`:''}
   <div class="reportNote" style="margin-top:18px"><b>Catatan Perkembangan:</b><br>Detail penilaian setiap pertemuan tersimpan di sistem dan dapat dipantau sesuai hak akses. Raport ini menampilkan ringkasan perkembangan santri.</div>`;
   return;
 }
 const detail=meetings.map(m=>{
   const blocks=m.items.map(x=>{
     const rows=sessionScoreRows(x);
     const material=Object.entries(x.fields||{}).filter(([k,v])=>v!==''&&v!=null&&k!=='benar'&&k!=='kurang').map(([k,v])=>(LABEL[k]||k)+': '+esc(v)).join(' • ')||'-';
     return `<div class="reportLesson"><div class="reportSessionHead"><div><b>${esc(x.jenis)}</b><br><span class="muted">${esc(x.kelas||'-')}</span></div><div class="reportSessionScore"><b>${esc(x.nilai)}</b> · ${grade(x.nilai)}</div></div><div class="muted reportMaterial">${material}</div><table class="componentTable"><tr><th>Komponen Penilaian</th><th>Bobot</th><th>Nilai</th></tr>${rows.map(r=>`<tr><td>${esc(r.name)}</td><td style="text-align:center">${esc(r.weight)}</td><td style="text-align:center"><b>${esc(r.score)}</b></td></tr>`).join('')}</table><div class="reportNote"><b>Evaluasi:</b> ${esc(x.catatan||'-')}</div></div>`;
   }).join('');
   return `<div class="reportSession"><div class="reportSessionHead"><div><b>Pertemuan ${m.index}</b> · ${fmt(m.date)}<br><span class="muted">${m.items.length} jenis pembelajaran</span></div><div class="reportSessionScore"><b>${m.avg.toFixed(1)}</b> · ${grade(m.avg)}</div></div>${blocks}</div>`;
 }).join('')||'<div class="muted">Belum ada sesi pembelajaran pada periode ini.</div>';
 const meetingSummary=meetings.map(m=>`<tr><td>${m.index}</td><td>${fmt(m.date)}</td><td>${m.items.map(x=>esc(x.jenis)).join('<br>')}</td><td style="text-align:center"><b>${m.items.map(x=>esc(Number(x.nilai).toFixed(1))).join('<br>')}</b></td><td style="text-align:center"><b>${m.avg.toFixed(1)}</b><br>${grade(m.avg)}</td></tr>`).join('');
 report.innerHTML=`<div class="reportHead"><img src="${LOGO}"><div><h2>RAPORT PEMBELAJARAN</h2><b>Shohibul Quran</b><br>Periode: <b>${fmt(rStart.value)}</b> s/d <b>${fmt(rEnd.value)}</b></div></div>
 <div class="reportStudent"><b>Nama:</b> ${esc(d.s.nama)} &nbsp; <b>TTL:</b> ${esc(d.s.ttl||'-')} &nbsp; <b>Jenis Kelamin:</b> ${esc(d.s.jenis_kelamin||'-')} &nbsp; <b>Kelas:</b> ${esc(d.s.level)} &nbsp; <b>Pengajar:</b> ${esc(d.s.pengajar||'-')}</div>
 <div class="reportAverage"><b>Rata-rata keseluruhan:</b> ${rowsSorted.length?avg.toFixed(1):'-'} ${rowsSorted.length?'— '+grade(avg):''} &nbsp; <b>Total Pertemuan:</b> ${meetings.length} &nbsp; <b>Total Pembelajaran:</b> ${rowsSorted.length}</div>
 <h3>Rekap Nilai</h3><table class="summaryTable"><tr><th>Jenis Pembelajaran</th><th>Pertemuan</th><th>Rata-rata</th><th>Predikat</th></tr>${summaryRows}</table>
 <h3>Nilai Setiap Pertemuan</h3><table class="summaryTable"><tr><th>No.</th><th>Tanggal</th><th>Jenis Pembelajaran</th><th>Nilai</th><th>Rata-rata Hari</th></tr>${meetingSummary||'<tr><td colspan="5">Belum ada nilai pada periode ini.</td></tr>'}</table>
 <h3>Detail Setiap Pertemuan</h3>${detail}
 <h3>Rekap Kehadiran</h3>${attendanceTable}<div class="muted" style="margin-bottom:12px">Total hari/pertemuan tercatat: ${attMeetings}</div>${hasReportPrayer?`<h3>Format Doa & Pencapaian Hafalan Doa</h3><table class="summaryTable"><tr><th>Doa</th><th>Status</th><th>Catatan</th></tr>${doaTable}</table>`:''}`;
}
function printReport(){let r=document.getElementById('report');if(!r.innerText.trim())return alert('Pilih santri dan periode terlebih dahulu.');document.querySelectorAll('.page').forEach(x=>x.classList.remove('printable'));raport.classList.add('printable');window.print()}
function downloadHTML(){let r=report.innerHTML;if(!r)return alert('Tampilkan raport terlebih dahulu.');let doc='<!doctype html><html><head><meta charset="utf-8"><title>Raport Shohibul Quran</title><style>body{font-family:Arial;padding:25px;color:#24331d}table{width:100%;border-collapse:collapse}th,td{border:1px solid #777;padding:7px;vertical-align:top}th{background:#eef4e9}.reportHead{display:flex;gap:15px;border-bottom:2px solid #5f8f27;padding-bottom:10px}.reportHead img{width:75px;height:75px;object-fit:contain}</style></head><body>'+r+'</body></html>';let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([doc],{type:'text/html'}));a.download='Raport_Shohibul_Quran.html';a.click()}
function downloadPDF(){try{let d=reportData();if(!d.s)return alert('Pilih santri terlebih dahulu.');if(!d.rows.length&&!confirm('Belum ada nilai pada periode ini. Tetap buat raport?'))return;let pdf=makePDF(d);let a=document.createElement('a');a.href=URL.createObjectURL(pdf);a.download='Raport_'+d.s.nama.replace(/[^a-z0-9_-]+/gi,'_')+'_'+rStart.value+'_'+rEnd.value+'.pdf';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),3000)}catch(e){console.error(e);alert('Raport PDF gagal dibuat: '+(e?.message||e));}}
function escPDF(t){return String(t??'').replace(/\\/g,'\\\\').replace(/\(/g,'\\(').replace(/\)/g,'\\)')}
function makePDF(d){
  if(!window.jspdf||!window.jspdf.jsPDF){throw new Error('Library PDF belum siap. Pastikan koneksi internet aktif lalu muat ulang aplikasi.');}
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({orientation:'portrait',unit:'mm',format:'a4',compress:true});
  const PW=210, PH=297, M=14, bottom=18;
  let y=14;
  const green=[42,91,35], light=[239,245,235], border=[110,110,110];
  function safe(v){return String(v??'-').replace(/\s+/g,' ').trim()||'-';}
  function addHeader(){
    if(LOGO){try{doc.addImage(LOGO,'JPEG',M,y,22,19);}catch(e){}}
    doc.setTextColor(...green);doc.setFont('helvetica','bold');doc.setFontSize(13.5);doc.text('RAPORT PEMBELAJARAN',42,y+6);
    doc.setFontSize(8.5);doc.setFont('helvetica','normal');doc.text('Shohibul Quran',42,y+11);
    doc.setTextColor(25,25,25);
    const col2=108;
    function headerField(label,value,x,yy,w=84){
      doc.setFont('helvetica','bold');doc.setFontSize(7.8);doc.setTextColor(...green);doc.text(label,x,yy);
      doc.setFont('helvetica','normal');doc.setFontSize(8.2);doc.setTextColor(25,25,25);
      const valueX=x+31;
      const lines=doc.splitTextToSize(safe(value),w-31);
      doc.text(lines,valueX,yy,{baseline:'alphabetic'});
    }
    headerField('Nama:',d.s?.nama,M,y+25,82);
    headerField('TTL:',fmtTTL(d.s?.ttl),M,y+32,82);
    headerField('Jenis Kelamin:',d.s?.jenis_kelamin,M,y+39,82);
    headerField('Kelas:',d.s?.level,col2,y+25,82);
    headerField('Pengajar:',d.s?.pengajar,col2,y+32,82);
    headerField('Periode:',fmt(rStart.value)+' s/d '+fmt(rEnd.value),col2,y+39,82);
    doc.setDrawColor(...green);doc.setLineWidth(.5);doc.line(M,y+47,PW-M,y+47); y+=53;
  }
  function page(){doc.addPage();y=14;addHeader();}
  function ensure(h){if(y+h>PH-bottom){page();}}
  let firstSection=true; function title(t){if(!firstSection)y+=5; firstSection=false; ensure(9);doc.setFont('helvetica','bold');doc.setFontSize(11.2);doc.setTextColor(...green);doc.text(t,M,y);y+=3.6;}
  function text(t,x,w,size=9.2){doc.setFont('helvetica','normal');doc.setFontSize(size);doc.setTextColor(25,25,25);const a=doc.splitTextToSize(safe(t),w);doc.text(a,x,y);y+=a.length*(size*0.39)+0.6;return a.length;}
  function table(headers,rows,widths,font=7){
    const rowHBase=7.0, total=widths.reduce((a,b)=>a+b,0); 
    function drawRow(vals,head=false){
      const lines=vals.map((v,i)=>doc.splitTextToSize(safe(v),Math.max(5,widths[i]-3)));
      const rh=Math.max(rowHBase,Math.max(...lines.map(a=>a.length))*3.7+2.6);
      if(y+rh>PH-bottom){page(); if(head) return drawRow(vals,head); drawRow(headers,true); return drawRow(vals,false);}
      let x=M;doc.setDrawColor(...border);doc.setLineWidth(.2);
      for(let i=0;i<vals.length;i++){
        if(head){doc.setFillColor(...light);doc.setTextColor(25,25,25);doc.setFont('helvetica','bold');}
        else {doc.setFillColor(255,255,255);doc.setTextColor(25,25,25);doc.setFont('helvetica','normal');}
        doc.rect(x,y,widths[i],rh,head?'FD':'S');doc.setFontSize(font);
        doc.text(lines[i],x+1.5,y+3.35,{baseline:'top'});x+=widths[i];
      }
      y+=rh;
    }
    drawRow(headers,true);for(const r of rows)drawRow(r,false);y+=2;
  }
  addHeader();
  // RAPORT PDF SERAGAM: Walisantri dan Pengajar mendapatkan format ringkas yang sama.
  // Detail nilai/rubrik tetap tersedia di sistem sesuai hak akses Pengajar/Admin, tetapi tidak dicetak ke PDF.
  title('RINGKASAN PEMBELAJARAN');
  const avg=d.rows.length?d.rows.reduce((a,x)=>a+Number(x.nilai||0),0)/d.rows.length:0;
  const meetings=meetingGroups(d.rows);
  text('Rata-rata keseluruhan: '+(d.rows.length?avg.toFixed(1)+' - '+grade(avg):'Belum ada nilai pada periode ini.')+' | Total Pertemuan: '+meetings.length,M,PW-2*M,9.4);
  y+=0.8;

  const groups={};
  d.rows.forEach(x=>(groups[x.jenis]??=[]).push(Number(x.nilai)||0));
  const summary=Object.entries(groups).map(([k,v])=>{
    const n=v.reduce((a,b)=>a+b,0)/v.length;
    const dates=new Set(d.rows.filter(x=>x.jenis===k).map(x=>x.date));
    return [k,String(dates.size),n.toFixed(1),grade(n)];
  });
  table(
    ['Jenis Pembelajaran','Pertemuan','Rata-rata','Predikat'],
    summary.length?summary:[['Belum ada nilai','0','-','-']],
    [95,30,32,25],8
  );

  title('REKAP KEHADIRAN');
  const att=d.attendance||[];
  const attCount={hadir:0,izin:0,sakit:0,tidak_hadir:0};
  att.forEach(x=>{const k=String(x.status||''); if(k in attCount) attCount[k]++;});
  const attPct=att.length?Math.round(attCount.hadir/att.length*100):0;
  table(['Hadir','Izin','Sakit','Tidak Hadir','% Hadir'],[[String(attCount.hadir),String(attCount.izin),String(attCount.sakit),String(attCount.tidak_hadir),attPct+'%']],[32,32,32,42,35],8);

  const dr=doaRows(d.sid,d.st,d.en);
  const hasReportPrayer=dr.some(x=>x.done||String(x.note||'').trim());
  if(hasReportPrayer){
    title('CAPAIAN HAFALAN DOA');
    table(
      ['Doa','Status','Catatan'],
      dr.map(x=>[x.name,x.done?'Tuntas':'Belum Tuntas',safe(x.note||'-')]),
      [65,35,82],7.8
    );
  }

  title('PERKEMBANGAN SANTRI');
  const predicates=meetings.map(m=>m.avg).filter(Number.isFinite);
  let perkembangan='Belum ada data perkembangan pada periode ini.';
  if(predicates.length>=2){
    const first=predicates[0], last=predicates[predicates.length-1], diff=last-first;
    perkembangan='Nilai rata-rata bergerak dari '+first.toFixed(1)+' pada awal periode menjadi '+last.toFixed(1)+' pada akhir periode ('+(diff>=0?'+':'')+diff.toFixed(1)+').';
  }else if(predicates.length===1){
    perkembangan='Terdapat 1 pertemuan pada periode ini dengan nilai rata-rata '+predicates[0].toFixed(1)+'.';
  }
  text(perkembangan,M,PW-2*M,9);

  ensure(18);
  doc.setFont('helvetica','normal');doc.setFontSize(8.2);doc.setTextColor(70,70,70);
  const note='Raport menampilkan ringkasan perkembangan santri tanpa rincian komponen atau bobot penilaian. Detail data pembelajaran tetap tersimpan di sistem dan dapat diakses sesuai hak akses.';
  const noteLines=doc.splitTextToSize(note,PW-2*M);
  doc.text(noteLines,M,y);y+=noteLines.length*3.5+4;

  ensure(10);
  doc.setFontSize(7);doc.setTextColor(90,90,90);
  doc.text('Raport ini dibuat berdasarkan data pada periode yang dipilih.',M,PH-10);
  const pages=doc.getNumberOfPages();
  for(let i=1;i<=pages;i++){
    doc.setPage(i);
    doc.setFont('helvetica','normal');doc.setFontSize(7);doc.setTextColor(100,100,100);
    doc.text('Halaman '+i+' / '+pages,PW-M,PH-10,{align:'right'});
  }
  return doc.output('blob');
}

async function savePrayerRecords(){
  if(!(isAdmin()||isPengajar())){toast('Anda tidak memiliki hak untuk menyimpan capaian doa.','error');return;}
  const sid=String(document.getElementById('dSantri')?.value||'');
  if(!sid)return toast('Pilih santri terlebih dahulu.','error');
  if(!canManageStudent(sid))return toast('Santri ini bukan santri binaan Anda.','error');
  const dt=document.getElementById('dDate')?.value||today();
  if(!sid){toast('Pilih santri terlebih dahulu.','error');return;}
  if(!canManageStudent(sid)){toast('Santri ini tidak berada dalam daftar binaan Anda.','error');return;}
  const btn=document.getElementById('savePrayerBtn');
  if(btn){btn.disabled=true;btn.textContent='⏳ Menyimpan...';}
  try{
    // Simpan seluruh checklist dalam SATU request upsert agar jauh lebih cepat.
    const rows=DOA.map((doaName,i)=>({
      student_id:sid,
      tanggal:dt,
      doa:doaName,
      tercapai:!!document.getElementById('doa_'+i)?.checked,
      catatan:(document.getElementById('doa_note_'+i)?.value||'').trim()||null,
      created_by:currentUser.id,
      updated_at:new Date().toISOString()
    }));
    const {error}=await supabaseClient
      .from('prayer_records')
      .upsert(rows,{onConflict:'student_id,tanggal,doa'});
    if(error)throw error;

    // Perbarui cache lokal tanpa reload seluruh database.
    DOA.forEach((_,i)=>{
      const key=sid+'_'+dt+'_'+i;
      if(rows[i].tercapai)db.doa[key]=true; else delete db.doa[key];
      if(rows[i].catatan)db.doa[key+'_note']=rows[i].catatan; else delete db.doa[key+'_note'];
    });
    toast('✓ Capaian doa tersimpan.','success',3000);
    renderDoa();
    renderReport();
  }catch(e){
    console.error('savePrayerRecords:',e);
    toast('Gagal menyimpan capaian doa: '+(e?.message||e),'error',7000);
  }finally{
    if(btn){btn.disabled=false;btn.textContent='💾 Simpan Capaian Doa';}
  }
}

function renderDoa(){
 if(isWali()&&getWaliStudent())dSantri.value=String(getWaliStudent().id);
 let sid=dSantri.value,dt=dDate.value||today();
 const disabled=isWali()?'disabled':'';
 doaList.innerHTML=DOA.map((n,i)=>{
   let k=sid+'_'+dt+'_'+i;
   let note=db.doa[k+'_note']||'';
   const noteField=i===9?`<textarea id="doa_note_${i}" placeholder="Catatan manual" ${disabled}>${esc(note)}</textarea>`:'';
   return `<label style="display:block;padding:8px;border-bottom:1px solid #ddd"><input id="doa_${i}" type="checkbox" style="width:auto" ${db.doa[k]?'checked':''} ${disabled}> ${esc(n)}${noteField}</label>`;
 }).join('')+((isAdmin()||isPengajar())?`<div class="actions" style="margin-top:14px"><button id="savePrayerBtn" type="button" class="btn primary" onclick="savePrayerRecords()">💾 Simpan Capaian Doa</button><span class="muted" style="align-self:center">Centang seluruh doa yang tercapai pada tanggal tersebut, lalu tekan Simpan.</span></div>`:'');
}
function backup(){if(!isAdmin())return alert('Hanya Admin yang dapat melakukan backup.');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(db,null,2)],{type:'application/json'}));a.download='Shohibul_Quran_Backup.json';a.click()}
function restore(e){if(!isAdmin())return alert('Hanya Admin yang dapat mengimpor data.');let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{db=JSON.parse(r.result);db.teachers=db.teachers||[];save();refresh();alert('Data berhasil diimpor.')}catch(err){alert('File backup tidak valid.')}};r.readAsText(f)}
function wipe(){if(!isAdmin())return alert('Hanya Admin yang dapat menghapus data.');if(confirm('Hapus seluruh data?')){db={santri:[],sessions:[],doa:{},teachers:[]};save();refresh()}}
function renderWaliAccounts(){let el=document.getElementById('akunWaliList');if(!el)return;if(!isAdmin()){el.innerHTML='';return}el.innerHTML=db.santri.length?'<table><tr><th>Santri</th><th>User ID Supabase</th><th>Status</th></tr>'+db.santri.map(s=>`<tr><td>${esc(s.nama)}</td><td style="font-size:11px">${esc(s.waliUser||'-')}</td><td>${s.waliUser?'Terhubung':'Belum terhubung'}</td></tr>`).join('')+'</table>':'<p class="muted">Belum ada santri.</p>'}
function fillPerkSantri(){
 const el=document.getElementById('perkSantri'); if(!el)return;
 const list=isAdmin()? (db.santri||[]).filter(s=>s.aktif!==false) : (isPengajar()?getPengajarStudents():[]);
 const current=el.value;
 el.innerHTML='<option value="">Pilih santri</option>'+list.map(s=>`<option value="${esc(String(s.id))}">${esc(s.nama)}</option>`).join('');
 if(current && list.some(s=>String(s.id)===current)) el.value=current; else if(list.length===1) el.value=String(list[0].id);
}
function renderPerkembangan(){
 const el=document.getElementById('perkembanganData'); if(!el)return;
 const sid=document.getElementById('perkSantri')?.value; if(!sid){el.innerHTML='<div class="card"><p class="muted">Pilih santri untuk melihat profil perkembangan.</p></div>';return;}
 const s=(db.santri||[]).find(x=>String(x.id)===String(sid)); if(!s){el.innerHTML='';return;}
 const start=document.getElementById('perkStart')?.value||''; const end=document.getElementById('perkEnd')?.value||'';
 const rows=(db.sessions||[]).filter(x=>String(x.santriId)===String(sid)&&(!start||String(x.date)>=start)&&(!end||String(x.date)<=end)&&Number.isFinite(Number(x.nilai))).sort((a,b)=>String(a.date).localeCompare(String(b.date)));
 const dates=[...new Set(rows.map(x=>String(x.date)))];
 const avg=rows.length?rows.reduce((a,x)=>a+Number(x.nilai||0),0)/rows.length:0;
 const byType={}; rows.forEach(x=>{const k=x.jenis||'Lainnya';(byType[k]??=[]).push(Number(x.nilai||0));});
 const typeRows=Object.entries(byType).map(([k,v])=>{const a=v.reduce((x,y)=>x+y,0)/v.length;return `<tr><td>${esc(k)}</td><td>${v.length}</td><td>${a.toFixed(1)}</td><td>${esc(grade(a))}</td></tr>`}).join('');
 const dayMap={};rows.forEach(x=>(dayMap[x.date]??=[]).push(Number(x.nilai||0)));
 const dailyChartRows=dates.map(d=>{const v=dayMap[d]||[];const a=v.length?v.reduce((x,y)=>x+y,0)/v.length:0;return {date:d,nilai:a,jenis:`${v.length} pembelajaran`};});
 const progressChart=buildWaliProgressChart(dailyChartRows);
 const recent=dates.slice(-10).reverse().map(d=>{const v=dayMap[d],a=v.reduce((x,y)=>x+y,0)/v.length;return `<tr><td>${fmt(d)}</td><td>${v.length} pembelajaran</td><td><b>${a.toFixed(1)}</b></td><td>${esc(grade(a))}</td></tr>`}).join('');
 const detailRows=rows.slice().sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,20).map(x=>{const q=sessionQuranDetails(x);return `<tr><td>${fmt(x.date)}</td><td>${esc(x.jenis||'-')}</td><td>${esc(q.surah)}</td><td>${esc(q.ayat)}</td><td>${esc(q.juz)}</td><td>${esc(q.halaman)}</td><td><b>${Number(x.nilai||0).toFixed(1)}</b></td><td>${esc(x.predikat||grade(Number(x.nilai||0)))}</td></tr>`}).join('');
 const doaKeys=Object.keys(db.doa||{}).filter(k=>!k.endsWith('_note')&&db.doa[k]===true&&k.startsWith(String(sid)+'_'));
 el.innerHTML=`<div class="card"><div class="dashWelcome"><div><h3>${esc(s.nama)}</h3><p class="muted">${esc(s.level||'-')} • Pengajar: ${esc(s.pengajar||'-')}</p></div><div class="dashDate">${rows.length?'Periode '+(start||'awal')+' s/d '+(end||'sekarang'):'Belum ada nilai'}</div></div><div class="dashStats"><div class="dashStat"><div class="dashIcon">📅</div><div><small>Pertemuan</small><strong>${dates.length}</strong><span>tanggal unik</span></div></div><div class="dashStat"><div class="dashIcon">📊</div><div><small>Rata-rata</small><strong>${rows.length?avg.toFixed(1):'-'}</strong><span>${rows.length?grade(avg):'Belum ada nilai'}</span></div></div><div class="dashStat"><div class="dashIcon">📚</div><div><small>Pembelajaran</small><strong>${rows.length}</strong><span>hasil penilaian</span></div></div><div class="dashStat"><div class="dashIcon">📿</div><div><small>Doa Tuntas</small><strong>${doaKeys.length}</strong><span>1 ceklis = 1 doa</span></div></div></div></div>
 <div class="card progressChart"><h3>📈 Grafik Perkembangan</h3><p class="muted">Satu titik grafik mewakili satu tanggal/pertemuan. Jika dalam satu hari ada beberapa pembelajaran, nilainya dirata-ratakan untuk titik hari tersebut.</p>${progressChart}</div>
 <div class="dashGrid2"><div class="card"><h3>📚 Rekap Jenis Pembelajaran</h3><div class="dashTableWrap"><table><tr><th>Pembelajaran</th><th>Jumlah</th><th>Rata-rata</th><th>Predikat</th></tr>${typeRows||'<tr><td colspan="4" class="muted">Belum ada data.</td></tr>'}</table></div></div><div class="card"><h3>📅 Perkembangan Terbaru</h3><div class="dashTableWrap"><table><tr><th>Tanggal</th><th>Aktivitas</th><th>Rata-rata Hari</th><th>Predikat</th></tr>${recent||'<tr><td colspan="4" class="muted">Belum ada data.</td></tr>'}</table></div><p class="muted" style="margin-top:8px">Jika satu hari memiliki beberapa pembelajaran, tetap dihitung sebagai satu pertemuan.</p></div></div>
 <div class="card"><h3>📖 Rincian Bacaan & Hafalan Terbaru</h3><p class="muted">Surah, ayat, juz, dan halaman yang dicatat pengajar. Tanda — berarti tidak diisi atau tidak relevan.</p><div class="dashTableWrap"><table><tr><th>Tanggal</th><th>Pembelajaran</th><th>Surah</th><th>Ayat</th><th>Juz</th><th>Halaman</th><th>Nilai</th><th>Predikat</th></tr>${detailRows||'<tr><td colspan="8" class="muted">Belum ada data.</td></tr>'}</table></div></div>`;
}

function renderAdminDashboard(){
  const el=document.getElementById('dashboardData');
  if(!el||!isAdmin())return;
  const students=db.santri||[], sessions=db.sessions||[], teachers=db.teachers||[];
  const activeStudents=students.filter(s=>s.aktif!==false);
  const scored=sessions.filter(x=>Number.isFinite(Number(x.nilai)));
  const avg=scored.length?scored.reduce((a,x)=>a+Number(x.nilai||0),0)/scored.length:0;
  const meetingDates=new Set(scored.map(x=>String(x.date||'')).filter(Boolean));
  const studentIdsWithScores=new Set(scored.map(x=>String(x.santriId)));
  const withoutScore=activeStudents.filter(s=>!studentIdsWithScores.has(String(s.id)));
  const doaDone=Object.keys(db.doa||{}).filter(k=>!k.endsWith('_note')&&db.doa[k]===true).length;
  const classNames=["Kelas Iqra'","Kelas Al Qur'an","Kelas Tashih","Kelas Tahfizh"];
  const classCards=classNames.map(k=>{
    const ss=activeStudents.filter(s=>s.level===k), ids=new Set(ss.map(s=>String(s.id))), rows=scored.filter(x=>ids.has(String(x.santriId)));
    const dates=new Set(rows.map(x=>String(x.date||'')).filter(Boolean));
    const a=rows.length?rows.reduce((sum,x)=>sum+Number(x.nilai||0),0)/rows.length:0;
    return `<div class="dashMini"><div class="dashMiniTitle">${esc(k)}</div><div class="dashMiniValue">${ss.length}</div><div class="muted">santri • ${dates.size} pertemuan • rata-rata ${rows.length?a.toFixed(1):'-'}</div></div>`;
  }).join('');
  const dayMap={};
  scored.forEach(x=>{const d=String(x.date||'');if(!d)return;(dayMap[d]??=[]).push(Number(x.nilai||0));});
  const days=Object.keys(dayMap).sort().slice(-10);
  const chart=days.length?`<div class="dashChart">${days.map(d=>{const vals=dayMap[d],a=vals.reduce((u,v)=>u+v,0)/vals.length,h=Math.max(8,Math.round((a/100)*150));return `<div class="dashBarCol"><div class="dashBarValue">${a.toFixed(1)}</div><div class="dashBar" style="height:${h}px" title="Rata-rata ${a.toFixed(1)} pada ${d}"></div><div class="dashBarLabel">${d.slice(8,10)}/${d.slice(5,7)}</div></div>`}).join('')}</div>`:'<div class="dashEmpty">Belum ada data pertemuan untuk grafik.</div>';
  const todayStr=today();
  const todaySchedules=(jadwalData||[]).filter(x=>x.status!=='nonaktif'&&String(x.hari||'')===hariNama(new Date()));
  const todayAttendance=(presensiCloud||[]).filter(x=>String(x.tanggal||x.date||'')===String(todayStr));
  const rawSessionStatuses=(sessionStatusCloud||[]).filter(x=>x && (x.status==='diliburkan'||x.status==='dijadwalkan_ulang'));
  // Satu santri + satu tanggal + satu status dihitung satu kali pada rekap Dashboard,
  // walaupun terdapat lebih dari satu record jadwal yang mengarah ke sesi yang sama.
  const uniqueSessionStatusMap=new Map();
  rawSessionStatuses.forEach(x=>{
    const sch=(jadwalData||[]).find(j=>String(j.id)===String(x.schedule_id));
    const studentId=String(sch?.student_id||x.student_id||'');
    const tanggal=String(x.tanggal||'').slice(0,10);
    const key=`${studentId}|${tanggal}|${x.status}`;
    const prev=uniqueSessionStatusMap.get(key);
    if(!prev || String(x.updated_at||x.created_at||'')>String(prev.updated_at||prev.created_at||'')) uniqueSessionStatusMap.set(key,{...x,__student_id:studentId});
  });
  const sessionStatuses=[...uniqueSessionStatusMap.values()];
  const totalDiliburkan=sessionStatuses.filter(x=>x.status==='diliburkan').length;
  const totalDijadwalkanUlang=sessionStatuses.filter(x=>x.status==='dijadwalkan_ulang').length;
  const recentSessionStatuses=sessionStatuses.slice().sort((a,b)=>String(b.tanggal||'').localeCompare(String(a.tanggal||''))).slice(0,5);
  const sessionStatusRecentHtml=recentSessionStatuses.length?recentSessionStatuses.map(x=>{
    const sch=(jadwalData||[]).find(j=>String(j.id)===String(x.schedule_id));
    const st=students.find(a=>String(a.id)===String(x.__student_id||sch?.student_id));
    const label=x.status==='diliburkan'?'Diliburkan':'Dijadwalkan ulang';
    return `<div style="display:flex;justify-content:space-between;gap:8px;padding:7px 0;border-bottom:1px solid var(--line);font-size:12px"><span><b>${fmt(x.tanggal)}</b> · ${esc(st?.nama||sch?.santri_nama||'-')}</span><span class="muted">${label}</span></div>`;
  }).join(''):'<div class="muted">Belum ada pembelajaran yang diliburkan atau dijadwalkan ulang.</div>';
  const hadir=todayAttendance.filter(x=>String(x.status||'').toLowerCase()==='hadir').length;
  const izin=todayAttendance.filter(x=>String(x.status||'').toLowerCase()==='izin').length;
  const sakit=todayAttendance.filter(x=>String(x.status||'').toLowerCase()==='sakit').length;
  const tidakHadir=todayAttendance.filter(x=>['tidak hadir','tidak_hadir','alpha','alpa'].includes(String(x.status||'').toLowerCase())).length;
  const currentMonth=monthNow();
  let sppBilled=0,sppPaid=0,sppOutstanding=0,sppLunas=0,sppUnpaid=0;
  activeStudents.forEach(st=>{try{const r=calcSpp(st,currentMonth),bill=sppBillFor(st.id,currentMonth),p=sppPaidFor(st.id,currentMonth),amount=r.cfg.model==='per_pertemuan'?Number(r.amount||0):Number(bill?.nominal_tagihan??r.amount);sppBilled+=amount;sppPaid+=p;const rem=Math.max(0,amount-p);sppOutstanding+=rem;if(amount>0&&rem<=0)sppLunas++;else if(amount>0&&p<=0)sppUnpaid++;}catch(e){}});
  const financeRows=financeTransactionsCloud||[];
  const financeIncome=financeRows.filter(x=>String(x.jenis||x.type||'').toLowerCase()==='pemasukan').reduce((a,x)=>a+Number(x.nominal||x.amount||0),0);
  const financeExpense=financeRows.filter(x=>String(x.jenis||x.type||'').toLowerCase()==='pengeluaran').reduce((a,x)=>a+Number(x.nominal||x.amount||0),0);
  const financeBalance=Number(financeOpeningCloud||0)+financeIncome-financeExpense;
  const recent=sessions.slice().sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,6);
  const recentHtml=recent.length?`<div class="dashTableWrap"><table><tr><th>Tanggal</th><th>Santri</th><th>Pembelajaran</th><th>Nilai</th><th>Predikat</th></tr>${recent.map(x=>{const st=students.find(s=>String(s.id)===String(x.santriId));return `<tr><td>${fmt(x.date)}</td><td><b>${esc(st?.nama||'-')}</b></td><td>${esc(x.jenis||'-')}</td><td><b>${Number(x.nilai||0).toFixed(1)}</b></td><td>${esc(grade(x.nilai))}</td></tr>`}).join('')}</table></div>`:'<div class="dashEmptyBox">Belum ada sesi pembelajaran.</div>';
  const scheduleHtml=todaySchedules.length?todaySchedules.slice(0,6).map(x=>{const st=students.find(s=>String(s.id)===String(x.student_id));return `<div class="scheduleItem"><div class="scheduleTime">${esc(x.jam||x.waktu||'-')}</div><h4>${esc(st?.nama||x.santri_nama||x.student_name||x.nama_santri||'-')}</h4><div class="muted">${esc(x.kelas||'-')} • ${esc(x.jenis||x.jenis_pembelajaran||'-')}</div></div>`}).join(''):'<div class="dashEmptyBox">Tidak ada jadwal aktif untuk hari ini.</div>';
  const missingHtml=withoutScore.length?withoutScore.slice(0,8).map(s=>`<span class="dashPill">${esc(s.nama)} <small>${esc(s.level||'')}</small></span>`).join(''):'<span class="muted">Semua santri aktif sudah memiliki minimal satu nilai.</span>';
  const quick=`<div class="dashAdminActions">
    <button class="dashQuickBtn" onclick="showPage('santri',document.getElementById('navSantri'))"><span class="dashQuickIcon">👥</span><span><b>Data Santri</b><small>Kelola data santri</small></span></button>
    <button class="dashQuickBtn" onclick="showPage('jadwal',document.getElementById('navJadwal'))"><span class="dashQuickIcon">🗓️</span><span><b>Jadwal</b><small>Atur jadwal mengaji</small></span></button>
    <button class="dashQuickBtn" onclick="openPresensiAtTarget(document.getElementById('navPresensi'))"><span class="dashQuickIcon">📋</span><span><b>Presensi</b><small>Catat kehadiran</small></span></button>
    <button class="dashQuickBtn" onclick="showPage('nilai',document.getElementById('navNilai'))"><span class="dashQuickIcon">📝</span><span><b>Pembelajaran & Nilai</b><small>Input hasil belajar</small></span></button>
  </div>`;
  el.innerHTML=`<div class="dashWelcome"><div><h3>Dashboard Admin</h3><p class="muted">Pusat ringkasan operasional Shohibul Quran System.</p></div><div class="dashDate">${fmt(today())}</div></div>
    ${quick}
    <div class="dashStats">
      <div class="dashStat"><div class="dashIcon">👥</div><div><small>Santri Aktif</small><strong>${activeStudents.length}</strong><span>Total data: ${students.length}</span></div></div>
      <div class="dashStat"><div class="dashIcon">👨‍🏫</div><div><small>Pengajar</small><strong>${teachers.length}</strong><span>${teachers.filter(x=>x.status==='Aktif').length} aktif</span></div></div>
      <div class="dashStat"><div class="dashIcon">📅</div><div><small>Pertemuan</small><strong>${meetingDates.size}</strong><span>1 tanggal = 1 pertemuan</span></div></div>
      <div class="dashStat"><div class="dashIcon">📊</div><div><small>Rata-rata Nilai</small><strong>${scored.length?avg.toFixed(1):'-'}</strong><span>${scored.length?grade(avg):'Belum ada nilai'}</span></div></div>
      <div class="dashStat"><div class="dashIcon">🤲</div><div><small>Doa Tuntas</small><strong>${doaDone}</strong><span>Jumlah doa yang diceklis</span></div></div>
    </div>
    <div class="dashAdminGrid">
      <div class="dashAdminPanel"><h3>📋 Presensi Hari Ini</h3><div class="dashAdminMetric">${todayAttendance.length}</div><div class="muted">Data presensi tercatat</div><div class="dashAdminStatus"><span>Hadir ${hadir}</span><span>Izin ${izin}</span><span>Sakit ${sakit}</span><span>Tidak Hadir ${tidakHadir}</span></div></div>
      <div class="dashAdminPanel"><h3>💰 SPP ${esc(currentMonth)}</h3><div class="dashAdminMetric">${money(sppBilled)}</div><div class="muted">Total tagihan bulan berjalan</div><div class="dashAdminStatus"><span>Dibayar ${money(sppPaid)}</span><span>Sisa ${money(sppOutstanding)}</span><span>Lunas ${sppLunas}</span><span>Belum ${sppUnpaid}</span></div></div>
      <div class="dashAdminPanel"><h3>💵 Keuangan</h3><div class="dashAdminMetric">${money(financeBalance)}</div><div class="muted">Saldo saat ini</div><div class="dashAdminStatus"><span>Masuk ${money(financeIncome)}</span><span>Keluar ${money(financeExpense)}</span></div></div>
    </div>
    <div class="dashGrid2 dashSection"><div class="card dashPanel"><h3>🏖️ Rekap Pembelajaran Diliburkan</h3><div class="dashMiniGrid"><div class="dashMini"><div class="dashMiniTitle">Total Diliburkan</div><div class="dashMiniValue">${totalDiliburkan}</div><div class="muted">tidak dihitung sebagai absen santri</div></div><div class="dashMini"><div class="dashMiniTitle">Dijadwalkan Ulang</div><div class="dashMiniValue">${totalDijadwalkanUlang}</div><div class="muted">pertemuan yang ditunda</div></div></div><div style="margin-top:10px"><b style="font-size:12px">Riwayat Terakhir</b>${sessionStatusRecentHtml}</div></div><div class="card dashPanel"><h3>ℹ️ Keterangan</h3><p class="muted">Pertemuan yang diliburkan atau dijadwalkan ulang tidak masuk sebagai ketidakhadiran santri dan tidak membuat sesi pembelajaran baru.</p><div class="dashAlert">Gunakan menu Jadwal → Presensi untuk mengubah status pertemuan.</div></div></div>
    <div class="dashGrid2 dashSection"><div class="card dashPanel"><h3>📌 Aktivitas Hari Ini</h3><div class="dashMiniGrid"><div class="dashMini"><div class="dashMiniTitle">Jadwal Hari Ini</div><div class="dashMiniValue">${todaySchedules.length}</div><div class="muted">jadwal aktif</div></div><div class="dashMini"><div class="dashMiniTitle">Presensi Tercatat</div><div class="dashMiniValue">${todayAttendance.length}</div><div class="muted">${hadir} hadir</div></div></div>${todaySchedules.length?'':'<div class="dashAlert">Belum ada jadwal aktif hari ini.</div>'}</div><div class="card dashPanel"><h3>⚠️ Perlu Perhatian</h3><p class="muted">Santri aktif yang belum memiliki penilaian.</p><div class="dashPills">${missingHtml}</div></div></div>
    <div class="dashGrid2 dashSection"><div class="card dashPanel"><h3>📈 Tren Nilai Harian</h3><p class="muted">Rata-rata nilai per tanggal.</p>${chart}</div><div class="card dashPanel"><h3>🏫 Rekap Per Kelas</h3><div class="dashMiniGrid">${classCards}</div></div></div>
    <div class="dashGrid2 dashSection"><div class="card dashPanel"><h3>🗓️ Jadwal Hari Ini</h3><div class="scheduleToday">${scheduleHtml}</div></div><div class="card dashPanel"><h3>🕒 Pembelajaran Terbaru</h3>${recentHtml}</div></div>`;
}
function normalizeScheduleKind(value){
  return String(value||'').normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'');
}
function getScheduleSessionState(schedule,date=today()){
  const sid=String(schedule?.student_id||schedule?.santriId||schedule?.studentId||'');
  const kind=normalizeScheduleKind(schedule?.jenis||schedule?.jenis_pembelajaran||'');
  const day=String(date).slice(0,10);
  if(!sid)return {completed:false,attendance:false,lesson:false,status:null};
  const statusRow=(sessionStatusCloud||[]).find(r=>String(r.schedule_id)===String(schedule?.id||'')&&String(r.tanggal||'').slice(0,10)===day);
  const attendance=(presensiCloud||[]).some(r=>String(r.student_id||r.santriId||'')===sid&&String(r.tanggal||r.date||'').slice(0,10)===day);
  const lesson=(db.sessions||[]).some(row=>{
    const rowSid=String(row.santriId||row.student_id||row.studentId||'');
    const rowDate=String(row.date||row.tanggal||row.session_date||'').slice(0,10);
    if(rowSid!==sid||rowDate!==day)return false;
    const rowKind=normalizeScheduleKind(row.jenis||row.jenis_pembelajaran||row.learning_type||'');
    return !kind||!rowKind||rowKind===kind;
  });
  return {completed:attendance&&lesson,attendance,lesson,status:statusRow?.status||null};
}
function isScheduleLessonCompleted(schedule,date=today()){
  return getScheduleSessionState(schedule,date).completed;
}
function completedMeetingLabel(){return '<span class="badge" style="display:inline-block;padding:10px 12px">✓ Presensi & pembelajaran selesai</span>'}
function scheduleActionLabel(schedule,date=today()){
  const state=getScheduleSessionState(schedule,date);
  if(state.status==='diliburkan')return '<span class="badge" style="display:inline-block;padding:10px 12px">🔴 Pembelajaran diliburkan</span>';
  if(state.status==='dijadwalkan_ulang')return '<span class="badge" style="display:inline-block;padding:10px 12px">🔄 Dijadwalkan ulang</span>';
  if(state.completed)return completedMeetingLabel();
  if(state.attendance&&!state.lesson)return '<span class="badge" style="display:inline-block;padding:10px 12px">✓ Presensi tersimpan · lanjutkan pembelajaran</span>';
  if(state.lesson&&!state.attendance)return '<span class="badge" style="display:inline-block;padding:10px 12px">✓ Pembelajaran tersimpan · lengkapi presensi</span>';
  return '';
}
function startScheduleSession(studentId, jenis){
  const already=isScheduleLessonCompleted({student_id:studentId,jenis:jenis},today());
  if(already){toast('Pertemuan ini sudah selesai dan nilai telah tersimpan.','info');renderJadwal();renderPengajarDashboard();return;}

  try{
    const st=(db.santri||[]).find(s=>String(s.id)===String(studentId));
    if(!st)return toast('Santri pada jadwal tidak ditemukan.','error');
    const ps=document.getElementById('presSantri'); if(ps){ps.value=st.id;}
    const pt=document.getElementById('presTanggal'); if(pt)pt.value=today();
    openPresensiAtTarget(document.getElementById('navPresensi'));
    const ctx=document.getElementById('presensiScheduleContext');
    if(ctx){ctx.style.display='block';ctx.textContent='📅 Pertemuan dimulai dari jadwal hari ini untuk '+st.nama+'. Silakan catat presensi, lalu lanjutkan ke Sesi & Nilai.';}
    const btn=document.getElementById('continueSessionBtn'); if(btn)btn.style.display='inline-flex';
    if(typeof renderPresensi==='function')renderPresensi();
  }catch(e){console.error(e);toast('Gagal membuka pertemuan dari jadwal.','error');}
}

function renderPengajarDashboard(){
  const el=document.getElementById('dashboardData');
  if(!el||!isPengajar())return;
  const students=getPengajarStudents(),ids=new Set(students.map(s=>String(s.id)));
  const rows=(db.sessions||[]).filter(x=>ids.has(String(x.santriId))&&Number.isFinite(Number(x.nilai)));
  const avg=rows.length?rows.reduce((a,x)=>a+Number(x.nilai||0),0)/rows.length:0;
  const meetingDates=new Set(rows.map(x=>String(x.date||'')).filter(Boolean));
  const without=students.filter(s=>!rows.some(x=>String(x.santriId)===String(s.id)));
  const recent=rows.slice().sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,6);
  const doaDone=Object.keys(db.doa||{}).filter(k=>!k.endsWith('_note')&&db.doa[k]===true).filter(k=>{const parts=k.split('_');parts.pop();const sid=parts.join('_');return ids.has(String(sid));}).length;
  const todayStr=today();
  const todaySchedules=(jadwalData||[]).filter(x=>x.status!=='nonaktif'&&String(x.hari||'')===hariNama(new Date())&&ids.has(String(x.student_id||x.santriId||x.studentId||''))).sort((a,b)=>String(a.jam||a.waktu||'').localeCompare(String(b.jam||b.waktu||'')));
  const findStudent=x=>students.find(s=>String(s.id)===String(x.student_id||x.santriId||x.studentId));
  const scheduleHtml=todaySchedules.length?`<div class="teacherTodayList">${todaySchedules.slice(0,8).map(x=>{const st=findStudent(x);const sid=st?.id||x.student_id||x.santriId||x.studentId||'';const done=isScheduleLessonCompleted(x,todayStr);return `<div class="teacherTodayItem"><div class="teacherTodayTime">${esc(x.jam||x.waktu||'-')}</div><div><h4>${esc(x.santri_nama||x.student_name||x.nama_santri||st?.nama||'-')}</h4><div class="muted">${esc(x.kelas||'-')} • ${esc(x.jenis||x.jenis_pembelajaran||'-')}</div></div>${done?completedMeetingLabel():`<button class="btn primary" onclick="startScheduleSession('${esc(String(sid))}','${esc(String(x.jenis||x.jenis_pembelajaran||''))}')">▶ Mulai Pertemuan</button>`}</div>`}).join('')}</div>`:'<div class="teacherEmpty">Tidak ada jadwal binaan untuk hari ini.</div>';
  const recentHtml=recent.length?`<div class="dashTableWrap"><table><tr><th>Tanggal</th><th>Santri</th><th>Pembelajaran</th><th>Surah</th><th>Ayat</th><th>Juz</th><th>Halaman</th><th>Nilai</th><th>Predikat</th></tr>${recent.map(x=>{const st=students.find(s=>String(s.id)===String(x.santriId));const q=sessionQuranDetails(x);return`<tr><td>${fmt(x.date)}</td><td><b>${esc(st?.nama||'-')}</b></td><td>${esc(x.jenis||'-')}</td><td>${esc(q.surah)}</td><td>${esc(q.ayat)}</td><td>${esc(q.juz)}</td><td>${esc(q.halaman)}</td><td><b>${Number(x.nilai||0).toFixed(1)}</b></td><td>${esc(grade(x.nilai))}</td></tr>`}).join('')}</table></div>`:'<div class="teacherEmpty">Belum ada pembelajaran tersimpan.</div>';
  const missingHtml=without.length?`<div class="teacherAttention">${without.slice(0,8).map(s=>`<div class="teacherAttentionItem"><span><b>${esc(s.nama)}</b><br><small class="muted">${esc(s.level||'Belum ada nilai')}</small></span><button class="btn" onclick="showPage('pembelajaran',document.querySelector('[onclick*=&quot;pembelajaran&quot;]'))">Input Nilai</button></div>`).join('')}</div>`:'<div class="dashGood">✓ Semua santri binaan sudah memiliki minimal satu penilaian.</div>';
  el.innerHTML=`
    <div class="teacherDashHead"><div class="headRow"><div><h3>Dashboard Pengajar</h3><p class="muted">Selamat datang, <b>${esc(getCurrentTeacher()?.nama_lengkap||'Pengajar')}</b> · Pengajar Shohibul Quran</p></div><div class="teacherDashBadge">📅 ${fmt(today())}</div></div></div>
    <div class="teacherDashQuick">
      <button class="dashQuickBtn" onclick="openPresensiAtTarget(document.getElementById('navPresensi'))"><span class="dashQuickIcon">📋</span><span><b>Presensi</b><small>Catat kehadiran</small></span></button>
      <button class="dashQuickBtn" onclick="showPage('pembelajaran',document.querySelector('[onclick*=&quot;pembelajaran&quot;]'))"><span class="dashQuickIcon">📝</span><span><b>Pembelajaran & Nilai</b><small>Input hasil belajar</small></span></button>
      <button class="dashQuickBtn" onclick="showPage('perkembangan',document.getElementById('navPerkembangan'))"><span class="dashQuickIcon">📈</span><span><b>Perkembangan</b><small>Lihat progres santri</small></span></button>
      <button class="dashQuickBtn" onclick="showPage('raport',document.getElementById('navRaport'))"><span class="dashQuickIcon">📄</span><span><b>Raport</b><small>Rekap hasil belajar</small></span></button>
    </div>
    <div class="dashStats">
      <div class="dashStat"><div class="dashIcon">👥</div><div><small>Santri Binaan</small><strong>${students.length}</strong><span>Santri yang ditugaskan</span></div></div>
      <div class="dashStat"><div class="dashIcon">📅</div><div><small>Total Pertemuan</small><strong>${meetingDates.size}</strong><span>1 tanggal = 1 pertemuan</span></div></div>
      <div class="dashStat"><div class="dashIcon">📊</div><div><small>Rata-rata Nilai</small><strong>${rows.length?avg.toFixed(1):'-'}</strong><span>${rows.length?grade(avg):'Belum ada nilai'}</span></div></div>
      <div class="dashStat"><div class="dashIcon">⚠️</div><div><small>Belum Ada Nilai</small><strong>${without.length}</strong><span>Santri binaan</span></div></div>
      <div class="dashStat"><div class="dashIcon">🤲</div><div><small>Doa Tuntas</small><strong>${doaDone}</strong><span>Jumlah doa yang diceklis</span></div></div>
    </div>
    <div class="dashGrid2 dashSection"><div class="card dashPanel"><h3>🗓️ Jadwal Hari Ini</h3><p class="muted">Jadwal yang terhubung dengan santri binaan Anda.</p>${scheduleHtml}</div><div class="card dashPanel"><h3>⚠️ Perlu Perhatian</h3><p class="muted">Santri binaan yang belum memiliki penilaian.</p>${missingHtml}</div></div>
    <div class="card dashPanel"><h3>🕒 Pembelajaran Terbaru</h3><p class="muted">Enam penilaian terakhir dari santri binaan Anda, termasuk surah, ayat, juz, dan halaman jika dicatat.</p>${recentHtml}</div>`;
}

function renderPengajarManagement(){
  const el=document.getElementById('pengajarManagement');if(!el||!isAdmin())return;
  const rows=(db.teachers||[]); const active=rows.filter(x=>x.status==='Aktif').length;
  el.innerHTML=`<div class="grid"><div class="dashMini"><div class="dashMiniTitle">Total Pengajar</div><div class="dashMiniValue">${rows.length}</div><div class="muted">Data pengajar terdaftar</div></div><div class="dashMini"><div class="dashMiniTitle">Pengajar Aktif</div><div class="dashMiniValue">${active}</div><div class="muted">Dapat dipilih untuk penugasan</div></div></div><p class="muted" style="margin-top:10px">Gunakan menu <b>Data Pengajar</b> untuk menambah, mengedit, menonaktifkan, atau menghapus pengajar. Kolom Pengajar pada Data Santri sekarang menggunakan daftar pengajar aktif.</p>`;
}


function backupSnapshot(){
  return {
    app:'Shohibul Quran System',
    format_version:1,
    exported_at:new Date().toISOString(),
    db:{santri:db.santri||[],sessions:db.sessions||[],doa:db.doa||{},teachers:db.teachers||[]},
    cloud:{
      attendance_records:presensiCloud||[],
      session_statuses:sessionStatusCloud||[],
      schedules:jadwalData||[],
      spp_settings:sppSettingsCloud||[],
      spp_bills:sppBillsCloud||[],
      spp_payments:sppPaymentsCloud||[],
      finance_transactions:financeTransactionsCloud||[],
      finance_opening_balance:Number(financeOpeningCloud||0)
    }
  };
}
function downloadBackupJSON(){
  if(!isAdmin()){toast('Fitur backup hanya tersedia untuk Admin.','error');return}
  const payload=backupSnapshot();
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json;charset=utf-8'});
  const url=URL.createObjectURL(blob); const a=document.createElement('a');
  const stamp=new Date().toISOString().slice(0,19).replace(/[T:]/g,'-');
  a.href=url; a.download='Shohibul_Quran_Backup_'+stamp+'.json'; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
  const c=payload.cloud; const info=document.getElementById('backupInfo');
  if(info)info.textContent=`Backup dibuat ${new Date().toLocaleString('id-ID')} • ${payload.db.santri.length} santri • ${payload.db.sessions.length} sesi • ${payload.db.teachers.length} pengajar • ${c.attendance_records.length} presensi • ${c.schedules.length} jadwal • ${c.spp_bills.length} tagihan SPP • ${c.finance_transactions.length} transaksi keuangan.`;
  toast('Backup JSON berhasil dibuat.','success');
}
function normalizeBackup(raw){
  if(!raw||raw.app!=='Shohibul Quran System'||!raw.db)return null;
  const c=raw.cloud||{};
  return {db:{santri:Array.isArray(raw.db.santri)?raw.db.santri:[],sessions:Array.isArray(raw.db.sessions)?raw.db.sessions:[],doa:raw.db.doa&&typeof raw.db.doa==='object'?raw.db.doa:{},teachers:Array.isArray(raw.db.teachers)?raw.db.teachers:[]},cloud:{attendance_records:Array.isArray(c.attendance_records)?c.attendance_records:[],session_statuses:Array.isArray(c.session_statuses)?c.session_statuses:[],schedules:Array.isArray(c.schedules)?c.schedules:[],spp_settings:Array.isArray(c.spp_settings)?c.spp_settings:[],spp_bills:Array.isArray(c.spp_bills)?c.spp_bills:[],spp_payments:Array.isArray(c.spp_payments)?c.spp_payments:[],finance_transactions:Array.isArray(c.finance_transactions)?c.finance_transactions:[],finance_opening_balance:Number(c.finance_opening_balance||0)}};
}
async function restoreBackupJSON(e){
  if(!isAdmin()){toast('Restore hanya tersedia untuk Admin.','error');return}
  const file=e.target.files?.[0]; if(!file)return;
  try{
    const raw=JSON.parse(await file.text()); const snap=normalizeBackup(raw);
    if(!snap)throw new Error('Format backup tidak dikenali. Gunakan file Backup JSON dari Shohibul Quran System.');
    const total=snap.db.santri.length+snap.db.sessions.length+snap.db.teachers.length+snap.cloud.attendance_records.length+snap.cloud.session_statuses.length+snap.cloud.schedules.length+snap.cloud.spp_bills.length+snap.cloud.spp_payments.length+snap.cloud.finance_transactions.length;
    if(!confirm(`Restore ${total} data dari backup ${raw.exported_at||'-'}? Data yang memiliki ID sama akan diperbarui. Data lain tidak dihapus.`))return;
    const errors=[];
    const write=async(label,query)=>{const r=await query;if(r?.error){errors.push(label+': '+r.error.message);return false}return true};
    if(snap.db.santri.length) await write('Santri',supabaseClient.from('students').upsert(snap.db.santri.map(s=>({id:s.id,nama:s.nama,tempat_lahir:s.tempat_lahir||'',tanggal_lahir:s.tanggal_lahir||null,alamat:s.alamat||'',walisantri:s.wali||'',wali_email_login:s.wali_email_login||null,wali_user_id:(s.wali_user_id||s.waliUser)||null,kelas:s.level||'',pengajar:s.pengajar||'',jenis_kelamin:s.jenis_kelamin||'',aktif:s.aktif!==false})),{onConflict:'id'}));
    if(snap.db.sessions.length) await write('Sesi pembelajaran',supabaseClient.from('learning_sessions').upsert(snap.db.sessions.map(x=>({id:x.id,student_id:x.santriId,tanggal:x.date,kelas:x.kelas,jenis_pembelajaran:x.jenis,fields:x.fields||{},scores:x.scores||[],nilai:Number(x.nilai||0),predikat:x.predikat||grade(x.nilai),rubric_scores:x.rubricScores||[],catatan:x.catatan||'',created_by:currentUser.id})),{onConflict:'id'}));
    if(snap.cloud.attendance_records.length) await write('Presensi',supabaseClient.from('attendance_records').upsert(snap.cloud.attendance_records,{onConflict:'student_id,tanggal'}));
    if(snap.cloud.schedules.length) await write('Jadwal',supabaseClient.from('schedules').upsert(snap.cloud.schedules,{onConflict:'id'}));
    if(snap.cloud.spp_settings.length) await write('Pengaturan SPP',supabaseClient.from('spp_settings').upsert(snap.cloud.spp_settings,{onConflict:'student_id'}));
    if(snap.cloud.spp_bills.length) await write('Tagihan SPP',supabaseClient.from('spp_bills').upsert(snap.cloud.spp_bills,{onConflict:'student_id,periode'}));
    if(snap.cloud.spp_payments.length) await write('Pembayaran SPP',supabaseClient.from('spp_payments').upsert(snap.cloud.spp_payments,{onConflict:'id'}));
    if(snap.cloud.finance_transactions.length) await write('Transaksi keuangan',supabaseClient.from('finance_transactions').upsert(snap.cloud.finance_transactions,{onConflict:'id'}));
    const prayers=[];Object.keys(snap.db.doa).forEach(k=>{if(k.endsWith('_note'))return;const parts=k.split('_'),idx=parts.pop(),tanggal=parts.pop(),student_id=parts.join('_');const doa=DOA[Number(idx)]||idx;if(snap.db.doa[k]||snap.db.doa[k+'_note'])prayers.push({student_id,tanggal,doa,tercapai:!!snap.db.doa[k],catatan:snap.db.doa[k+'_note']||null,created_by:currentUser.id})});
    for(const prayer of prayers){const q=await supabaseClient.from('prayer_records').select('id').eq('student_id',prayer.student_id).eq('tanggal',prayer.tanggal).eq('doa',prayer.doa).maybeSingle();if(q.error){errors.push('Doa: '+q.error.message);continue}const r=q.data?await supabaseClient.from('prayer_records').update({tercapai:prayer.tercapai,catatan:prayer.catatan,updated_at:new Date().toISOString()}).eq('id',q.data.id):await supabaseClient.from('prayer_records').insert(prayer);if(r.error)errors.push('Doa: '+r.error.message)}
    await loadCloudData(); await loadSppCloud(); await loadFinanceCloud(); await loadJadwalCloud(); refresh();
    if(errors.length){alert('Restore selesai dengan beberapa bagian yang gagal:\n\n'+errors.join('\n'))}else{toast('Restore backup berhasil. Data dengan ID sama telah diperbarui.','success')}
  }catch(err){alert('Restore gagal: '+(err?.message||err))}finally{e.target.value=''}
}

function renderKomunikasi(){
  const el=document.getElementById('komunikasiData'); if(!el||!currentUser)return;
  const students=isAdmin()?(db.santri||[]):(isPengajar()?getPengajarStudents():[]);
  const ids=new Set(students.map(s=>String(s.id)));
  const rows=(db.sessions||[]).filter(x=>ids.has(String(x.santriId)));
  const todayDate=new Date(); const start=new Date(todayDate); start.setDate(start.getDate()-6); const startStr=start.toISOString().slice(0,10), endStr=todayDate.toISOString().slice(0,10);
  const week=rows.filter(x=>String(x.date||'')>=startStr&&String(x.date||'')<=endStr);
  const meetings=new Set(week.map(x=>String(x.date||'')).filter(Boolean));
  const avg=week.length?week.reduce((a,x)=>a+Number(x.nilai||0),0)/week.length:0;
  const notes=rows.filter(x=>String(x.catatan||'').trim()).slice().sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,12);
  const latest=rows.slice().sort((a,b)=>String(b.date).localeCompare(String(a.date))).slice(0,10);
  const noteHtml=notes.length?notes.map(x=>{const st=students.find(s=>String(s.id)===String(x.santriId));return `<div class="card" style="margin:0 0 8px"><div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap"><b>${esc(st?.nama||'-')}</b><span class="muted">${fmt(x.date)} • ${esc(x.jenis||'-')}</span></div><div style="margin-top:7px">${esc(x.catatan)}</div></div>`}).join(''):'<p class="muted">Belum ada catatan perkembangan pengajar.</p>';
  const activityHtml=latest.length?`<div style="overflow:auto"><table><tr><th>Tanggal</th><th>Santri</th><th>Pembelajaran</th><th>Nilai</th><th>Predikat</th></tr>${latest.map(x=>{const st=students.find(s=>String(s.id)===String(x.santriId));return `<tr><td>${fmt(x.date)}</td><td>${esc(st?.nama||'-')}</td><td>${esc(x.jenis||'-')}</td><td><b>${Number(x.nilai||0).toFixed(1)}</b></td><td>${esc(grade(x.nilai))}</td></tr>`}).join('')}</table></div>`:'<p class="muted">Belum ada aktivitas pembelajaran.</p>';
  el.innerHTML=`<div class="dashStats"><div class="dashStat"><div class="dashIcon">📅</div><div><small>Pertemuan 7 Hari</small><strong>${meetings.size}</strong><span>1 tanggal = 1 pertemuan</span></div></div><div class="dashStat"><div class="dashIcon">📊</div><div><small>Rata-rata 7 Hari</small><strong>${week.length?avg.toFixed(1):'-'}</strong><span>${week.length?grade(avg):'Belum ada data'}</span></div></div><div class="dashStat"><div class="dashIcon">📝</div><div><small>Catatan Pengajar</small><strong>${notes.length}</strong><span>Catatan tersimpan</span></div></div></div><div class="dashGrid2"><div class="card"><h3>📝 Catatan Perkembangan</h3><p class="muted">Catatan yang sudah tersimpan pada sesi pembelajaran.</p>${noteHtml}</div><div class="card"><h3>🕒 Aktivitas Terbaru</h3>${activityHtml}</div></div>`;
}

const SPP_KEY='shohibul_spp_settings_v22';
const SPP_PAY_KEY='shohibul_spp_payments_v22';
let sppCloudReady=false;
let sppSettingsCloud=[];
let sppBillsCloud=[];
let sppPaymentsCloud=[];
let financeTransactionsCloud=[]; let financeCloudReady=false; let financeOpeningCloud=0;
function loadSppStore(key){try{return JSON.parse(localStorage.getItem(key)||'{}')}catch(e){return {}}}
function saveSppStore(key,obj){localStorage.setItem(key,JSON.stringify(obj))}
function getSppSettings(){return loadSppStore(SPP_KEY)}
function getSppPayments(){return loadSppStore(SPP_PAY_KEY)}
function monthNow(){return new Date().toISOString().slice(0,7)}
function uniqueMeetingCount(studentId,month){const dates=new Set((db.sessions||[]).filter(x=>String(x.santriId)===String(studentId)&&String(x.date||'').slice(0,7)===month).map(x=>String(x.date)).filter(Boolean));return dates.size}
function money(n){return 'Rp '+Number(n||0).toLocaleString('id-ID')}
function sppStudentRows(){return visibleStudents().filter(s=>s.aktif!==false)}
function localCfg(studentId){const x=getSppSettings()[studentId];return x||{model:'tetap',nominal:0,tarif:0}}
function cloudCfg(studentId){const x=sppSettingsCloud.find(r=>String(r.student_id)===String(studentId));return x?{model:x.model||'tetap',nominal:Number(x.nominal||0),tarif:Number(x.tarif||0)}:localCfg(studentId)}
function calcSpp(student,month){const cfg=cloudCfg(student.id);let meetings=uniqueMeetingCount(student.id,month);let amount=cfg.model==='per_pertemuan'?meetings*Number(cfg.tarif||0):Number(cfg.nominal||0);return {cfg,meetings,amount}}
async function loadSppCloud(){
  sppCloudReady=false;
  const [a,b,c]=await Promise.all([
    supabaseClient.from('spp_settings').select('*'),
    supabaseClient.from('spp_bills').select('*'),
    supabaseClient.from('spp_payments').select('*').order('tanggal_bayar',{ascending:false})
  ]);
  const err=[a,b,c].find(x=>x.error);
  if(err){
    const msg=String(err.error?.message||err.error||'');
    sppCloudReady=false;
    if(/could not find the table|relation .* does not exist|schema cache/i.test(msg)){
      throw new Error('Tabel SPP belum dibuat di Supabase. Buka Pengaturan → Setup SPP Supabase, jalankan SQL sekali di Supabase SQL Editor, lalu muat ulang aplikasi.');
    }
    throw new Error(msg);
  }
  sppSettingsCloud=a.data||[]; sppBillsCloud=b.data||[]; sppPaymentsCloud=c.data||[]; sppCloudReady=true;
}
async function loadFinanceCloud(){
  financeCloudReady=false; financeOpeningCloud=0;
  const [tx,settings]=await Promise.all([
    supabaseClient.from('finance_transactions').select('*').order('tanggal',{ascending:false}).order('created_at',{ascending:false}),
    supabaseClient.from('finance_settings').select('*').limit(1)
  ]);
  if(tx.error){console.warn('Keuangan cloud belum siap:',tx.error.message); financeTransactionsCloud=[]; return;}
  financeTransactionsCloud=tx.data||[]; financeOpeningCloud=Number(settings.data?.[0]?.saldo_awal||0); financeCloudReady=true;
}
function financeRows(){return isAdmin()?financeTransactionsCloud:[];}
function resetFinanceForm(){
  const d=document.getElementById('finDate'); if(d)d.value=today();
  const a=document.getElementById('finAmount'); if(a)a.value='';
  const n=document.getElementById('finNote'); if(n)n.value='';
}
async function saveFinanceTransaction(){
  if(!isAdmin())return alert('Hanya Admin yang dapat mengelola keuangan.');
  const type=document.getElementById('finType')?.value||'income';
  const category=(document.getElementById('finCategory')?.value||'').trim();
  const tanggal=document.getElementById('finDate')?.value||today();
  const amount=Number(document.getElementById('finAmount')?.value||0);
  const note=(document.getElementById('finNote')?.value||'').trim();
  if(!category)return alert('Pilih kategori transaksi.');
  if(!tanggal)return alert('Tanggal wajib diisi.');
  if(!(amount>0))return alert('Nominal harus lebih dari 0.');
  const {error}=await supabaseClient.from('finance_transactions').insert({type,category,tanggal,nominal:amount,keterangan:note||null,created_by:currentUser.id});
  if(error){alert('Gagal menyimpan transaksi: '+error.message);return;}
  await loadFinanceCloud(); renderFinance(); resetFinanceForm(); toast('Transaksi keuangan berhasil disimpan.','success');
}
async function deleteFinanceTransaction(id){
  if(!isAdmin())return;
  if(!confirm('Hapus transaksi ini?'))return;
  const {error}=await supabaseClient.from('finance_transactions').delete().eq('id',id);
  if(error){alert('Gagal menghapus transaksi: '+error.message);return;}
  await loadFinanceCloud(); renderFinance(); toast('Transaksi dihapus.','success');
}
async function saveFinanceOpening(){
  if(!isAdmin())return;
  const amount=Number(document.getElementById('financeOpening')?.value||0);
  if(amount<0)return alert('Saldo awal tidak boleh negatif.');
  const {data,error}=await supabaseClient.from('finance_settings').select('id').limit(1);
  if(error){alert('Gagal membaca saldo awal: '+error.message);return;}
  let result;
  if(data?.[0]?.id){result=await supabaseClient.from('finance_settings').update({saldo_awal:amount,updated_by:authUid,updated_at:new Date().toISOString()}).eq('id',data[0].id);}
  else{result=await supabaseClient.from('finance_settings').insert({saldo_awal:amount,updated_by:currentUser.id});}
  if(result.error){alert('Gagal menyimpan saldo awal: '+result.error.message);return;}
  financeOpeningCloud=amount; renderFinance(); toast('Saldo awal berhasil disimpan.','success');
}
function financeOpeningBefore(start){
  let bal=Number(financeOpeningCloud||0);
  const all=financeAllCombinedRows().map(x=>({date:x.date,type:x.type,amount:Number(x.amount||0)}));
  all.forEach(r=>{if(start && String(r.date)<String(start)) bal += r.type==='income'?r.amount:-r.amount;});
  return bal;
}
function financeDateRange(){
  const start=document.getElementById('finStart')?.value||''; const end=document.getElementById('finEnd')?.value||'';
  return {start,end};
}
function financeAllCombinedRows(){
  const manual=financeRows().map(x=>({id:'m_'+x.id,date:x.tanggal,type:x.type,category:x.category,amount:Number(x.nominal||0),note:x.keterangan||'',source:'Manual'}));
  const spp=(!isAdmin()?[]:sppPaymentsCloud.map(x=>{const st=db.santri.find(s=>String(s.id)===String(x.student_id));return {id:'s_'+x.id,date:x.tanggal_bayar,type:'income',category:'SPP',amount:Number(x.nominal||0),note:st?('SPP '+st.nama+' — '+(x.periode||'')):'SPP',source:'SPP'};}));
  return [...manual,...spp].sort((a,b)=>String(b.date).localeCompare(String(a.date)));
}
function financeCombinedRows(){
  const {start,end}=financeDateRange();
  const manual=financeRows().filter(x=>(!start||String(x.tanggal)>=start)&&(!end||String(x.tanggal)<=end)).map(x=>({id:'m_'+x.id,date:x.tanggal,type:x.type,category:x.category,amount:Number(x.nominal||0),note:x.keterangan||'',source:'Manual'}));
  const spp=(!isAdmin()?[]:sppPaymentsCloud.filter(x=>(!start||String(x.tanggal_bayar)>=start)&&(!end||String(x.tanggal_bayar)<=end)).map(x=>{const st=db.santri.find(s=>String(s.id)===String(x.student_id));return {id:'s_'+x.id,date:x.tanggal_bayar,type:'income',category:'SPP',amount:Number(x.nominal||0),note:st?('SPP '+st.nama+' — '+(x.periode||'')):'SPP',source:'SPP'};}));
  return [...manual,...spp].sort((a,b)=>String(b.date).localeCompare(String(a.date)));
}
function renderFinance(){
  const card=document.getElementById('financeManualCard'),sumCard=document.getElementById('financeSummaryCard'),sqlCard=document.getElementById('financeSqlCard'),dashCard=document.getElementById('financeDashboardCard');
  const visible=isAdmin();
  if(card)card.style.display=visible?'block':'none';
  if(sumCard)sumCard.style.display=visible?'block':'none';
  if(sqlCard)sqlCard.style.display=visible?'block':'none';
  if(dashCard)dashCard.style.display=visible?'block':'none';
  if(!visible)return;
  const now=today(); const month=now.slice(0,7); const fs=document.getElementById('finStart'),fe=document.getElementById('finEnd');
  if(fs&&!fs.value)fs.value=month+'-01'; if(fe&&!fe.value){const d=new Date(Number(month.slice(0,4)),Number(month.slice(5,7)),0);fe.value=d.toISOString().slice(0,10);}
  const rows=financeCombinedRows(); let income=0,expense=0; rows.forEach(r=>r.type==='income'?income+=r.amount:expense+=r.amount); const opening=financeOpeningBefore(financeDateRange().start); const balance=opening+income-expense;
  const opEl=document.getElementById('financeOpening'); if(opEl)opEl.value=financeOpeningCloud||0;
  document.getElementById('financeSummary').innerHTML=`<div class="grid"><div class="card"><b>Saldo Awal Periode</b><div class="dashMiniValue">${money(opening)}</div></div><div class="card"><b>Total Pemasukan</b><div class="dashMiniValue">${money(income)}</div></div><div class="card"><b>Total Pengeluaran</b><div class="dashMiniValue">${money(expense)}</div></div><div class="card"><b>Saldo Akhir</b><div class="dashMiniValue">${money(balance)}</div></div></div>`;
  renderFinanceDashboard(rows);
  const led=document.getElementById('financeLedger');
  let running=opening; const chronological=[...rows].sort((a,b)=>String(a.date).localeCompare(String(b.date))||String(a.id).localeCompare(String(b.id))); chronological.forEach(r=>{running += r.type==='income'?r.amount:-r.amount; r.running=running;}); const display=[...chronological].reverse();
  led.innerHTML=display.length?'<table><tr><th>Tanggal</th><th>Jenis</th><th>Kategori</th><th>Sumber</th><th>Nominal</th><th>Saldo Berjalan</th><th>Keterangan</th><th>Aksi</th></tr>'+display.map(r=>`<tr><td>${fmt(r.date)}</td><td>${r.type==='income'?'Pemasukan':'Pengeluaran'}</td><td>${esc(r.category)}</td><td>${esc(r.source)}</td><td>${money(r.amount)}</td><td><b>${money(r.running)}</b></td><td>${esc(r.note)}</td><td>${r.source==='Manual'?`<button class="btn danger" onclick="deleteFinanceTransaction('${r.id.slice(2)}')">Hapus</button>`:'<span class="muted">Otomatis</span>'}</td></tr>`).join('')+'</table>':'<p class="muted">Belum ada transaksi pada periode ini.</p>';
}
function renderFinanceDashboard(rows){
 const card=document.getElementById('financeDashboardCard'),el=document.getElementById('financeDashboard'); if(!card||!el)return; if(!isAdmin()){card.style.display='none';el.innerHTML='';return;} card.style.display='block';
 const all=financeAllCombinedRows(); const allIncome=all.filter(r=>r.type==='income').reduce((a,r)=>a+Number(r.amount||0),0); const allExpense=all.filter(r=>r.type==='expense').reduce((a,r)=>a+Number(r.amount||0),0); const currentBalance=Number(financeOpeningCloud||0)+allIncome-allExpense;
 const month=String(document.getElementById('sppMonth')?.value||monthNow()); const monthRows=all.filter(r=>String(r.date||'').slice(0,7)===month); const mi=monthRows.filter(r=>r.type==='income').reduce((a,r)=>a+Number(r.amount||0),0); const me=monthRows.filter(r=>r.type==='expense').reduce((a,r)=>a+Number(r.amount||0),0);
 const bills=sppBillsCloud.filter(b=>String(b.periode)===month); let billed=0,paid=0,arrears=0,paidCount=0,partialCount=0,unpaidCount=0; bills.forEach(b=>{const tag=Number(b.nominal_tagihan||0),pay=sppPaidFor(b.student_id,month),s=tag-pay;billed+=tag;paid+=pay;if(s<=0)paidCount++;else if(pay>0)partialCount++;else unpaidCount++;if(s>0)arrears+=s;});
 const cats={}; monthRows.forEach(r=>{const k=(r.type==='income'?'Pemasukan: ':'Pengeluaran: ')+r.category;cats[k]=(cats[k]||0)+Number(r.amount||0);}); const catHtml=Object.entries(cats).sort((a,b)=>b[1]-a[1]).slice(0,8).map(([k,v])=>`<div style="display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid var(--line)"><span>${esc(k)}</span><b>${money(v)}</b></div>`).join('')||'<p class="muted">Belum ada transaksi bulan ini.</p>';
 const months=[]; const base=new Date(Number(month.slice(0,4)),Number(month.slice(5,7))-1,1); for(let i=5;i>=0;i--){const d=new Date(base.getFullYear(),base.getMonth()-i,1),key=d.toISOString().slice(0,7),mr=all.filter(r=>String(r.date||'').slice(0,7)===key);months.push({key,income:mr.filter(r=>r.type==='income').reduce((a,r)=>a+Number(r.amount||0),0),expense:mr.filter(r=>r.type==='expense').reduce((a,r)=>a+Number(r.amount||0),0)});} const max=Math.max(1,...months.flatMap(m=>[m.income,m.expense]));
 const chart=months.map(m=>{const iw=Math.round(m.income/max*100),ew=Math.round(m.expense/max*100);return `<div style="margin:9px 0"><div style="display:flex;justify-content:space-between;font-size:12px"><b>${m.key}</b><span>${money(m.income)} / ${money(m.expense)}</span></div><div style="height:8px;background:#eef2eb;border-radius:6px;overflow:hidden;margin-top:4px"><div style="height:100%;width:${iw}%;background:#5f8f27"></div></div><div style="height:6px;background:#f3e9e9;border-radius:6px;overflow:hidden;margin-top:3px"><div style="height:100%;width:${ew}%;background:#a44b4b"></div></div></div>`}).join('');
 el.innerHTML=`<div class="grid"><div class="card"><b>💰 Saldo Saat Ini</b><div class="dashMiniValue">${money(currentBalance)}</div></div><div class="card"><b>📥 Pemasukan ${esc(month)}</b><div class="dashMiniValue">${money(mi)}</div></div><div class="card"><b>📤 Pengeluaran ${esc(month)}</b><div class="dashMiniValue">${money(me)}</div></div><div class="card"><b>🧮 Saldo Bersih ${esc(month)}</b><div class="dashMiniValue">${money(mi-me)}</div></div></div><div class="grid" style="margin-top:12px"><div class="card"><h4 style="margin-top:0">💳 SPP ${esc(month)}</h4><p>Tagihan: <b>${money(billed)}</b></p><p>Dibayar: <b>${money(paid)}</b></p><p>Tunggakan: <b>${money(arrears)}</b></p><p>Lunas: <b>${paidCount}</b> • Sebagian: <b>${partialCount}</b> • Belum: <b>${unpaidCount}</b></p></div><div class="card"><h4 style="margin-top:0">📋 Sumber/Kategori</h4>${catHtml}</div></div><div class="card" style="margin-top:12px"><h4 style="margin-top:0">📈 Pemasukan vs Pengeluaran — 6 Bulan</h4><p class="muted" style="font-size:12px">Baris hijau = pemasukan • baris merah = pengeluaran</p>${chart}</div>`;
}
function printFinanceReport(){
  if(!isAdmin())return; const {start,end}=financeDateRange(); const rows=financeCombinedRows(); let income=0,expense=0; rows.forEach(r=>r.type==='income'?income+=r.amount:expense+=r.amount); const opening=financeOpeningBefore(start); const closing=opening+income-expense;
  let running=opening; const chronological=[...rows].sort((a,b)=>String(a.date).localeCompare(String(b.date))||String(a.id).localeCompare(String(b.id))); const body=chronological.map(r=>{running+=r.type==='income'?r.amount:-r.amount; return `<tr><td>${fmt(r.date)}</td><td>${r.type==='income'?'Pemasukan':'Pengeluaran'}</td><td>${esc(r.category)}</td><td>${esc(r.source)}</td><td>${money(r.amount)}</td><td>${money(running)}</td><td>${esc(r.note)}</td></tr>`}).join('');
  const w=window.open('','_blank','width=1100,height=800'); if(!w){alert('Popup diblokir. Izinkan popup untuk mencetak laporan.');return;}
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Laporan Keuangan Shohibul Quran</title><style>@page{size:A4 landscape;margin:12mm}body{font-family:Arial;color:#222}h1{text-align:center;margin:0}p{text-align:center;color:#666}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{border:1px solid #bbb;padding:7px;text-align:left}th{background:#eee}.sum{margin-top:15px;font-weight:bold;line-height:1.8}</style></head><body><h1>SHOHIBUL QURAN</h1><p>LAPORAN KEUANGAN ${start||'-'} s/d ${end||'-'}</p><div class="sum">Saldo Awal Periode: ${money(opening)}<br>Total Pemasukan: ${money(income)}<br>Total Pengeluaran: ${money(expense)}<br>Saldo Akhir: ${money(closing)}</div><table><tr><th>Tanggal</th><th>Jenis</th><th>Kategori</th><th>Sumber</th><th>Nominal</th><th>Saldo Berjalan</th><th>Keterangan</th></tr>${body}</table><script>window.onload=()=>setTimeout(()=>window.print(),300)<\/script></body></html>`); w.document.close();
}
function sppBillFor(studentId,month){return sppBillsCloud.find(x=>String(x.student_id)===String(studentId)&&String(x.periode)===String(month))}
function sppPaidFor(studentId,month){return sppPaymentsCloud.filter(x=>String(x.student_id)===String(studentId)&&String(x.periode)===String(month)).reduce((a,x)=>a+Number(x.nominal||0),0)}
async function saveSppSetting(id){
  if(!isAdmin())return alert('Hanya Admin yang dapat mengatur SPP.');
  const model=document.getElementById('sppModel_'+id)?.value||'tetap'; const val=Number(document.getElementById('sppValue_'+id)?.value||0);
  if(val<0)return alert('Nominal/tarif tidak boleh negatif.');
  const payload={student_id:id,model,nominal:model==='per_pertemuan'?0:val,tarif:model==='per_pertemuan'?val:0,updated_by:currentUser.id};
  const {error}=await supabaseClient.from('spp_settings').upsert(payload,{onConflict:'student_id'});
  if(error)return alert('Gagal menyimpan pengaturan SPP. Pastikan SQL SPP sudah dijalankan di Supabase: '+error.message);
  await loadSppCloud(); renderSPP(); toast('Pengaturan SPP disimpan ke Supabase.','success');
}
async function generateSppBills(){
  if(!isAdmin())return alert('Hanya Admin yang dapat membuat tagihan.');
  const month=document.getElementById('sppMonth')?.value||monthNow(); const rows=sppStudentRows();
  const payload=rows.map(s=>{const r=calcSpp(s,month);return {student_id:s.id,periode:month,model:r.cfg.model,jumlah_pertemuan:r.meetings,tarif_pertemuan:r.cfg.tarif||0,nominal_tagihan:r.amount,updated_by:currentUser.id}});
  if(!payload.length)return alert('Belum ada santri.');
  const {error}=await supabaseClient.from('spp_bills').upsert(payload,{onConflict:'student_id,periode'});
  if(error)return alert('Gagal membuat tagihan. Pastikan SQL SPP sudah dijalankan di Supabase: '+error.message);
  await loadSppCloud(); renderSPP(); toast('Tagihan bulan '+month+' berhasil diperbarui.','success');
}
async function saveSppPayment(id,month){
  if(!isAdmin())return alert('Hanya Admin yang dapat mencatat pembayaran.');
  const input=document.getElementById('sppPaid_'+id); const paid=Number(input?.value||0);
  if(paid<0)return alert('Nominal pembayaran tidak boleh negatif.');
  const bill=sppBillFor(id,month); if(!bill)return alert('Buat tagihan bulan ini terlebih dahulu.');
  const {error}=await supabaseClient.from('spp_payments').insert({student_id:id,periode:month,bill_id:bill.id,nominal:paid,tanggal_bayar:today(),created_by:currentUser.id});
  if(error)return alert('Gagal menyimpan pembayaran. Pastikan SQL SPP sudah dijalankan di Supabase: '+error.message);
  await loadSppCloud(); renderSPP(); toast('Pembayaran SPP tersimpan.','success');
}
function latestPaymentFor(studentId,month){
  return sppPaymentsCloud.filter(x=>String(x.student_id)===String(studentId)&&String(x.periode)===String(month)).sort((a,b)=>String(b.tanggal_bayar||'').localeCompare(String(a.tanggal_bayar||'')))[0]||null;
}
function receiptNo(studentId,month){
  const sid=String(studentId).replace(/-/g,'').slice(-6).toUpperCase();
  return 'SPP-'+String(month||'').replace('-','')+'-'+sid;
}
function printSppReceipt(studentId,month){
  if(!currentUser)return;
  const s=(db.santri||[]).find(x=>String(x.id)===String(studentId));
  const bill=sppBillFor(studentId,month); const payments=sppPaymentsCloud.filter(x=>String(x.student_id)===String(studentId)&&String(x.periode)===String(month));
  if(!s||!bill||!payments.length){alert('Belum ada pembayaran untuk dibuatkan kwitansi.');return;}
  const paid=payments.reduce((a,x)=>a+Number(x.nominal||0),0), remain=Math.max(0,Number(bill.nominal_tagihan||0)-paid);
  const latest=payments.slice().sort((a,b)=>String(b.tanggal_bayar||'').localeCompare(String(a.tanggal_bayar||'')))[0];
  const html=`<!doctype html><html><head><meta charset="utf-8"><title>Kwitansi SPP</title><style>
  @page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#222;margin:0}.receipt{max-width:760px;margin:0 auto;border:1px solid #bbb;padding:28px;border-radius:10px}.head{text-align:center;border-bottom:2px solid #222;padding-bottom:15px;margin-bottom:20px}.head h1{margin:0 0 4px;font-size:22px}.head p{margin:3px 0;color:#666}.row{display:flex;justify-content:space-between;gap:20px;margin:9px 0}.label{color:#666}.total{font-size:18px;font-weight:700;border-top:1px solid #ccc;border-bottom:1px solid #ccc;padding:14px 0;margin:16px 0}.status{font-weight:700}.sign{display:flex;justify-content:flex-end;margin-top:55px}.signbox{text-align:center;width:220px}@media print{.receipt{border:none;padding:0}.no-print{display:none}}</style></head><body><div class="receipt"><div class="head"><h1>SHOHIBUL QURAN</h1><p>KWITANSI PEMBAYARAN SPP</p></div><div class="row"><span class="label">No. Kwitansi</span><b>${receiptNo(studentId,month)}</b></div><div class="row"><span class="label">Nama Santri</span><b>${esc(s.nama||'-')}</b></div><div class="row"><span class="label">Periode</span><b>${esc(month)}</b></div><div class="row"><span class="label">Jumlah Pertemuan</span><b>${Number(bill.jumlah_pertemuan||0)} kali</b></div><div class="row"><span class="label">Total Tagihan</span><b>${money(bill.nominal_tagihan)}</b></div><div class="row"><span class="label">Pembayaran Terakhir</span><b>${money(latest.nominal)}</b></div><div class="row"><span class="label">Tanggal Pembayaran</span><b>${esc(latest.tanggal_bayar||'-')}</b></div><div class="total"><div class="row"><span>Total Sudah Dibayar</span><span>${money(paid)}</span></div><div class="row"><span>Sisa</span><span>${money(remain)}</span></div><div class="row"><span>Status</span><span class="status">${remain<=0?'LUNAS':'SEBAGIAN'}</span></div></div><p>Catatan: ${esc(latest.catatan||'-')}</p><div class="sign"><div class="signbox">Admin<br><br><br>____________________</div></div><button class="no-print" onclick="window.print()">Cetak / Simpan PDF</button></div><script>window.onload=()=>setTimeout(()=>window.print(),300)<\/script></body></html>`;
  const w=window.open('','_blank','width=850,height=900'); if(!w){alert('Popup diblokir. Izinkan popup untuk mencetak kwitansi.');return;} w.document.open();w.document.write(html);w.document.close();
}
function renderSppReport(month,rows){
  const el=document.getElementById('sppReport'); const card=document.getElementById('sppReportCard'); if(!el||!card)return;
  if(!isAdmin()){card.style.display='none';el.innerHTML='';return;}
  card.style.display='block';
  let total=0,paid=0,lunas=0,sebagian=0,belum=0;
  rows.forEach(s=>{const r=calcSpp(s,month),bill=sppBillFor(s.id,month),amount=r.cfg.model==='per_pertemuan'?Number(r.amount||0):Number(bill?.nominal_tagihan??r.amount);const p=sppPaidFor(s.id,month);const rem=Math.max(0,amount-p);total+=amount;paid+=p;if(amount>0&&rem<=0)lunas++;else if(p>0)sebagian++;else if(amount>0)belum++;});
  el.innerHTML=`<div class="grid"><div class="card"><b>Total Tagihan</b><div class="dashMiniValue">${money(total)}</div></div><div class="card"><b>Total Pembayaran</b><div class="dashMiniValue">${money(paid)}</div></div><div class="card"><b>Total Tunggakan</b><div class="dashMiniValue">${money(Math.max(0,total-paid))}</div></div><div class="card"><b>Status Santri</b><div style="margin-top:7px">🟢 Lunas: <b>${lunas}</b> • 🟡 Sebagian: <b>${sebagian}</b> • 🔴 Belum: <b>${belum}</b></div></div></div><div style="margin-top:12px"><button class="btn" onclick="printSppReport('${month}')">📄 Cetak / Simpan Laporan PDF</button></div>`;
}
function printSppReport(month){
  if(!isAdmin())return;
  const rows=sppStudentRows(); let total=0,paid=0,body='';
  rows.forEach(s=>{const r=calcSpp(s,month),bill=sppBillFor(s.id,month),amount=r.cfg.model==='per_pertemuan'?Number(r.amount||0):Number(bill?.nominal_tagihan??r.amount),p=sppPaidFor(s.id,month),rem=Math.max(0,amount-p);total+=amount;paid+=p;body+=`<tr><td>${esc(s.nama)}</td><td>${r.meetings}</td><td>${money(amount)}</td><td>${money(p)}</td><td>${money(rem)}</td><td>${amount===0?'Belum diatur':rem<=0?'Lunas':p>0?'Sebagian':'Belum Bayar'}</td></tr>`});
  const w=window.open('','_blank','width=1000,height=800');if(!w){alert('Popup diblokir. Izinkan popup untuk mencetak laporan.');return;}
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Laporan SPP ${month}</title><style>@page{size:A4 landscape;margin:12mm}body{font-family:Arial;color:#222}h1{text-align:center;margin:0 0 5px}p{text-align:center;color:#666}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{border:1px solid #bbb;padding:7px;text-align:left}th{background:#eee}.sum{margin-top:15px;font-weight:bold}</style></head><body><h1>SHOHIBUL QURAN</h1><p>LAPORAN SPP — PERIODE ${esc(month)}</p><table><tr><th>Santri</th><th>Pertemuan</th><th>Tagihan</th><th>Dibayar</th><th>Sisa</th><th>Status</th></tr>${body}</table><div class="sum">Total Tagihan: ${money(total)} &nbsp;&nbsp; Total Pembayaran: ${money(paid)} &nbsp;&nbsp; Total Tunggakan: ${money(Math.max(0,total-paid))}</div><script>window.onload=()=>setTimeout(()=>window.print(),300)<\/script></body></html>`);w.document.close();
}
function renderSPP(){
  const month=document.getElementById('sppMonth')?.value||monthNow();
  if(document.getElementById('sppMonth'))document.getElementById('sppMonth').value=month;
  const settingsEl=document.getElementById('sppSettings'), billEl=document.getElementById('sppBills');
  const gen=document.getElementById('sppGenerateCard'), status=document.getElementById('sppCloudStatus');
  if(!settingsEl||!billEl)return;

  // v65: Walisantri hanya melihat tagihan SPP anak yang terhubung melalui wali_user_id.
  if(isWali()){
    const child=getWaliStudent();
    const children=getWaliStudents();
    if(document.getElementById('sppAdminCard'))document.getElementById('sppAdminCard').style.display='none';
    if(gen)gen.style.display='none';
    if(document.getElementById('sppReportCard'))document.getElementById('sppReportCard').style.display='none';
    const search=document.getElementById('sppSearch'); if(search)search.parentElement.style.display='none';
    if(status)status.innerHTML='☁️ <b>Tagihan SPP Anak</b> — hanya data anak yang terhubung dengan akun Walisantri.';
    if(!child){
      billEl.innerHTML='<div class="card"><p class="muted">Akun Walisantri belum terhubung dengan data santri.</p></div>';
      return;
    }
    const rows=children.length?children:[child];
    let h='';
    let found=false;
    rows.forEach(s=>{
      const sid=String(s.id);
      const bill=sppBillsCloud.find(x=>String(x.student_id)===sid&&String(x.periode)===String(month));
      const paid=sppPaymentsCloud.filter(x=>String(x.student_id)===sid&&String(x.periode)===String(month)).reduce((a,x)=>a+Number(x.nominal||0),0);
      found=true;
      const amount=Number(bill?.nominal_tagihan||0), remain=Math.max(0,amount-paid);
      const statusTxt=!bill?'Belum ada tagihan':amount<=0?'Belum diatur':remain<=0?'Lunas':paid>0?'Sebagian':'Belum Bayar';
      h+='<div class="card" style="margin-bottom:12px;border-left:4px solid #4b7f3b;background:#f7fbf5"><div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;align-items:center"><div><b>👨‍👩‍👧 '+esc(s.nama)+'</b><div class="muted">Tagihan SPP periode '+esc(month)+'</div></div><span class="badge">'+statusTxt+'</span></div>';
      h+='<div class="waliTableWrap" style="margin-top:10px"><table><tr><th>Periode</th><th>Pertemuan</th><th>Tagihan</th><th>Dibayar</th><th>Sisa</th></tr>';
      h+='<tr><td><b>'+esc(month)+'</b></td><td>'+Number(bill?.jumlah_pertemuan||0)+'</td><td>'+money(amount)+'</td><td>'+money(paid)+'</td><td>'+money(remain)+'</td></tr></table></div></div>';
    });
    if(!found)h+='<div class="card"><p class="muted">Belum ada data SPP untuk anak-anak yang terhubung pada periode '+esc(month)+'.</p></div>';
    h='<div class="card" style="margin-bottom:12px"><h3 style="margin:0 0 4px">📊 Rekap SPP Keluarga</h3><div class="muted">Menampilkan seluruh anak yang terhubung dengan akun Walisantri.</div></div>'+h;
    billEl.innerHTML=h;
    return;
  }

  const q=String(document.getElementById('sppSearch')?.value||'').toLowerCase();
  const rows=sppStudentRows().filter(s=>!q||String(s.nama||'').toLowerCase().includes(q));
  if(status)status.innerHTML=sppCloudReady?'☁️ <b>Tersambung ke Supabase</b> — data SPP tersimpan permanen.':'⚠️ <b>Data SPP belum tersambung ke Supabase.</b> Jalankan SQL v22 yang disediakan untuk membuat tabel SPP.';
  if(gen)gen.style.display=isAdmin()?'block':'none';
  if(!isAdmin())settingsEl.parentElement.style.display='none';
  else{
    settingsEl.parentElement.style.display='block';
    let h='<table><tr><th>Santri</th><th>Model</th><th>Nominal/Tarif</th><th>Aksi</th></tr>';
    rows.forEach(s=>{const c=cloudCfg(s.id),val=c.model==='per_pertemuan'?c.tarif:c.nominal;h+='<tr><td><b>'+esc(s.nama)+'</b><div class="muted">'+esc(s.kelas||s.level||'')+'</div></td><td><select id="sppModel_'+s.id+'"><option value="tetap" '+(c.model==='tetap'?'selected':'')+'>SPP Tetap</option><option value="per_pertemuan" '+(c.model==='per_pertemuan'?'selected':'')+'>Per Pertemuan</option><option value="manual" '+(c.model==='manual'?'selected':'')+'>Manual</option></select></td><td><input id="sppValue_'+s.id+'" type="number" min="0" value="'+Number(val||0)+'" placeholder="Rp"></td><td><button class="btn primary" onclick="saveSppSetting(&quot;'+s.id+'&quot;)">Simpan</button></td></tr>'});
    settingsEl.innerHTML=rows.length?'<div class="table-scroll spp-settings-scroll">'+h+'</table></div>':'<p class="muted">Belum ada santri.</p>';
  }
  if(!rows.length){billEl.innerHTML='<p class="muted">Belum ada data SPP.</p>';renderSppReport(month,rows);return}
  let total=0,paidTotal=0,h='<table><tr><th>Santri</th><th>Model</th><th>Pertemuan</th><th>Tagihan</th><th>Dibayar</th><th>Sisa</th><th>Status</th><th>Aksi</th></tr>';
  rows.forEach(s=>{const r=calcSpp(s,month),bill=sppBillFor(s.id,month),p=sppPaidFor(s.id,month),amount=r.cfg.model==='per_pertemuan'?Number(r.amount||0):Number(bill?.nominal_tagihan??r.amount),remain=Math.max(0,amount-p);total+=amount;paidTotal+=p;const statusTxt=amount===0?'Belum diatur':remain<=0?'Lunas':p>0?'Sebagian':'Belum Bayar';const paidCell=isAdmin()?'<input id="sppPaid_'+s.id+'" type="number" min="0" placeholder="Nominal pembayaran" style="width:145px">':money(p);const payAction=isAdmin()?'<button class="btn" onclick="saveSppPayment(&quot;'+s.id+'&quot;,&quot;'+month+'&quot;)">Catat Bayar</button>':'';const receiptAction=p>0?'<button class="btn" onclick="printSppReceipt(&quot;'+s.id+'&quot;,&quot;'+month+'&quot;)">🧾 Kwitansi</button>':'';h+='<tr><td><b>'+esc(s.nama)+'</b></td><td>'+(r.cfg.model==='per_pertemuan'?'Per Pertemuan':r.cfg.model==='manual'?'Manual':'Tetap')+'</td><td>'+r.meetings+'</td><td>'+money(amount)+'</td><td>'+money(p)+(isAdmin()?' '+paidCell:'')+'</td><td>'+money(remain)+'</td><td><span class="badge">'+statusTxt+'</span></td><td>'+payAction+' '+receiptAction+'</td></tr>'});
  h+='</table><div class="grid" style="margin-top:12px"><div class="card"><b>Total Tagihan</b><div class="dashMiniValue">'+money(total)+'</div></div><div class="card"><b>Total Dibayar</b><div class="dashMiniValue">'+money(paidTotal)+'</div></div><div class="card"><b>Total Sisa</b><div class="dashMiniValue">'+money(Math.max(0,total-paidTotal))+'</div></div></div>';
  billEl.innerHTML='<div class="table-scroll spp-bills-scroll">'+h.replace('</table><div class="grid"','</table></div><div class="grid"')+'</div>'; renderSppReport(month,rows);
}
const PRESENSI_KEY='shohibul_presensi_v43';
let editPresensiId=null;
function presensiLoad(){return Array.isArray(presensiCloud)?presensiCloud:[]}
function resetPresensiForm(){
  editPresensiId=null;
  const btn=document.getElementById('savePresensiBtn'); if(btn)btn.textContent='Simpan Presensi';
  const cancel=document.getElementById('cancelEditPresensiBtn'); if(cancel)cancel.style.display='none';
  const next=document.getElementById('continueSessionBtn'); if(next)next.style.display='none';
  const ss=document.getElementById('sessionStatus'); if(ss)ss.value='berlangsung';
  const sr=document.getElementById('sessionStatusReason'); if(sr)sr.value='';
  applySessionStatusUI();
}
function currentSessionStatusRow(){
  const ctx=activeScheduleContext;
  if(!ctx || !ctx.id)return null;
  const tanggal=String(ctx.jadwalDate||document.getElementById('presTanggal')?.value||today()).slice(0,10);
  return (sessionStatusCloud||[]).find(x=>String(x.schedule_id)===String(ctx.id)&&String(x.tanggal).slice(0,10)===tanggal)||null;
}
function prepareSessionStatusUI(){
  const box=document.getElementById('sessionStatusBox');
  if(!box)return;
  const ctx=activeScheduleContext;
  if(!ctx || !ctx.id){box.style.display='none'; return;}
  box.style.display='block';
  const row=currentSessionStatusRow();
  const st=document.getElementById('sessionStatus'); if(st)st.value=row?.status||'berlangsung';
  const reason=document.getElementById('sessionStatusReason'); if(reason)reason.value=row?.alasan||'';
  applySessionStatusUI();
}
function applySessionStatusUI(){
  const ctx=activeScheduleContext;
  const box=document.getElementById('sessionStatusBox');
  if(!ctx || !ctx.id){if(box)box.style.display='none';return;}
  if(box)box.style.display='block';
  const status=document.getElementById('sessionStatus')?.value||'berlangsung';
  const grid=document.getElementById('presensiStudentFormGrid');
  const save=document.getElementById('savePresensiBtn');
  const cancel=document.getElementById('cancelEditPresensiBtn');
  const next=document.getElementById('continueSessionBtn');
  const notice=document.getElementById('sessionStatusNotice');
  const disabled=status!=='berlangsung';
  if(grid)grid.querySelectorAll('input,select').forEach(el=>el.disabled=disabled || (el.id==='presSantri'&&isPengajar()));
  if(save)save.disabled=disabled;
  if(next && disabled)next.style.display='none';
  if(notice){
    notice.textContent=disabled
      ? (status==='diliburkan' ? 'Pembelajaran diliburkan. Presensi santri tidak perlu diisi dan tidak dihitung sebagai ketidakhadiran.' : 'Pertemuan dijadwalkan ulang. Presensi santri tidak perlu diisi untuk tanggal ini.')
      : 'Pembelajaran berlangsung. Silakan isi presensi santri seperti biasa.';
  }
}
async function saveSessionStatus(){
  try{
  if(!currentUser || (!isAdmin()&&!isPengajar())){toast('Akses status pertemuan hanya untuk Admin dan Pengajar.','error');return}
  const ctx=activeScheduleContext;
  if(!ctx || !ctx.id){toast('Status pertemuan hanya dapat disimpan dari Presensi yang dibuka melalui Jadwal.','error');return}
  if(sessionStatusSetupNeeded){toast('Setup Status Pertemuan Supabase belum dijalankan. Admin perlu menjalankan SQL di Pengaturan.','error');return}
  const status=document.getElementById('sessionStatus')?.value||'berlangsung';
  const alasan=(document.getElementById('sessionStatusReason')?.value||'').trim();
  const tanggal=String(ctx.jadwalDate||document.getElementById('presTanggal')?.value||today()).slice(0,10);
  const existing=currentSessionStatusRow();
  if(status==='berlangsung'){
    if(existing){
      const {error}=await supabaseClient.from('session_statuses').delete().eq('id',existing.id);
      if(error){toast('Gagal mengembalikan status pembelajaran: '+error.message,'error');return}
      sessionStatusCloud=sessionStatusCloud.filter(x=>String(x.id)!==String(existing.id));
    }
  }else{
    const teacher=getCurrentTeacher();
    const payload={schedule_id:ctx.id,tanggal,status,alasan:alasan||null,teacher_id:teacher?.id||null,created_by:existing?.created_by||currentUser.id,updated_by:currentUser.id};
    if(existing)payload.id=existing.id;
    const {data,error}=await supabaseClient.from('session_statuses').upsert(payload,{onConflict:'schedule_id,tanggal'}).select('*').single();
    if(error){toast('Gagal menyimpan status pertemuan: '+error.message,'error');return}
    const i=sessionStatusCloud.findIndex(x=>String(x.id)===String(data.id));
    if(i>=0)sessionStatusCloud[i]=data;else sessionStatusCloud.unshift(data);
  }
  prepareSessionStatusUI();
  renderPresensi();
  renderJadwal();renderPengajarDashboard();
  toast(status==='berlangsung'?'Pembelajaran dikembalikan menjadi berlangsung.':status==='diliburkan'?'Pertemuan ditandai sebagai diliburkan.':'Pertemuan ditandai sebagai dijadwalkan ulang.','success');
  }catch(e){console.error('saveSessionStatus failed:',e);toast('Status pertemuan gagal disimpan: '+(e?.message||String(e)),'error')}
}
function editPresensi(id){
  if(!currentUser || (!isAdmin()&&!isPengajar())){toast('Akses presensi hanya untuk Admin dan Pengajar.','error');return}
  const row=presensiCloud.find(x=>String(x.id)===String(id));
  if(!row){toast('Data presensi tidak ditemukan.','error');return}
  const student=(db.santri||[]).find(s=>String(s.id)===String(row.student_id));
  if(!student){toast('Santri pada presensi tidak ditemukan.','error');return}
  if(isPengajar() && !visibleStudents().some(s=>String(s.id)===String(row.student_id))){toast('Anda hanya dapat mengubah presensi santri yang ditugaskan.','error');return}
  editPresensiId=String(row.id);
  const d=document.getElementById('presTanggal'); if(d)d.value=String(row.tanggal||'').slice(0,10);
  const st=document.getElementById('presSantri'); if(st){st.value=String(row.student_id);st.disabled=isPengajar();}
  const status=document.getElementById('presStatus'); if(status)status.value=row.status||'hadir';
  const cat=document.getElementById('presCatatan'); if(cat)cat.value=row.catatan||'';
  const btn=document.getElementById('savePresensiBtn'); if(btn)btn.textContent='Simpan Perubahan';
  const cancel=document.getElementById('cancelEditPresensiBtn'); if(cancel)cancel.style.display='inline-flex';
  const next=document.getElementById('continueSessionBtn'); if(next)next.style.display='none';
  const title=document.getElementById('presensiTitle'); if(title)title.textContent='✏️ Edit Presensi';
  document.getElementById('presensiFormCard')?.scrollIntoView({behavior:'smooth',block:'start'});
}
function cancelEditPresensi(){
  editPresensiId=null;
  const st=document.getElementById('presSantri'); if(st)st.disabled=false;
  const btn=document.getElementById('savePresensiBtn'); if(btn)btn.textContent='Simpan Presensi';
  const cancel=document.getElementById('cancelEditPresensiBtn'); if(cancel)cancel.style.display='none';
  const title=document.getElementById('presensiTitle'); if(title)title.textContent='📋 Presensi Santri';
  const cat=document.getElementById('presCatatan'); if(cat)cat.value='';
  const next=document.getElementById('continueSessionBtn'); if(next)next.style.display='none';
}
async function deletePresensi(id){
  if(!currentUser || (!isAdmin()&&!isPengajar())){toast('Akses presensi hanya untuk Admin dan Pengajar.','error');return}
  const row=presensiCloud.find(x=>String(x.id)===String(id));
  if(!row){toast('Data presensi tidak ditemukan.','error');return}
  if(isPengajar() && !visibleStudents().some(s=>String(s.id)===String(row.student_id))){toast('Anda hanya dapat menghapus presensi santri yang ditugaskan.','error');return}
  const student=(db.santri||[]).find(s=>String(s.id)===String(row.student_id));
  const label=(student?.nama||'Santri')+' • '+fmt(row.tanggal);
  if(!confirm('Hapus presensi ini?\n\n'+label+'\nStatus: '+({hadir:'Hadir',izin:'Izin',sakit:'Sakit',tidak_hadir:'Tidak Hadir'}[row.status]||row.status)+'\n\nTindakan ini tidak dapat dibatalkan.'))return;
  // V149: hapus langsung melalui Supabase. Otorisasi Pengajar ditegakkan oleh
  // policy DELETE attendance_records berdasarkan students.teacher_id -> teachers.user_id.
  const {data:deletedRows,error}=await supabaseClient.from('attendance_records').delete().eq('id',row.id).select('id');
  if(error){toast('Gagal menghapus presensi: '+error.message+' Jalankan SQL Hak DELETE Pengajar V152 di Pengaturan.','error',7000);return}
  if(!deletedRows || !deletedRows.length){toast('Database tidak menghapus baris ini. Jalankan SQL Hak DELETE Pengajar V152 di Pengaturan.','error',7000);return}
  const {data:stillThere,error:verifyError}=await supabaseClient.from('attendance_records').select('id').eq('id',row.id).maybeSingle();
  if(verifyError){toast('Presensi dihapus, tetapi verifikasi database gagal: '+verifyError.message+' Jalankan Setup Presensi Supabase terbaru di Pengaturan.','error');return}
  if(stillThere){toast('Presensi belum benar-benar terhapus dari database. Periksa RLS Supabase.','error');return}
  presensiCloud=presensiCloud.filter(x=>String(x.id)!==String(row.id));
  if(String(editPresensiId)===String(row.id))cancelEditPresensi();
  renderPresensi();
  toast('Presensi berhasil dihapus.','success');
}
function fillPresensiSelects(){
  const students=isAdmin()?(db.santri||[]):visibleStudents();
  const opts='<option value="">Pilih santri</option>'+students.filter(s=>s.aktif!==false).map(s=>'<option value="'+s.id+'">'+esc(s.nama)+'</option>').join('');
  ['presSantri','presRekapSantri'].forEach(id=>{const el=document.getElementById(id);if(el){const old=el.value;el.innerHTML=opts;el.value=old}})
  const todayStr=today(); const d=document.getElementById('presTanggal'); if(d&&!d.value)d.value=todayStr;
  const st=document.getElementById('presEnd'); if(st&&!st.value)st.value=todayStr;
  const ss=document.getElementById('presStart'); if(ss&&!ss.value){let x=new Date(todayStr);x.setMonth(x.getMonth()-1);ss.value=x.toISOString().slice(0,10)}
}
async function savePresensi(){
  if(!currentUser || (!isAdmin()&&!isPengajar())){toast('Akses presensi hanya untuk Admin dan Pengajar.','error');return}
  if(presensiSetupNeeded){toast('Setup Presensi Supabase belum dijalankan. Buka Pengaturan → Setup Presensi Supabase.','error');return}
  const tanggal=document.getElementById('presTanggal')?.value, student_id=document.getElementById('presSantri')?.value, status=document.getElementById('presStatus')?.value, catatan=(document.getElementById('presCatatan')?.value||'').trim();
  if(!tanggal||!student_id||!status){toast('Tanggal, santri, dan status wajib diisi.','error');return}
  const {data:authState,error:authStateError}=await supabaseClient.auth.getSession();
  const authUid=authState?.session?.user?.id||currentUser?.id||'';
  if(authStateError||!authUid){toast('Sesi login Supabase tidak tersedia. Silakan login kembali.','error');return}
  const student=(db.santri||[]).find(s=>String(s.id)===String(student_id));
  if(!student){toast('Santri tidak termasuk dalam akses akun ini.','error');return}
  if(isPengajar() && !visibleStudents().some(s=>String(s.id)===String(student_id))){toast('Anda hanya dapat mencatat presensi santri yang ditugaskan.','error');return}
  const existing=presensiCloud.find(x=>String(x.student_id)===String(student_id)&&String(x.tanggal)===String(tanggal));
  let data,error;
  if(editPresensiId){
    const editing=presensiCloud.find(x=>String(x.id)===String(editPresensiId));
    if(!editing){toast('Data presensi yang diedit sudah tidak tersedia.','error');cancelEditPresensi();return}
    if(existing && String(existing.id)!==String(editPresensiId)){toast('Presensi untuk santri dan tanggal tersebut sudah ada. Pilih tanggal lain.','error');return}
    const res=await supabaseClient.from('attendance_records').update({student_id,tanggal,status,catatan:catatan||null,updated_by:currentUser.id,updated_at:new Date().toISOString()}).eq('id',editPresensiId).select('*').single();
    data=res.data; error=res.error;
  }else{
    const payload={student_id,tanggal,status,catatan:catatan||null,updated_by:authUid};
    if(existing) payload.id=existing.id; else payload.created_by=authUid;
    const res=await supabaseClient.from('attendance_records').upsert(payload,{onConflict:'student_id,tanggal'}).select('*').single();
    data=res.data; error=res.error;
  }
  if(error){toast('Gagal menyimpan presensi: '+error.message,'error');return}
  const i=presensiCloud.findIndex(x=>String(x.id)===String(data.id)); if(i>=0)presensiCloud[i]=data;else presensiCloud.unshift(data);
  const wasEditing=!!editPresensiId;
  editPresensiId=null;
  const santriSelect=document.getElementById('presSantri'); if(santriSelect)santriSelect.disabled=false;
  const saveBtn=document.getElementById('savePresensiBtn'); if(saveBtn)saveBtn.textContent='Simpan Presensi';
  const cancelBtn=document.getElementById('cancelEditPresensiBtn'); if(cancelBtn)cancelBtn.style.display='none';
  const formTitle=document.getElementById('presensiTitle'); if(formTitle)formTitle.textContent='📋 Presensi Santri';
  document.getElementById('presCatatan').value='';
  const nextBtn=document.getElementById('continueSessionBtn');
  if(nextBtn){
    if(status==='hadir'){
      // v67: Presensi dapat langsung diteruskan ke Sesi & Nilai.
      // Jika berasal dari Jadwal, pertahankan konteks Jadwal. Jika tidak, cari jadwal aktif santri pada hari yang sama.
      let ctx=activeScheduleContext && String(activeScheduleContext.student_id)===String(student_id) && String(activeScheduleContext.jadwalDate||tanggal)===String(tanggal) ? activeScheduleContext : null;
      if(!ctx){
        const day=hariNama(new Date(tanggal+'T00:00:00'));
        const match=(jadwalData||[]).find(x=>String(x.student_id)===String(student_id) && String(x.hari)===String(day) && String(x.status||'aktif')==='aktif');
        if(match) ctx={id:match.id,student_id:match.student_id,hari:match.hari,jam:match.jam,jenis:match.jenis||'',kelas:match.kelas||'',jadwalDate:tanggal};
      }
      if(!ctx){
        const st=(db.santri||[]).find(x=>String(x.id)===String(student_id));
        ctx={id:null,student_id, hari:hariNama(new Date(tanggal+'T00:00:00')),jam:'',jenis:'',kelas:st?.level||'',jadwalDate:tanggal};
      }
      activeScheduleContext=ctx;
      // v68: simpan konteks Presensi secara eksplisit agar Sesi & Nilai selalu mengikuti santri yang baru dipresensi.
      window.__presensiSessionContext={student_id:String(student_id),jadwalDate:String(tanggal),jenis:ctx.jenis||'',kelas:ctx.kelas||'',id:ctx.id||null};
      nextBtn.style.display='inline-flex';
    }else{
      nextBtn.style.display='none';
    }
  }
  renderPresensi();
  // Perbarui status pada Jadwal dan dashboard segera setelah presensi tersimpan.
  if(typeof renderJadwal==='function') renderJadwal();
  if(typeof renderAdminDashboard==='function') renderAdminDashboard();
  if(typeof renderPengajarDashboard==='function') renderPengajarDashboard();
  toast(status==='hadir' ? 'Presensi tersimpan. Status jadwal diperbarui; silakan lanjut ke Input Sesi & Nilai.' : 'Presensi berhasil disimpan ke Supabase.','success');
}

function applyScheduleSessionContext(){
  if(!activeScheduleContext)return false;
  const ctx=activeScheduleContext, sid=String(ctx.student_id||'');
  const s=document.getElementById('pSantri');
  if(!s || !sid)return false;
  if(typeof fill==='function')fill('pSantri');
  let opt=[...s.options].find(o=>String(o.value)===sid);
  if(!opt){ const st=(db.santri||[]).find(x=>String(x.id)===sid); if(st){ opt=document.createElement('option'); opt.value=sid; opt.textContent=st.nama||'Santri'; s.appendChild(opt); } }
  if(!opt)return false;
  s.value=sid; s.disabled=true;
  const d=document.getElementById('pTanggal'); if(d)d.value=ctx.jadwalDate||today();
  if(typeof syncClass==='function')syncClass();
  const k=document.getElementById('pKelas'); if(k && ctx.kelas){ const ko=[...k.options].find(o=>String(o.value)===String(ctx.kelas)||String(o.textContent)===String(ctx.kelas)); if(ko)k.value=ko.value; }
  if(typeof populateJenis==='function')populateJenis();
  const j=document.getElementById('pJenis'); if(j && ctx.jenis){ const jo=[...j.options].find(o=>String(o.value)===String(ctx.jenis)||String(o.textContent)===String(ctx.jenis)); if(jo)j.value=jo.value; }
  if(typeof buildLearningForm==='function')buildLearningForm();
  return true;
}
function continueToSession(){
  const pc=window.__presensiSessionContext;
  if(pc && pc.student_id){
    activeScheduleContext=Object.assign({},activeScheduleContext||{},pc,{student_id:String(pc.student_id),jadwalDate:pc.jadwalDate||today()});
  }
  const ctx=Object.assign({},activeScheduleContext||{});
  const sid=String(ctx.student_id||'');
  if(!sid)return toast('Santri dari Presensi belum ditemukan. Silakan simpan Presensi terlebih dahulu.','error');
  const st=(db.santri||[]).find(x=>String(x.id)===sid);
  if(!st)return toast('Santri dari Presensi tidak ditemukan.','error');
  const btn=document.getElementById('navPembelajaran');
  showPage('pembelajaran',btn);
  const apply=()=>{
    try{
      const s=document.getElementById('pSantri');
      if(!s)return false;
      if(typeof fill==='function')fill('pSantri');
      let opt=[...s.options].find(o=>String(o.value)===sid);
      if(!opt){opt=document.createElement('option');opt.value=sid;opt.textContent=st.nama||'Santri';s.appendChild(opt)}
      s.value=sid;
      s.disabled=true;
      s.dataset.fromPresensi='1';
      s.dataset.studentId=sid;
      const d=document.getElementById('pTanggal');
      if(d)d.value=ctx.jadwalDate||today();
      if(typeof syncClass==='function')syncClass();
      const k=document.getElementById('pKelas');
      if(k){const cls=st.level||ctx.kelas||'';const ko=[...k.options].find(o=>String(o.value)===String(cls)||String(o.textContent)===String(cls));if(ko)k.value=ko.value;k.disabled=true;}
      if(typeof populateJenis==='function')populateJenis();
      const j=document.getElementById('pJenis');
      if(j && ctx.jenis){const jo=[...j.options].find(o=>String(o.value)===String(ctx.jenis)||String(o.textContent)===String(ctx.jenis));if(jo)j.value=jo.value;}
      if(typeof buildLearningForm==='function')buildLearningForm();
      const hint=document.getElementById('sessionStudentHint');
      if(hint)hint.textContent='Santri otomatis dari Presensi: '+(st.nama||'-');
      return true;
    }catch(e){console.error('apply presensi session context',e);return false;}
  };
  // Terapkan beberapa kali karena showPage/refresh dapat mengisi ulang select santri.
  apply();
  setTimeout(apply,150);
  setTimeout(apply,450);
  setTimeout(()=>{
    if(apply())toast('Sesi siap. Nama santri mengikuti Presensi: '+st.nama+'.','info');
    else toast('Nama santri dari Presensi belum berhasil diterapkan.','error');
  },800);
}
function renderPresensi(){
  if(!currentUser || isWali())return;
  const students=db.santri||[];
  fillPresensiSelects();
  const selected=document.getElementById('presRekapSantri')?.value||'';
  const start=document.getElementById('presStart')?.value||'';
  const end=document.getElementById('presEnd')?.value||'';
  const allowed=new Set(visibleStudents().map(s=>String(s.id)));
  let rows=presensiLoad().filter(x=>allowed.has(String(x.student_id)))
    .filter(x=>!selected||String(x.student_id)===String(selected))
    .filter(x=>(!start||x.tanggal>=start)&&(!end||x.tanggal<=end));
  rows.sort((a,b)=>String(b.tanggal).localeCompare(String(a.tanggal)));

  const statsFor=(studentId)=>{
    const rr=rows.filter(x=>String(x.student_id)===String(studentId));
    const counts={hadir:0,izin:0,sakit:0,tidak_hadir:0};
    rr.forEach(x=>counts[x.status]=(counts[x.status]||0)+1);
    const meetings=new Set(rr.map(x=>String(x.tanggal))).size;
    const pct=rr.length?Math.round(counts.hadir/rr.length*100):0;
    return {rr,counts,meetings,pct};
  };

  const counts={hadir:0,izin:0,sakit:0,tidak_hadir:0};
  rows.forEach(x=>counts[x.status]=(counts[x.status]||0)+1);
  const uniqueDates=selected?new Set(rows.map(x=>x.tanggal)).size:new Set(rows.map(x=>x.student_id+'|'+x.tanggal)).size;
  const pct=rows.length?Math.round(counts.hadir/rows.length*100):0;
  let h='';
  if(presensiSetupNeeded) h+='<div class="card" style="border-left:4px solid #b07b00;background:#fff9e8"><b>Setup Presensi belum selesai.</b><p class="muted">Admin perlu menjalankan SQL pada menu Pengaturan → Setup Presensi Supabase agar presensi tersimpan permanen.</p></div>';
  h+='<div class="grid"><div class="card"><b>Pertemuan</b><div class="dashMiniValue">'+uniqueDates+'</div><div class="muted">'+(selected?'tanggal unik santri':'data per santri')+'</div></div><div class="card"><b>Hadir</b><div class="dashMiniValue">'+counts.hadir+'</div></div><div class="card"><b>Kehadiran</b><div class="dashMiniValue">'+pct+'%</div></div><div class="card"><b>Rekap</b><div class="muted">Hadir '+counts.hadir+' • Izin '+counts.izin+' • Sakit '+counts.sakit+' • Tidak Hadir '+counts.tidak_hadir+'</div></div></div>';

  const summaryStudents=selected?students.filter(s=>String(s.id)===String(selected)):visibleStudents();
  let sh='<h4 style="margin:18px 0 8px">📊 Rekap Per Santri</h4><div class="waliTableWrap"><table><tr><th>Santri</th><th>Pertemuan</th><th>Hadir</th><th>Izin</th><th>Sakit</th><th>Tidak Hadir</th><th>Kehadiran</th></tr>';
  if(summaryStudents.length){
    summaryStudents.forEach(s=>{const z=statsFor(s.id);sh+='<tr><td><b>'+esc(s.nama)+'</b></td><td>'+z.meetings+'</td><td>'+z.counts.hadir+'</td><td>'+z.counts.izin+'</td><td>'+z.counts.sakit+'</td><td>'+z.counts.tidak_hadir+'</td><td><b>'+z.pct+'%</b></td></tr>'});
  } else sh+='<tr><td colspan="7" class="muted">Belum ada data santri.</td></tr>';
  sh+='</table></div>';
  h+=sh;

  h+='<h4 style="margin:18px 0 8px">📅 Detail Presensi</h4><div class="waliTableWrap"><table><tr><th>Tanggal</th><th>Santri</th><th>Status</th><th>Catatan</th><th>Aksi</th></tr>';
  if(rows.length)rows.forEach(x=>{const st=students.find(s=>String(s.id)===String(x.student_id));const label={hadir:'Hadir',izin:'Izin',sakit:'Sakit',tidak_hadir:'Tidak Hadir'}[x.status]||x.status;h+='<tr><td>'+fmt(x.tanggal)+'</td><td>'+esc(st?.nama||'-')+'</td><td><span class="badge">'+label+'</span></td><td>'+esc(x.catatan||'-')+'</td><td><div style="display:flex;gap:6px;flex-wrap:wrap"><button type="button" class="btn" onclick="editPresensi(\''+esc(String(x.id))+'\')">✏️ Edit</button><button type="button" class="btn danger" onclick="deletePresensi(\''+esc(String(x.id))+'\')">🗑️ Hapus</button></div></td></tr>'});
  else h+='<tr><td colspan="5" class="muted">Belum ada data presensi pada periode ini.</td></tr>';
  h+='</table></div><p class="muted" style="margin-top:8px">Admin dan Pengajar dapat memperbaiki tanggal, status, catatan, atau menghapus presensi. Pengajar hanya dapat mengelola santri yang menjadi tugasnya.</p>';
  if(isAdmin()){
    const teacherByUser=new Map((db.teachers||[]).filter(t=>t.user_id).map(t=>[String(t.user_id),t]));
    const teacherLogs=new Map();
    (presensiLoad()||[]).filter(x=>(!start||String(x.tanggal||'')>=start)&&(!end||String(x.tanggal||'')<=end)).forEach(x=>{
      const uid=String(x.created_by||''); if(!uid)return;
      const teacher=teacherByUser.get(uid); if(!teacher)return;
      const key=uid+'|'+String(x.tanggal||'').slice(0,10);
      if(!teacherLogs.has(key))teacherLogs.set(key,{uid,tanggal:String(x.tanggal||'').slice(0,10),teacher:teacher.nama_lengkap||teacher.nama_panggilan||'Pengajar',students:new Set(),hadir:0,izin:0,sakit:0,tidak_hadir:0});
      const log=teacherLogs.get(key);log.students.add(String(x.student_id));log[x.status]=(log[x.status]||0)+1;
    });
    const logs=[...teacherLogs.values()].sort((a,b)=>b.tanggal.localeCompare(a.tanggal)||a.teacher.localeCompare(b.teacher));
    h+='<h4 style="margin:22px 0 8px">👨‍🏫 Rekap Absensi Pengajar</h4><p class="muted">Kehadiran pengajar dicatat otomatis ketika pengajar yang login menyimpan presensi santri. Rekap mengikuti rentang tanggal di atas.</p><div class="waliTableWrap"><table><tr><th>Tanggal</th><th>Pengajar</th><th>Santri Diabsen</th><th>Hadir</th><th>Izin</th><th>Sakit</th><th>Tidak Hadir</th><th>Status</th></tr>';
    if(logs.length)logs.forEach(x=>{h+='<tr><td>'+esc(fmt(x.tanggal))+'</td><td><b>'+esc(x.teacher)+'</b></td><td>'+x.students.size+'</td><td>'+x.hadir+'</td><td>'+x.izin+'</td><td>'+x.sakit+'</td><td>'+x.tidak_hadir+'</td><td><span class="badge">Presensi diisi</span></td></tr>'});
    else h+='<tr><td colspan="8" class="muted">Belum ada rekaman presensi yang terhubung dengan akun pengajar pada rentang tanggal ini.</td></tr>';
    h+='</table></div>';
  }
  const el=document.getElementById('presensiData'); if(el)el.innerHTML=h;
  const activeStatus=currentSessionStatusRow();
  const ctx=document.getElementById('presensiScheduleContext');
  if(ctx && activeScheduleContext?.id && activeStatus){ctx.style.display='block';ctx.innerHTML='<b>📅 Status Pertemuan: '+(activeStatus.status==='diliburkan'?'Pembelajaran Diliburkan':'Dijadwalkan Ulang')+'</b><div class="muted" style="margin-top:4px">'+esc(activeStatus.alasan||'Tidak ada keterangan')+' • '+fmt(activeStatus.tanggal)+'</div>';}
  if(activeScheduleContext?.id)prepareSessionStatusUI();
}

const JADWAL_KEY='shohibul_jadwal_v47';
let jadwalData=[]; let editJadwalId=null; let jadwalSetupNeeded=false;
const JADWAL_DAY_ORDER={Senin:1,Selasa:2,Rabu:3,Kamis:4,Jumat:5,Sabtu:6,Minggu:7};
function hariNama(d){return ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'][new Date(d).getDay()]}

function jadwalLoad(){try{const x=JSON.parse(localStorage.getItem(JADWAL_KEY)||'[]');return Array.isArray(x)?x:[]}catch(e){return[]}}
function jadwalSaveLocal(){localStorage.setItem(JADWAL_KEY,JSON.stringify(jadwalData))}
async function loadJadwalCloud(){
  const {data,error}=await supabaseClient.from('schedules').select('*').order('hari').order('jam');
  if(error){const msg=String(error.message||''); if(/schema cache|relation .* does not exist|could not find the table/i.test(msg)){jadwalSetupNeeded=true; jadwalData=jadwalLoad(); return;} throw new Error('Gagal membaca jadwal: '+msg)}
  jadwalSetupNeeded=false; jadwalData=(data||[]).map(x=>({id:x.id,student_id:x.student_id,hari:x.hari,jam:x.jam,jenis:x.jenis,kelas:x.kelas||'',status:x.status||'aktif',teacher_id:x.teacher_id||null,created_at:x.created_at,updated_at:x.updated_at}));
}
function scheduleTimeOptions(){
  const out=['<option value="">Pilih jam</option>'];
  for(let h=6;h<=22;h++){for(const m of [0,30]){if(h===22&&m>0)continue;const v=String(h).padStart(2,'0')+':'+String(m).padStart(2,'0');out.push('<option value="'+v+'">'+v+'</option>')}}
  return out.join('');
}
function initJadwalTimePickers(){
  const html=scheduleTimeOptions();
  const main=document.getElementById('jadwalJam');
  if(main){const cur=main.value;main.innerHTML=html;if(cur)main.value=cur;}
  for(let i=0;i<7;i++){
    const e=document.getElementById('batchTime'+i);
    if(e){const cur=e.value;e.innerHTML=html;if(cur)e.value=cur;}
  }
}
function ensureJadwalTimePickers(){
  initJadwalTimePickers();
  for(let i=0;i<7;i++){
    const e=document.getElementById('batchTime'+i);
    if(e && e.options.length<=1)e.innerHTML=scheduleTimeOptions();
  }
}
function getStudentByScheduleSelect(id){const v=document.getElementById(id)?.value;return (db.santri||[]).find(s=>String(s.id)===String(v));}
function onJadwalSantriChange(){
  const st=getStudentByScheduleSelect('jadwalSantri');
  const kelas=document.getElementById('jadwalKelas'); if(kelas)kelas.value=st?.level||st?.kelas||'';
  const jenis=document.getElementById('jadwalJenis'); if(jenis && !jenis.value && st?.kelas)jenis.value='';
}
function onJadwalBatchSantriChange(){
  const st=getStudentByScheduleSelect('jadwalBatchSantri');
  const kelas=document.getElementById('jadwalBatchKelas'); if(kelas)kelas.value=st?.level||st?.kelas||'';
}
function syncJadwalDayButtons(){ const h=document.getElementById('jadwalHari')?.value; document.querySelectorAll('[data-jadwal-day]').forEach(b=>b.classList.toggle('active',b.dataset.jadwalDay===h)); }
function resetJadwalForm(){clearJadwalBatch()}
function visibleSchedule(){let rows=jadwalData.filter(x=>x.status!=='nonaktif');if(isPengajar()){const ids=new Set(visibleStudents().map(s=>String(s.id)));rows=rows.filter(x=>ids.has(String(x.student_id)))}return rows}
function fillJadwalSantri(){const rows=visibleStudents().slice().sort((a,b)=>String(a.nama).localeCompare(String(b.nama)));const e=document.getElementById('jadwalBatchSantri');if(e){const old=e.value;e.innerHTML='<option value="">Pilih santri</option>'+rows.map(s=>'<option value="'+esc(s.id)+'">'+esc(s.nama)+'</option>').join('');if(rows.some(s=>String(s.id)===String(old)))e.value=old;}onJadwalBatchSantriChange();initJadwalTimePickers()}
function toggleJadwalWeekly(){fillJadwalSantri();const p=document.querySelector('#jadwal .jadwalWeeklyBox');if(p)p.style.display='block';}
function syncBatchDay(i){
  const c=document.getElementById('batchDay'+i),t=document.getElementById('batchTime'+i);
  if(c&&t){
    ensureJadwalTimePickers();
    t.disabled=false;
    t.classList.toggle('slotTimeActive',c.checked);
    if(!c.checked)t.value='';
  }
}
async function saveJadwal(){return saveJadwalBatch()}
async function saveJadwalBatch(){
 if(!isAdmin()&&!isPengajar()){toast('Akses jadwal hanya untuk Admin dan Pengajar.','error');return}
 if(jadwalSetupNeeded){toast('Setup Jadwal Supabase belum selesai. Jalankan SQL di Pengaturan.','error');return}
 const student_id=document.getElementById('jadwalBatchSantri')?.value;
 const jenis=document.getElementById('jadwalBatchJenis')?.value.trim();
 const kelas=document.getElementById('jadwalBatchKelas')?.value.trim();
 const status=document.getElementById('jadwalBatchStatus')?.value||'aktif';
 if(!student_id||!jenis){toast('Santri dan jenis pembelajaran wajib diisi.','error');return}
 if(isPengajar()&&!visibleStudents().some(s=>String(s.id)===String(student_id))){toast('Anda hanya dapat membuat jadwal santri yang ditugaskan.','error');return}
 const dayNames=['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Minggu'];
 const slots=[];for(let i=0;i<7;i++){const c=document.getElementById('batchDay'+i),t=document.getElementById('batchTime'+i);if(c?.checked){if(!t?.value){toast('Pilih jam untuk '+dayNames[i]+'.','error');return}slots.push({hari:dayNames[i],jam:t.value})}}
 if(editJadwalId){
   if(slots.length!==1){toast('Saat mengubah jadwal, pilih tepat 1 hari dan jam.','error');return}
   const x=slots[0];
   const st=db.santri.find(s=>String(s.id)===String(student_id));
   const payload={student_id,hari:x.hari,jam:x.jam,jenis,kelas,status,teacher_id:getCurrentTeacherId()||st?.teacher_id||null,updated_at:new Date().toISOString()};
   const res=await supabaseClient.from('schedules').update(payload).eq('id',editJadwalId).select().single();
   if(res.error){toast('Gagal memperbarui jadwal: '+res.error.message,'error');return}
   await loadJadwalCloud();clearJadwalBatch();renderJadwal();toast('Jadwal berhasil diperbarui.','success');return;
 }
 if(slots.length<2||slots.length>5){toast('Setiap santri harus memiliki 2–5 slot jadwal per pekan.','error');return}
 const st=db.santri.find(s=>String(s.id)===String(student_id));const teacher=getCurrentTeacherId()||st?.teacher_id||null;
 const duplicates=slots.filter(x=>(jadwalData||[]).some(r=>String(r.student_id)===String(student_id)&&String(r.hari)===x.hari&&String(r.jam).slice(0,5)===x.jam&&String(r.status||'aktif')==='aktif'));
 if(duplicates.length){toast('Ada slot yang sudah tersimpan: '+duplicates.map(x=>x.hari+' '+x.jam).join(', ')+'.','error');return}
 const payloads=slots.map(x=>({student_id,hari:x.hari,jam:x.jam,jenis,kelas,status,teacher_id:teacher,created_by:currentUser.id,updated_at:new Date().toISOString()}));
 const res=await supabaseClient.from('schedules').insert(payloads).select();
 if(res.error){toast('Gagal menyimpan jadwal mingguan: '+res.error.message,'error');return}
 await loadJadwalCloud();renderJadwal();clearJadwalBatch();toast(slots.length+' slot jadwal berhasil disimpan.','success')
}
function editJadwal(id){
 const x=jadwalData.find(r=>String(r.id)===String(id));if(!x)return;
 editJadwalId=x.id;
 fillJadwalSantri();
 const s=document.getElementById('jadwalBatchSantri');if(s)s.value=x.student_id;
 onJadwalBatchSantriChange();
 const jenis=document.getElementById('jadwalBatchJenis');if(jenis)jenis.value=x.jenis||'';
 const st=document.getElementById('jadwalBatchStatus');if(st)st.value=x.status||'aktif';
 clearBatchDaysOnly();
 const idx=['Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Minggu'].indexOf(x.hari);
 if(idx>=0){const c=document.getElementById('batchDay'+idx),t=document.getElementById('batchTime'+idx);if(c)c.checked=true;ensureJadwalTimePickers();if(t)t.value=String(x.jam||'').slice(0,5);syncBatchDay(idx)}
 const btn=document.getElementById('saveJadwalWeeklyBtn');if(btn)btn.textContent='✏️ Perbarui Jadwal';
 window.scrollTo({top:0,behavior:'smooth'});
}
function clearBatchDaysOnly(){for(let i=0;i<7;i++){const c=document.getElementById('batchDay'+i),t=document.getElementById('batchTime'+i);if(c)c.checked=false;if(t){t.disabled=false;t.value=''}}}
function clearJadwalBatch(){
 editJadwalId=null;
 const s=document.getElementById('jadwalBatchSantri');if(s)s.value='';
 const k=document.getElementById('jadwalBatchKelas');if(k)k.value='';
 const j=document.getElementById('jadwalBatchJenis');if(j)j.value='';
 const st=document.getElementById('jadwalBatchStatus');if(st)st.value='aktif';
 clearBatchDaysOnly();
 const btn=document.getElementById('saveJadwalWeeklyBtn');if(btn)btn.textContent='💾 Simpan Jadwal Mingguan';
 ensureJadwalTimePickers();
}
async function deleteJadwal(id){if(!isAdmin())return toast('Hanya Admin yang dapat menghapus jadwal.','error');if(jadwalSetupNeeded)return toast('Setup Jadwal Supabase belum selesai.','error');if(!confirm('Hapus jadwal ini?'))return;const {error}=await supabaseClient.from('schedules').delete().eq('id',id);if(error){toast('Gagal menghapus jadwal: '+error.message,'error');return}await loadJadwalCloud();renderJadwal();toast('Jadwal dihapus.','success')}
let activeScheduleContext=null; function startPertemuan(id){const x=jadwalData.find(r=>String(r.id)===String(id));if(!x)return;if(isScheduleLessonCompleted(x,today())){toast('Pertemuan ini sudah selesai dan nilai telah tersimpan.','info');renderJadwal();return;}activeScheduleContext={id:x.id,student_id:x.student_id,hari:x.hari,jam:x.jam,jenis:x.jenis,kelas:x.kelas||'',jadwalDate:today()};const btn=document.getElementById('navPresensi');openPresensiAtTarget(btn);setTimeout(()=>{fillPresensiSelects();const ps=document.getElementById('presSantri');const pt=document.getElementById('presTanggal');if(ps)ps.value=x.student_id;if(pt)pt.value=today();const c=document.getElementById('presensiScheduleContext');if(c){c.style.display='block';c.innerHTML='<b>📅 Pertemuan dari Jadwal</b><div style="margin-top:4px">'+esc(x.hari)+' · '+esc(x.jam)+' · '+esc(x.jenis)+(x.kelas?' · '+esc(x.kelas):'')+'</div><div class="muted">Santri: '+esc(db.santri.find(s=>String(s.id)===String(x.student_id))?.nama||'-')+'</div>'}prepareSessionStatusUI();scrollToPageTarget('presensiTitle',120)},350);toast('Presensi siap untuk '+(db.santri.find(s=>String(s.id)===String(x.student_id))?.nama||'santri')+'.','info')}
function renderJadwal(){
 ensureJadwalTimePickers();
 fillJadwalSantri();
 const setupMsg=jadwalSetupNeeded?'<div class="notice warning">⚠️ Setup Jadwal Supabase belum selesai. Jalankan SQL pada Pengaturan → Setup Jadwal Supabase.</div>':'';
 const rows=visibleSchedule().slice().sort((a,b)=>(JADWAL_DAY_ORDER[a.hari]||99)-(JADWAL_DAY_ORDER[b.hari]||99)||(a.jam||'').localeCompare(b.jam||''));
 const todayName=hariNama(new Date());const todayRows=rows.filter(x=>x.hari===todayName);const name=id=>db.santri.find(s=>String(s.id)===String(id))?.nama||'-';
 const todayEl=document.getElementById('jadwalHariIni');if(todayEl){todayEl.innerHTML=todayRows.length?'<div class="scheduleToday">'+todayRows.map(x=>'<div class="scheduleItem"><div class="scheduleTime">'+esc(x.jam)+' · '+esc(tanggalBerikutnyaUntukHari(x.hari))+'</div><h4>'+esc(name(x.student_id))+'</h4><div>'+esc(x.jenis)+'</div><div class="muted">'+esc(x.kelas||'-')+'</div><div class="actions">'+(scheduleActionLabel(x,today())||'<button class="btn primary" onclick="startPertemuan(\''+x.id+'\')">▶ Mulai Pertemuan</button>')+'</div></div>').join('')+'</div>':'<div class="muted">Belum ada jadwal aktif untuk hari ini.</div>'}
 const grouped={};rows.forEach(x=>{const sid=String(x.student_id);(grouped[sid]??=[]).push(x)});
 const summaryEl=document.getElementById('jadwalSummary');if(summaryEl){const groups=Object.entries(grouped).sort((a,b)=>name(a[0]).localeCompare(name(b[0])));summaryEl.innerHTML=groups.length?groups.map(([sid,rs])=>'<div class="jadwalSummary"><b>'+esc(name(sid))+'</b> <span class="muted">• '+rs.length+' slot/minggu</span><div style="margin-top:6px">'+rs.map(x=>'<span class="badge" style="margin:2px 4px 2px 0;display:inline-block">'+esc(x.hari)+' '+esc(x.jam)+'</span>').join('')+'</div></div>').join(''):'<div class="muted">Belum ada jadwal aktif.</div>'}
 const el=document.getElementById('jadwalData');if(!el)return;let h=setupMsg+'<div class="waliTableWrap"><table><tr><th>Hari</th><th>Jam</th><th>Santri</th><th>Kelas</th><th>Pembelajaran</th><th>Aksi</th></tr>';if(rows.length)rows.forEach(x=>{h+='<tr><td><b>'+esc(x.hari)+'</b><br><span class="muted">'+esc(tanggalBerikutnyaUntukHari(x.hari))+'</span></td><td>'+esc(x.jam)+'</td><td>'+esc(name(x.student_id))+'</td><td>'+esc(x.kelas||'-')+'</td><td>'+esc(x.jenis)+'</td><td><div class="actions">'+(scheduleActionLabel(x,today())||'<button class="btn" onclick="startPertemuan(\''+x.id+'\')">▶ Presensi / Lanjutkan</button>')+'<button class="btn edit" onclick="editJadwal(\''+x.id+'\')">Edit</button>'+(isAdmin()?'<button class="btn danger" onclick="deleteJadwal(\''+x.id+'\')">Hapus</button>':'')+'</div></td></tr>'});else h+='<tr><td colspan="6" class="muted">Belum ada jadwal.</td></tr>';h+='</table></div>';el.innerHTML=h
}

function getCurrentTeacherId(){const t=(db.teachers||[]).find(x=>String(x.user_id||'')===String(currentUser?.id||''));return t?.id||null}
function refresh(){
  // v51: jadwal Supabase adalah sumber data utama; jangan menimpa data cloud dengan localStorage saat refresh.
  initSppSqlCard(); initFinanceSqlCard(); initPresensiSqlCard(); initJadwalSqlCard(); initSessionStatusSqlCard(); initSessionSqlCard(); initAdabSqlCard(); renderFinance(); const backupCard=document.getElementById('backupCard'); if(backupCard) backupCard.style.display=isAdmin()?'block':'none';
  if(!currentUser)return;
  applyRole();
  if(activeScheduleContext && document.getElementById("pembelajaran")?.classList.contains("active")){ setTimeout(()=>applyScheduleSessionContext(),100); }
  renderAdminDashboard();
  renderPengajarDashboard();
  renderKomunikasi();
  fillPresensiSelects();
  renderPresensi();
  renderJadwal();
  fillPerkSantri();
  renderPerkembangan();
  renderPengajarManagement();
  renderSantri();fillTeachers();fill('pSantri');fill('rSantri');fill('dSantri');
  pTanggal.value=pTanggal.value||today();dDate.value=dDate.value||today();rEnd.value=rEnd.value||today();
  if(!rStart.value){let d=new Date(rEnd.value);d.setMonth(d.getMonth()-1);rStart.value=d.toISOString().slice(0,10)}
  // Sinkronkan level formulir dengan level santri terbaru saat membuka/memperbarui Pembelajaran.
  // Jangan menimpa kelas sesi lama ketika sedang mengedit riwayat sesi.
  if(!editSessionId && document.getElementById('pembelajaran')?.classList.contains('active') && pSantri.value){
    syncClass();
  }else{
    if(!pKelas.value)pKelas.value="Kelas Iqra'";
    populateJenis();
  }
  renderSessions();renderReport();renderDoa();renderWaliAccounts();renderTeacherList();renderWaliAccountSelect();renderAccountStatus();ensureWaliSelection();renderAdabPage();renderWaliPortal();
  if(editSessionId && editSessionDraft && document.getElementById('pembelajaran')?.classList.contains('active')) setTimeout(restoreSessionEditForm,0);
}

const ADAB_SETUP_SQL=`create table if not exists public.student_adab_notes (
 id uuid primary key default gen_random_uuid(),
 student_id uuid not null references public.students(id) on delete cascade,
 tanggal date not null default current_date,
 kategori text not null default 'Adab umum',
 kondisi text not null default 'Baik' check (kondisi in ('Baik','Berkembang','Perlu perhatian')),
 catatan text,
 nasihat text,
 nasihat_disampaikan boolean not null default false,
 created_by uuid references auth.users(id),
 updated_by uuid references auth.users(id),
 created_at timestamptz not null default now(),
 updated_at timestamptz not null default now()
);
create index if not exists student_adab_notes_student_date_idx on public.student_adab_notes(student_id,tanggal desc);
alter table public.student_adab_notes enable row level security;
grant select,insert,update,delete on public.student_adab_notes to authenticated;
drop policy if exists student_adab_admin on public.student_adab_notes;
create policy student_adab_admin on public.student_adab_notes for all to authenticated using (public.app_is_admin()) with check (public.app_is_admin());
drop policy if exists student_adab_teacher_select on public.student_adab_notes;
create policy student_adab_teacher_select on public.student_adab_notes for select to authenticated using (public.app_is_teacher_for_student(student_id));
drop policy if exists student_adab_teacher_insert on public.student_adab_notes;
create policy student_adab_teacher_insert on public.student_adab_notes for insert to authenticated with check (public.app_is_teacher_for_student(student_id));
drop policy if exists student_adab_teacher_update on public.student_adab_notes;
create policy student_adab_teacher_update on public.student_adab_notes for update to authenticated using (public.app_is_teacher_for_student(student_id)) with check (public.app_is_teacher_for_student(student_id));
drop policy if exists student_adab_teacher_delete on public.student_adab_notes;
create policy student_adab_teacher_delete on public.student_adab_notes for delete to authenticated using (public.app_is_teacher_for_student(student_id));
drop policy if exists student_adab_wali_select on public.student_adab_notes;
create policy student_adab_wali_select on public.student_adab_notes for select to authenticated using (exists (select 1 from public.students s where s.id=student_adab_notes.student_id and s.wali_user_id=auth.uid()));
notify pgrst, 'reload schema';`;
function initAdabSqlCard(){const card=document.getElementById('adabSqlCard'),ta=document.getElementById('adabSqlText');if(card&&ta){card.style.display=isAdmin()?'block':'none';ta.value=ADAB_SETUP_SQL}}
async function copyAdabSql(){const ta=document.getElementById('adabSqlText');try{await navigator.clipboard.writeText(ta.value);toast('SQL setup Catatan Adab berhasil disalin.','success')}catch(e){ta?.select();document.execCommand('copy');toast('SQL setup Catatan Adab disalin.','success')}}
const FINANCE_SETUP_SQL=`create table if not exists public.finance_transactions (id uuid primary key default gen_random_uuid(), type text not null check (type in ('income','expense')), category text not null, tanggal date not null default current_date, nominal numeric(14,2) not null check (nominal>0), keterangan text, created_by uuid references auth.users(id), created_at timestamptz not null default now());
create table if not exists public.finance_settings (id uuid primary key default gen_random_uuid(), saldo_awal numeric(14,2) not null default 0, updated_by uuid references auth.users(id), updated_at timestamptz not null default now());
alter table public.finance_transactions enable row level security;
alter table public.finance_settings enable row level security;
drop policy if exists finance_settings_admin on public.finance_settings;
create policy finance_settings_admin on public.finance_settings for all to authenticated using (public.app_is_admin()) with check (public.app_is_admin());
drop policy if exists finance_transactions_admin on public.finance_transactions;
create policy finance_transactions_admin on public.finance_transactions for all to authenticated using (public.app_is_admin()) with check (public.app_is_admin());
notify pgrst, 'reload schema';`;
function initFinanceSqlCard(){const card=document.getElementById('financeSqlCard'),ta=document.getElementById('financeSqlText');if(card&&ta){card.style.display=isAdmin()?'block':'none';ta.value=FINANCE_SETUP_SQL}}
async function copyFinanceSql(){const ta=document.getElementById('financeSqlText');try{await navigator.clipboard.writeText(ta.value);toast('SQL setup keuangan berhasil disalin.','success')}catch(e){ta?.select();document.execCommand('copy');toast('SQL setup keuangan disalin.','success')}}
const PRESENSI_SETUP_SQL=`create table if not exists public.attendance_records (id uuid primary key default gen_random_uuid(), student_id uuid not null references public.students(id) on delete cascade, tanggal date not null, status text not null check (status in ('hadir','izin','sakit','tidak_hadir')), catatan text, created_by uuid references auth.users(id), updated_by uuid references auth.users(id), created_at timestamptz not null default now(), updated_at timestamptz not null default now(), unique(student_id,tanggal));
alter table public.attendance_records enable row level security;
drop policy if exists attendance_admin on public.attendance_records;
create policy attendance_admin on public.attendance_records for all to authenticated using (public.app_is_admin()) with check (public.app_is_admin());
drop policy if exists attendance_teacher_select on public.attendance_records;
create policy attendance_teacher_select on public.attendance_records for select to authenticated using (public.app_is_teacher_for_student(student_id));
drop policy if exists attendance_teacher_insert on public.attendance_records;
create policy attendance_teacher_insert on public.attendance_records for insert to authenticated with check (public.app_is_teacher_for_student(student_id));
drop policy if exists attendance_teacher_update on public.attendance_records;
create policy attendance_teacher_update on public.attendance_records for update to authenticated using (public.app_is_teacher_for_student(student_id)) with check (public.app_is_teacher_for_student(student_id));
drop policy if exists attendance_teacher_delete on public.attendance_records;
drop policy if exists attendance_teacher_delete_v149 on public.attendance_records;
drop policy if exists attendance_teacher_delete_v150 on public.attendance_records;
drop policy if exists attendance_teacher_delete_v151 on public.attendance_records;
create policy attendance_teacher_delete_v151
on public.attendance_records
for delete to authenticated
using (
  public.app_is_admin()
  or public.app_is_teacher_for_student(student_id)
  or exists (
    select 1
    from public.students s
    left join public.teachers t on t.id = s.teacher_id
    left join public.profiles p on p.id = auth.uid()
    where s.id = attendance_records.student_id
      and coalesce(t.status,'Aktif') = 'Aktif'
      and (
        (
          t.id is not null
          and (
            t.user_id = auth.uid()
            or lower(trim(coalesce(t.email_login,''))) = lower(trim(coalesce(auth.jwt()->>'email','')))
            or lower(trim(coalesce(t.nama_lengkap,''))) = lower(trim(coalesce(p.full_name,'')))
          )
          and (
            s.teacher_id = t.id
            or lower(trim(coalesce(s.pengajar,''))) = lower(trim(coalesce(t.nama_lengkap,'')))
            or lower(trim(coalesce(s.pengajar,''))) = lower(trim(coalesce(t.email_login,'')))
          )
        )
        or lower(trim(coalesce(s.pengajar,''))) = lower(trim(coalesce(p.full_name,'')))
      )
  )
);
drop function if exists public.delete_attendance_for_teacher(uuid,uuid);
notify pgrst, 'reload schema';`;

